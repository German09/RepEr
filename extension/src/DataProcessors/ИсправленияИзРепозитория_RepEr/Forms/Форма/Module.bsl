///////////////////////////////////////////////////////////////////////////////////////////////////////
// Поиск и установка исправлений из репозиториев исправлений настроенных библиотек.
// Открывается вместо портала 1С:Обновление программ из типовых форм установки обновлений.
//
// Список - исправления репозиториев настроенных библиотек для их текущих версий и установленные исправления,
// которых в репозиториях нет.
// Выделенные исправления можно установить, отключить, подключить или удалить по одному (для тестирования),
// «Синхронизировать все» приводит к репозиториям все сразу, как регламентное задание.
// Чтобы исправление не работало, его отключают: отключенное синхронизация не трогает. Удаление - только
// в контекстном меню: удаленное исправление из репозитория автоматическая загрузка поставит снова,
// поэтому перед удалением форма предлагает ее выключить.
// После каждой установки или удаления оповещает ИзмененыИсправления_RepEr.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Автоматическую навигационную ссылку платформа окну формы не назначает, и команда
	// «Получить ссылку» недоступна. Ссылка задается явно, чтобы ее можно было получить из окна.
	АвтоНавигационнаяСсылка	= Ложь;
	НавигационнаяСсылка		= "e1cib/app/Обработка.ИсправленияИзРепозитория_RepEr";

	НастроитьКнопки();
	НастроитьКартинкуОтката();
	УстановитьУсловноеОформление();
	ЗаполнитьСписок();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Если Не РепозиторийНастроен Тогда
		ПодключитьОбработчикОжидания("ОткрытьНастройки", 0.1, Истина);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПояснениеОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ПоказатьПредупреждение(, ПояснениеПолностью,, НСтр("ru = 'Ошибки получения исправлений'"));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПлан

&НаКлиенте
Процедура ПланВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле = Элементы.ПланКоммит Тогда
		ИмяСсылки = "СсылкаНаКоммит";
	ИначеЕсли Поле = Элементы.ПланВерсияСборки Тогда
		ИмяСсылки = "СсылкаНаВерсию";
	ИначеЕсли СчетчикиКолонки(Поле) <> Неопределено Тогда
		// Сеансы до подключения исправления, после него и после отключения - в типовом списке активных пользователей.
		СтандартнаяОбработка	= Ложь;
		ДанныеСтроки			= План.НайтиПоИдентификатору(ВыбраннаяСтрока);
		Счетчики				= СчетчикиКолонки(Поле);
		Если ДанныеСтроки[Счетчики[0]] + ДанныеСтроки[Счетчики[1]] = 0 Тогда
			Возврат; // Пустая ячейка: сеансов нет или у откаченного исправления они не показываются.
		КонецЕсли;
		ОткрытьАктивныхПользователей(НомераСеансовПодключения(ДанныеСтроки.ДатаПодключения,
			ДанныеСтроки.ДатаОтключения, Счетчики));
		Возврат;
	ИначеЕсли Поле = Элементы.ПланПользователей Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьПользователейЗадачи(План.НайтиПоИдентификатору(ВыбраннаяСтрока));
		Возврат;
	Иначе
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	ОткрытьСсылкуСтроки(План.НайтиПоИдентификатору(ВыбраннаяСтрока), ИмяСсылки, Ложь);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьВыбранные(Команда)

	Имена = ВыделенныеИсправления();
	Если Имена.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выделите исправления, которые нужно установить.'"));
		Возврат;
	КонецЕсли;

	ВыполнитьОперацию(НачатьОперацию("РепозиторийИсправлений_RepEr.УстановитьИсправления", Имена),
		НСтр("ru = 'Установка исправлений из репозитория...'"));

КонецПроцедуры

&НаКлиенте
Процедура ОтключитьВыбранные(Команда)

	Имена = ВыделенныеИсправления();
	Если Имена.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выделите исправления, которые нужно отключить.'"));
		Возврат;
	КонецЕсли;

	ВыполнитьОперацию(НачатьОперацию("РепозиторийИсправлений_RepEr.ОтключитьИсправления", Имена),
		НСтр("ru = 'Отключение исправлений...'"));

КонецПроцедуры

&НаКлиенте
Процедура ПодключитьВыбранные(Команда)

	Имена = ВыделенныеИсправления();
	Если Имена.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выделите исправления, которые нужно подключить.'"));
		Возврат;
	КонецЕсли;

	ВыполнитьОперацию(НачатьОперацию("РепозиторийИсправлений_RepEr.ПодключитьИсправления", Имена),
		НСтр("ru = 'Подключение исправлений...'"));

КонецПроцедуры

&НаКлиенте
Процедура УдалитьВыбранные(Команда)

	Имена = ВыделенныеИсправления();
	Если Имена.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выделите исправления, которые нужно удалить.'"));
		Возврат;
	КонецЕсли;

	ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Удалить исправления: %1?'"), СтрСоединить(Имена, ", "));
	Оповещение = Новый ОписаниеОповещения("УдалитьВыбранныеЗавершение", ЭтотОбъект, Имена);

	// Исправление из репозитория регламентное задание загрузки поставит снова - предлагается его выключить.
	Если Не ЕстьВыделенныеВРепозитории() Или Не ЗагрузкаВключена() Тогда
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;

	ТекстВопроса = ТекстВопроса + Символы.ПС + Символы.ПС
		+ НСтр("ru = 'Включена автоматическая загрузка исправлений: она установит их из репозитория снова.
		|Чтобы исправление не работало, лучше отключить его: отключенное загрузка не трогает.'");
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить("Отключить", НСтр("ru = 'Отключить'"));
	Кнопки.Добавить("УдалитьИВыключитьЗагрузку", НСтр("ru = 'Удалить и выключить загрузку'"));
	Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Только удалить'"));
	Кнопки.Добавить(КодВозвратаДиалога.Отмена);
	ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки,, "Отключить");

КонецПроцедуры

&НаКлиенте
Процедура Синхронизировать(Команда)

	Если Не ЕстьИзменения Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Установленные исправления соответствуют репозиторию.'"));
		Возврат;
	КонецЕсли;

	ВыполнитьОперацию(НачатьСинхронизацию(), НСтр("ru = 'Синхронизация исправлений с репозиторием...'"));

КонецПроцедуры

&НаКлиенте
Процедура Настройки(Команда)

	ОткрытьНастройки();

КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)

	ЗаполнитьСписок();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКоммит(Команда)

	ОткрытьСсылкуСтроки(Элементы.План.ТекущиеДанные, "СсылкаНаКоммит", Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСписок()

	РепозиторийНастроен	= РепозиторийИсправлений_RepEr.РепозиторийНастроен();
	Список				= РепозиторийИсправлений_RepEr.СписокИсправлений();

	Таблица = РеквизитФормыВЗначение("План");
	Таблица.Очистить();
	Для Каждого Исправление Из Список.Исправления Цикл
		Строка = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Исправление);
		Строка.Исправление	= Исправление.Имя;
		Строка.ЭтоСрочное	= Исправление.Срочное;
		Строка.Срочное		= ?(Исправление.Срочное, БиблиотекаКартинок.СрочноеИсправление_RepEr, Новый Картинка);
		// Откаченное исправление и откат (REV) - одной картинкой: оба - результат git revert EF-коммита.
		// Откат - вид исправления, картинка у наименования; откаченное - состояние, картинка в состоянии.
		Строка.Откат		= ?(Исправление.Откат, БиблиотекаКартинок.ОтменитьДействие, Новый Картинка);
		Строка.Откачено		= ?(Исправление.Отозвано, БиблиотекаКартинок.ОтменитьДействие, Новый Картинка);
		Строка.Подключено	= ПредставлениеДаты(Исправление.ДатаПодключения);
		Строка.Отключено	= ПредставлениеДаты(Исправление.ДатаОтключения);
		Если Исправление.Отозвано Тогда
			// В сеансах без откаченного исправления все правильно: их число ни о чем не говорит.
			Строка.ФоновыхДо	= 0;
			Строка.ОстальныхДо	= 0;
		КонецЕсли;

		Строка.СеансовДо				= ПредставлениеСеансов(Строка.ФоновыхДо, Строка.ОстальныхДо);
		Строка.СеансовПосле				= ПредставлениеСеансов(Строка.ФоновыхПосле, Строка.ОстальныхПосле);
		Строка.СеансовПослеОтключения	= ПредставлениеСеансов(Строка.ФоновыхПослеОтключения,
			Строка.ОстальныхПослеОтключения);
	КонецЦикла;
	Таблица.Сортировать("Порядок, ПорядокУстановки, Исправление");
	ЗначениеВРеквизитФормы(Таблица, "План");
	УстановитьОформлениеДатДоНачалаПериода();

	ЕстьИзменения								= Список.ЕстьИзменения;
	Элементы.ФормаСинхронизировать.Доступность	= ЕстьИзменения;

	Строки = Новый Массив;
	Если Список.Библиотеки.Количество() = 0 Тогда
		Строки.Добавить(НСтр("ru = 'Репозиторий исправлений не настроен.'"));
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Строки, Список.Ошибки);
	ПояснениеПолностью				= СтрСоединить(Строки, Символы.ПС);
	Элементы.Пояснение.Заголовок	= КраткоеПояснение(Строки, ПояснениеПолностью);
	Элементы.Пояснение.Видимость	= Строки.Количество() > 0;

КонецПроцедуры

// Ошибки одной строкой с картинкой: полный текст занимает полэкрана и сдвигает список вниз.
// Ошибки обычно отличаются только началом («Не удалось получить ...: »), а причина у них одна -
// например, RepEr недоступен. Тогда выводится только причина. Полный текст - по ссылке «Подробнее».
//
// Параметры:
//  Строки				- Массив из Строка - ошибки.
//  ПояснениеПолностью	- Строка - ошибки через перевод строки.
//
// Возвращаемое значение:
//  ФорматированнаяСтрока, Строка - пустая строка, если ошибок нет.
//
&НаСервереБезКонтекста
Функция КраткоеПояснение(Строки, ПояснениеПолностью)

	Если Строки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Причины = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		Позиция = СтрНайти(Строка, ": ");
		Причина = ?(Позиция = 0, Строка, Сред(Строка, Позиция + 2));
		Причина = ВРег(Лев(Причина, 1)) + Сред(Причина, 2);
		Если Причины.Найти(Причина) = Неопределено Тогда
			Причины.Добавить(Причина);
		КонецЕсли;
	КонецЦикла;

	Если Строки.Количество() = 1 Тогда
		Текст = Строки[0];
	ИначеЕсли Причины.Количество() = 1 Тогда
		Текст = Причины[0];
	Иначе
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 (и еще ошибок: %2)'"),
			Строки[0], Строки.Количество() - 1);
	КонецЕсли;
	// Описание ошибки бывает многострочным - видна только первая строка.
	Позиция = СтрНайти(Текст, Символы.ПС);
	Если Позиция > 0 Тогда
		Текст = Лев(Текст, Позиция - 1);
	КонецЕсли;

	Части = Новый Массив;
	Части.Добавить(БиблиотекаКартинок.Предупреждение);
	Части.Добавить(" " + Текст);
	Если Текст <> ПояснениеПолностью Тогда
		Части.Добавить(" ");
		Части.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Подробнее'"),,,, "Подробнее"));
	КонецЕсли;

	Возврат Новый ФорматированнаяСтрока(Части);

КонецФункции

// Типовые картинки команд: они видны и на кнопках командной панели, и в контекстном меню таблицы.
// Отключение и подключение - картинками состояния, к которому они приводят, как в легенде и в заголовках
// колонок: «Отключено» и «Будет подключено после перезапуска». Удаление - не круглым красным крестиком
// БиблиотекаКартинок.Удалить: его не отличить от состояния «Не удалось подключить».
//
&НаСервере
Процедура НастроитьКнопки()
	
	Команды.УстановитьВыбранные.Картинка	= БиблиотекаКартинок.ОбновитьФайлИзФайлаНаДиске;
	Команды.ОтключитьВыбранные.Картинка		= БиблиотекаКартинок.СостоянияИсправленийОтключено_RepEr;
	Команды.ПодключитьВыбранные.Картинка	= БиблиотекаКартинок.СостоянияРасширенийБудетПодключено;
	Команды.УдалитьВыбранные.Картинка		= БиблиотекаКартинок.ПометитьНаУдаление;
	Команды.Синхронизировать.Картинка		= БиблиотекаКартинок.РегламентноеЗадание;
	Команды.Обновить.Картинка				= БиблиотекаКартинок.Обновить;
	Команды.Настройки.Картинка				= БиблиотекаКартинок.НастройкиШестеренка;
	Команды.ОткрытьКоммит.Картинка			= БиблиотекаКартинок.ВнешняяСсылкаНаОбъектИнформационнойБазы;
	
	Для Каждого Кнопка Из Элементы.ФормаКоманднаяПанель.ПодчиненныеЭлементы Цикл
		Если ТипЗнч(Кнопка) = Тип("КнопкаФормы") Тогда
			Кнопка.Отображение = ОтображениеКнопки.КартинкаИТекст;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Откат (REV) в легенде - типовой картинкой отмены действия: картинка конфигурации без заимствования
// в расширение доступна только из кода.
//
&НаСервере
Процедура НастроитьКартинкуОтката()

	Элементы.КартинкаОткат.Картинка = БиблиотекаКартинок.ОтменитьДействие;

КонецПроцедуры

// Наименование срочного исправления (FIRE) - жирным. Число сеансов не выделяется: это гиперссылки,
// как коммит и версия сборки.
//
&НаСервере
Процедура УстановитьУсловноеОформление()

	Элемент = УсловноеОформление.Элементы.Добавить();

	Поле		= Элемент.Поля.Элементы.Добавить();
	Поле.Поле	= Новый ПолеКомпоновкиДанных(Элементы.ПланНаименование.Имя);

	Отбор					= Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение		= Новый ПолеКомпоновкиДанных("План.ЭтоСрочное");
	Отбор.ВидСравнения		= ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение	= Истина;

	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтыСтиля.ВажнаяНадписьШрифт);

	// Без пострадавших - пустая ячейка, а не 0: иначе нули в каждой строке отвлекают от исправлений с ошибками.
	Элемент = УсловноеОформление.Элементы.Добавить();

	Поле		= Элемент.Поля.Элементы.Добавить();
	Поле.Поле	= Новый ПолеКомпоновкиДанных(Элементы.ПланПользователей.Имя);

	Отбор					= Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение		= Новый ПолеКомпоновкиДанных("План.Пользователей");
	Отбор.ВидСравнения		= ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение	= 0;

	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "");

КонецПроцедуры

// Подключение и отключение раньше начала периода журнала: дата в списке - начало периода,
// показывается «до» и дата начала периода. Давно подключенные исправления - серым шрифтом.
// Коммиты сегодняшнего дня - только время.
// Начало периода и сегодняшний день сдвигаются, поэтому оформление пересоздается при каждом заполнении списка.
//
&НаСервере
Процедура УстановитьОформлениеДатДоНачалаПериода()

	ИмяОформления = "ДоНачалаПериода";

	Индекс = УсловноеОформление.Элементы.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если УсловноеОформление.Элементы[Индекс].Представление = ИмяОформления Тогда
			УсловноеОформление.Элементы.Удалить(УсловноеОформление.Элементы[Индекс]);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	НачалоПериода	= РепозиторийИсправлений_RepEr.НачалоПериодаПодключения();
	Текст			= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'до %1'"),
		Формат(НачалоПериода, "ДФ=dd.MM.yy"));

	Колонки = Новый Соответствие;
	Колонки.Вставить(Элементы.ПланПодключено.Имя,	"План.ДатаПодключения");
	Колонки.Вставить(Элементы.ПланОтключено.Имя,	"План.ДатаОтключения");
	Для Каждого Колонка Из Колонки Цикл
		Элемент					= УсловноеОформление.Элементы.Добавить();
		Элемент.Представление	= ИмяОформления;

		Поле		= Элемент.Поля.Элементы.Добавить();
		Поле.Поле	= Новый ПолеКомпоновкиДанных(Колонка.Ключ);

		Отбор					= Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отбор.ЛевоеЗначение		= Новый ПолеКомпоновкиДанных(Колонка.Значение);
		Отбор.ВидСравнения		= ВидСравненияКомпоновкиДанных.Равно;
		Отбор.ПравоеЗначение	= НачалоПериода;

		Элемент.Оформление.УстановитьЗначениеПараметра("Текст", Текст);
	КонецЦикла;

	Элемент					= УсловноеОформление.Элементы.Добавить();
	Элемент.Представление	= ИмяОформления;

	Отбор					= Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение		= Новый ПолеКомпоновкиДанных("План.ДатаПодключения");
	Отбор.ВидСравнения		= ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение	= НачалоПериода;

	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);

	// Коммит сегодня - только время, как подключение и отключение (см. ПредставлениеДаты).
	// Колонка остается датой, чтобы сортировка по ней не ломалась.
	Элемент					= УсловноеОформление.Элементы.Добавить();
	Элемент.Представление	= ИмяОформления;

	Поле		= Элемент.Поля.Элементы.Добавить();
	Поле.Поле	= Новый ПолеКомпоновкиДанных(Элементы.ПланДатаКоммита.Имя);

	Отбор					= Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение		= Новый ПолеКомпоновкиДанных("План.ДатаКоммита");
	Отбор.ВидСравнения		= ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
	Отбор.ПравоеЗначение	= НачалоДня(ТекущаяДатаСеанса());

	Элемент.Оформление.УстановитьЗначениеПараметра("Формат", "ДФ=HH:mm");

КонецПроцедуры

// Параметры:
//  Момент - Дата - подключение или отключение исправления, пустая - нет в журнале регистрации.
//
// Возвращаемое значение:
//  Строка - сегодня - только время, иначе дата и время.
//
&НаСервереБезКонтекста
Функция ПредставлениеДаты(Момент)

	Если Не ЗначениеЗаполнено(Момент) Тогда
		Представление = "";
	ИначеЕсли НачалоДня(Момент) = НачалоДня(ТекущаяДатаСеанса()) Тогда
		Представление = Формат(Момент, "ДФ=HH:mm");
	Иначе
		Представление = Формат(Момент, "ДФ='dd.MM.yy HH:mm'");
	КонецЕсли;

	Возврат Представление;

КонецФункции

// Фоновые задания и остальные сеансы - одной строкой «ФЗ + сеансы»: у колонок группы «В ячейке»
// платформа разделяет значения запятой, и разделитель не настраивается.
//
// Параметры:
//  Фоновых		- Число - фоновые задания.
//  Остальных	- Число - остальные сеансы.
//
// Возвращаемое значение:
//  Строка - «ФЗ + сеансы», пустая - сеансов нет.
//
&НаСервереБезКонтекста
Функция ПредставлениеСеансов(Фоновых, Остальных)

	Если Фоновых = 0 И Остальных = 0 Тогда
		Представление = "";
	Иначе
		Представление = Формат(Фоновых, "ЧН=0; ЧГ=0") + " + " + Формат(Остальных, "ЧН=0; ЧГ=0");
	КонецЕсли;

	Возврат Представление;

КонецФункции

// В колонке сеансов - фоновые задания и остальные сеансы одной строкой, см. ПредставлениеСеансов.
// Какое из чисел нажато, не различить, поэтому в список попадают сеансы обоих счетчиков колонки.
//
// Параметры:
//  Поле - ПолеФормы - колонка таблицы План.
//
// Возвращаемое значение:
//  Массив из Строка - имена счетчиков исправления в колонке: фоновые и остальные сеансы.
//  Неопределено - колонка не с сеансами.
//
&НаКлиенте
Функция СчетчикиКолонки(Поле)

	Если Поле = Элементы.ПланСеансовДо Тогда
		Счетчики = СтрРазделить("ФоновыхДо,ОстальныхДо", ",");
	ИначеЕсли Поле = Элементы.ПланСеансовПосле Тогда
		Счетчики = СтрРазделить("ФоновыхПосле,ОстальныхПосле", ",");
	ИначеЕсли Поле = Элементы.ПланСеансовПослеОтключения Тогда
		Счетчики = СтрРазделить("ФоновыхПослеОтключения,ОстальныхПослеОтключения", ",");
	Иначе
		Счетчики = Неопределено;
	КонецЕсли;

	Возврат Счетчики;

КонецФункции

// Параметры:
//  ДатаПодключения	- Дата
//  ДатаОтключения	- Дата
//  Счетчики		- Массив из Строка - см. СчетчикиКолонки
//
// Возвращаемое значение:
//  Массив из Число - см. РепозиторийИсправлений_RepEr.НомераСеансовПодключения
//
&НаСервереБезКонтекста
Функция НомераСеансовПодключения(ДатаПодключения, ДатаОтключения, Счетчики)

	Возврат РепозиторийИсправлений_RepEr.НомераСеансовПодключения(ДатаПодключения, ДатаОтключения, Счетчики);

КонецФункции

// Открывает типовой список активных пользователей только с указанными сеансами. Параметра отбора
// по сеансам у типовой формы нет: строки остальных сеансов удаляются из ее списка после открытия.
// Окно каждый раз новое: в уже открытом списке строк нужных сеансов может не быть.
// Команда «Обновить» в нем возвращает все сеансы.
//
// Параметры:
//  НомераСеансов - Массив из Число
//
&НаКлиенте
Процедура ОткрытьАктивныхПользователей(НомераСеансов)

	Если НомераСеансов.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Таких сеансов сейчас нет.'"));
		Возврат;
	КонецЕсли;

	Форма = ОткрытьФорму("Обработка.АктивныеПользователи.Форма",,, Новый УникальныйИдентификатор);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Список	= Форма.СписокПользователей;
	Индекс	= Список.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если НомераСеансов.Найти(Список[Индекс].Сеанс) = Неопределено Тогда
			Список.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	Форма.КоличествоАктивныхПользователей = Список.Количество();

КонецПроцедуры

// Пользователи, у которых возникали ошибки по задаче исправления, по данным RepEr - списком для выбора:
// выбранный пользователь этой базы открывается.
//
// Параметры:
//  ДанныеСтроки - ДанныеФормыЭлементКоллекции - строка таблицы План.
//
&НаКлиенте
Процедура ОткрытьПользователейЗадачи(ДанныеСтроки)

	Если Не ЗначениеЗаполнено(ДанныеСтроки.Задача) Тогда
		ПоказатьПредупреждение(, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Задача исправления %1 неизвестна.'"), ДанныеСтроки.Исправление));
		Возврат;
	КонецЕсли;

	Результат = ПользователиЗадачи(ДанныеСтроки.Задача);
	Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
		ПоказатьПредупреждение(, Результат.Ошибка);
		Возврат;
	ИначеЕсли Результат.Пользователи.Количество() = 0 Тогда
		ПоказатьПредупреждение(, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'В RepEr нет ошибок по задаче %1.'"), ДанныеСтроки.Задача));
		Возврат;
	КонецЕсли;

	Список = Новый СписокЗначений;
	Для Каждого Пользователь Из Результат.Пользователи Цикл
		Список.Добавить(?(Пользователь.Пользователь = Неопределено, Пользователь.Имя, Пользователь.Пользователь),
			Пользователь.Представление);
	КонецЦикла;
	ЗаголовокСписка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Пользователи с ошибками по задаче %1'"), ДанныеСтроки.Задача);
	Список.ПоказатьВыборЭлемента(Новый ОписаниеОповещения("ПослеВыбораПользователяЗадачи", ЭтотОбъект), ЗаголовокСписка);

КонецПроцедуры

// Параметры:
//  ВыбранныйЭлемент		- ЭлементСпискаЗначений, Неопределено - пользователь из списка, см. ОткрытьПользователейЗадачи
//  ДополнительныеПараметры	- Неопределено
//
&НаКлиенте
Процедура ПослеВыбораПользователяЗадачи(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

	// Пользователя, которого нет в этой базе, открыть нельзя: в списке только его имя.
	Если ВыбранныйЭлемент <> Неопределено И ТипЗнч(ВыбранныйЭлемент.Значение) <> Тип("Строка") Тогда
		ПоказатьЗначение(, ВыбранныйЭлемент.Значение);
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  Задача - Строка - код задачи исправления.
//
// Возвращаемое значение:
//  см. РепозиторийИсправлений_RepEr.ПользователиЗадачи
//  У пользователей дополнительно Представление - Строка - для списка выбора.
//
&НаСервереБезКонтекста
Функция ПользователиЗадачи(Задача)

	Результат = РепозиторийИсправлений_RepEr.ПользователиЗадачи(Задача);
	Для Каждого Пользователь Из Результат.Пользователи Цикл
		Пользователь.Вставить("Представление", ?(Пользователь.Пользователь = Неопределено, Пользователь.Имя,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1 (%2)", Пользователь.Пользователь, Пользователь.Имя)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращаемое значение:
//  Массив из Строка - имена выделенных исправлений.
//
&НаКлиенте
Функция ВыделенныеИсправления()

	Имена = Новый Массив;
	Для Каждого Идентификатор Из Элементы.План.ВыделенныеСтроки Цикл
		Имена.Добавить(План.НайтиПоИдентификатору(Идентификатор).Исправление);
	КонецЦикла;

	Возврат Имена;

КонецФункции

// Параметры:
//  ДанныеСтроки		- ДанныеФормыЭлементКоллекции - строка таблицы План.
//						- Неопределено - нет текущей строки.
//  ИмяСсылки			- Строка - колонка с адресом: СсылкаНаКоммит или СсылкаНаВерсию.
//  СообщатьОбОшибке	- Булево - предупредить, если адреса нет.
//
&НаКлиенте
Процедура ОткрытьСсылкуСтроки(ДанныеСтроки, ИмяСсылки, СообщатьОбОшибке)

	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ДанныеСтроки[ИмяСсылки]) Тогда
		ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(ДанныеСтроки[ИмяСсылки]);
	ИначеЕсли СообщатьОбОшибке Тогда
		ПоказатьПредупреждение(, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'У исправления %1 в репозитории нет адреса коммита.'"), ДанныеСтроки.Исправление));
	КонецЕсли;

КонецПроцедуры

// Возвращаемое значение:
//  Булево - среди выделенных есть исправления, которые синхронизация установит из репозитория:
//           есть сборка в репозитории и исправление не откачено.
//
&НаКлиенте
Функция ЕстьВыделенныеВРепозитории()

	Для Каждого Идентификатор Из Элементы.План.ВыделенныеСтроки Цикл
		ДанныеСтроки = План.НайтиПоИдентификатору(Идентификатор);
		Если ЗначениеЗаполнено(ДанныеСтроки.ВерсияСборки) И Не ДанныеСтроки.Отозвано Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаСервереБезКонтекста
Функция ЗагрузкаВключена()

	Возврат Константы.ЗагружатьИУстанавливатьИсправленияАвтоматически.Получить();

КонецФункции

&НаСервереБезКонтекста
Процедура ВыключитьЗагрузку()

	РепозиторийИсправлений_RepEr.ВключитьЗагрузку(Ложь);

КонецПроцедуры

// Параметры:
//  Ответ	- КодВозвратаДиалога
//			- Строка - «Отключить»: отключить вместо удаления;
//			  «УдалитьИВыключитьЗагрузку»: перед удалением выключить автоматическую загрузку.
//  Имена	- Массив из Строка
//
&НаКлиенте
Процедура УдалитьВыбранныеЗавершение(Ответ, Имена) Экспорт

	Если Ответ = "Отключить" Тогда
		ВыполнитьОперацию(НачатьОперацию("РепозиторийИсправлений_RepEr.ОтключитьИсправления", Имена),
			НСтр("ru = 'Отключение исправлений...'"));
		Возврат;
	ИначеЕсли Ответ = "УдалитьИВыключитьЗагрузку" Тогда
		// До удаления: иначе задание, запущенное во время удаления, поставит исправления снова.
		ВыключитьЗагрузку();
	ИначеЕсли Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ВыполнитьОперацию(НачатьОперацию("РепозиторийИсправлений_RepEr.УдалитьИсправления", Имена),
		НСтр("ru = 'Удаление исправлений...'"));

КонецПроцедуры

&НаСервере
Функция НачатьОперацию(ИмяФункции, Имена)

	ПараметрыВыполнения								= ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания	= НСтр("ru = 'Установка и удаление исправлений из репозитория'");

	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, ИмяФункции, Имена);

КонецФункции

&НаСервере
Функция НачатьСинхронизацию()

	ПараметрыВыполнения								= ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания	= НСтр("ru = 'Синхронизация исправлений с репозиторием'");

	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, "РепозиторийИсправлений_RepEr.Синхронизировать");

КонецФункции

// Параметры:
//  ДлительнаяОперация	- см. ДлительныеОперации.ВыполнитьФункцию
//  ТекстСообщения		- Строка
//
&НаКлиенте
Процедура ВыполнитьОперацию(ДлительнаяОперация, ТекстСообщения)

	ПараметрыОжидания						= ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения		= ТекстСообщения;
	ПараметрыОжидания.ВыводитьОкноОжидания	= Истина;

	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация,
		Новый ОписаниеОповещения("ПослеОперации", ЭтотОбъект), ПараметрыОжидания);

КонецПроцедуры

// Параметры:
//  Результат				- см. ДлительныеОперацииКлиент.НовыйРезультатДлительнойОперации
//  ДополнительныеПараметры	- Неопределено
//
&НаКлиенте
Процедура ПослеОперации(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат; // Отменено пользователем.
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;

	Итог = ИтогОперации(Результат.АдресРезультата);
	ЗаполнитьСписок();

	Если Не Итог.Изменено Тогда
		ПоказатьПредупреждение(, Итог.Текст);
		Возврат;
	КонецЕсли;

	Оповестить("ИзмененыИсправления_RepEr");

	// Установленные и удаленные исправления подключаются только в новом сеансе.
	ТекстВопроса = Итог.Текст + Символы.ПС + Символы.ПС
		+ НСтр("ru = 'Изменения вступят в силу после перезапуска программы. Перезапустить сейчас?'");
	ПоказатьВопрос(Новый ОписаниеОповещения("ПерезапуститьЗавершение", ЭтотОбъект), ТекстВопроса,
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

// Параметры:
//  Ответ					- КодВозвратаДиалога
//  ДополнительныеПараметры	- Неопределено
//
&НаКлиенте
Процедура ПерезапуститьЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗавершитьРаботуСистемы(Ложь, Истина);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ИтогОперации(АдресРезультата)

	Синхронизация = ПолучитьИзВременногоХранилища(АдресРезультата);

	Строки = Новый Массив;
	Если Синхронизация.Установлены.Количество() > 0 Тогда
		Строки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Установлены: %1.'"), СтрСоединить(Синхронизация.Установлены, ", ")));
	КонецЕсли;
	Если Синхронизация.Удалены.Количество() > 0 Тогда
		Строки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Удалены: %1.'"), СтрСоединить(Синхронизация.Удалены, ", ")));
	КонецЕсли;
	Если Синхронизация.Подключены.Количество() > 0 Тогда
		Строки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Подключены: %1.'"), СтрСоединить(Синхронизация.Подключены, ", ")));
	КонецЕсли;
	Если Синхронизация.Отключены.Количество() > 0 Тогда
		Строки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Отключены: %1.'"), СтрСоединить(Синхронизация.Отключены, ", ")));
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Строки, Синхронизация.Ошибки);
	Если Строки.Количество() = 0 Тогда
		Строки.Добавить(НСтр("ru = 'Изменений нет.'"));
	КонецЕсли;

	Итог = Новый Структура;
	Итог.Вставить("Текст",		СтрСоединить(Строки, Символы.ПС));
	Итог.Вставить("Изменено",	Синхронизация.Установлены.Количество() > 0 Или Синхронизация.Удалены.Количество() > 0
		Или Синхронизация.Подключены.Количество() > 0 Или Синхронизация.Отключены.Количество() > 0);

	Возврат Итог;

КонецФункции

&НаКлиенте
Процедура ОткрытьНастройки() Экспорт

	ОткрытьФорму("ОбщаяФорма.НастройкиРепозитория_RepEr",, ЭтотОбъект,,,,
		Новый ОписаниеОповещения("ПослеНастройки", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

// Параметры:
//  Записано				- Булево, Неопределено - Истина, если настройки записаны.
//  ДополнительныеПараметры	- Неопределено
//
&НаКлиенте
Процедура ПослеНастройки(Записано, ДополнительныеПараметры) Экспорт

	Если Записано = Истина Тогда
		ЗаполнитьСписок();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
