#Область СлужебныеПроцедурыИФункции

&НаСервере
&После("ПриСозданииНаСервере")
Процедура ПриСозданииНаСервере_RepEr(Отказ, СтандартнаяОбработка)

	РепозиторийДоступен_RepEr = РепозиторийИсправлений_RepEr.РепозиторийДоступен();
	Если Не РепозиторийДоступен_RepEr Тогда
		Возврат;
	КонецЕсли;

	Элементы.ПоискИУстановкаОбновлений.Видимость						= Истина;
	Элементы.ПоискИУстановкаОбновлений.Заголовок						= НСтр("ru = 'Поиск и установка исправлений'");
	Элементы.ПоискИУстановкаОбновленийРасширеннаяПодсказка.Заголовок	= РепозиторийИсправлений_RepEr.ПредставлениеИсточника();

КонецПроцедуры

&НаКлиенте
&Вместо("ПоискИУстановкаОбновлений")
Процедура ПоискИУстановкаОбновлений_RepEr(Команда)

	Если Не РепозиторийДоступен_RepEr Тогда
		ПродолжитьВызов(Команда);
		Возврат;
	КонецЕсли;

	Закрыть();
	ОткрытьФорму("Обработка.ИсправленияИзРепозитория_RepEr.Форма");

КонецПроцедуры

// Типовая форма прячет ссылку при подключении через веб-сервер, так как обновление с портала
// там недоступно. Исправления из репозитория устанавливаются на сервере, поэтому ссылка остается.
//
&НаКлиенте
&После("ПередОткрытиемСтраницы")
Процедура ПередОткрытиемСтраницы_RepEr(Знач НоваяСтраница = Неопределено)

	Если РепозиторийДоступен_RepEr Тогда
		Элементы.ГруппаПоискИУстановкаОбновлений.Видимость = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
