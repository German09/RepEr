#Область ОбработчикиСобытий

// Открывается по внешней ссылке из задачи об ошибке, которую формирует RepEr:
//	https://<сервер>/<публикация>#e1cib/command/ОбщаяКоманда.ЖурналРегистрацииПоОшибке_RepEr?cmdprm=СправочникСсылка.Пользователи:<hex>,...
// Платформа передает в команду по ссылке только ссылки, поэтому пользователь и период
// записаны в уникальные идентификаторы несуществующих ссылок, см. ОтборЖурналаРегистрации
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Отбор = ОтборЖурналаРегистрации(ПараметрКоманды);
	Если Отбор = Неопределено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Не удалось прочитать из ссылки пользователя и период ошибки.'"));
	Иначе
		ЖурналРегистрацииКлиент.ОткрытьЖурналРегистрации(Отбор, ПараметрыВыполненияКоманды.Источник);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Отбор журнала регистрации из ссылок параметра команды.
// Строка UTF-8 "<начало><окончание><имя пользователя>" (даты - ГГГГММДДччммсс) записана
// шестнадцатеричными цифрами по 32 в уникальные идентификаторы ссылок, хвост дополнен нулями.
// 
// Параметры:
//  Ссылки - Массив Из ЛюбаяСсылка
//         - ЛюбаяСсылка
// 
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если ссылки не удалось разобрать:
//  * Пользователь 	- Строка - имя пользователя информационной базы
//  * ДатаНачала 	- Дата
//  * ДатаОкончания - Дата
&НаСервере
Функция ОтборЖурналаРегистрации(Знач Ссылки)
	
	Результат = Неопределено;
	ДлинаДаты = 14;
	
	Если ТипЗнч(Ссылки) <> Тип("Массив") Тогда
		Ссылки = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ссылки);
	КонецЕсли;
	
	Части = Новый Массив;
	Для Каждого Ссылка Из Ссылки Цикл
		Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Ссылка)) Тогда
			Части.Добавить(СтрЗаменить(Строка(Ссылка.УникальныйИдентификатор()), "-", ""));
		КонецЕсли;
	КонецЦикла;
	
	Цифры = СтрСоединить(Части);
	Пока СтрЗаканчиваетсяНа(Цифры, "00") Цикл
		Цифры = Лев(Цифры, СтрДлина(Цифры) - 2);
	КонецЦикла;
	
	Попытка
		Текст = ПолучитьСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзHexСтроки(Цифры), КодировкаТекста.UTF8);
	Исключение
		Текст = "";
	КонецПопытки;
	
	Даты = Лев(Текст, 2 * ДлинаДаты);
	Пользователь = Сред(Текст, 2 * ДлинаДаты + 1);
	Если СтрДлина(Даты) = 2 * ДлинаДаты И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Даты)
		И ЗначениеЗаполнено(Пользователь) Тогда
		
		Попытка
			Результат = Новый Структура;
			Результат.Вставить("Пользователь", 	Пользователь);
			Результат.Вставить("ДатаНачала", 	Дата(Лев(Даты, ДлинаДаты)));
			Результат.Вставить("ДатаОкончания", Дата(Сред(Даты, ДлинаДаты + 1)));
		Исключение
			Результат = Неопределено;
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
