#Область ОбработчикиСобытий

// GET /hs/reperext/patches?since=2026-10-05T10:00:00 - исправления в базе и ошибки их загрузки с даты since
// (без параметра - за последний час) для проверки установки в пайплайне,
// см. РепозиторийИсправлений_RepEr.СостояниеУстановки
//
// Ответ - JSON:
//  now				- дата базы: ее передавать в since следующего запроса;
//  auto_install	- включена загрузка исправлений по расписанию;
//  patches			- [{name, uuid, version, state, fire, attached_at, sessions_before}], state - attached (подключено),
//					  pending (будет подключено), failed (не удалось подключить), disabled (снят флажок «Подключать»);
//  errors			- [{date, text, count}] - ошибки загрузки без повторов.
//
Функция ИсправленияПолучить(Запрос)

	НачалоПериода	= ТекущаяДатаСеанса() - 3600;
	ПараметрДаты	= Запрос.ПараметрыЗапроса.Получить("since");
	ДатаВерна		= Истина;
	Если ЗначениеЗаполнено(ПараметрДаты) Тогда
		Попытка
			НачалоПериода = XMLЗначение(Тип("Дата"), ПараметрДаты);
		Исключение
			ДатаВерна = Ложь;
		КонецПопытки;
	КонецЕсли;

	Если ДатаВерна Тогда
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.УстановитьТелоИзСтроки(ОбщегоНазначения.ЗначениеВJSON(ДанныеОтвета(НачалоПериода)),
			КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Иначе
		Ответ = Новый HTTPСервисОтвет(400);
		Ответ.Заголовки.Вставить("Content-Type", "text/plain; charset=utf-8");
		Ответ.УстановитьТелоИзСтроки(НСтр("ru = 'Параметр since - дата в формате 2026-10-05T10:00:00'"),
			КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;

	Возврат Ответ;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметры:
//  НачалоПериода - Дата - ошибки загрузки читаются с этой даты.
//
// Возвращаемое значение:
//  Структура - данные ответа, см. ИсправленияПолучить
//
Функция ДанныеОтвета(НачалоПериода)

	Состояние = РепозиторийИсправлений_RepEr.СостояниеУстановки(НачалоПериода);

	СостоянияПоСтатусу = Новый Соответствие;
	СостоянияПоСтатусу.Вставить(0, "attached");
	СостоянияПоСтатусу.Вставить(1, "pending");
	СостоянияПоСтатусу.Вставить(2, "failed");
	СостоянияПоСтатусу.Вставить(5, "disabled");

	Исправления = Новый Массив;
	Для Каждого Исправление Из Состояние.Исправления Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("name",			Исправление.Имя);
		Элемент.Вставить("uuid",			Исправление.Идентификатор);
		Элемент.Вставить("version",			Исправление.Версия);
		Элемент.Вставить("state",			СостоянияПоСтатусу.Получить(Исправление.Статус));
		Элемент.Вставить("fire",			Исправление.Срочное);
		Элемент.Вставить("attached_at",		Исправление.ДатаПодключения);
		Элемент.Вставить("sessions_before",	Исправление.СеансовДо);
		Исправления.Добавить(Элемент);
	КонецЦикла;

	Ошибки = Новый Массив;
	Для Каждого Ошибка Из Состояние.Ошибки Цикл
		Ошибки.Добавить(Новый Структура("date, text, count", Ошибка.Дата, Ошибка.Текст, Ошибка.Раз));
	КонецЦикла;

	Данные = Новый Структура;
	Данные.Вставить("now",			Состояние.Дата);
	Данные.Вставить("auto_install",	Состояние.Автозагрузка);
	Данные.Вставить("patches",		Исправления);
	Данные.Вставить("errors",		Ошибки);

	Возврат Данные;

КонецФункции

#КонецОбласти
