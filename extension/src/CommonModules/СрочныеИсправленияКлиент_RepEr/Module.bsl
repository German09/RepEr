// @strict-types

///////////////////////////////////////////////////////////////////////////////////////////////////////
// Перезапуск сеанса при срочных исправлениях (FIRE) на клиенте: вопрос о перезапуске и автоматический перезапуск
// по истечении времени, см. СрочныеИсправления_RepEr
// Обработчики ожидания - в глобальном модуле, см. СрочныеИсправленияГлобальный_RepEr
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Подключает вопрос о перезапуске и автоматический перезапуск, если сервер сообщил о срочных исправлениях,
// не подключенных в сеансе. Подключает один раз за сеанс: после перезапуска подключатся все исправления сразу.
//
// Параметры:
//  Результаты - Соответствие из КлючИЗначение - результаты обмена между клиентом и сервером,
//               см. СрочныеИсправления_RepEr.ПриПериодическомПолученииДанныхКлиентаНаСервере:
//   * Ключ		- Строка - имя результата.
//   * Значение	- Произвольный - результат.
//
Процедура ПослеПериодическогоПолученияДанныхКлиентаНаСервере(Результаты) Экспорт

	Данные = Результаты.Получить("RepEr.СрочныеИсправления"); // Структура, Неопределено
	Если ТипЗнч(Данные) <> Тип("Структура") Или ПараметрыПерезапуска() <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Перезапуск = НовыйПерезапуск(Данные);
	ХранилищеКлиента().Вставить(ИмяПараметра(), Перезапуск);

	ПодключитьОбработчикОжидания("ПредложитьПерезапускДляСрочныхИсправлений_RepEr", 1, Истина);
	Если Перезапуск.Автоматически Тогда
		ПодключитьОбработчикОжидания("ПерезапуститьДляСрочныхИсправлений_RepEr", Перезапуск.Таймаут, Истина);
	КонецЕсли;

КонецПроцедуры

// Предлагает перезапустить программу, чтобы подключились срочные исправления. Ответ «Позже» означает,
// что по истечении времени сеанс перезапускается, а не завершается, см. Перезапустить
//
Асинх Процедура ПредложитьПерезапуск() Экспорт

	Перезапуск = ПараметрыПерезапуска();
	Если Перезапуск = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Кнопки = Новый СписокЗначений; // СписокЗначений из Строка
	Кнопки.Добавить("Сейчас",	НСтр("ru = 'Сейчас'"));
	Кнопки.Добавить("Позже",	НСтр("ru = 'Позже'"));

	Ответ = Ждать ВопросАсинх(ТекстВопроса(Перезапуск), Кнопки, , "Сейчас", НСтр("ru = 'Перезапуск программы'")); // Строка, Неопределено
	Если Ответ = "Сейчас" Тогда
		ПрекратитьРаботуСистемы(Истина);
	ИначеЕсли Ответ = "Позже" Тогда
		Перезапуск.Перезапустить = Истина;
	КонецЕсли;

КонецПроцедуры

// Перезапускает сеанс по истечении времени на перезапуск. Если пользователь не ответил на вопрос о перезапуске,
// сеанс завершается без перезапуска: скорее всего, за компьютером никого нет.
//
Асинх Процедура Перезапустить() Экспорт

	Перезапуск = ПараметрыПерезапуска();
	Если Перезапуск = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Перезапуск.Перезапустить Тогда
		ТекстПредупреждения = НСтр("ru = 'Время на перезапуск для срочного исправления истекло. Сеанс будет перезапущен.'");
	Иначе
		ТекстПредупреждения = НСтр("ru = 'Время на перезапуск для срочного исправления истекло. Сеанс будет завершен.'");
	КонецЕсли;

	Ждать ПредупреждениеАсинх(ТекстПредупреждения, 10, НСтр("ru = 'Перезапуск программы'"));

	ПрекратитьРаботуСистемы(Перезапуск.Перезапустить);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Текст вопроса о перезапуске одним абзацем: исправленная ошибка - жирным, срок перезапуска и время
// автоматического перезапуска - жирным и цветом.
//
// Параметры:
//  Перезапуск - см. НовыйПерезапуск
//
// Возвращаемое значение:
//  ФорматированнаяСтрока
//
Функция ТекстВопроса(Перезапуск)

	//@skip-check property-return-type - элементы стиля БСП передает на клиент структурой, см. СтандартныеПодсистемыКлиент.ЭлементыСтиля
	Жирный	= СтандартныеПодсистемыКлиент.ЭлементыСтиля().ВажнаяНадписьШрифт; // Шрифт
	Время	= Формат(Перезапуск.Время, "ДФ=ЧЧ:мм");
	Ошибка	= Новый ФорматированнаяСтрока(СтрШаблон(" «%1»", Перезапуск.Исправление), Жирный);

	Части = Новый Массив; // Массив из Строка, ФорматированнаяСтрока
	Если Перезапуск.Исправлений > 1 Тогда
		Части.Добавить(НСтр("ru = 'Мы нашли в работе системы ошибки, в том числе'"));
		Части.Добавить(Ошибка);
		Части.Добавить(НСтр("ru = ', и поправили их. Чтобы исправления вступили в силу, вам нужно'"));
	Иначе
		Части.Добавить(НСтр("ru = 'Мы нашли в работе системы ошибку'"));
		Части.Добавить(Ошибка);
		Части.Добавить(НСтр("ru = ' и поправили ее. Чтобы исправление вступило в силу, вам нужно'"));
	КонецЕсли;

	Если Перезапуск.Автоматически Тогда
		Части.Добавить(Новый ФорматированнаяСтрока(СтрШаблон(НСтр("ru = ' перезапустить 1С до %1'"), Время),
			Жирный, WebЦвета.ЦветМорскойВолныНейтральный));
		Части.Добавить(НСтр("ru = ', или мы перезапустим ваш сеанс'"));
		Части.Добавить(Новый ФорматированнаяСтрока(СтрШаблон(НСтр("ru = ' автоматически ровно в %1.'"), Время),
			Жирный, WebЦвета.ТемноКрасный));
	Иначе
		Части.Добавить(НСтр("ru = ' перезапустить 1С.'"));
		Части.Добавить(Новый ФорматированнаяСтрока(
			НСтр("ru = ' (У вас права администратора: автоматически ваш сеанс перезапущен не будет.)'"), Жирный));
	КонецЕсли;
	Части.Добавить(НСтр("ru = ' Перезапустить сеанс сейчас?'"));

	Возврат Новый ФорматированнаяСтрока(Части);

КонецФункции

// Параметры:
//  Данные - Структура - перезапуск, о котором сообщил сервер:
//   * Исправление		- Строка - представление первого неподключенного срочного исправления.
//   * Исправлений		- Число - сколько срочных исправлений не подключено.
//   * Автоматически	- Булево - перезапустить сеанс по истечении времени: пользователь не полноправный.
//   * Таймаут			- Число - секунд на перезапуск.
//
// Возвращаемое значение:
//  Структура:
//   * Исправление		- Строка - представление первого неподключенного срочного исправления.
//   * Исправлений		- Число - сколько срочных исправлений не подключено.
//   * Автоматически	- Булево - перезапустить сеанс по истечении времени: пользователь не полноправный.
//   * Таймаут			- Число - секунд на перезапуск.
//   * Время			- Дата - когда сеанс будет перезапущен автоматически.
//   * Перезапустить	- Булево - пользователь ответил «Позже»: по истечении времени перезапустить сеанс,
//						  а не завершить.
//
Функция НовыйПерезапуск(Данные)

	Перезапуск = Новый Структура;
	Перезапуск.Вставить("Исправление",		Данные.Исправление);
	Перезапуск.Вставить("Исправлений",		Данные.Исправлений);
	Перезапуск.Вставить("Автоматически",	Данные.Автоматически);
	Перезапуск.Вставить("Таймаут",			Данные.Таймаут);
	Перезапуск.Вставить("Время",			ОбщегоНазначенияКлиент.ДатаСеанса() + Данные.Таймаут);
	Перезапуск.Вставить("Перезапустить",	Ложь);

	Возврат Перезапуск;

КонецФункции

// Возвращаемое значение:
//  - см. НовыйПерезапуск
//  - Неопределено - сервер не сообщал о перезапуске.
//
Функция ПараметрыПерезапуска()

	Значение = ХранилищеКлиента().Получить(ИмяПараметра());
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Перезапуск = Значение; // см. НовыйПерезапуск
	Иначе
		Перезапуск = Неопределено;
	КонецЕсли;

	Возврат Перезапуск;

КонецФункции

// Глобальная переменная ПараметрыПриложения модуля управляемого приложения: хранилище данных сеанса на клиенте.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ		- Строка - имя параметра.
//   * Значение	- Произвольный
//
Функция ХранилищеКлиента()

	//@skip-check undefined-variable - глобальная переменная модуля управляемого приложения базовой конфигурации.
	Возврат ПараметрыПриложения;

КонецФункции

Функция ИмяПараметра()

	Возврат "RepEr.СрочныеИсправления";

КонецФункции

#КонецОбласти
