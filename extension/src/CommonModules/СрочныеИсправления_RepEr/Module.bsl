// @strict-types

///////////////////////////////////////////////////////////////////////////////////////////////////////
// Перезапуск сеансов при срочных исправлениях (FIRE). Расширение подключается только в сеансах, начатых после
// его установки, поэтому в уже открытых сеансах срочное исправление не работает, пока их не перезапустят.
//
// При периодическом обмене клиента с сервером срочные исправления в базе сравниваются с подключенными в сеансе.
// Если есть неподключенные, клиент предлагает перезапустить программу, а по истечении времени перезапускает
// сеанс сам, полноправных пользователей только предупреждает, см. СрочныеИсправленияКлиент_RepEr
//
// Срочное исправление определяется так же, как в списках исправлений, см. РепозиторийИсправлений_RepEr.ЭтоСрочноеИсправление
// Перезапуск включается в настройках репозитория исправлений, см. РепозиторийИсправлений_RepEr.НастройкиПерезапуска
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Добавляет в результаты периодического обмена с клиентом перезапуск, если в сеансе не подключены срочные
// исправления из базы. Ключ результата - «RepEr.СрочныеИсправления».
//
// Параметры:
//  Результаты - Соответствие из КлючИЗначение - результаты обмена между клиентом и сервером:
//   * Ключ		- Строка - имя результата.
//   * Значение	- Произвольный - результат.
//
Процедура ПриПериодическомПолученииДанныхКлиентаНаСервере(Результаты) Экспорт

	// Сначала то, что не читает базу: в большинстве сеансов все расширения подключены.
	Неподключенные = НеподключенныеРасширения();
	Если Неподключенные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Настройки = РепозиторийИсправлений_RepEr.НастройкиПерезапуска();
	Если Не Настройки.Включен Тогда
		Возврат;
	КонецЕсли;

	Срочные = СрочныеИз(Неподключенные);
	Если Срочные.Количество() = 0 Или ПерезапускНеПомог(Срочные) Тогда
		Возврат;
	КонецЕсли;

	Перезапуск = Новый Структура;
	Перезапуск.Вставить("Исправление",		ПредставлениеИсправления(Срочные[0]));
	Перезапуск.Вставить("Исправлений",		Срочные.Количество());
	Перезапуск.Вставить("Автоматически",	Не Пользователи.ЭтоПолноправныйПользователь());
	Перезапуск.Вставить("Таймаут",			Настройки.МинутДоПерезапуска * 60);

	Результаты.Вставить("RepEr.СрочныеИсправления", Перезапуск);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Расширения, которые есть в базе, но не подключены в текущем сеансе: установлены или заменены новой сборкой
// после его начала. Не попадают расширения со снятым флажком «Подключать» и расширения, которые платформа
// не смогла подключить в текущем сеансе: в новом сеансе они тоже не подключатся, перезапуск не поможет.
//
// Возвращаемое значение:
//  Массив из РасширениеКонфигурации
//
Функция НеподключенныеРасширения()

	УстановитьПривилегированныйРежим(Истина);
	ВБазе			= РасширенияКонфигурации.Получить(, ИсточникРасширенийКонфигурации.БазаДанных);
	Подключенные	= ХешиРасширений(ИсточникРасширенийКонфигурации.СеансАктивные);
	НеПодключились	= ХешиРасширений(ИсточникРасширенийКонфигурации.СеансОтключенные);
	УстановитьПривилегированныйРежим(Ложь);

	Результат = Новый Массив; // Массив из РасширениеКонфигурации
	Для Каждого Расширение Из ВБазе Цикл
		Ключ = КлючРасширения(Расширение);
		Если Расширение.Активно
			И Подключенные.Получить(Ключ) <> Расширение.ХешСумма
			И НеПодключились.Получить(Ключ) <> Расширение.ХешСумма Тогда
			Результат.Добавить(Расширение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Параметры:
//  Расширения - Массив из РасширениеКонфигурации
//
// Возвращаемое значение:
//  Массив из РасширениеКонфигурации - срочные исправления.
//
Функция СрочныеИз(Расширения)

	Срочные		= РепозиторийИсправлений_RepEr.СрочныеИсправления();
	Результат	= Новый Массив; // Массив из РасширениеКонфигурации
	Для Каждого Расширение Из Расширения Цикл
		Если РепозиторийИсправлений_RepEr.ЭтоСрочноеИсправление(Расширение.Имя, Срочные) Тогда
			Результат.Добавить(Расширение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Определяет, что перезапуск уже предлагали из-за тех же сборок срочных исправлений, а сеанс начат после этого:
// значит, после перезапуска они так и не подключились. Так бывает, когда платформа не подключает расширение
// в сеансе, но и не считает его отключенным из-за ошибки. Чтобы не перезапускать сеансы по кругу, первое
// предложение перезапуска запоминается в общих настройках пользователя: какие сборки и когда.
//
// Параметры:
//  Срочные - Массив из РасширениеКонфигурации - неподключенные срочные исправления.
//
// Возвращаемое значение:
//  Булево
//
Функция ПерезапускНеПомог(Срочные)

	Сборки = Новый Массив; // Массив из Строка
	Для Каждого Расширение Из Срочные Цикл
		// Идентификатор расширения в базе новый при каждой установке: по нему различаются сборки.
		Сборки.Добавить(Расширение.Имя + " " + Строка(Расширение.УникальныйИдентификатор));
	КонецЦикла;
	КлючСборок = СтрСоединить(Сборки, ", ");

	// Время сервера, а не сеанса: с ним сравнивается начало сеанса.
	//@skip-check use-non-recommended-method - начало сеанса платформа отдает во времени сервера.
	Сейчас		= ТекущаяДата();
	Сохраненное	= ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("RepEr.СрочныеИсправления", "Предложение");
	Предложение	= НовоеПредложение("", Дата(1, 1, 1));
	Если ТипЗнч(Сохраненное) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Предложение, Сохраненное);
	КонецЕсли;

	Если Предложение.Сборки = КлючСборок И ТипЗнч(Предложение.Дата) = Тип("Дата") Тогда
		Результат = ПолучитьТекущийСеансИнформационнойБазы().НачалоСеанса > Предложение.Дата;
	Иначе
		ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("RepEr.СрочныеИсправления", "Предложение",
			НовоеПредложение(КлючСборок, Сейчас));
		Результат = Ложь;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Параметры:
//  Сборки	- Строка - имена и идентификаторы сборок срочных исправлений, из-за которых предложен перезапуск.
//  Момент	- Дата - когда предложен, во времени сервера.
//
// Возвращаемое значение:
//  Структура:
//   * Сборки	- Строка
//   * Дата		- Дата
//
Функция НовоеПредложение(Сборки, Момент)

	Возврат Новый Структура("Сборки, Дата", Сборки, Момент);

КонецФункции

// Параметры:
//  Расширение - РасширениеКонфигурации
//
// Возвращаемое значение:
//  Строка - синоним, а если его нет - имя расширения.
//
Функция ПредставлениеИсправления(Расширение)

	Возврат ?(ЗначениеЗаполнено(Расширение.Синоним), Расширение.Синоним, Расширение.Имя);

КонецФункции

// Параметры:
//  Источник - ИсточникРасширенийКонфигурации
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ		- Строка - см. КлючРасширения
//   * Значение	- ДвоичныеДанные - хеш-сумма расширения: платформа возвращает двоичные данные,
//				  хотя в синтакс-помощнике указана строка.
//
Функция ХешиРасширений(Источник)

	Хеши = Новый Соответствие;
	Для Каждого Расширение Из РасширенияКонфигурации.Получить(, Источник) Цикл
		Хеши.Вставить(КлючРасширения(Расширение), Расширение.ХешСумма);
	КонецЦикла;

	Возврат Хеши;

КонецФункции

// Ключ для сравнения расширений базы и сеанса: имя и область действия. Сборки исправления различаются
// хеш-суммой, имя у них общее.
//
// Параметры:
//  Расширение - РасширениеКонфигурации
//
// Возвращаемое значение:
//  Строка
//
Функция КлючРасширения(Расширение)

	Возврат Расширение.Имя + " " + Строка(Расширение.ОбластьДействия);

КонецФункции

#КонецОбласти
