#Область СлужебныеПроцедурыИФункции

// Типовое регламентное задание автоматической загрузки исправлений загружает исправления только
// из репозиториев исправлений, исправления 1С не загружаются, см. РепозиторийИсправлений_RepEr.ЗагрузкаИсправлений
//
&Вместо("РегламентноеЗаданиеПолучениеИУстановкаИсправленийКонфигурации")
Процедура РегламентноеЗаданиеПолучениеИУстановкаИсправленийКонфигурации_RepEr()

	РепозиторийИсправлений_RepEr.ЗагрузкаИсправлений();

КонецПроцедуры

// Флажок «Загружать и устанавливать исправления (патчи) автоматически» включает задание без подключения
// к Интернет-поддержке: исправления загружаются из репозиториев, см. РепозиторийИсправлений_RepEr.ВключитьЗагрузку
//
// Параметры:
//  ЗначениеНастройки - Булево
//
&Вместо("ВключитьОтключитьАвтоматическуюУстановкуИсправлений")
Процедура ВключитьОтключитьАвтоматическуюУстановкуИсправлений_RepEr(Знач ЗначениеНастройки)

	РепозиторийИсправлений_RepEr.ВключитьЗагрузку(ЗначениеНастройки = Истина);

КонецПроцедуры

// Подключение к Интернет-поддержке и отключение от нее не меняют использование задания: оно определяется
// только флажком автоматической загрузки, см. РепозиторийИсправлений_RepEr.ОбновитьИспользованиеЗагрузки
//
// Параметры:
//  Логин - Строка
//
&Вместо("ПриИзмененииДанныхАутентификации")
Процедура ПриИзмененииДанныхАутентификации_RepEr(Логин)

	РепозиторийИсправлений_RepEr.ОбновитьИспользованиеЗагрузки();

КонецПроцедуры

#КонецОбласти
