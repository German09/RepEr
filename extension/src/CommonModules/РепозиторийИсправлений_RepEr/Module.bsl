// Удаляет и устанавливает исправления по плану, см. ПланИзменений.
//
// Параметры:
//  Настройки	- Структура - репозиторий, из которого скачиваются устанавливаемые исправления, см. Настройки
//				- Неопределено - план только удаляет исправления.
//  План		- см. ПланИзменений
//  Результат	- см. Синхронизировать
//
Процедура ПрименитьИзменения(Настройки, План, Результат)
	
	Удалить			= План.Удалить;
	УдалитьИмена	= План.УдалитьИмена;
	Установить		= План.Установить;
	
	Параметры									= ОбновлениеКонфигурации.ПараметрыУстановкиИсправлений();
	Параметры.ВФоне								= ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание() <> Неопределено;
	Параметры.ПроверятьПрименимостьПоМанифесту	= Истина;

	УстановитьПривилегированныйРежим(Истина);

	Если Удалить.Количество() > 0 Тогда
		Итог = ОбновлениеКонфигурации.УстановкаИУдалениеИсправлений(Новый Структура("Удалить", Удалить), Параметры);
		ДобавитьОшибки(Итог, Результат);
		Если Итог.НеУдалено = 0 Тогда
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат.Удалены, УдалитьИмена, Истина);
		КонецЕсли;
	КонецЕсли;

	Адреса = Новый Массив;
	Для Каждого Запись Из Установить Цикл
		Адрес = СкачатьАрхив(Настройки, Запись, Результат.Ошибки);
		Если Адрес <> Неопределено Тогда
			Адреса.Добавить(Адрес);
		КонецЕсли;
	КонецЦикла;
	Если Адреса.Количество() > 0 Тогда
		Итог = ОбновлениеКонфигурации.УстановкаИУдалениеИсправлений(Новый Структура("Установить", Адреса), Параметры);
		ДобавитьОшибки(Итог, Результат);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат.Установлены, Итог.Установленные, Истина);
	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Сравнивает оглавление репозитория с установленными исправлениями.
//
// Исправления ставятся по возрастанию порядка установки (поле order оглавления): если несколько исправлений
// перехватывают один метод, работает перехватчик расширения, установленного последним. Поэтому установленное
// исправление, которое по порядку идет позже устанавливаемого и перехватывает те же методы (поле methods),
// удаляется и ставится заново после него.
//
// Параметры:
//  Оглавление	- Соответствие из КлючИЗначение: Строка, Произвольный - оглавление репозитория.
//  Ошибки		- Массив из Строка - сюда добавляются ошибки.
//  Отбор		- Соответствие из КлючИЗначение: Строка, Булево - имена исправлений, которые нужно привести
//				  к репозиторию; остальные не трогаются, кроме переустановки ради порядка.
//				- Неопределено - все исправления репозитория.
//
// Возвращаемое значение:
//  Структура:
//   * Удалить			- Массив из Строка - идентификаторы исправлений к удалению.
//   * УдалитьИмена		- Массив из Строка - имена исправлений к удалению.
//   * Установить		- Массив из Произвольный - записи оглавления к установке (Соответствие), по возрастанию порядка.
//   * Актуальны		- Массив из Строка - имена исправлений репозитория, которые уже установлены.
//   * Переустановить	- Массив из Строка - имена установленных исправлений, которые ставятся заново после
//						  исправления с меньшим порядком и теми же методами.
//   * Вручную			- Массив из Строка - имена исправлений репозитория, которые не установить: расширение с таким
//						  именем установлено без описания исправления (вручную или до перезапуска после установки).
//
Функция ПланИзменений(Оглавление, Ошибки, Отбор = Неопределено)

	Записи = Оглавление.Получить("patches");
	Если ТипЗнч(Записи) <> Тип("Массив") Тогда
		Ошибки.Добавить(НСтр("ru = 'В оглавлении репозитория нет списка исправлений (patches)'"));
		Записи = Новый Массив;
	КонецЕсли;

	// Установленные исправления: по идентификатору из манифеста и по имени.
	УстановленныеПоИдентификатору	= Новый Соответствие;
	УстановленныеПоИмени			= Новый Соответствие;
	Для Каждого Установленное Из ОбновлениеКонфигурации.УстановленныеИсправления() Цикл
		Идентификатор = ?(Установленное.Идентификатор = Неопределено, "", НРег(Строка(Установленное.Идентификатор)));
		Если ЗначениеЗаполнено(Идентификатор) Тогда
			УстановленныеПоИдентификатору.Вставить(Идентификатор, Установленное.Наименование);
		КонецЕсли;
		УстановленныеПоИмени.Вставить(Установленное.Наименование, Идентификатор);
	КонецЦикла;

	План = Новый Структура;
	План.Вставить("Удалить",		Новый Массив);
	План.Вставить("УдалитьИмена",	Новый Массив);
	План.Вставить("Установить",		Новый Массив);
	План.Вставить("Актуальны",		Новый Массив);
	План.Вставить("Переустановить",	Новый Массив);
	План.Вставить("Вручную",		Новый Массив);

	// Отозванные сборки удаляются, текущие разбираются по возрастанию порядка установки.
	Текущие = Новый ТаблицаЗначений;
	Текущие.Колонки.Добавить("Порядок",	Новый ОписаниеТипов("Число"));
	Текущие.Колонки.Добавить("Номер",	Новый ОписаниеТипов("Число"));
	Текущие.Колонки.Добавить("Запись");
	Для Каждого Запись Из Записи Цикл
		Идентификатор	= НРег(Строка(Запись.Получить("uuid")));
		Имя				= Строка(Запись.Получить("name"));
		Если Запись.Получить("revoked") = Истина Тогда
			Если (Отбор = Неопределено Или Отбор.Получить(Имя) <> Неопределено)
				И УстановленныеПоИдентификатору.Получить(Идентификатор) <> Неопределено Тогда
				План.Удалить.Добавить(Идентификатор);
				План.УдалитьИмена.Добавить(Имя);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Текущая			= Текущие.Добавить();
		Текущая.Порядок	= ПорядокУстановки(Запись);
		Текущая.Номер	= Текущие.Количество();
		Текущая.Запись	= Запись;
	КонецЦикла;
	Текущие.Сортировать("Порядок, Номер");

	// Методы исправлений, которые ставятся в этой синхронизации, - для поиска установленных исправлений,
	// которые нужно переустановить после них.
	Устанавливаемые = Новый Соответствие;
	Для Каждого Текущая Из Текущие Цикл
		Запись			= Текущая.Запись;
		Идентификатор	= НРег(Строка(Запись.Получить("uuid")));
		Имя				= Строка(Запись.Получить("name"));
		Если УстановленныеПоИдентификатору.Получить(Идентификатор) <> Неопределено Тогда
			// Эта сборка уже установлена.
			Если Не ПерехватываетТеЖеМетоды(Запись, Устанавливаемые) Тогда
				План.Актуальны.Добавить(Имя);
				Продолжить;
			КонецЕсли;
			// Раньше по порядку ставится исправление с теми же методами: переустановить эту сборку после него,
			// чтобы ее перехватчики работали поверх.
			План.Удалить.Добавить(Идентификатор);
			План.УдалитьИмена.Добавить(Имя);
			План.Переустановить.Добавить(Имя);
		Иначе
			Если Отбор <> Неопределено И Отбор.Получить(Имя) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ИдентификаторУстановленного = УстановленныеПоИмени.Получить(Имя);
			Если ИдентификаторУстановленного = "" Тогда
				План.Вручную.Добавить(Имя);
				Продолжить;
			ИначеЕсли ИдентификаторУстановленного <> Неопределено Тогда
				// Установлена прежняя сборка этого исправления: удалить ее перед установкой новой.
				План.Удалить.Добавить(ИдентификаторУстановленного);
				План.УдалитьИмена.Добавить(Имя);
			КонецЕсли;
		КонецЕсли;
		План.Установить.Добавить(Запись);
		ДобавитьМетоды(Устанавливаемые, Запись);
	КонецЦикла;

	Возврат План;

КонецФункции

// Порядок установки исправления: поле order записи оглавления; в записях, опубликованных до его появления, - 0.
//
// Параметры:
//  Запись - Соответствие из КлючИЗначение: Строка, Произвольный - запись оглавления репозитория.
//
// Возвращаемое значение:
//  Число
//
Функция ПорядокУстановки(Запись)

	Порядок = Запись.Получить("order");
	Возврат ?(ТипЗнч(Порядок) = Тип("Число"), Число(Порядок), 0);

КонецФункции

// Добавляет методы, которые перехватывает и добавляет исправление (поле methods записи оглавления).
//
// Параметры:
//  Методы - Соответствие из КлючИЗначение: Строка, Булево - метод в нижнем регистре; ключ «*» - у какого-то
//           исправления список методов неизвестен.
//  Запись - Соответствие из КлючИЗначение: Строка, Произвольный - запись оглавления репозитория.
//
Процедура ДобавитьМетоды(Методы, Запись)

	Список = Запись.Получить("methods");
	Если ТипЗнч(Список) <> Тип("Массив") Тогда
		Методы.Вставить("*", Истина);
		Возврат;
	КонецЕсли;
	Для Каждого Метод Из Список Цикл
		Методы.Вставить(НРег(Метод), Истина);
	КонецЦикла;

КонецПроцедуры

// Определяет, перехватывает ли исправление какой-то из методов. Если список методов неизвестен - считается,
// что перехватывает.
//
// Параметры:
//  Запись - Соответствие из КлючИЗначение: Строка, Произвольный - запись оглавления репозитория.
//  Методы - см. ДобавитьМетоды.Методы
//
// Возвращаемое значение:
//  Булево
//
Функция ПерехватываетТеЖеМетоды(Запись, Методы)

	Если Методы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Список = Запись.Получить("methods");
	Если ТипЗнч(Список) <> Тип("Массив") Или Методы.Получить("*") <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого Метод Из Список Цикл
		Если Методы.Получить(НРег(Метод)) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ДобавитьОшибки(Итог, Результат)
	
	Для Каждого Ошибка Из Итог.Ошибки Цикл
		Результат.Ошибки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1 %2: %3'"), Ошибка.Событие, Ошибка.НомерПатча, Ошибка.Причина));
	КонецЦикла;
	
КонецПроцедуры

// Читает оглавление репозитория для версии библиотеки и запоминает срочные исправления. Для версии, для которой
// исправлений еще не публиковали, RepEr отдает пустое оглавление с признаком not_found, а 404 - это ошибка:
// в RepEr нет базы с таким кодом или у нее нет репозитория GitLab.
//
// Параметры:
//  Настройки	- см. Настройки
//  Ошибки		- Массив из Строка - сюда добавляются ошибки.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение: Строка, Произвольный - оглавление репозитория.
//  Неопределено - оглавление не получено.
//
Функция Оглавление(Настройки, Ошибки)
	
	Оглавление = Неопределено;
	
	Ответ = ВыполнитьЗапрос(Настройки, ПутьВерсии(Настройки) + "/index.json");
	Если Ответ.КодСостояния <> 200 Тогда
		Ошибки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось получить оглавление репозитория %1: %2'"), Настройки.Версия, Ответ.Описание));
	Иначе
		Попытка
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(ПолучитьСтрокуИзДвоичныхДанных(Ответ.Тело, КодировкаТекста.UTF8));
			Оглавление = ПрочитатьJSON(Чтение, Истина);
			Чтение.Закрыть();
			ЗапомнитьСрочные(Настройки, Оглавление);
		Исключение
			Ошибки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Оглавление репозитория %1 не разобрано: %2'"), Настройки.Версия,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
	КонецЕсли;
	
	Возврат Оглавление;
	
КонецФункции

// Скачивает архив исправления, сверяет контрольную сумму и помещает его во временное хранилище.
//
Функция СкачатьАрхив(Настройки, Запись, Ошибки)
	
	Адрес = Неопределено;
	
	ИмяФайла	= Строка(Запись.Получить("file"));
	Ответ		= ВыполнитьЗапрос(Настройки, ПутьВерсии(Настройки) + "/" + КодироватьСтроку(ИмяФайла, СпособКодированияСтроки.КодировкаURL));
	Если Ответ.КодСостояния <> 200 Тогда
		Ошибки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось скачать %1: %2'"), ИмяФайла, Ответ.Описание));
	Иначе
		Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
		Хеширование.Добавить(Ответ.Тело);
		Сумма = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
		Если Сумма <> НРег(Строка(Запись.Получить("sha256"))) Тогда
			Ошибки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Контрольная сумма %1 не совпала с оглавлением репозитория'"), ИмяФайла));
		Иначе
			Адрес = ПоместитьВоВременноеХранилище(Ответ.Тело, Новый УникальныйИдентификатор);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Адрес;
	
КонецФункции

// Адрес страницы версии пакета ленты в GitLab, например https://<сервер>/<группа>/<проект>/-/packages/123.
// Его знает RepEr: у базы ни адреса проекта, ни токена GitLab нет.
//
// Параметры:
//  Настройки - см. Настройки
//
// Возвращаемое значение:
//  Строка - адрес страницы версии или страницы пакетов проекта; пустая строка - RepEr его не вернул.
//
Функция СтраницаВерсии(Настройки)
	
	Страница	= "";
	Ответ		= ВыполнитьЗапрос(Настройки, ПутьВерсии(Настройки));
	Данные		= ?(Ответ.КодСостояния = 200, ЗначениеИзJSON(Ответ.Тело), Неопределено);
	Если ТипЗнч(Данные) = Тип("Соответствие") И ЗначениеЗаполнено(Данные.Получить("page")) Тогда
		Страница = Строка(Данные.Получить("page"));
	КонецЕсли;
	
	Возврат Страница;
	
КонецФункции

// Выполняет запрос к HTTP-сервису Service базы RepEr.
//
// Параметры:
//  Настройки	- см. Настройки
//  Путь		- Строка - путь от адреса сервиса (после кода базы) в кодировке URL, например patches/1.3.19.01/index.json.
//  Тело		- Строка - тело POST-запроса в JSON.
//				- Неопределено - GET-запрос.
//
// Возвращаемое значение:
//  Структура:
//   * КодСостояния	- Число - код ответа HTTP, 0 - ошибка соединения.
//   * Тело			- ДвоичныеДанные, Неопределено - тело ответа.
//   * Описание		- Строка - описание ошибки: текст ошибки от RepEr и код ответа.
//
Функция ВыполнитьЗапрос(Настройки, Путь, Тело = Неопределено)
	
	Ответ = Новый Структура("КодСостояния, Тело, Описание", 0, Неопределено, "");
	
	СтруктураURI			= ОбщегоНазначенияКлиентСервер.СтруктураURI(Настройки.Адрес);
	ЗащищенноеСоединение	= ?(НРег(СтруктураURI.Схема) = "https",
		Новый ЗащищенноеСоединениеOpenSSL(, Новый СертификатыУдостоверяющихЦентровОС), Неопределено);
	
	// Код базы в адресе может быть на русском, в настройках обработки ошибок - как закодированным, так и нет:
	// сегменты пути раскодируются и кодируются заново.
	Сегменты = Новый Массив;
	Для Каждого Сегмент Из СтрРазделить(ПутьБезПараметров(СтруктураURI.ПутьНаСервере), "/", Ложь) Цикл
		Сегменты.Добавить(КодироватьСтроку(РаскодироватьСтроку(Сегмент, СпособКодированияСтроки.КодировкаURL),
			СпособКодированияСтроки.КодировкаURL));
	КонецЦикла;
	Сегменты.Добавить(Путь);
	
	Попытка
		Соединение	= Новый HTTPСоединение(СтруктураURI.Хост, СтруктураURI.Порт,,,, 60, ЗащищенноеСоединение);
		Запрос		= Новый HTTPЗапрос("/" + СтрСоединить(Сегменты, "/"));
		Если ЗначениеЗаполнено(Настройки.Пользователь) Тогда
			// Заголовок авторизации - сразу, без ожидания 401: публикация RepEr может пускать без авторизации
			// под пользователем из default.vrd, и запрос выполнился бы без роли получения исправлений.
			ДанныеАвторизации = ПолучитьДвоичныеДанныеИзСтроки(Настройки.Пользователь + ":" + Настройки.Пароль);
			Запрос.Заголовки.Вставить("Authorization", "Basic " + ПолучитьBase64СтрокуИзДвоичныхДанных(ДанныеАвторизации));
		КонецЕсли;
		Если Тело = Неопределено Тогда
			HTTPОтвет = Соединение.Получить(Запрос);
		Иначе
			Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
			Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
			HTTPОтвет = Соединение.ОтправитьДляОбработки(Запрос);
		КонецЕсли;
		Ответ.КодСостояния	= HTTPОтвет.КодСостояния;
		Ответ.Тело			= HTTPОтвет.ПолучитьТелоКакДвоичныеДанные();
		Если Ответ.КодСостояния <> 200 Тогда
			Ответ.Описание = ОписаниеОтветаRepEr(Ответ.КодСостояния, HTTPОтвет.ПолучитьТелоКакСтроку());
		КонецЕсли;
	Исключение
		Ответ.Описание = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции

// Путь к каталогу версии библиотеки в ленте исправлений от адреса сервиса RepEr.
//
// Параметры:
//  Настройки - см. Настройки
//
// Возвращаемое значение:
//  Строка - например patches/1.3.19.01.
//
Функция ПутьВерсии(Настройки)

	Возврат "patches/" + КодироватьСтроку(Настройки.Версия, СпособКодированияСтроки.КодировкаURL);

КонецФункции

// Параметры:
//  ПутьНаСервере - Строка - путь с параметрами и якорем, см. ОбщегоНазначенияКлиентСервер.СтруктураURI
//
// Возвращаемое значение:
//  Строка - путь без параметров и якоря.
//
Функция ПутьБезПараметров(Знач ПутьНаСервере)

	Для Каждого Разделитель Из СтрРазделить("?,#", ",") Цикл
		Позиция = СтрНайти(ПутьНаСервере, Разделитель);
		Если Позиция > 0 Тогда
			ПутьНаСервере = Лев(ПутьНаСервере, Позиция - 1);
		КонецЕсли;
	КонецЦикла;

	Возврат ПутьНаСервере;

КонецФункции

// Описание неудачного ответа RepEr для пользователя и журнала регистрации.
//
// Параметры:
//  КодСостояния	- Число - код ответа HTTP.
//  Текст			- Строка - тело ответа: RepEr пишет в нем, что не так.
//
// Возвращаемое значение:
//  Строка
//
Функция ОписаниеОтветаRepEr(КодСостояния, Знач Текст)

	// Страница ошибки веб-сервера (HTML) пользователю ничего не скажет.
	Текст = СокрЛП(Текст);
	Если СтрНачинаетсяС(Текст, "<") Тогда
		Текст = "";
	КонецЕсли;
	Текст = Лев(Текст, 500);
	// Код ответа - в скобках после текста: причина важнее кода и должна читаться первой.
	Если СтрЗаканчиваетсяНа(Текст, ".") Тогда
		Текст = Лев(Текст, СтрДлина(Текст) - 1);
	КонецЕсли;

	Если КодСостояния = 401 Тогда
		Описание = НСтр("ru = 'RepEr не принял пользователя и пароль (код ответа 401)'");
	ИначеЕсли КодСостояния = 403 Тогда
		Описание = НСтр("ru = 'у пользователя RepEr нет роли «Получение исправлений и пользователей ошибок» (код ответа 403)'");
	ИначеЕсли КодСостояния = 404 И Не ЗначениеЗаполнено(Текст) Тогда
		Описание = НСтр("ru = 'в RepEr нет HTTP-сервиса Service или он не опубликован (код ответа 404)'");
	ИначеЕсли ЗначениеЗаполнено(Текст) Тогда
		Описание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%2 (код ответа %1)'"), КодСостояния, Текст);
	Иначе
		Описание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'код ответа %1'"), КодСостояния);
	КонецЕсли;

	Возврат Описание;

КонецФункции

// Параметры:
//  Тело - ДвоичныеДанные, Неопределено - тело ответа в JSON.
//
// Возвращаемое значение:
//  Произвольный - прочитанное значение, объекты JSON - в Соответствие; Неопределено - тело не JSON.
//
Функция ЗначениеИзJSON(Тело)

	Значение = Неопределено;
	Если ТипЗнч(Тело) = Тип("ДвоичныеДанные") Тогда
		Попытка
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(ПолучитьСтрокуИзДвоичныхДанных(Тело, КодировкаТекста.UTF8));
			Значение = ПрочитатьJSON(Чтение, Истина);
			Чтение.Закрыть();
		Исключение
			// Не JSON: вызывающий код сообщает, что ответ не получен.
			Значение = Неопределено;
		КонецПопытки;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Подключение к RepEr, в которую база отправляет ошибки: адрес сервиса обработки ошибок из общих настроек
// обработки ошибок, например https://<сервер>/reper/hs/reper/<код базы>/, в котором HTTP-сервис RepEr (/hs/reper/)
// заменен на Service (/hs/service/).
//
// Возвращаемое значение:
//  Структура:
//   * АдресОбработкиОшибок	- Строка - адрес сервиса обработки ошибок из настроек.
//   * Адрес				- Строка - адрес HTTP-сервиса Service с косой чертой в конце; пустая строка - адрес
//							  сервиса обработки ошибок не указан, это не RepEr или в нем нет кода базы.
//   * Код					- Строка - код базы в RepEr, раскодированный: код может быть на русском.
//
Функция ПодключениеКRepEr()

	УстановитьПривилегированныйРежим(Истина);
	АдресОбработкиОшибок = СокрЛП(ОбработкаОшибок.ПолучитьОбщиеНастройки().АдресСервисаОбработкиОшибок);
	УстановитьПривилегированныйРежим(Ложь);

	Результат = Новый Структура("АдресОбработкиОшибок, Адрес, Код", АдресОбработкиОшибок, "", "");

	Сервис	= "/hs/reper/";
	Позиция	= СтрНайти(НРег(АдресОбработкиОшибок), Сервис);
	Если Позиция > 0 Тогда
		Остаток	= ПутьБезПараметров(Сред(АдресОбработкиОшибок, Позиция + СтрДлина(Сервис)));
		Код		= "";
		Для Каждого Сегмент Из СтрРазделить(Остаток, "/", Ложь) Цикл
			Код = РаскодироватьСтроку(Сегмент, СпособКодированияСтроки.КодировкаURL);
			Прервать;
		КонецЦикла;
		Если ЗначениеЗаполнено(Код) Тогда
			Результат.Код	= Код;
			Результат.Адрес	= Лев(АдресОбработкиОшибок, Позиция - 1) + "/hs/service/"
				+ КодироватьСтроку(Код, СпособКодированияСтроки.КодировкаURL) + "/";
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Параметры:
//  АдресОбработкиОшибок - Строка - адрес сервиса обработки ошибок из настроек.
//
// Возвращаемое значение:
//  Строка - почему ленту исправлений не читать: адреса RepEr нет в настройках обработки ошибок.
//
Функция ОписаниеНетАдресаRepEr(АдресОбработкиОшибок)

	Если ЗначениеЗаполнено(АдресОбработкиОшибок) Тогда
		Описание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Адрес сервиса обработки ошибок %1 - не RepEr: в нем нет /hs/reper/<код базы>/.'"), АдресОбработкиОшибок);
	Иначе
		Описание = НСтр("ru = 'В настройках обработки ошибок не указан адрес сервиса обработки ошибок.
			|Укажите адрес RepEr: https://<сервер>/<публикация>/hs/reper/<код базы>/'");
	КонецЕсли;

	Возврат Описание;

КонецФункции

// Библиотека из описаний подсистем, имя которой совпадает с кодом базы в RepEr без учета регистра:
// код SYSTEM - библиотека system. Имена библиотек и коды могут быть на русском.
//
// Параметры:
//  Код - Строка - код базы в RepEr, см. ПодключениеКRepEr
//
// Возвращаемое значение:
//  Строка - имя библиотеки; пустая строка - такой библиотеки нет.
//
Функция БиблиотекаПоКоду(Код)

	ИмяБиблиотеки = "";
	Если ЗначениеЗаполнено(Код) Тогда
		Для Каждого Имя Из СтандартныеПодсистемыПовтИсп.ОписанияПодсистем().Порядок Цикл
			Если ВРег(Имя) = ВРег(СокрЛП(Код)) Тогда
				ИмяБиблиотеки = Имя;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат ИмяБиблиотеки;

КонецФункции

// Библиотека, выбранная в настройках репозитория, см. УстановитьНастройки
//
// Возвращаемое значение:
//  Строка - пустая строка, если репозиторий не настраивали или отключили.
//
Функция СохраненнаяБиблиотека()

	УстановитьПривилегированныйРежим(Истина);
	Сохраненные = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВладелецНастроек(), "Библиотеки");
	УстановитьПривилегированныйРежим(Ложь);

	ИмяБиблиотеки = "";
	Если ТипЗнч(Сохраненные) = Тип("Массив") Тогда
		Для Каждого Имя Из Сохраненные Цикл
			ИмяБиблиотеки = Строка(Имя);
			Прервать;
		КонецЦикла;
	КонецЕсли;

	Возврат ИмяБиблиотеки;

КонецФункции

// Код задачи по имени расширения исправления, которого нет в репозиториях: EF_9634_2 или EF_FIRE_9634_ФРК -
// system-9634 у библиотеки system, как в генераторе исправлений.
//
// Параметры:
//  Имя				- Строка - имя расширения исправления.
//  ИмяБиблиотеки	- Строка - настроенная библиотека.
//
// Возвращаемое значение:
//  Строка - пустая строка, если в имени нет номера задачи или библиотека не настроена.
//
Функция ЗадачаПоИмени(Имя, ИмяБиблиотеки)

	Задача = "";
	Если ЗначениеЗаполнено(ИмяБиблиотеки) Тогда
		Пометки = СтрРазделить("EF,FIRE,REV", ",");
		Для Каждого Часть Из СтрРазделить(Имя, "_", Ложь) Цикл
			Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Часть) Тогда
				Задача = ИмяБиблиотеки + "-" + Часть;
				Прервать;
			ИначеЕсли Пометки.Найти(ВРег(Часть)) = Неопределено Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Задача;

КонецФункции

// Заполняет число пользователей, у которых возникали ошибки по задачам исправлений, по данным RepEr:
// отчеты об ошибках, зарегистрированных под задачей, и их повторы.
//
// Параметры:
//  Исправления	- Массив из см. ОписаниеИсправления
//  Ошибки		- Массив из Строка - сюда добавляется ошибка, если RepEr не ответил.
//
Процедура ЗаполнитьПользователейЗадач(Исправления, Ошибки)

	КодыЗадач = Новый Массив;
	Для Каждого Описание Из Исправления Цикл
		Если ЗначениеЗаполнено(Описание.Задача) И КодыЗадач.Найти(Описание.Задача) = Неопределено Тогда
			КодыЗадач.Добавить(Описание.Задача);
		КонецЕсли;
	КонецЦикла;
	Если КодыЗадач.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, КодыЗадач);

	Ответ		= ВыполнитьЗапрос(Настройки(""), "issues/users/count", Запись.Закрыть());
	Количества	= ?(Ответ.КодСостояния = 200, ЗначениеИзJSON(Ответ.Тело), Неопределено);
	Если ТипЗнч(Количества) <> Тип("Массив") Тогда
		Ошибки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось получить из RepEr число пользователей с ошибками по задачам: %1'"), Ответ.Описание));
		Возврат;
	КонецЕсли;

	ПоЗадачам = Новый Соответствие;
	Для Каждого Элемент Из Количества Цикл
		Если ТипЗнч(Элемент) = Тип("Соответствие") Тогда
			ПоЗадачам.Вставить(ВРег(Строка(Элемент.Получить("issue"))), Элемент.Получить("users"));
		КонецЕсли;
	КонецЦикла;
	Для Каждого Описание Из Исправления Цикл
		Количество = ПоЗадачам.Получить(ВРег(Описание.Задача));
		Если ТипЗнч(Количество) = Тип("Число") Тогда
			Описание.Пользователей = Количество;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Пользователи этой базы по именам пользователей информационной базы из отчетов об ошибках.
//
// Параметры:
//  Имена - Массив из Строка
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ		- Строка - имя пользователя информационной базы.
//   * Значение	- СправочникСсылка.Пользователи
//
Функция ПользователиПоИменам(Имена)

	ПоИдентификаторам	= Новый Соответствие;
	Идентификаторы		= Новый Массив;

	УстановитьПривилегированныйРежим(Истина);
	Для Каждого Имя Из Имена Цикл
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Строка(Имя));
		Если ПользовательИБ <> Неопределено Тогда
			Идентификаторы.Добавить(ПользовательИБ.УникальныйИдентификатор);
			ПоИдентификаторам.Вставить(ПользовательИБ.УникальныйИдентификатор, Строка(Имя));
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Пользователи.Ссылка КАК Ссылка,
		|	Пользователи.ИдентификаторПользователяИБ КАК ИдентификаторПользователяИБ
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	Пользователи.ИдентификаторПользователяИБ В (&Идентификаторы)";
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);

	Результат	= Новый Соответствие;
	Выборка		= РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(ПоИдентификаторам.Получить(Выборка.ИдентификаторПользователяИБ), Выборка.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Параметры:
//  ИмяБиблиотеки - Строка - имя библиотеки из описаний подсистем; пустая строка - только подключение к RepEr.
//
// Возвращаемое значение:
//  Структура:
//   * ИмяБиблиотеки	- Строка - имя библиотеки, по версии которой выбирается каталог репозитория.
//   * Версия			- Строка - версия библиотеки, она же каталог репозитория.
//   * Адрес			- Строка - адрес HTTP-сервиса Service базы RepEr, см. ПодключениеКRepEr
//   * Пользователь		- Строка - пользователь RepEr.
//   * Пароль			- Строка - пароль пользователя RepEr.
//
Функция Настройки(ИмяБиблиотеки)

	Результат = Новый Структура;
	Результат.Вставить("ИмяБиблиотеки",	Строка(ИмяБиблиотеки));
	Результат.Вставить("Версия",		ВерсияБиблиотеки(ИмяБиблиотеки));
	Результат.Вставить("Адрес",			ПодключениеКRepEr().Адрес);
	Результат.Вставить("Пользователь",	"");
	Результат.Вставить("Пароль",		"");

	УстановитьПривилегированныйРежим(Истина);
	Сохраненные = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВладелецНастроек(), "Пользователь, Пароль");
	УстановитьПривилегированныйРежим(Ложь);

	Если ТипЗнч(Сохраненные) = Тип("Структура") Тогда
		Для Каждого КлючИЗначение Из Сохраненные Цикл
			Если ЗначениеЗаполнено(КлючИЗначение.Значение) Тогда
				Результат[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Библиотека, для которой настроен репозиторий: библиотека с именем, как код базы в RepEr, а если такой
// нет - выбранная в настройках. Репозиторий настроен, если настройки записаны (см. УстановитьНастройки)
// и в настройках обработки ошибок указан адрес RepEr, см. ПодключениеКRepEr
//
// Возвращаемое значение:
//  Массив из Строка - одна библиотека; пустой массив - репозиторий не настроен.
//
Функция НастроенныеБиблиотеки()

	Библиотеки	= Новый Массив;
	Сохраненная	= СохраненнаяБиблиотека();
	Если Не ЗначениеЗаполнено(Сохраненная) Тогда
		Возврат Библиотеки;
	КонецЕсли;

	Подключение = ПодключениеКRepEr();
	Если Не ЗначениеЗаполнено(Подключение.Адрес) Тогда
		Возврат Библиотеки;
	КонецЕсли;

	ИмяБиблиотеки = БиблиотекаПоКоду(Подключение.Код);
	Если Не ЗначениеЗаполнено(ИмяБиблиотеки) Тогда
		ИмяБиблиотеки = Сохраненная;
	КонецЕсли;
	Если ЗначениеЗаполнено(ВерсияБиблиотеки(ИмяБиблиотеки)) Тогда
		Библиотеки.Добавить(ИмяБиблиотеки);
	КонецЕсли;

	Возврат Библиотеки;

КонецФункции

// Версия библиотеки из описания подсистем, например 1.3.19.01. По ней выбирается каталог репозитория:
// исправления собираются под версию релиза и к другой версии не подходят.
//
// Параметры:
//  ИмяБиблиотеки - Строка
//
// Возвращаемое значение:
//  Строка - версия или пустая строка, если библиотеки нет в описаниях подсистем.
//
Функция ВерсияБиблиотеки(ИмяБиблиотеки)

	Описание = СтандартныеПодсистемыПовтИсп.ОписанияПодсистем().ПоИменам.Получить(ИмяБиблиотеки);
	Возврат ?(Описание = Неопределено, "", Описание.Версия);

КонецФункции

Процедура ПроверитьПравоАдминистрирования()
	
	Если Не Пользователи.ЭтоПолноправныйПользователь(, Истина) Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для настройки репозитория исправлений'");
	КонецЕсли;
	
КонецПроцедуры

// Владелец данных в безопасном хранилище: общий - для списка настроенных библиотек,
// с именем библиотеки - для настроек ее репозитория. Ключ «ЛентаИсправлений_CFR» - прежнее имя модуля:
// под ним уже сохранены настройки в базах, менять его нельзя.
//
// Параметры:
//  ИмяБиблиотеки - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ВладелецНастроек(ИмяБиблиотеки = "")

	Возврат "ЛентаИсправлений_CFR" + ?(ЗначениеЗаполнено(ИмяБиблиотеки), "." + ИмяБиблиотеки, "");

КонецФункции

Функция СобытиеЖурнала()
	
	Возврат НСтр("ru = 'Репозиторий исправлений'", ОбщегоНазначения.КодОсновногоЯзыка());
	
КонецФункции

#КонецОбласти
