///////////////////////////////////////////////////////////////////////////////////////////////////////
// Загрузка исправлений (EF) из репозиториев исправлений GitLab.
//
// Репозиторий - пакет generic в реестре пакетов GitLab: каталог на версию библиотеки (например 1.3.19.01),
// в нем архивы исправлений и оглавление index.json. Архивы - в формате исправлений БСП (cfe + Manifest.xml),
// ставятся и удаляются штатными средствами ОбновлениеКонфигурации.
//
// Репозиторий настраивается для библиотеки из описаний подсистем (см. регистр ВерсииПодсистем): у каждой
// библиотеки свой адрес и токен, каталог репозитория выбирается по версии этой библиотеки.
//
// Порядок: сначала удаляются отозванные сборки и сборки, замененные новыми, затем ставятся новые.
// Типовая УстановкаИУдалениеИсправлений делает наоборот, а расширение с занятым именем не установить.
//
// Исправление - один EF-коммит, несколько исправлений могут перехватывать один метод. Работает перехватчик
// расширения, установленного последним, поэтому исправления ставятся по возрастанию порядка установки (order
// в оглавлении), а установленные исправления с большим порядком и теми же методами ставятся заново.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Загружает исправления из репозиториев всех настроенных библиотек и приводит установленные исправления
// в соответствие с ними.
//
// Возвращаемое значение:
//  Структура:
//   * Версия		- Строка - библиотеки и их версии, для которых взяты репозитории, например «system 1.3.19.01».
//   * Установлены	- Массив из Строка - имена установленных исправлений.
//   * Удалены		- Массив из Строка - имена удаленных исправлений.
//   * Ошибки		- Массив из Строка - описания ошибок.
//
Функция Синхронизировать() Экспорт

	Возврат СинхронизироватьИсправления(Неопределено);

КонецФункции

// Приводит к репозиториям только указанные исправления: ставит текущую сборку (прежняя сборка удаляется),
// отозванное исправление удаляет. Используется для выборочной установки, в основном при тестировании.
//
// Параметры:
//  Имена - Массив из Строка - имена исправлений из репозиториев.
//
// Возвращаемое значение:
//  см. Синхронизировать
//
Функция УстановитьИсправления(Знач Имена) Экспорт

	ПроверитьПравоАдминистрирования();

	Отбор = Новый Соответствие;
	Для Каждого Имя Из Имена Цикл
		Отбор.Вставить(Имя, Истина);
	КонецЦикла;

	Возврат СинхронизироватьИсправления(Отбор);

КонецФункции

// Удаляет указанные установленные исправления, у которых есть описание исправления.
//
// Параметры:
//  Имена - Массив из Строка - имена установленных исправлений.
//
// Возвращаемое значение:
//  см. Синхронизировать
//
Функция УдалитьИсправления(Знач Имена) Экспорт

	ПроверитьПравоАдминистрирования();

	Результат = НовыйРезультатСинхронизации();

	План = Новый Структура("Удалить, УдалитьИмена, Установить", Новый Массив, Новый Массив, Новый Массив);
	Для Каждого Установленное Из ОбновлениеКонфигурации.УстановленныеИсправления() Цикл
		Если Имена.Найти(Установленное.Наименование) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Установленное.Идентификатор = Неопределено Тогда
			Результат.Ошибки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Исправление %1 не удалено: у него нет описания исправления. Удалите его в списке установленных исправлений.'"),
				Установленное.Наименование));
			Продолжить;
		КонецЕсли;
		План.Удалить.Добавить(Строка(Установленное.Идентификатор));
		План.УдалитьИмена.Добавить(Установленное.Наименование);
	КонецЦикла;

	ПрименитьИзменения(Неопределено, План, Результат);
	ЗаписатьРезультатВЖурнал(Результат);

	Возврат Результат;

КонецФункции

// Исправления репозиториев настроенных библиотек и их состояние в базе, для обработки ИсправленияИзРепозитория_RepEr.
// Ничего не меняет в базе, архивы не скачивает.
//
// Возвращаемое значение:
//  Структура:
//   * Библиотеки		- Массив из Структура:
//      ** Имя				- Строка - имя библиотеки.
//      ** Версия			- Строка - версия библиотеки, она же каталог репозитория.
//      ** СтраницаВерсии	- Строка - адрес страницы этой версии пакета репозитория в GitLab или пустая строка.
//      ** Адрес			- Строка - адрес репозитория из настроек.
//   * Исправления		- Массив из см. ОписаниеИсправления
//   * ЕстьИзменения	- Булево - синхронизация с репозиториями что-то установит или удалит.
//   * Ошибки			- Массив из Строка - описания ошибок.
//
Функция СписокИсправлений() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Библиотеки",	Новый Массив);
	Результат.Вставить("Исправления",	Новый Массив);
	Результат.Вставить("ЕстьИзменения",	Ложь);
	Результат.Вставить("Ошибки",		Новый Массив);

	// Установленные исправления: имя - идентификатор из описания, пустая строка - без описания.
	Установленные = Новый Соответствие;
	Для Каждого Установленное Из ОбновлениеКонфигурации.УстановленныеИсправления() Цикл
		Установленные.Вставить(Установленное.Наименование,
			?(Установленное.Идентификатор = Неопределено, "", НРег(Строка(Установленное.Идентификатор))));
	КонецЦикла;
	ВерсииУстановленных = Новый Соответствие;
	Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
		Если Установленные.Получить(Расширение.Имя) <> Неопределено Тогда
			ВерсииУстановленных.Вставить(Расширение.Имя, Расширение.Версия);
		КонецЕсли;
	КонецЦикла;
	Подключение = ПодключениеИсправлений();

	ВРепозиториях = Новый Соответствие;
	Для Каждого ИмяБиблиотеки Из НастроенныеБиблиотеки() Цикл
		Настройки	= Настройки(ИмяБиблиотеки);
		Ошибки		= Новый Массив;
		Оглавление	= Оглавление(Настройки, Ошибки);
		ДобавитьОшибкиБиблиотеки(Результат.Ошибки, Настройки, Ошибки);

		Библиотека = Новый Структура;
		Библиотека.Вставить("Имя",				ИмяБиблиотеки);
		Библиотека.Вставить("Версия",			Настройки.Версия);
		Библиотека.Вставить("СтраницаВерсии",	"");
		Библиотека.Вставить("Адрес",			Настройки.Адрес);
		Результат.Библиотеки.Добавить(Библиотека);

		Если Оглавление = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Библиотека.СтраницаВерсии = СтраницаВерсии(Настройки);

		Ошибки	= Новый Массив;
		План	= ПланИзменений(Оглавление, Ошибки);
		ДобавитьОшибкиБиблиотеки(Результат.Ошибки, Настройки, Ошибки);
		Если План.Удалить.Количество() > 0 Или План.Установить.Количество() > 0 Тогда
			Результат.ЕстьИзменения = Истина;
		КонецЕсли;

		ДобавитьИсправленияРепозитория(Результат.Исправления, Библиотека, Оглавление, Установленные, ВерсииУстановленных,
			Подключение, ВРепозиториях, План.Переустановить);
	КонецЦикла;

	НетВРепозиториях = Новый Массив;
	Для Каждого КлючИЗначение Из Установленные Цикл
		Если ВРепозиториях.Получить(КлючИЗначение.Ключ) = Неопределено Тогда
			Описание = ОписаниеИсправления(КлючИЗначение.Ключ, Неопределено, Неопределено,
				СостояниеНетВРепозитории(), КлючИЗначение.Значение);
			Результат.Исправления.Добавить(Описание);
			НетВРепозиториях.Добавить(Описание);
		КонецЕсли;
	КонецЦикла;

	ЗаполнитьПодключение(Результат.Исправления, Подключение);
	ЗаполнитьСеансыПодключения(Результат.Исправления);

	// Подключенное исправление, которого нет в репозиториях, - синей картинкой: неподключенное, отключенное
	// и с ошибкой подключения остаются со своими картинками.
	Для Каждого Описание Из НетВРепозиториях Цикл
		Если Описание.Статус = 0 Тогда
			Описание.Статус = 6;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции
// Состояние исправлений в базе для проверки установки в пайплайне, см. HTTP-сервис СостояниеИсправлений_RepEr.
// Репозитории не читает: только установленные исправления, их подключение и ошибки загрузки из журнала
// регистрации. Сеансы HTTP-сервиса не переиспользуются, поэтому подключение в сеансе сервиса - такое же,
// как в любом новом сеансе.
//
// Параметры:
//  НачалоПериода - Дата - ошибки загрузки читаются с этой даты.
//
// Возвращаемое значение:
//  Структура:
//   * Дата			- Дата - текущая дата сеанса: с нее читать ошибки при следующем запросе.
//   * Автозагрузка	- Булево - включена автоматическая загрузка исправлений по расписанию, см. ВключитьЗагрузку
//   * Исправления	- Массив из Структура:
//      ** Имя				- Строка - имя расширения исправления.
//      ** Идентификатор	- Строка - идентификатор из описания исправления; пустая строка - описания нет
//							  или расширение не подключено в сеансе: тогда сборку определяют по версии.
//      ** Версия			- Строка - версия расширения: у каждой сборки своя.
//      ** Статус			- Число - подключено (0), будет подключено (1), не удалось подключить (2),
//							  отключено (5), см. ОписаниеИсправления
//      ** Срочное			- Булево - срочное исправление (FIRE).
//      ** ДатаПодключения	- Дата - см. ОписаниеИсправления
//      ** СеансовДо		- Число - сеансы, начатые до подключения: в них исправление не работает.
//   * Ошибки		- Массив из Структура - ошибки загрузки без повторов, последние по дате:
//      ** Дата		- Дата - последний раз, когда ошибка записана в журнал.
//      ** Текст	- Строка
//      ** Раз		- Число - сколько раз записана с начала периода.
//
Функция СостояниеУстановки(НачалоПериода) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Дата",			ТекущаяДатаСеанса());
	Результат.Вставить("Автозагрузка",	Ложь);
	Результат.Вставить("Исправления",	Новый Массив);
	Результат.Вставить("Ошибки",		Новый Массив);

	Отбор = Новый Структура;
	Отбор.Вставить("ДатаНачала",	НачалоПериода);
	Отбор.Вставить("Событие",		СобытиеЖурнала());
	Отбор.Вставить("Уровень",		УровеньЖурналаРегистрации.Ошибка);
	Записи = Новый ТаблицаЗначений;

	УстановитьПривилегированныйРежим(Истина);
	Результат.Автозагрузка	= Константы.ЗагружатьИУстанавливатьИсправленияАвтоматически.Получить();
	Установленные			= ОбновлениеКонфигурации.УстановленныеИсправления();
	Версии					= Новый Соответствие;
	Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
		Версии.Вставить(Расширение.Имя, Расширение.Версия);
	КонецЦикла;
	ВыгрузитьЖурналРегистрации(Записи, Отбор, "Дата, Комментарий");
	УстановитьПривилегированныйРежим(Ложь);

	Описания		= Новый Массив;
	Идентификаторы	= Новый Соответствие;
	Для Каждого Установленное Из Установленные Цикл
		Идентификатор = ?(Установленное.Идентификатор = Неопределено, "", НРег(Строка(Установленное.Идентификатор)));
		Идентификаторы.Вставить(Установленное.Наименование, Идентификатор);
		Описания.Добавить(ОписаниеИсправления(Установленное.Наименование, Неопределено, Неопределено,
			СостояниеУстановлено(), Идентификатор));
	КонецЦикла;
	ЗаполнитьПодключение(Описания, ПодключениеИсправлений());
	ЗаполнитьСеансыПодключения(Описания);

	Для Каждого Описание Из Описания Цикл
		Исправление = Новый Структура;
		Исправление.Вставить("Имя",				Описание.Имя);
		Исправление.Вставить("Идентификатор",	Идентификаторы.Получить(Описание.Имя));
		Исправление.Вставить("Версия",			Строка(Версии.Получить(Описание.Имя)));
		Исправление.Вставить("Статус",			Описание.Статус);
		Исправление.Вставить("Срочное",			Описание.Срочное);
		Исправление.Вставить("ДатаПодключения",	Описание.ДатаПодключения);
		Исправление.Вставить("СеансовДо",		Описание.ФоновыхДо + Описание.ОстальныхДо);
		Результат.Исправления.Добавить(Исправление);
	КонецЦикла;

	// Задание повторяет ошибку при каждом запуске: в результат - по одной на текст.
	ПоТексту = Новый Соответствие;
	Для Каждого Запись Из Записи Цикл
		Ошибка = ПоТексту.Получить(Запись.Комментарий);
		Если Ошибка = Неопределено Тогда
			Ошибка = Новый Структура("Дата, Текст, Раз", Запись.Дата, Запись.Комментарий, 0);
			ПоТексту.Вставить(Запись.Комментарий, Ошибка);
			Результат.Ошибки.Добавить(Ошибка);
		КонецЕсли;
		Ошибка.Дата	= Макс(Ошибка.Дата, Запись.Дата);
		Ошибка.Раз	= Ошибка.Раз + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Определяет, настроен ли репозиторий хотя бы для одной библиотеки.
//
// Возвращаемое значение:
//  Булево
//
Функция РепозиторийНастроен() Экспорт

	Возврат НастроенныеБиблиотеки().Количество() > 0;

КонецФункции

// Определяет, ведет ли ссылка «Поиск и установка обновлений» типовых форм в репозитории исправлений:
// репозиторий настроен или пользователь может его настроить. Иначе типовые формы работают без изменений
// (ссылка ведет на портал 1С:Обновление программ).
//
// Возвращаемое значение:
//  Булево
//
Функция РепозиторийДоступен() Экспорт

	Возврат РепозиторийНастроен() Или Пользователи.ЭтоПолноправныйПользователь(, Истина);

КонецФункции

// Источник исправлений для подписи под ссылкой «Поиск и установка исправлений» в типовых формах,
// по аналогии с типовой подписью «с портала 1С:Обновление программ.». Адреса и версии репозиториев
// показывает обработка ИсправленияИзРепозитория_RepEr.
//
// Возвращаемое значение:
//  Строка
//
Функция ПредставлениеИсточника() Экспорт
	
	Если РепозиторийНастроен() Тогда
		Возврат НСтр("ru = 'из репозитория исправлений.'");
	КонецЕсли;
	
	Возврат НСтр("ru = '- репозиторий исправлений не настроен.'");
	
КонецФункции

// Определяет срочное исправление (FIRE): по пометке FIRE в репозитории или по имени расширения,
// например EF_FIRE_9643_ФРК у исправлений, поставленных вручную.
//
// Параметры:
//  Имя		- Строка - имя расширения исправления.
//  Срочные	- Соответствие из КлючИЗначение: Строка, Булево - имена срочных исправлений репозиториев, см. СрочныеИсправления
//			- Неопределено - прочитать сохраненные имена.
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоСрочноеИсправление(Имя, Знач Срочные = Неопределено) Экспорт

	Если СтрНайти(ВРег(Имя), "_FIRE_") > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Если Срочные = Неопределено Тогда
		Срочные = СрочныеИсправления();
	КонецЕсли;

	Возврат Срочные.Получить(Имя) = Истина;

КонецФункции

// Имена срочных исправлений из последних прочитанных оглавлений репозиториев всех настроенных библиотек.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ		- Строка - имя расширения исправления.
//   * Значение	- Булево - Истина.
//
Функция СрочныеИсправления() Экспорт

	Срочные = Новый Соответствие;

	УстановитьПривилегированныйРежим(Истина);
	Для Каждого ИмяБиблиотеки Из НастроенныеБиблиотеки() Цикл
		Имена = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВладелецНастроек(ИмяБиблиотеки), "Срочные");
		Если ТипЗнч(Имена) = Тип("Массив") Тогда
			Для Каждого Имя Из Имена Цикл
				Срочные.Вставить(Имя, Истина);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Срочные;

КонецФункции

// Картинка для колонки «Срочное (FIRE)» в списках исправлений.
//
// Параметры:
//  Имя		- Строка - имя расширения исправления.
//  Срочные	- см. ЭтоСрочноеИсправление.Срочные
//
// Возвращаемое значение:
//  Картинка - картинка СрочноеИсправление_RepEr (огонь) для срочного исправления, иначе пустая.
//
Функция КартинкаСрочного(Имя, Срочные = Неопределено) Экспорт

	Возврат ?(ЭтоСрочноеИсправление(Имя, Срочные), БиблиотекаКартинок.СрочноеИсправление_RepEr, Новый Картинка);

КонецФункции

// Определяет откат (REV): исправление из отката EF-коммита (git revert), например EF_REV_9634_2.
// Откат возвращает методы к прежнему тексту поверх более поздних исправлений.
//
// Параметры:
//  Имя - Строка - имя расширения исправления.
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоОткатИсправления(Имя) Экспорт

	Возврат СтрНайти(ВРег(Имя), "_REV_") > 0;

КонецФункции

// Сохраняет настройки репозитория библиотеки в безопасное хранилище. С пустым адресом репозиторий библиотеки отключается.
//
// Параметры:
//  ИмяБиблиотеки	- Строка - имя библиотеки из описаний подсистем, например system.
//  Адрес			- Строка - адрес репозитория, например https://<сервер GitLab>/<группа>/<проект>,
//					  или адрес пакета репозитория в API GitLab.
//  Токен			- Строка - токен GitLab с правом чтения реестра пакетов (токен развертывания, проекта или личный).
//					- Неопределено - оставить сохраненный токен.
//  Пользователь	- Строка - имя пользователя токена развертывания; если заполнено, используется базовая
//					  аутентификация, иначе токен передается в заголовке PRIVATE-TOKEN.
//
Процедура УстановитьНастройки(ИмяБиблиотеки, Адрес, Токен, Пользователь = "") Экспорт

	ПроверитьПравоАдминистрирования();

	Если ВерсияБиблиотеки(ИмяБиблиотеки) = "" Тогда
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Библиотека %1 не найдена в описаниях подсистем'"), ИмяБиблиотеки);
	КонецЕсли;

	Владелец = ВладелецНастроек(ИмяБиблиотеки);

	УстановитьПривилегированныйРежим(Истина);
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Владелец, Адрес, "Адрес");
	Если Токен <> Неопределено Тогда
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Владелец, Токен, "Токен");
	КонецЕсли;
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Владелец, Пользователь, "Пользователь");

	Библиотеки	= НастроенныеБиблиотеки();
	Индекс		= Библиотеки.Найти(ИмяБиблиотеки);
	Если ЗначениеЗаполнено(Адрес) И Индекс = Неопределено Тогда
		Библиотеки.Добавить(ИмяБиблиотеки);
	ИначеЕсли Не ЗначениеЗаполнено(Адрес) И Индекс <> Неопределено Тогда
		Библиотеки.Удалить(Индекс);
	КонецЕсли;
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ВладелецНастроек(), Библиотеки, "Библиотеки");
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Настройки репозитория библиотеки для формы настроек. Токен не возвращается, только признак, что он сохранен.
//
// Параметры:
//  ИмяБиблиотеки	- Строка - имя библиотеки; пустая строка - первая настроенная библиотека,
//					  а если таких нет - первая библиотека, которая не является конфигурацией.
//
// Возвращаемое значение:
//  Структура:
//   * Библиотеки			- Массив из Структура - библиотеки из описаний подсистем:
//      ** Имя			- Строка
//      ** Версия		- Строка
//      ** Настроена	- Булево - для библиотеки задан адрес репозитория.
//   * ИмяБиблиотеки		- Строка - библиотека, для которой возвращены настройки.
//   * Адрес				- Строка
//   * Пользователь			- Строка
//   * ТокенСохранен		- Булево
//   * ЗагрузкаПоРасписанию	- Булево - включена ли автоматическая загрузка исправлений, см. ВключитьЗагрузку
//   * Расписание			- РасписаниеРегламентногоЗадания, Структура - расписание типового регламентного задания
//							  загрузки исправлений (см. РегламентныеЗаданияСервер.РасписаниеРегламентногоЗадания).
//
Функция НастройкиДляФормы(Знач ИмяБиблиотеки = "") Экспорт

	ПроверитьПравоАдминистрирования();

	Настроенные				= НастроенныеБиблиотеки();
	Библиотеки				= Новый Массив;
	ПерваяНеКонфигурация	= "";
	ОписанияПодсистем		= СтандартныеПодсистемыПовтИсп.ОписанияПодсистем();
	Для Каждого Имя Из ОписанияПодсистем.Порядок Цикл
		Описание = ОписанияПодсистем.ПоИменам.Получить(Имя);
		Библиотеки.Добавить(Новый Структура("Имя, Версия, Настроена", Имя, Описание.Версия,
			Настроенные.Найти(Имя) <> Неопределено));
		Если Не Описание.ЭтоКонфигурация И Не ЗначениеЗаполнено(ПерваяНеКонфигурация) Тогда
			ПерваяНеКонфигурация = Имя;
		КонецЕсли;
	КонецЦикла;

	Если Не ЗначениеЗаполнено(ИмяБиблиотеки) Тогда
		ИмяБиблиотеки = ?(Настроенные.Количество() > 0, Настроенные[0], ПерваяНеКонфигурация);
	КонецЕсли;
	Настройки = Настройки(ИмяБиблиотеки);

	Результат = Новый Структура;
	Результат.Вставить("Библиотеки",	Библиотеки);
	Результат.Вставить("ИмяБиблиотеки",	Строка(ИмяБиблиотеки));
	Результат.Вставить("Адрес",			Настройки.Адрес);
	Результат.Вставить("Пользователь",	Настройки.Пользователь);
	Результат.Вставить("ТокенСохранен",	ЗначениеЗаполнено(Настройки.Токен));

	Результат.Вставить("ЗагрузкаПоРасписанию",	Константы.ЗагружатьИУстанавливатьИсправленияАвтоматически.Получить());
	Результат.Вставить("Расписание",			РегламентныеЗаданияСервер.РасписаниеРегламентногоЗадания(ЗаданиеЗагрузки()));

	Возврат Результат;

КонецФункции

// Проверяет доступ к репозиторию библиотеки с указанными настройками: читает оглавление для версии библиотеки.
//
// Параметры:
//  ИмяБиблиотеки	- Строка - имя библиотеки.
//  Адрес			- Строка - адрес пакета репозитория.
//  Токен			- Строка - токен GitLab.
//					- Неопределено - взять сохраненный токен.
//  Пользователь	- Строка - имя пользователя токена развертывания.
//
// Возвращаемое значение:
//  Структура:
//   * Успех	- Булево
//   * Описание	- Строка - результат проверки для пользователя.
//
Функция ПроверитьПодключение(ИмяБиблиотеки, Адрес, Токен, Пользователь) Экспорт

	ПроверитьПравоАдминистрирования();

	Настройки				= Настройки(ИмяБиблиотеки);
	Настройки.Адрес			= Адрес;
	Настройки.Пользователь	= Пользователь;
	Если Токен <> Неопределено Тогда
		Настройки.Токен = Токен;
	КонецЕсли;

	Результат = Новый Структура("Успех, Описание", Ложь, "");
	Если Не ЗначениеЗаполнено(Настройки.Адрес) Тогда
		Результат.Описание = НСтр("ru = 'Не указан адрес репозитория.'");
		Возврат Результат;
	КонецЕсли;

	Ошибки		= Новый Массив;
	Оглавление	= Оглавление(Настройки, Ошибки);
	Если Оглавление = Неопределено Тогда
		Результат.Описание = СтрСоединить(Ошибки, Символы.ПС);
		Возврат Результат;
	КонецЕсли;

	Записи				= Оглавление.Получить("patches");
	Количество			= ?(ТипЗнч(Записи) = Тип("Массив"), Записи.Количество(), 0);
	Результат.Успех		= Истина;
	Результат.Описание	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Репозиторий доступен. %1 %2, исправлений в репозитории: %3.'"), ИмяБиблиотеки, Настройки.Версия, Количество);

	Возврат Результат;

КонецФункции

// Включает или выключает автоматическую загрузку исправлений из репозиториев: типовой флажок «Загружать
// и устанавливать исправления (патчи) автоматически» (константа ЗагружатьИУстанавливатьИсправленияАвтоматически)
// и типовое регламентное задание загрузки исправлений, которое вместо исправлений 1С загружает исправления
// из репозиториев, см. ЗагрузкаИсправлений
// Подключение к Интернет-поддержке для этого не нужно.
//
// Параметры:
//  Использование	- Булево - выполнять ли задание по расписанию.
//  Расписание		- РасписаниеРегламентногоЗадания - новое расписание задания.
//					- Число - период запуска в минутах (каждый день).
//					- Неопределено - оставить текущее расписание.
//
Процедура ВключитьЗагрузку(Использование = Истина, Знач Расписание = Неопределено) Экспорт

	ПроверитьПравоАдминистрирования();

	Если ТипЗнч(Расписание) = Тип("Число") Тогда
		ИнтервалМинут						= Расписание;
		Расписание							= Новый РасписаниеРегламентногоЗадания;
		Расписание.ПериодПовтораДней		= 1;
		Расписание.ПериодПовтораВТечениеДня	= ИнтервалМинут * 60;
	КонецЕсли;

	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("Использование", Использование);
	Если Расписание <> Неопределено Тогда
		ПараметрыЗадания.Вставить("Расписание", Расписание);
	КонецЕсли;

	Константы.ЗагружатьИУстанавливатьИсправленияАвтоматически.Установить(Использование = Истина);
	РегламентныеЗаданияСервер.ИзменитьЗадание(ЗаданиеЗагрузки(), ПараметрыЗадания);

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Обработчик типового регламентного задания загрузки исправлений: исправления 1С не загружаются,
// только исправления из репозиториев.
//
Процедура ЗагрузкаИсправлений() Экспорт

	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(ЗаданиеЗагрузки());

	Если Не Пользователи.ЭтоПолноправныйПользователь(, Истина, Ложь) Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав.'");
	КонецЕсли;

	// Итог синхронизация пишет в журнал регистрации сама, см. ЗаписатьРезультатВЖурнал
	Синхронизировать();

КонецПроцедуры

// Включает типовое регламентное задание загрузки исправлений, если включена автоматическая загрузка,
// и выключает, если нет: подключение к Интернет-поддержке на него не влияет, см. ВключитьЗагрузку
//
Процедура ОбновитьИспользованиеЗагрузки() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	РегламентныеЗаданияСервер.УстановитьИспользованиеРегламентногоЗадания(ЗаданиеЗагрузки(),
		Константы.ЗагружатьИУстанавливатьИсправленияАвтоматически.Получить());
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Номера текущих сеансов, которые попадают в счетчики сеансов исправления, см. ЗаполнитьСеансыПодключения
//
// Параметры:
//  ДатаПодключения	- Дата - см. ОписаниеИсправления
//  ДатаОтключения	- Дата - см. ОписаниеИсправления
//  Счетчики		- Массив из Строка - имена счетчиков из ОписаниеИсправления: ФоновыхДо, ОстальныхПосле и т.п.
//
// Возвращаемое значение:
//  Массив из Число - номера сеансов; пустой - даты подключения и отключения не заполнены.
//
Функция НомераСеансовПодключения(ДатаПодключения, ДатаОтключения, Счетчики) Экспорт

	НомераСеансов = Новый Массив;
	Если Не ЗначениеЗаполнено(ДатаПодключения) И Не ЗначениеЗаполнено(ДатаОтключения) Тогда
		Возврат НомераСеансов; // Исправление не подключалось: сеансы не считаются.
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Сеансы = ПолучитьСеансыИнформационнойБазы();
	УстановитьПривилегированныйРежим(Ложь);

	Для Каждого Сеанс Из Сеансы Цикл
		Если Счетчики.Найти(СчетчикСеанса(Сеанс, ДатаПодключения, ДатаОтключения)) <> Неопределено Тогда
			НомераСеансов.Добавить(Сеанс.НомерСеанса);
		КонецЕсли;
	КонецЦикла;

	Возврат НомераСеансов;

КонецФункции

// Начало периода, за который журнал регистрации читается для дат подключения и отключения исправлений:
// сегодня и два предыдущих дня. Исправление, подключенное или отключенное раньше, получает эту дату,
// см. ЗаполнитьСеансыПодключения
//
// Возвращаемое значение:
//  Дата
//
Функция НачалоПериодаПодключения() Экспорт

	Возврат НачалоДня(ТекущаяДатаСеанса()) - 2 * 86400;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Типовое регламентное задание автоматической загрузки исправлений: собственного задания у расширения нет.
//
// Возвращаемое значение:
//  ОбъектМетаданных
//
Функция ЗаданиеЗагрузки()

	Возврат Метаданные.РегламентныеЗадания.ПолучениеИУстановкаИсправленийКонфигурации;

КонецФункции

Функция СинхронизироватьИсправления(Отбор)

	Результат	= НовыйРезультатСинхронизации();
	Версии		= Новый Массив;

	Библиотеки = НастроенныеБиблиотеки();
	Если Библиотеки.Количество() = 0 Тогда
		Результат.Ошибки.Добавить(НСтр("ru = 'Репозиторий исправлений не настроен, см. РепозиторийИсправлений_RepEr.УстановитьНастройки'"));
	КонецЕсли;

	Для Каждого ИмяБиблиотеки Из Библиотеки Цикл
		Настройки = Настройки(ИмяБиблиотеки);
		Версии.Добавить(ИмяБиблиотеки + " " + Настройки.Версия);

		Ошибки		= Новый Массив;
		Оглавление	= Оглавление(Настройки, Ошибки);
		Если Оглавление <> Неопределено Тогда
			ИтогБиблиотеки	= НовыйРезультатСинхронизации();
			План			= ПланИзменений(Оглавление, Ошибки, Отбор);
			Для Каждого Имя Из План.Вручную Цикл
				Ошибки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Исправление %1 не установлено: расширение с таким именем установлено без описания исправления (вручную)'"),
					Имя));
			КонецЦикла;
			ПрименитьИзменения(Настройки, План, ИтогБиблиотеки);
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат.Установлены, ИтогБиблиотеки.Установлены);
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат.Удалены, ИтогБиблиотеки.Удалены);
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Ошибки, ИтогБиблиотеки.Ошибки);
		КонецЕсли;
		ДобавитьОшибкиБиблиотеки(Результат.Ошибки, Настройки, Ошибки);
	КонецЦикла;

	Результат.Версия = СтрСоединить(Версии, ", ");
	ЗаписатьРезультатВЖурнал(Результат);

	Возврат Результат;

КонецФункции

// Пишет итог синхронизации или удаления в журнал регистрации, событие «Репозиторий исправлений»:
// и регламентного задания, и ручного запуска. По ошибкам из журнала пайплайн показывает, почему
// исправление не установилось, см. СостояниеУстановки
//
// Параметры:
//  Результат - см. Синхронизировать
//
Процедура ЗаписатьРезультатВЖурнал(Результат)

	Если Результат.Установлены.Количество() > 0 Или Результат.Удалены.Количество() > 0 Тогда
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Установлены: %1. Удалены: %2.'"),
			СтрСоединить(Результат.Установлены, ", "), СтрСоединить(Результат.Удалены, ", "));
		Если ЗначениеЗаполнено(Результат.Версия) Тогда
			Текст = Результат.Версия + ". " + Текст;
		КонецЕсли;
		ЗаписьЖурналаРегистрации(СобытиеЖурнала(), УровеньЖурналаРегистрации.Информация,,, Текст);
	КонецЕсли;
	Для Каждого Ошибка Из Результат.Ошибки Цикл
		ЗаписьЖурналаРегистрации(СобытиеЖурнала(), УровеньЖурналаРегистрации.Ошибка,,, Ошибка);
	КонецЦикла;

КонецПроцедуры

// Возвращаемое значение:
//  см. Синхронизировать
//
Функция НовыйРезультатСинхронизации()

	Результат = Новый Структура;
	Результат.Вставить("Версия",		"");
	Результат.Вставить("Установлены",	Новый Массив);
	Результат.Вставить("Удалены",		Новый Массив);
	Результат.Вставить("Ошибки",		Новый Массив);
	Возврат Результат;

КонецФункции

// Добавляет ошибки репозитория библиотеки, при нескольких репозиториях - с именем библиотеки.
//
// Параметры:
//  Ошибки				- Массив из Строка - куда добавить.
//  Настройки			- см. Настройки
//  ОшибкиРепозитория	- Массив из Строка
//
Процедура ДобавитьОшибкиБиблиотеки(Ошибки, Настройки, ОшибкиРепозитория)

	НесколькоРепозиториев = НастроенныеБиблиотеки().Количество() > 1;
	Для Каждого Ошибка Из ОшибкиРепозитория Цикл
		Ошибки.Добавить(?(НесколькоРепозиториев, Настройки.ИмяБиблиотеки + ": " + Ошибка, Ошибка));
	КонецЦикла;

КонецПроцедуры

// Добавляет исправления репозитория библиотеки в список для формы.
//
// Параметры:
//  Исправления		- Массив из см. ОписаниеИсправления
//  Библиотека		- Структура - репозиторий библиотеки, элемент Библиотеки из см. СписокИсправлений
//  Оглавление		- Соответствие из КлючИЗначение: Строка, Произвольный - оглавление репозитория.
//  Установленные		- Соответствие из КлючИЗначение: Строка, Строка - имя - идентификатор установленного исправления.
//  ВерсииУстановленных	- Соответствие из КлючИЗначение: Строка, Строка - имя - версия установленного расширения.
//  Подключение			- см. ПодключениеИсправлений
//  ВРепозиториях		- Соответствие из КлючИЗначение: Строка, Булево - сюда добавляются имена исправлений репозитория.
//  Переустановить		- Массив из Строка - установленные исправления, которые синхронизация поставит заново ради
//						  порядка установки, см. ПланИзменений.
//
Процедура ДобавитьИсправленияРепозитория(Исправления, Библиотека, Оглавление, Установленные, ВерсииУстановленных,
	Подключение, ВРепозиториях, Переустановить)

	// В репозитории у исправления может быть несколько сборок: прежние отозваны, текущая - неотозванная.
	Записи = Оглавление.Получить("patches");
	Если ТипЗнч(Записи) <> Тип("Массив") Тогда
		Записи = Новый Массив;
	КонецЕсли;
	Имена		= Новый Массив;
	Текущие		= Новый Соответствие;
	Последние	= Новый Соответствие;
	Сборки		= Новый Соответствие; // Имя и идентификатор сборки - Истина: все сборки, и отозванные.
	ПоВерсиям	= Новый Соответствие; // Имя и версия сборки - идентификатор сборки.
	Для Каждого Запись Из Записи Цикл
		Имя = Строка(Запись.Получить("name"));
		Если Имена.Найти(Имя) = Неопределено Тогда
			Имена.Добавить(Имя);
		КонецЕсли;
		Последние.Вставить(Имя, Запись);
		Сборки.Вставить(Имя + " " + НРег(Строка(Запись.Получить("uuid"))), Истина);
		ПоВерсиям.Вставить(Имя + " " + Строка(Запись.Получить("patch_version")), НРег(Строка(Запись.Получить("uuid"))));
		Если Запись.Получить("revoked") <> Истина Тогда
			Текущие.Вставить(Имя, Запись);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Имя Из Имена Цикл
		Текущая						= Текущие.Получить(Имя);
		Запись						= ?(Текущая = Неопределено, Последние.Получить(Имя), Текущая);
		ИдентификаторУстановленного	= Установленные.Получить(Имя);
		СостояниеПодключения		= Подключение.Получить(Имя);
		Если ИдентификаторУстановленного = "" И СостояниеПодключения <> Неопределено
			И Не СостояниеПодключения.Подключено Тогда
			// Описание исправления читается из метаданных сеанса, у неподключенного в сеансе расширения его нет:
			// установленная сборка определяется по версии расширения, она у каждой сборки своя.
			ПоВерсии = ПоВерсиям.Получить(Имя + " " + ВерсииУстановленных.Получить(Имя));
			Если ПоВерсии <> Неопределено Тогда
				ИдентификаторУстановленного = ПоВерсии;
			КонецЕсли;
		КонецЕсли;
		Если ИдентификаторУстановленного = Неопределено Тогда
			Состояние = ?(Текущая = Неопределено, СостояниеОтозвано(), СостояниеНеУстановлено());
		ИначеЕсли ИдентификаторУстановленного = "" Тогда
			Состояние = СостояниеУстановленоВручную();
		ИначеЕсли Сборки.Получить(Имя + " " + ИдентификаторУстановленного) = Неопределено Тогда
			Состояние = СостояниеУстановленаСборкаНеИзРепозитория();
		ИначеЕсли Текущая = Неопределено Тогда
			Состояние = СостояниеУстановленоОтозванное();
		ИначеЕсли ИдентификаторУстановленного = НРег(Строка(Текущая.Получить("uuid"))) Тогда
			Состояние = ?(Переустановить.Найти(Имя) = Неопределено, СостояниеУстановлено(), СостояниеБудетПереустановлено());
		Иначе
			Состояние = СостояниеУстановленаПрежняяСборка();
		КонецЕсли;
		Описание = ОписаниеИсправления(Имя, Библиотека, Запись, Состояние, ИдентификаторУстановленного);
		Если Состояние = СостояниеУстановленаПрежняяСборка() Тогда
			// Текущая сборка репозитория не установлена: картинка «подключена другая сборка» и версия сборки в базе.
			Описание.Состояние	= ПредставлениеУстановленнойСборки(ВерсииУстановленных.Получить(Имя));
			Описание.Статус		= 3;
		ИначеЕсли Состояние = СостояниеУстановленаСборкаНеИзРепозитория() Тогда
			// Сборки с таким идентификатором в репозитории нет: поставлена из файла, например локальная сборка.
			// Синхронизация заменит ее текущей сборкой, а если текущей нет (все отозваны) - не тронет.
			Описание.Состояние	= ПредставлениеСборкиНеИзРепозитория(ВерсииУстановленных.Получить(Имя));
			Описание.Статус		= 4;
			Описание.Порядок	= ?(Текущая = Неопределено, 1, 0);
		КонецЕсли;
		Исправления.Добавить(Описание);
		ВРепозиториях.Вставить(Имя, Истина);
	КонецЦикла;

КонецПроцедуры

// Параметры:
//  Имя							- Строка - имя расширения исправления.
//  Библиотека					- Структура - репозиторий, в котором исправление, элемент Библиотеки из см. СписокИсправлений
//								- Неопределено - исправления нет в репозиториях.
//  Запись						- Соответствие из КлючИЗначение - запись оглавления репозитория.
//								- Неопределено - исправления нет в репозиториях.
//  Состояние					- Строка - представление состояния исправления в базе.
//  ИдентификаторУстановленного	- Строка - идентификатор установленного исправления, пустая строка - без описания исправления.
//								- Неопределено - исправление не установлено.
//
// Возвращаемое значение:
//  Структура:
//   * Имя				- Строка - имя расширения исправления.
//   * Статус			- Число - индекс картинки СостоянияИсправлений_RepEr: подключено (0), будет подключено (1),
//						  не удалось подключить (2), как в типовой форме расширений; подключена другая сборка (3);
//						  подключена сборка не из репозитория (4); отключено (5); подключено, в репозитории нет (6);
//						  не подключено (-1), см. ЗаполнитьПодключение и СписокИсправлений.
//   * Отозвано			- Булево - все сборки исправления отозваны в репозитории: коммит исправления откачен.
//   * Отключено		- Булево - расширение в базе, но отключено (снят флажок «Подключать»):
//						  в новых сеансах не подключается.
//   * Откат			- Булево - откат EF-коммита (REV), см. ЭтоОткатИсправления
//   * Библиотека		- Строка - библиотека, в репозитории которой исправление.
//   * Наименование		- Строка - тема коммита без кода задачи и пометок EF и FIRE.
//   * Коммит			- Строка - тема коммита.
//   * СсылкаНаКоммит	- Строка - адрес коммита или пустая строка.
//   * ВерсияСборки		- Строка - версия сборки исправления в репозитории.
//   * ПорядокУстановки	- Число - порядок установки исправления (номер коммита в истории после релиза);
//						  0 - неизвестен (исправления нет в репозиториях или опубликовано без порядка).
//   * СсылкаНаВерсию	- Строка - адрес страницы версии пакета репозитория или пустая строка.
//   * Состояние		- Строка - представление состояния исправления в базе.
//   * Срочное			- Булево - срочное исправление (FIRE).
//   * Порядок			- Число - 0 - синхронизация изменит исправление, 1 - не изменит.
//   * ДатаПодключения	- Дата - подключение этой сборки расширения в базе (установка или флажок «Подключать»)
//						  по журналу регистрации за последние три дня; начало периода - подключено раньше;
//						  пустая - исправление не подключалось, см. ЗаполнитьСеансыПодключения
//   * ДатаОтключения	- Дата - отключение этой сборки (снят флажок «Подключать») или ее удаление из базы
//						  по журналу регистрации за последние три дня; пустая - не отключалось.
//   * ФоновыхДо		- Число - фоновые задания, начатые до ДатаПодключения: в них исправление не подключено.
//   * ОстальныхДо		- Число - остальные сеансы, начатые до ДатаПодключения.
//   * ФоновыхПосле		- Число - фоновые задания, начатые после ДатаПодключения и до ДатаОтключения:
//						  в них исправление подключено.
//   * ОстальныхПосле	- Число - остальные сеансы, начатые после ДатаПодключения и до ДатаОтключения.
//   * ФоновыхПослеОтключения	- Число - фоновые задания, начатые после ДатаОтключения: в них исправление
//								  не подключено.
//   * ОстальныхПослеОтключения	- Число - остальные сеансы, начатые после ДатаОтключения.
//
Функция ОписаниеИсправления(Имя, Библиотека, Запись, Состояние, ИдентификаторУстановленного)

	ИмяБиблиотеки	= ?(Библиотека = Неопределено, "", Библиотека.Имя);
	Тема			= ?(Запись = Неопределено, "", Строка(Запись.Получить("description")));
	// Записи, опубликованные до появления полей commit_title и fire, разбираются по теме коммита.
	Разбор			= РазобратьТему(Тема, ИмяБиблиотеки);
	// В записях первых публикаций перед темой коммита стоит «Commit - ».
	Коммит			= ?(Запись = Неопределено, "", Строка(Запись.Получить("commit_title")));
	Если СтрНачинаетсяС(Коммит, "Commit - ") Тогда
		Коммит = Сред(Коммит, СтрДлина("Commit - ") + 1);
	КонецЕсли;
	Статус			= ?(ИдентификаторУстановленного = Неопределено, -1, 0);

	Описание = Новый Структура;
	Описание.Вставить("Имя",				Строка(Имя));
	Описание.Вставить("Статус",				Статус);
	Описание.Вставить("Отозвано",			Состояние = СостояниеОтозвано() Или Состояние = СостояниеУстановленоОтозванное());
	Описание.Вставить("Отключено",			Ложь);
	Описание.Вставить("Откат",				ЭтоОткатИсправления(Имя) Или Запись <> Неопределено И Запись.Получить("revert") = Истина);
	Описание.Вставить("Библиотека",			Строка(ИмяБиблиотеки));
	Описание.Вставить("Наименование",		?(ЗначениеЗаполнено(Разбор.Наименование), Разбор.Наименование, Строка(Имя)));
	Описание.Вставить("Коммит",				Коммит);
	Описание.Вставить("СсылкаНаКоммит",		?(Запись = Неопределено, "", Строка(Запись.Получить("commit_url"))));
	Описание.Вставить("ВерсияСборки",		?(Запись = Неопределено, "", Строка(Запись.Получить("patch_version"))));
	Описание.Вставить("ПорядокУстановки",	?(Запись = Неопределено, 0, ПорядокУстановки(Запись)));
	Описание.Вставить("СсылкаНаВерсию",		?(Библиотека = Неопределено, "", Библиотека.СтраницаВерсии));
	Описание.Вставить("Состояние",			Состояние);
	Описание.Вставить("Срочное",			ЭтоСрочноеИсправление(Имя, Новый Соответствие)
		Или Запись <> Неопределено И (Запись.Получить("fire") = Истина Или Разбор.Срочное));

	ТребуютДействия = Новый Массив;
	ТребуютДействия.Добавить(СостояниеНеУстановлено());
	ТребуютДействия.Добавить(СостояниеУстановленаПрежняяСборка());
	ТребуютДействия.Добавить(СостояниеУстановленоОтозванное());
	ТребуютДействия.Добавить(СостояниеБудетПереустановлено());
	Описание.Вставить("Порядок", ?(ТребуютДействия.Найти(Состояние) = Неопределено, 1, 0));

	Описание.Вставить("ДатаПодключения",			Дата(1, 1, 1));
	Описание.Вставить("ДатаОтключения",				Дата(1, 1, 1));
	Описание.Вставить("ФоновыхДо",					0);
	Описание.Вставить("ОстальныхДо",				0);
	Описание.Вставить("ФоновыхПосле",				0);
	Описание.Вставить("ОстальныхПосле",				0);
	Описание.Вставить("ФоновыхПослеОтключения",		0);
	Описание.Вставить("ОстальныхПослеОтключения",	0);

	Возврат Описание;

КонецФункции

// Подключение установленных исправлений в текущем сеансе, как в типовой форме расширений.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение: Строка, Структура - имя исправления - его подключение:
//   * Подключено	- Булево - подключено в текущем сеансе.
//   * Ошибка		- Булево - платформа отключила расширение в текущем сеансе из-за ошибки подключения.
//   * Отключено	- Булево - снят флажок «Подключать»: в новых сеансах расширение не подключается.
//
Функция ПодключениеИсправлений()

	УстановитьПривилегированныйРежим(Истина);
	Расширения	= РасширенияКонфигурации.Получить();
	Активные	= КлючиПодключения(ИсточникРасширенийКонфигурации.СеансАктивные);
	Отключенные	= КлючиПодключения(ИсточникРасширенийКонфигурации.СеансОтключенные);
	УстановитьПривилегированныйРежим(Ложь);

	Подключение = Новый Соответствие;
	Для Каждого Расширение Из Расширения Цикл
		Если Не ОбновлениеКонфигурации.ЭтоИсправление(Расширение) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = КлючПодключения(Расширение);

		Состояние = Новый Структура;
		Состояние.Вставить("Подключено",	Активные.Получить(Ключ) <> Неопределено);
		Состояние.Вставить("Ошибка",		Отключенные.Получить(Ключ) <> Неопределено);
		Состояние.Вставить("Отключено",		Не Расширение.Активно);
		Подключение.Вставить(Расширение.Имя, Состояние);
	КонецЦикла;

	Возврат Подключение;

КонецФункции

// Параметры:
//  Источник - ИсточникРасширенийКонфигурации
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение: Строка, Булево - см. КлючПодключения - Истина.
//
Функция КлючиПодключения(Источник)

	Ключи = Новый Соответствие;
	Для Каждого Расширение Из РасширенияКонфигурации.Получить(, Источник) Цикл
		Ключи.Вставить(КлючПодключения(Расширение), Истина);
	КонецЦикла;

	Возврат Ключи;

КонецФункции

// Ключ расширения для сравнения расширений базы и сеанса, как в типовой форме расширений: имя и содержимое.
//
// Параметры:
//  Расширение - РасширениеКонфигурации
//
// Возвращаемое значение:
//  Строка
//
Функция КлючПодключения(Расширение)

	Возврат Расширение.Имя + " " + ПолучитьHexСтрокуИзДвоичныхДанных(Расширение.ХешСумма) + " "
		+ Строка(Расширение.ОбластьДействия);

КонецФункции

// Заполняет статус и состояние исправлений в базе по их подключению.
// Отключенное (снят флажок «Подключать») и «Не удалось подключить» важнее картинок сборки: отключенное
// не подключается в новых сеансах, даже если подключено в текущем; остальные неподключенные в текущем сеансе
// подключатся после перезапуска.
//
// Параметры:
//  Исправления	- Массив из см. ОписаниеИсправления
//  Подключение	- см. ПодключениеИсправлений
//
Процедура ЗаполнитьПодключение(Исправления, Подключение)

	Для Каждого Исправление Из Исправления Цикл
		Состояние = Подключение.Получить(Исправление.Имя);
		Если Состояние = Неопределено Тогда
			Продолжить; // Нет в базе.
		КонецЕсли;
		Исправление.Отключено = Состояние.Отключено;
		Если Состояние.Отключено Тогда
			Исправление.Статус		= 5;
			Исправление.Состояние	= ПредставлениеПодключения(Исправление.Состояние, НСтр("ru = 'Отключено'"));
		ИначеЕсли Состояние.Подключено Тогда
			Продолжить;
		ИначеЕсли Состояние.Ошибка Тогда
			Исправление.Статус		= 2;
			Исправление.Состояние	= ПредставлениеПодключения(Исправление.Состояние, НСтр("ru = 'Не удалось подключить'"));
		ИначеЕсли Исправление.Статус = 0 Тогда
			Исправление.Статус		= 1;
			Исправление.Состояние	= ПредставлениеПодключения(Исправление.Состояние, НСтр("ru = 'Будет подключено'"));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Параметры:
//  Состояние	- Строка - состояние исправления в базе, например «Подключено, но отозвано» или «Сборка 1.3.19.01.2».
//  Подключение	- Строка - подключение исправления, например «Будет подключено».
//
// Возвращаемое значение:
//  Строка - состояние, в котором «Подключено» заменено подключением: «Будет подключено, но отозвано»;
//           у состояния сборки подключение - через точку с запятой: «Сборка 1.3.19.01.2; будет подключено».
//
Функция ПредставлениеПодключения(Состояние, Подключение)

	Если СтрНачинаетсяС(Состояние, СостояниеУстановлено()) Тогда
		Представление = Подключение + Сред(Состояние, СтрДлина(СостояниеУстановлено()) + 1);
	Иначе
		Представление = Состояние + "; " + НРег(Подключение);
	КонецЕсли;

	Возврат Представление;

КонецФункции

// Заполняет у исправлений даты подключения и отключения и число сеансов, начатых до подключения, после него
// и после отключения: расширение подключается только в сеансах, начатых после подключения и до отключения.
// Журнал регистрации читается за последние три дня; исправление, подключенное раньше, получает дату начала
// этого периода. У исправления, которого нет в базе, даты - по его удалению из базы за этот период:
// в сеансах, начатых до удаления, удаленное расширение еще работает.
//
// Параметры:
//  Исправления - Массив из см. ОписаниеИсправления
//
Процедура ЗаполнитьСеансыПодключения(Исправления)

	НачалоПериода	= НачалоПериодаПодключения();
	ПустаяДата		= Дата(1, 1, 1);

	УстановитьПривилегированныйРежим(Истина);
	История	= ИсторияПодключенияРасширений(НачалоПериода);
	Сеансы	= ПолучитьСеансыИнформационнойБазы();
	// Имя уникально среди расширений в базе, но не в журнале: у сборок одного исправления оно общее.
	ВБазе	= Новый Соответствие;
	Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
		Если ОбновлениеКонфигурации.ЭтоИсправление(Расширение) Тогда
			ВБазе.Вставить(Расширение.Имя, Новый Структура("Ключ, Активно",
				КлючРасширения(Расширение.УникальныйИдентификатор, ПолучитьHexСтрокуИзДвоичныхДанных(Расширение.ХешСумма)),
				Расширение.Активно));
		КонецЕсли;
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);

	Для Каждого Исправление Из Исправления Цикл
		// По расширению в базе, а не по статусу: у строки с другой сборкой в базе картинки нет.
		Расширение = ВБазе.Получить(Исправление.Имя);
		Если Расширение <> Неопределено Тогда
			Периоды = История.Расширения.Получить(Расширение.Ключ);
			Если Периоды = Неопределено Тогда
				Периоды = Новый Структура("ДатаПодключения, ДатаОтключения", НачалоПериода, ПустаяДата);
			КонецЕсли;
			ДатаПодключения	= ?(ЗначениеЗаполнено(Периоды.ДатаПодключения), Периоды.ДатаПодключения, НачалоПериода);
			ДатаОтключения	= ПустаяДата;
			Если Не Расширение.Активно Тогда
				ДатаОтключения = ?(ЗначениеЗаполнено(Периоды.ДатаОтключения), Периоды.ДатаОтключения, НачалоПериода);
			КонецЕсли;
		Иначе
			Ключ = История.Удаленные.Получить(Исправление.Имя);
			Если Ключ = Неопределено Тогда
				Продолжить; // Нет в базе и не удалялось из нее за период.
			КонецЕсли;
			Периоды			= История.Расширения.Получить(Ключ);
			ДатаПодключения	= Периоды.ДатаПодключения;
			ДатаОтключения	= Периоды.ДатаОтключения;
		КонецЕсли;
		Исправление.ДатаПодключения	= ДатаПодключения;
		Исправление.ДатаОтключения	= ДатаОтключения;

		Для Каждого Сеанс Из Сеансы Цикл
			Счетчик = СчетчикСеанса(Сеанс, ДатаПодключения, ДатаОтключения);
			Исправление[Счетчик] = Исправление[Счетчик] + 1;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Параметры:
//  Сеанс			- СеансИнформационнойБазы
//  ДатаПодключения	- Дата - см. ОписаниеИсправления
//  ДатаОтключения	- Дата - см. ОписаниеИсправления
//
// Возвращаемое значение:
//  Строка - имя счетчика сеансов из ОписаниеИсправления, в который попадает сеанс.
//
Функция СчетчикСеанса(Сеанс, ДатаПодключения, ДатаОтключения)

	Если ЗначениеЗаполнено(ДатаОтключения) И Сеанс.НачалоСеанса >= ДатаОтключения Тогда
		Период = "ПослеОтключения";
	ИначеЕсли ЗначениеЗаполнено(ДатаПодключения) И Сеанс.НачалоСеанса >= ДатаПодключения Тогда
		Период = "После";
	Иначе
		Период = "До";
	КонецЕсли;

	Возврат ?(Сеанс.ИмяПриложения = "BackgroundJob", "Фоновых", "Остальных") + Период;

КонецФункции

// История подключения расширений в базе по журналу регистрации. Добавление, изменение и удаление расширения
// пишет в журнал платформа, в данных события - имя, идентификатор, хеш-сумма и флажок «Подключать»
// расширения, см. ДанныеСобытияРасширения. Сборки одного исправления различаются идентификатором
// и хеш-суммой: имя у них общее. Вызывается в привилегированном режиме.
//
// Параметры:
//  НачалоПериода - Дата - журнал читается с этой даты.
//
// Возвращаемое значение:
//  Структура:
//   * Расширения	- Соответствие из КлючИЗначение: Строка, Структура - см. КлючРасширения - периоды сборки:
//      ** ДатаПодключения	- Дата - первое событие сборки с флажком «Подключать» или первое после ее отключения;
//							  начало периода - удалена, а подключена раньше; пустая - не подключалась.
//      ** ДатаОтключения	- Дата - снят флажок «Подключать» или сборка удалена после ДатаПодключения;
//							  пустая - не отключалась.
//   * Удаленные	- Соответствие из КлючИЗначение: Строка, Строка - имя расширения - см. КлючРасширения
//					  последней удаленной сборки.
//
Функция ИсторияПодключенияРасширений(НачалоПериода)

	ПустаяДата = Дата(1, 1, 1);

	События = Новый Массив;
	События.Добавить("_$InfoBase$_.DBConfigExtensionInsert");
	События.Добавить("_$InfoBase$_.DBConfigExtensionUpdate");
	События.Добавить("_$InfoBase$_.DBConfigExtensionDelete");

	Отбор = Новый Структура;
	Отбор.Вставить("ДатаНачала",	НачалоПериода);
	Отбор.Вставить("Событие",		События);

	Записи = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(Записи, Отбор, "Дата, Событие, Данные");

	История = Новый Структура("Расширения, Удаленные", Новый Соответствие, Новый Соответствие);
	Для Каждого Запись Из Записи Цикл
		Данные = ДанныеСобытияРасширения(Запись.Данные);
		Если Данные = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Ключ		= КлючРасширения(Данные.Идентификатор, Данные.ХешСумма);
		ЭтоУдаление	= СтрЗаканчиваетсяНа(Запись.Событие, ".DBConfigExtensionDelete");
		Активно		= Данные.Активно;
		Периоды		= История.Расширения.Получить(Ключ);
		Если Периоды = Неопределено Тогда
			Периоды = Новый Структура("ДатаПодключения, ДатаОтключения", ПустаяДата, ПустаяДата);
			Если Активно Тогда
				// Первое событие сборки - удаление: подключена она была раньше начала периода.
				Периоды.ДатаПодключения = ?(ЭтоУдаление, НачалоПериода, Запись.Дата);
			КонецЕсли;
			История.Расширения.Вставить(Ключ, Периоды);
		ИначеЕсли Активно И Не ЭтоУдаление И ЗначениеЗаполнено(Периоды.ДатаОтключения) Тогда
			// Снова подключена после отключения.
			Периоды.ДатаПодключения	= Запись.Дата;
			Периоды.ДатаОтключения	= ПустаяДата;
		КонецЕсли;
		Если (ЭтоУдаление Или Не Активно) И Не ЗначениеЗаполнено(Периоды.ДатаОтключения) Тогда
			Периоды.ДатаОтключения = Запись.Дата;
		КонецЕсли;
		Если ЭтоУдаление И ЗначениеЗаполнено(Данные.Имя) Тогда
			История.Удаленные.Вставить(Данные.Имя, Ключ);
		КонецЕсли;
	КонецЦикла;

	Возврат История;

КонецФункции

// Данные события журнала регистрации о добавлении, изменении или удалении расширения. Имена свойств платформа
// пишет на языке сервера: Name, UUID, HashSum, Active или Имя, УникальныйИдентификатор, ХешСумма, Активно.
// При добавлении расширения идентификатор и хеш-сумма нулевые: настоящие - в следующем за ним изменении.
//
// Параметры:
//  Данные - Произвольный - данные события.
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если в событии нет идентификатора и хеш-суммы расширения:
//   * Имя				- Строка
//   * Идентификатор	- Строка
//   * ХешСумма			- Строка
//   * Активно			- Булево - установлен флажок «Подключать».
//
Функция ДанныеСобытияРасширения(Данные)

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Имя",			"");
	Результат.Вставить("Идентификатор",	"");
	Результат.Вставить("ХешСумма",		"");
	Результат.Вставить("Активно",		Истина);

	Свойства = Новый Соответствие;
	Свойства.Вставить("Имя",			"Name, Имя");
	Свойства.Вставить("Идентификатор",	"UUID, УникальныйИдентификатор");
	Свойства.Вставить("ХешСумма",		"HashSum, ХешСумма");
	Свойства.Вставить("Активно",		"Active, Активно");
	Для Каждого Свойство Из Свойства Цикл
		Для Каждого ИмяВСобытии Из СтрРазделить(Свойство.Значение, ", ", Ложь) Цикл
			Значение = Неопределено;
			Если Данные.Свойство(ИмяВСобытии, Значение) И Значение <> Неопределено Тогда
				Результат[Свойство.Ключ] = ?(Свойство.Ключ = "Активно", Значение <> Ложь, Строка(Значение));
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если СтрЗаменить(СтрЗаменить(Результат.Идентификатор, "0", ""), "-", "") = ""
		Или СтрЗаменить(Результат.ХешСумма, "0", "") = "" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Ключ установленной сборки расширения: идентификатор объекта расширения в базе новый при каждой установке,
// хеш-сумма - у каждого содержимого своя.
//
// Параметры:
//  Идентификатор	- УникальныйИдентификатор, Строка - идентификатор расширения в базе.
//  ХешСумма		- Строка - хеш-сумма расширения шестнадцатеричной строкой.
//
// Возвращаемое значение:
//  Строка
//
Функция КлючРасширения(Идентификатор, ХешСумма)

	Возврат НРег(Строка(Идентификатор)) + " " + НРег(ХешСумма);

КонецФункции

// Разбирает тему EF-коммита, например «system-9634 EF FIRE ФРК», так же, как генератор исправлений:
// наименование - тема без кодов задач и пометок EF и FIRE.
//
// Параметры:
//  Тема			- Строка - тема коммита.
//  ИмяБиблиотеки	- Строка - библиотека, в репозитории которой исправление: код задачи - ее имя и номер.
//
// Возвращаемое значение:
//  Структура:
//   * Наименование	- Строка - тема без кодов задач и пометок.
//   * Задача		- Строка - первый код задачи из темы.
//   * Срочное		- Булево - в теме есть пометка FIRE.
//
Функция РазобратьТему(Тема, ИмяБиблиотеки)

	Результат = Новый Структура("Наименование, Задача, Срочное", "", "", Ложь);

	Слова = Новый Массив;
	Для Каждого Слово Из СтрРазделить(Тема, " ", Ложь) Цикл
		Чистое = СокрЛП(СтрЗаменить(СтрЗаменить(СтрЗаменить(Слово, ",", ""), ";", ""), ":", ""));
		Если Чистое = "EF" Тогда
			Продолжить;
		ИначеЕсли Чистое = "FIRE" Тогда
			Результат.Срочное = Истина;
			Продолжить;
		ИначеЕсли ЭтоКодЗадачи(Чистое, ИмяБиблиотеки) Тогда
			Если Не ЗначениеЗаполнено(Результат.Задача) Тогда
				Результат.Задача = Чистое;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Слова.Добавить(Слово);
	КонецЦикла;

	Наименование	= СокрЛП(СтрСоединить(Слова, " "));
	Разделители		= ",;:.-|/" + Символ(8211) + Символ(8212); // С короткими и длинными тире.
	Пока ЗначениеЗаполнено(Наименование) И СтрНайти(Разделители, Лев(Наименование, 1)) > 0 Цикл
		Наименование = СокрЛП(Сред(Наименование, 2));
	КонецЦикла;
	Пока ЗначениеЗаполнено(Наименование) И СтрНайти(Разделители, Прав(Наименование, 1)) > 0 Цикл
		Наименование = СокрЛП(Лев(Наименование, СтрДлина(Наименование) - 1));
	КонецЦикла;
	Результат.Наименование = Наименование;

	Возврат Результат;

КонецФункции

// Код задачи: имя библиотеки, дефис и номер, например system-9634.
//
// Параметры:
//  Слово			- Строка
//  ИмяБиблиотеки	- Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоКодЗадачи(Слово, ИмяБиблиотеки)

	Если Не ЗначениеЗаполнено(ИмяБиблиотеки) Или Не СтрНачинаетсяС(ВРег(Слово), ВРег(ИмяБиблиотеки) + "-") Тогда
		Возврат Ложь;
	КонецЕсли;

	Номер = Сред(Слово, СтрДлина(ИмяБиблиотеки) + 2);
	Возврат ЗначениеЗаполнено(Номер) И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Номер);

КонецФункции

// Запоминает имена срочных исправлений из оглавления репозитория библиотеки для типового списка установленных
// исправлений: в описании манифеста пометки FIRE нет.
//
// Параметры:
//  Настройки	- см. Настройки
//  Оглавление	- Соответствие из КлючИЗначение: Строка, Произвольный - оглавление репозитория.
//
Процедура ЗапомнитьСрочные(Настройки, Оглавление)

	Записи = Оглавление.Получить("patches");
	Если ТипЗнч(Записи) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Имена = Новый СписокЗначений;
	Для Каждого Запись Из Записи Цикл
		Имя = Строка(Запись.Получить("name"));
		Если Запись.Получить("revoked") = Истина Или Имена.НайтиПоЗначению(Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Запись.Получить("fire") = Истина Или РазобратьТему(Строка(Запись.Получить("description")), Настройки.ИмяБиблиотеки).Срочное Тогда
			Имена.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Имена.СортироватьПоЗначению();

	Владелец = ВладелецНастроек(Настройки.ИмяБиблиотеки);

	УстановитьПривилегированныйРежим(Истина);
	Сохраненные = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Владелец, "Срочные");
	Если ТипЗнч(Сохраненные) <> Тип("Массив")
		Или СтрСоединить(Сохраненные, ",") <> СтрСоединить(Имена.ВыгрузитьЗначения(), ",") Тогда
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Владелец, Имена.ВыгрузитьЗначения(), "Срочные");
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

