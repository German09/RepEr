// Удаляет и устанавливает исправления по плану, см. ПланИзменений.
//
// Параметры:
//  Настройки	- Структура - репозиторий, из которого скачиваются устанавливаемые исправления, см. Настройки
//				- Неопределено - план только удаляет исправления.
//  План		- см. ПланИзменений
//  Результат	- см. Синхронизировать
//
Процедура ПрименитьИзменения(Настройки, План, Результат)
	
	Удалить			= План.Удалить;
	УдалитьИмена	= План.УдалитьИмена;
	Установить		= План.Установить;
	
	Параметры									= ОбновлениеКонфигурации.ПараметрыУстановкиИсправлений();
	Параметры.ВФоне								= ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание() <> Неопределено;
	Параметры.ПроверятьПрименимостьПоМанифесту	= Истина;

	УстановитьПривилегированныйРежим(Истина);

	Если Удалить.Количество() > 0 Тогда
		Итог = ОбновлениеКонфигурации.УстановкаИУдалениеИсправлений(Новый Структура("Удалить", Удалить), Параметры);
		ДобавитьОшибки(Итог, Результат);
		Если Итог.НеУдалено = 0 Тогда
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат.Удалены, УдалитьИмена, Истина);
		КонецЕсли;
	КонецЕсли;

	Адреса = Новый Массив;
	Для Каждого Запись Из Установить Цикл
		Адрес = СкачатьАрхив(Настройки, Запись, Результат.Ошибки);
		Если Адрес <> Неопределено Тогда
			Адреса.Добавить(Адрес);
		КонецЕсли;
	КонецЦикла;
	Если Адреса.Количество() > 0 Тогда
		Итог = ОбновлениеКонфигурации.УстановкаИУдалениеИсправлений(Новый Структура("Установить", Адреса), Параметры);
		ДобавитьОшибки(Итог, Результат);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат.Установлены, Итог.Установленные, Истина);
	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Сравнивает оглавление репозитория с установленными исправлениями.
//
// Исправления ставятся по возрастанию порядка установки (поле order оглавления): если несколько исправлений
// перехватывают один метод, работает перехватчик расширения, установленного последним. Поэтому установленное
// исправление, которое по порядку идет позже устанавливаемого и перехватывает те же методы (поле methods),
// удаляется и ставится заново после него.
//
// Параметры:
//  Оглавление	- Соответствие из КлючИЗначение: Строка, Произвольный - оглавление репозитория.
//  Ошибки		- Массив из Строка - сюда добавляются ошибки.
//  Отбор		- Соответствие из КлючИЗначение: Строка, Булево - имена исправлений, которые нужно привести
//				  к репозиторию; остальные не трогаются, кроме переустановки ради порядка.
//				- Неопределено - все исправления репозитория.
//
// Возвращаемое значение:
//  Структура:
//   * Удалить			- Массив из Строка - идентификаторы исправлений к удалению.
//   * УдалитьИмена		- Массив из Строка - имена исправлений к удалению.
//   * Установить		- Массив из Произвольный - записи оглавления к установке (Соответствие), по возрастанию порядка.
//   * Актуальны		- Массив из Строка - имена исправлений репозитория, которые уже установлены.
//   * Переустановить	- Массив из Строка - имена установленных исправлений, которые ставятся заново после
//						  исправления с меньшим порядком и теми же методами.
//   * Вручную			- Массив из Строка - имена исправлений репозитория, которые не установить: расширение с таким
//						  именем установлено без описания исправления (вручную или до перезапуска после установки).
//
Функция ПланИзменений(Оглавление, Ошибки, Отбор = Неопределено)

	Записи = Оглавление.Получить("patches");
	Если ТипЗнч(Записи) <> Тип("Массив") Тогда
		Ошибки.Добавить(НСтр("ru = 'В оглавлении репозитория нет списка исправлений (patches)'"));
		Записи = Новый Массив;
	КонецЕсли;

	// Установленные исправления: по идентификатору из манифеста и по имени.
	УстановленныеПоИдентификатору	= Новый Соответствие;
	УстановленныеПоИмени			= Новый Соответствие;
	Для Каждого Установленное Из ОбновлениеКонфигурации.УстановленныеИсправления() Цикл
		Идентификатор = ?(Установленное.Идентификатор = Неопределено, "", НРег(Строка(Установленное.Идентификатор)));
		Если ЗначениеЗаполнено(Идентификатор) Тогда
			УстановленныеПоИдентификатору.Вставить(Идентификатор, Установленное.Наименование);
		КонецЕсли;
		УстановленныеПоИмени.Вставить(Установленное.Наименование, Идентификатор);
	КонецЦикла;

	План = Новый Структура;
	План.Вставить("Удалить",		Новый Массив);
	План.Вставить("УдалитьИмена",	Новый Массив);
	План.Вставить("Установить",		Новый Массив);
	План.Вставить("Актуальны",		Новый Массив);
	План.Вставить("Переустановить",	Новый Массив);
	План.Вставить("Вручную",		Новый Массив);

	// Отозванные сборки удаляются, текущие разбираются по возрастанию порядка установки.
	Текущие = Новый ТаблицаЗначений;
	Текущие.Колонки.Добавить("Порядок",	Новый ОписаниеТипов("Число"));
	Текущие.Колонки.Добавить("Номер",	Новый ОписаниеТипов("Число"));
	Текущие.Колонки.Добавить("Запись");
	Для Каждого Запись Из Записи Цикл
		Идентификатор	= НРег(Строка(Запись.Получить("uuid")));
		Имя				= Строка(Запись.Получить("name"));
		Если Запись.Получить("revoked") = Истина Тогда
			Если (Отбор = Неопределено Или Отбор.Получить(Имя) <> Неопределено)
				И УстановленныеПоИдентификатору.Получить(Идентификатор) <> Неопределено Тогда
				План.Удалить.Добавить(Идентификатор);
				План.УдалитьИмена.Добавить(Имя);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Текущая			= Текущие.Добавить();
		Текущая.Порядок	= ПорядокУстановки(Запись);
		Текущая.Номер	= Текущие.Количество();
		Текущая.Запись	= Запись;
	КонецЦикла;
	Текущие.Сортировать("Порядок, Номер");

	// Методы исправлений, которые ставятся в этой синхронизации, - для поиска установленных исправлений,
	// которые нужно переустановить после них.
	Устанавливаемые = Новый Соответствие;
	Для Каждого Текущая Из Текущие Цикл
		Запись			= Текущая.Запись;
		Идентификатор	= НРег(Строка(Запись.Получить("uuid")));
		Имя				= Строка(Запись.Получить("name"));
		Если УстановленныеПоИдентификатору.Получить(Идентификатор) <> Неопределено Тогда
			// Эта сборка уже установлена.
			Если Не ПерехватываетТеЖеМетоды(Запись, Устанавливаемые) Тогда
				План.Актуальны.Добавить(Имя);
				Продолжить;
			КонецЕсли;
			// Раньше по порядку ставится исправление с теми же методами: переустановить эту сборку после него,
			// чтобы ее перехватчики работали поверх.
			План.Удалить.Добавить(Идентификатор);
			План.УдалитьИмена.Добавить(Имя);
			План.Переустановить.Добавить(Имя);
		Иначе
			Если Отбор <> Неопределено И Отбор.Получить(Имя) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ИдентификаторУстановленного = УстановленныеПоИмени.Получить(Имя);
			Если ИдентификаторУстановленного = "" Тогда
				План.Вручную.Добавить(Имя);
				Продолжить;
			ИначеЕсли ИдентификаторУстановленного <> Неопределено Тогда
				// Установлена прежняя сборка этого исправления: удалить ее перед установкой новой.
				План.Удалить.Добавить(ИдентификаторУстановленного);
				План.УдалитьИмена.Добавить(Имя);
			КонецЕсли;
		КонецЕсли;
		План.Установить.Добавить(Запись);
		ДобавитьМетоды(Устанавливаемые, Запись);
	КонецЦикла;

	Возврат План;

КонецФункции

// Порядок установки исправления: поле order записи оглавления; в записях, опубликованных до его появления, - 0.
//
// Параметры:
//  Запись - Соответствие из КлючИЗначение: Строка, Произвольный - запись оглавления репозитория.
//
// Возвращаемое значение:
//  Число
//
Функция ПорядокУстановки(Запись)

	Порядок = Запись.Получить("order");
	Возврат ?(ТипЗнч(Порядок) = Тип("Число"), Число(Порядок), 0);

КонецФункции

// Добавляет методы, которые перехватывает и добавляет исправление (поле methods записи оглавления).
//
// Параметры:
//  Методы - Соответствие из КлючИЗначение: Строка, Булево - метод в нижнем регистре; ключ «*» - у какого-то
//           исправления список методов неизвестен.
//  Запись - Соответствие из КлючИЗначение: Строка, Произвольный - запись оглавления репозитория.
//
Процедура ДобавитьМетоды(Методы, Запись)

	Список = Запись.Получить("methods");
	Если ТипЗнч(Список) <> Тип("Массив") Тогда
		Методы.Вставить("*", Истина);
		Возврат;
	КонецЕсли;
	Для Каждого Метод Из Список Цикл
		Методы.Вставить(НРег(Метод), Истина);
	КонецЦикла;

КонецПроцедуры

// Определяет, перехватывает ли исправление какой-то из методов. Если список методов неизвестен - считается,
// что перехватывает.
//
// Параметры:
//  Запись - Соответствие из КлючИЗначение: Строка, Произвольный - запись оглавления репозитория.
//  Методы - см. ДобавитьМетоды.Методы
//
// Возвращаемое значение:
//  Булево
//
Функция ПерехватываетТеЖеМетоды(Запись, Методы)

	Если Методы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Список = Запись.Получить("methods");
	Если ТипЗнч(Список) <> Тип("Массив") Или Методы.Получить("*") <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого Метод Из Список Цикл
		Если Методы.Получить(НРег(Метод)) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ДобавитьОшибки(Итог, Результат)
	
	Для Каждого Ошибка Из Итог.Ошибки Цикл
		Результат.Ошибки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1 %2: %3'"), Ошибка.Событие, Ошибка.НомерПатча, Ошибка.Причина));
	КонецЦикла;
	
КонецПроцедуры

// Читает оглавление репозитория для версии библиотеки и запоминает срочные исправления.
//
// Параметры:
//  Настройки	- см. Настройки
//  Ошибки		- Массив из Строка - сюда добавляются ошибки.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение: Строка, Произвольный - оглавление репозитория.
//  Неопределено - оглавление не получено.
//
Функция Оглавление(Настройки, Ошибки)
	
	Оглавление = Неопределено;
	
	Ответ = ВыполнитьЗапрос(Настройки, Настройки.Версия + "/index.json");
	Если Ответ.КодСостояния = 404 Тогда
		// Для этой версии исправлений еще не публиковали.
		Оглавление = Новый Соответствие;
		Оглавление.Вставить("patches", Новый Массив);
	ИначеЕсли Ответ.КодСостояния <> 200 Тогда
		Ошибки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось получить оглавление репозитория %1: %2'"), Настройки.Версия, Ответ.Описание));
	Иначе
		Попытка
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(ПолучитьСтрокуИзДвоичныхДанных(Ответ.Тело, КодировкаТекста.UTF8));
			Оглавление = ПрочитатьJSON(Чтение, Истина);
			Чтение.Закрыть();
			ЗапомнитьСрочные(Настройки, Оглавление);
		Исключение
			Ошибки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Оглавление репозитория %1 не разобрано: %2'"), Настройки.Версия,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
	КонецЕсли;
	
	Возврат Оглавление;
	
КонецФункции

// Скачивает архив исправления, сверяет контрольную сумму и помещает его во временное хранилище.
//
Функция СкачатьАрхив(Настройки, Запись, Ошибки)
	
	Адрес = Неопределено;
	
	ИмяФайла	= Строка(Запись.Получить("file"));
	Ответ		= ВыполнитьЗапрос(Настройки, Настройки.Версия + "/" + КодироватьСтроку(ИмяФайла, СпособКодированияСтроки.КодировкаURL));
	Если Ответ.КодСостояния <> 200 Тогда
		Ошибки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось скачать %1: %2'"), ИмяФайла, Ответ.Описание));
	Иначе
		Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
		Хеширование.Добавить(Ответ.Тело);
		Сумма = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
		Если Сумма <> НРег(Строка(Запись.Получить("sha256"))) Тогда
			Ошибки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Контрольная сумма %1 не совпала с оглавлением репозитория'"), ИмяФайла));
		Иначе
			Адрес = ПоместитьВоВременноеХранилище(Ответ.Тело, Новый УникальныйИдентификатор);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Адрес;
	
КонецФункции

// Адрес страницы версии пакета репозитория в GitLab, например https://<сервер>/<группа>/<проект>/-/packages/123.
//
// Параметры:
//  Настройки - см. Настройки
//
// Возвращаемое значение:
//  Строка - адрес страницы версии; если его узнать не удалось - адрес страницы пакетов проекта или пустая строка.
//
Функция СтраницаВерсии(Настройки)
	
	// Если страницу версии узнать не удалось (например, токену не разрешен список пакетов),
	// ведем на страницу пакетов проекта.
	АдресПроекта		= АдресПроекта(Настройки.Адрес);
	СтраницаПоУмолчанию	= ?(ЗначениеЗаполнено(АдресПроекта), АдресПроекта + "/-/packages", "");
	
	Ответ = ВыполнитьЗапрос(Настройки, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		"packages?package_type=generic&package_name=%1&package_version=%2",
		ИмяПакета(), КодироватьСтроку(Настройки.Версия, СпособКодированияСтроки.КодировкаURL)), Истина);
	Если Ответ.КодСостояния <> 200 Тогда
		Возврат СтраницаПоУмолчанию;
	КонецЕсли;
	
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ПолучитьСтрокуИзДвоичныхДанных(Ответ.Тело, КодировкаТекста.UTF8));
		Пакеты = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Возврат СтраницаПоУмолчанию;
	КонецПопытки;
	
	Если ТипЗнч(Пакеты) <> Тип("Массив") Тогда
		Возврат СтраницаПоУмолчанию;
	КонецЕсли;
	
	// Отбор package_name в API нестрогий, поэтому имя и версия сверяются точно.
	СтруктураURI = ОбщегоНазначенияКлиентСервер.СтруктураURI(АдресAPI(Настройки.Адрес));
	Для Каждого Пакет Из Пакеты Цикл
		Ссылки = Пакет.Получить("_links");
		Если Пакет.Получить("name") <> ИмяПакета() Или Пакет.Получить("version") <> Настройки.Версия
			Или ТипЗнч(Ссылки) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		ПутьНаСайте = Ссылки.Получить("web_path");
		Если ЗначениеЗаполнено(ПутьНаСайте) Тогда
			Возврат СтруктураURI.Схема + "://" + СтруктураURI.ИмяСервера + ПутьНаСайте;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтраницаПоУмолчанию;
	
КонецФункции

// Выполняет GET к репозиторию.
//
// Параметры:
//  Настройки	- см. Настройки
//  Путь		- Строка - путь относительно адреса пакета репозитория или, если ОтПроекта, относительно проекта в API.
//  ОтПроекта	- Булево - путь задан от проекта: .../api/v4/projects/<проект>/<Путь>.
//
// Возвращаемое значение:
//  Структура:
//   * КодСостояния	- Число - код ответа HTTP, 0 - ошибка соединения.
//   * Тело			- ДвоичныеДанные, Неопределено - тело ответа.
//   * Описание		- Строка - описание ошибки.
//
Функция ВыполнитьЗапрос(Настройки, Путь, ОтПроекта = Ложь)
	
	Ответ = Новый Структура("КодСостояния, Тело, Описание", 0, Неопределено, "");
	
	СтруктураURI			= ОбщегоНазначенияКлиентСервер.СтруктураURI(АдресAPI(Настройки.Адрес));
	ЗащищенноеСоединение	= ?(НРег(СтруктураURI.Схема) = "https",
		Новый ЗащищенноеСоединениеOpenSSL(, Новый СертификатыУдостоверяющихЦентровОС), Неопределено);
	Пользователь	= ?(ЗначениеЗаполнено(Настройки.Пользователь), Настройки.Пользователь, "");
	Пароль			= ?(ЗначениеЗаполнено(Настройки.Пользователь), Настройки.Токен, "");
	
	ПутьНаСервере	= "/" + СокрЛП(СтруктураURI.ПутьНаСервере);
	ПутьНаСервере	= СтрЗаменить(ПутьНаСервере, "//", "/");
	Если Не СтрЗаканчиваетсяНа(ПутьНаСервере, "/") Тогда
		ПутьНаСервере = ПутьНаСервере + "/";
	КонецЕсли;
	Если ОтПроекта Тогда
		Позиция = СтрНайти(ПутьНаСервере, "/packages/generic/");
		Если Позиция > 0 Тогда
			ПутьНаСервере = Лев(ПутьНаСервере, Позиция);
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		Соединение = Новый HTTPСоединение(СтруктураURI.Хост, СтруктураURI.Порт, Пользователь, Пароль,, 60,
			ЗащищенноеСоединение);
		Запрос = Новый HTTPЗапрос(ПутьНаСервере + Путь);
		Если Не ЗначениеЗаполнено(Настройки.Пользователь) Тогда
			Запрос.Заголовки.Вставить("PRIVATE-TOKEN", Настройки.Токен);
		КонецЕсли;
		HTTPОтвет			= Соединение.Получить(Запрос);
		Ответ.КодСостояния	= HTTPОтвет.КодСостояния;
		Ответ.Тело			= HTTPОтвет.ПолучитьТелоКакДвоичныеДанные();
		Если Ответ.КодСостояния <> 200 Тогда
			Ответ.Описание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'код ответа %1'"), Ответ.КодСостояния);
		КонецЕсли;
	Исключение
		Ответ.Описание = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции

// Адрес пакета репозитория в API GitLab. В настройках задается адрес репозитория,
// например https://gitlab.domain.ru/user/release, он преобразуется в
// https://gitlab.domain.ru/api/v4/projects/user%2Frelease/packages/generic/ef.
// Адрес API в настройках используется как есть.
//
// Параметры:
//  Адрес - Строка - адрес из настроек репозитория.
//
// Возвращаемое значение:
//  Строка
//
Функция АдресAPI(Знач Адрес)

	АдресПроекта = АдресПроекта(Адрес);
	Если Не ЗначениеЗаполнено(АдресПроекта) Тогда
		Возврат СокрЛП(Адрес);
	КонецЕсли;

	СтруктураURI	= ОбщегоНазначенияКлиентСервер.СтруктураURI(АдресПроекта);
	ПутьПроекта		= СтрЗаменить(СокрЛП(СтруктураURI.ПутьНаСервере), "/", "%2F");

	Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1://%2/api/v4/projects/%3/packages/generic/%4",
		СтруктураURI.Схема, СтруктураURI.ИмяСервера, ПутьПроекта, ИмяПакета());

КонецФункции

// Адрес репозитория на сайте GitLab, например https://gitlab.domain.ru/user/release.
// Принимает адрес репозитория, в том числе с окончанием .git или /-/packages.
//
// Параметры:
//  Адрес - Строка - адрес из настроек репозитория.
//
// Возвращаемое значение:
//  Строка - адрес репозитория без завершающей косой черты или пустая строка, если задан адрес API.
//
Функция АдресПроекта(Знач Адрес) Экспорт

	Адрес = СокрЛП(Адрес);
	Если Не ЗначениеЗаполнено(Адрес) Или СтрНайти(Адрес, "/api/v4/") > 0 Тогда
		Возврат "";
	КонецЕсли;

	Позиция = СтрНайти(Адрес, "/-/");
	Если Позиция > 0 Тогда
		Адрес = Лев(Адрес, Позиция - 1);
	КонецЕсли;
	Пока СтрЗаканчиваетсяНа(Адрес, "/") Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;
	Если СтрЗаканчиваетсяНа(НРег(Адрес), ".git") Тогда
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 4);
	КонецЕсли;

	Возврат Адрес;

КонецФункции

// Имя generic-пакета репозитория в реестре пакетов проекта: то же, что в переменной EF_FEED_URL файла .gitlab-ci.yml.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяПакета()
	
	Возврат "ef";
	
КонецФункции

// Параметры:
//  ИмяБиблиотеки - Строка - имя библиотеки из описаний подсистем.
//
// Возвращаемое значение:
//  Структура:
//   * ИмяБиблиотеки	- Строка - имя библиотеки, по версии которой выбирается каталог репозитория.
//   * Версия			- Строка - версия библиотеки, она же каталог репозитория.
//   * Адрес			- Строка
//   * Токен			- Строка
//   * Пользователь		- Строка
//
Функция Настройки(ИмяБиблиотеки)

	Результат = Новый Структура;
	Результат.Вставить("ИмяБиблиотеки",	Строка(ИмяБиблиотеки));
	Результат.Вставить("Версия",		ВерсияБиблиотеки(ИмяБиблиотеки));
	Результат.Вставить("Адрес",			"");
	Результат.Вставить("Токен",			"");
	Результат.Вставить("Пользователь",	"");

	УстановитьПривилегированныйРежим(Истина);
	Сохраненные = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВладелецНастроек(ИмяБиблиотеки),
		"Адрес, Токен, Пользователь");
	УстановитьПривилегированныйРежим(Ложь);

	Если ТипЗнч(Сохраненные) = Тип("Структура") Тогда
		Для Каждого КлючИЗначение Из Сохраненные Цикл
			Если ЗначениеЗаполнено(КлючИЗначение.Значение) Тогда
				Результат[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Библиотеки, для которых задан адрес репозитория, в порядке настройки. Библиотеки, которых больше нет
// в описаниях подсистем, пропускаются.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция НастроенныеБиблиотеки()

	УстановитьПривилегированныйРежим(Истина);
	Сохраненные = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВладелецНастроек(), "Библиотеки");
	УстановитьПривилегированныйРежим(Ложь);

	Библиотеки = Новый Массив;
	Если ТипЗнч(Сохраненные) = Тип("Массив") Тогда
		Для Каждого ИмяБиблиотеки Из Сохраненные Цикл
			Если ЗначениеЗаполнено(ВерсияБиблиотеки(ИмяБиблиотеки)) Тогда
				Библиотеки.Добавить(ИмяБиблиотеки);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Библиотеки;

КонецФункции

// Версия библиотеки из описания подсистем, например 1.3.19.01. По ней выбирается каталог репозитория:
// исправления собираются под версию релиза и к другой версии не подходят.
//
// Параметры:
//  ИмяБиблиотеки - Строка
//
// Возвращаемое значение:
//  Строка - версия или пустая строка, если библиотеки нет в описаниях подсистем.
//
Функция ВерсияБиблиотеки(ИмяБиблиотеки)

	Описание = СтандартныеПодсистемыПовтИсп.ОписанияПодсистем().ПоИменам.Получить(ИмяБиблиотеки);
	Возврат ?(Описание = Неопределено, "", Описание.Версия);

КонецФункции

Процедура ПроверитьПравоАдминистрирования()
	
	Если Не Пользователи.ЭтоПолноправныйПользователь(, Истина) Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для настройки репозитория исправлений'");
	КонецЕсли;
	
КонецПроцедуры

// Владелец данных в безопасном хранилище: общий - для списка настроенных библиотек,
// с именем библиотеки - для настроек ее репозитория. Ключ «ЛентаИсправлений_CFR» - прежнее имя модуля:
// под ним уже сохранены настройки в базах, менять его нельзя.
//
// Параметры:
//  ИмяБиблиотеки - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ВладелецНастроек(ИмяБиблиотеки = "")

	Возврат "ЛентаИсправлений_CFR" + ?(ЗначениеЗаполнено(ИмяБиблиотеки), "." + ИмяБиблиотеки, "");

КонецФункции

Функция СобытиеЖурнала()
	
	Возврат НСтр("ru = 'Репозиторий исправлений'", ОбщегоНазначения.КодОсновногоЯзыка());
	
КонецФункции

#КонецОбласти
