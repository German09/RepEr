#Область ОбработчикиСобытийФормы

// Список обновляется после установки или удаления исправлений в обработке ИсправленияИзРепозитория_RepEr.
//
// Параметры:
//  ИмяСобытия	- Строка
//  Параметр	- Произвольный
//  Источник	- Произвольный
//
&НаКлиенте
Процедура ОбработкаОповещения_RepEr(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзмененыИсправления_RepEr" Тогда
		ОбновитьСписокИсправлений();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
&После("ПриСозданииНаСервере")
Процедура ПриСозданииНаСервере_RepEr(Отказ, СтандартнаяОбработка)

	РепозиторийДоступен_RepEr = РепозиторийИсправлений_RepEr.РепозиторийДоступен();
	Если Не РепозиторийДоступен_RepEr Тогда
		Возврат;
	КонецЕсли;

	// Ссылка ведет в репозиторий исправлений: она работает и при подключении через веб-сервер,
	// так как исправления загружаются и устанавливаются на сервере.
	Элементы.ПоискИУстановкаОбновлений.Видимость						= Не Параметры.ПриОбновлении;
	Элементы.ПоискИУстановкаОбновлений.Заголовок						= НСтр("ru = 'Поиск и установка исправлений'");
	Элементы.ПоискИУстановкаОбновленийРасширеннаяПодсказка.Заголовок	= РепозиторийИсправлений_RepEr.ПредставлениеИсточника();

КонецПроцедуры

&НаКлиенте
&Вместо("ПоискИУстановкаОбновлений")
Процедура ПоискИУстановкаОбновлений_RepEr(Команда)

	Если Не РепозиторийДоступен_RepEr Тогда
		ПродолжитьВызов(Команда);
		Возврат;
	КонецЕсли;

	ОткрытьФорму("Обработка.ИсправленияИзРепозитория_RepEr.Форма",, ЭтотОбъект);

КонецПроцедуры

// Помечает срочные исправления (FIRE) картинкой огня СрочноеИсправление_RepEr: по имени расширения
// и по пометке FIRE в репозитории, см. РепозиторийИсправлений_RepEr.СрочныеИсправления
//
&НаСервере
&После("ОбновитьСписокИсправлений")
Процедура ОбновитьСписокИсправлений_RepEr()
	
	Срочные = РепозиторийИсправлений_RepEr.СрочныеИсправления();
	Для Каждого Исправление Из УстановленныеИсправления Цикл
		Исправление.Срочное_RepEr = РепозиторийИсправлений_RepEr.КартинкаСрочного(Исправление.Имя, Срочные);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
