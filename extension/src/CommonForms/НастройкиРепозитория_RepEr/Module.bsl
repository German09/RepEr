///////////////////////////////////////////////////////////////////////////////////////////////////////
// Настройки репозиториев исправлений: для выбранной библиотеки - адрес пакета GitLab и токен,
// общие - автоматическая загрузка типовым регламентным заданием, см. РепозиторийИсправлений_RepEr.ВключитьЗагрузку
// Сохраненный токен в форму не передается: пустое поле токена
// оставляет его без изменений. Пустой адрес отключает репозиторий библиотеки.
//
// Возвращает при закрытии Истина, если настройки записаны.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Настройки				= ЗагрузитьНастройкиБиблиотеки("");
	ЗагрузкаПоРасписанию	= Настройки.ЗагрузкаПоРасписанию;
	Расписание				= Настройки.Расписание;

	ОбновитьПредставлениеРасписания(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура БиблиотекаПриИзменении(Элемент)

	БиблиотекаПриИзмененииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура АдресПриИзменении(Элемент)
	
	ОбновитьПодсказки();
	
КонецПроцедуры

&НаКлиенте
Процедура АдресОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если ПустаяСтрока(Адрес) Тогда
		Возврат;
	КонецЕсли;
	ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(СокрЛП(Адрес));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузкаПоРасписаниюПриИзменении(Элемент)

	ОбновитьПредставлениеРасписания(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)

	Если ПустаяСтрока(Библиотека) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Выберите библиотеку.'"),, "Библиотека");
		Возврат;
	КонецЕсли;

	ЗаписатьНастройки();
	Закрыть(Истина);

КонецПроцедуры

&НаКлиенте
Процедура НастроитьРасписание(Команда)
	
	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(Расписание);
	Диалог.Показать(Новый ОписаниеОповещения("ПослеИзмененияРасписания", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодключение(Команда)

	Результат = ПроверитьПодключениеНаСервере();
	ПоказатьПредупреждение(, Результат.Описание);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет список библиотек и настройки репозитория библиотеки. Несохраненные изменения адреса и токена
// при смене библиотеки не переносятся.
//
// Параметры:
//  ИмяБиблиотеки - Строка - библиотека; пустая строка - выбрать по умолчанию, см. РепозиторийИсправлений_RepEr.НастройкиДляФормы
//
// Возвращаемое значение:
//  см. РепозиторийИсправлений_RepEr.НастройкиДляФормы
//
&НаСервере
Функция ЗагрузитьНастройкиБиблиотеки(ИмяБиблиотеки)

	Настройки = РепозиторийИсправлений_RepEr.НастройкиДляФормы(ИмяБиблиотеки);

	СписокВыбора = Элементы.Библиотека.СписокВыбора;
	СписокВыбора.Очистить();
	Для Каждого Описание Из Настройки.Библиотеки Цикл
		Представление = Описание.Имя + " " + Описание.Версия
			+ ?(Описание.Настроена, " - " + НСтр("ru = 'репозиторий настроен'"), "");
		СписокВыбора.Добавить(Описание.Имя, Представление);
	КонецЦикла;

	Библиотека						= Настройки.ИмяБиблиотеки;
	Адрес							= Настройки.Адрес;
	Пользователь					= Настройки.Пользователь;
	Токен							= "";
	Элементы.Токен.ПодсказкаВвода	= ?(Настройки.ТокенСохранен,
		НСтр("ru = 'Сохранен. Оставьте пустым, чтобы не менять'"), "");

	ОбновитьПодсказки();

	Возврат Настройки;

КонецФункции

&НаСервере
Процедура БиблиотекаПриИзмененииНаСервере()

	ЗагрузитьНастройкиБиблиотеки(Библиотека);

КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройки()

	РепозиторийИсправлений_RepEr.УстановитьНастройки(Библиотека, СокрЛП(Адрес), НовыйТокен(), СокрЛП(Пользователь));
	РепозиторийИсправлений_RepEr.ВключитьЗагрузку(ЗагрузкаПоРасписанию, Расписание);
	Токен = "";

КонецПроцедуры

&НаСервере
Функция ПроверитьПодключениеНаСервере()

	Возврат РепозиторийИсправлений_RepEr.ПроверитьПодключение(Библиотека, СокрЛП(Адрес), НовыйТокен(), СокрЛП(Пользователь));

КонецФункции

// Возвращаемое значение:
//  Строка, Неопределено - введенный токен или Неопределено, если поле пустое (оставить сохраненный).
//
&НаСервере
Функция НовыйТокен()

	Возврат ?(ПустаяСтрока(Токен), Неопределено, СокрЛП(Токен));

КонецФункции

// Параметры:
//  НовоеРасписание			- РасписаниеРегламентногоЗадания, Неопределено - результат типового диалога расписания.
//  ДополнительныеПараметры	- Неопределено
//
&НаКлиенте
Процедура ПослеИзмененияРасписания(НовоеРасписание, ДополнительныеПараметры) Экспорт
	
	Если НовоеРасписание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Расписание				= НовоеРасписание;
	ЗагрузкаПоРасписанию	= Истина;
	ОбновитьПредставлениеРасписания(ЭтотОбъект);
	
КонецПроцедуры

// Как в типовой панели администрирования: представление расписания с заглавной буквы.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПредставлениеРасписания(Форма)
	
	Форма.Элементы.НастроитьРасписание.Доступность = Форма.ЗагрузкаПоРасписанию;
	Если Форма.ЗагрузкаПоРасписанию И Форма.Расписание <> Неопределено Тогда
		РасписаниеПредставление	= Строка(Форма.Расписание);
		Представление			= ВРег(Лев(РасписаниеПредставление, 1)) + Сред(РасписаниеПредставление, 2);
	Иначе
		Представление = "";
	КонецЕсли;
	Форма.Элементы.РасписаниеПояснение.Заголовок = Представление;
	
КонецПроцедуры

// Подсказки к адресу и токену: названия страниц GitLab в них - ссылки на эти страницы репозитория.
//
&НаСервере
Процедура ОбновитьПодсказки()
	
	АдресПроекта = РепозиторийИсправлений_RepEr.АдресПроекта(Адрес);
	
	Элементы.АдресРасширеннаяПодсказка.Заголовок = Новый ФорматированнаяСтрока(
		НСтр("ru = 'Адрес репозитория в GitLab: исправления лежат в его реестре пакетов ('"),
		СсылкаНаСтраницуПроекта("Deploy - Package Registry", АдресПроекта, "/-/packages"),
		НСтр("ru = '). Можно указать и адрес пакета в API: https://<сервер GitLab>/api/v4/projects/<ID проекта>/packages/generic/ef.
		|Пустой адрес отключает репозиторий библиотеки.'"));
	
	Элементы.ТокенРасширеннаяПодсказка.Заголовок = Новый ФорматированнаяСтрока(
		НСтр("ru = 'Как получить: в GitLab откройте проект - Settings - Repository -'") + " ",
		СсылкаНаСтраницуПроекта("Deploy tokens", АдресПроекта, "/-/settings/repository#js-deploy-tokens"),
		НСтр("ru = ' - Add token, отметьте только read_package_registry и нажмите Create deploy token.
		|Имя пользователя и токен показываются один раз - сразу скопируйте их сюда.
		|Можно также токен доступа проекта (Settings -'") + " ",
		СсылкаНаСтраницуПроекта("Access tokens", АдресПроекта, "/-/settings/access_tokens"),
		НСтр("ru = ', scope read_api) - тогда пользователь не нужен.'"));
	
КонецПроцедуры

// Возвращаемое значение:
//  ФорматированнаяСтрока - ссылка на страницу проекта или текст без ссылки, если адрес проекта неизвестен.
//
&НаСервереБезКонтекста
Функция СсылкаНаСтраницуПроекта(Текст, АдресПроекта, Путь)
	
	Если ПустаяСтрока(АдресПроекта) Тогда
		Возврат Новый ФорматированнаяСтрока(Текст);
	КонецЕсли;
	
	Возврат Новый ФорматированнаяСтрока(Текст,,,, АдресПроекта + Путь);
	
КонецФункции

#КонецОбласти
