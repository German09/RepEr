///////////////////////////////////////////////////////////////////////////////////////////////////////
// Настройки репозитория исправлений: лента читается через RepEr, в которую база отправляет ошибки - адрес
// из настроек обработки ошибок, здесь только библиотека, пользователь и пароль RepEr; общие - автоматическая
// загрузка типовым регламентным заданием, см. РепозиторийИсправлений_RepEr.ВключитьЗагрузку
// Сохраненный пароль в форму не передается: пустое поле пароля оставляет его без изменений.
//
// Возвращает при закрытии Истина, если настройки записаны.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Настройки				= ЗагрузитьНастройкиБиблиотеки("");
	ЗагрузкаПоРасписанию	= Настройки.ЗагрузкаПоРасписанию;
	Расписание				= Настройки.Расписание;

	ОбновитьПредставлениеРасписания(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура БиблиотекаПриИзменении(Элемент)

	БиблиотекаПриИзмененииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура АдресОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка	= Ложь;
	Публикация				= ПубликацияRepEr(Адрес);
	Если ЗначениеЗаполнено(Публикация) Тогда
		ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(Публикация);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузкаПоРасписаниюПриИзменении(Элемент)

	ОбновитьПредставлениеРасписания(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)

	Если ПустаяСтрока(Библиотека) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Выберите библиотеку.'"),, "Библиотека");
		Возврат;
	КонецЕсли;

	ЗаписатьНастройки();
	Закрыть(Истина);

КонецПроцедуры

&НаКлиенте
Процедура НастроитьРасписание(Команда)
	
	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(Расписание);
	Диалог.Показать(Новый ОписаниеОповещения("ПослеИзмененияРасписания", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодключение(Команда)

	Результат = ПроверитьПодключениеНаСервере();
	ПоказатьПредупреждение(, Результат.Описание);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет список библиотек и настройки репозитория. Несохраненные пользователь и пароль при смене
// библиотеки не переносятся.
//
// Параметры:
//  ИмяБиблиотеки - Строка - библиотека; пустая строка - выбрать по умолчанию, см. РепозиторийИсправлений_RepEr.НастройкиДляФормы
//
// Возвращаемое значение:
//  см. РепозиторийИсправлений_RepEr.НастройкиДляФормы
//
&НаСервере
Функция ЗагрузитьНастройкиБиблиотеки(ИмяБиблиотеки)

	Настройки = РепозиторийИсправлений_RepEr.НастройкиДляФормы(ИмяБиблиотеки);

	СписокВыбора = Элементы.Библиотека.СписокВыбора;
	СписокВыбора.Очистить();
	Для Каждого Описание Из Настройки.Библиотеки Цикл
		Представление = Описание.Имя + " " + Описание.Версия
			+ ?(Описание.Настроена, " - " + НСтр("ru = 'репозиторий настроен'"), "");
		СписокВыбора.Добавить(Описание.Имя, Представление);
	КонецЦикла;

	Библиотека						= Настройки.ИмяБиблиотеки;
	Адрес							= Настройки.Адрес;
	Пользователь					= Настройки.Пользователь;
	Пароль							= "";
	Элементы.Пароль.ПодсказкаВвода	= ?(Настройки.ПарольСохранен,
		НСтр("ru = 'Сохранен. Оставьте пустым, чтобы не менять'"), "");
	// Библиотека с именем, как код базы в RepEr, используется всегда: другую не выбрать.
	Элементы.Библиотека.ТолькоПросмотр = Настройки.БиблиотекаПоКоду;

	ОбновитьПодсказки(Настройки);

	Возврат Настройки;

КонецФункции

&НаСервере
Процедура БиблиотекаПриИзмененииНаСервере()

	ЗагрузитьНастройкиБиблиотеки(Библиотека);

КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройки()

	РепозиторийИсправлений_RepEr.УстановитьНастройки(Библиотека, СокрЛП(Пользователь), НовыйПароль());
	РепозиторийИсправлений_RepEr.ВключитьЗагрузку(ЗагрузкаПоРасписанию, Расписание);
	Пароль = "";

КонецПроцедуры

&НаСервере
Функция ПроверитьПодключениеНаСервере()

	Возврат РепозиторийИсправлений_RepEr.ПроверитьПодключение(Библиотека, СокрЛП(Пользователь), НовыйПароль());

КонецФункции

// Возвращаемое значение:
//  Строка, Неопределено - введенный пароль или Неопределено, если поле пустое (оставить сохраненный).
//
&НаСервере
Функция НовыйПароль()

	Возврат ?(ПустаяСтрока(Пароль), Неопределено, Пароль);

КонецФункции

// Параметры:
//  НовоеРасписание			- РасписаниеРегламентногоЗадания, Неопределено - результат типового диалога расписания.
//  ДополнительныеПараметры	- Неопределено
//
&НаКлиенте
Процедура ПослеИзмененияРасписания(НовоеРасписание, ДополнительныеПараметры) Экспорт
	
	Если НовоеРасписание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Расписание				= НовоеРасписание;
	ЗагрузкаПоРасписанию	= Истина;
	ОбновитьПредставлениеРасписания(ЭтотОбъект);
	
КонецПроцедуры

// Как в типовой панели администрирования: представление расписания с заглавной буквы.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПредставлениеРасписания(Форма)
	
	Форма.Элементы.НастроитьРасписание.Доступность = Форма.ЗагрузкаПоРасписанию;
	Если Форма.ЗагрузкаПоРасписанию И Форма.Расписание <> Неопределено Тогда
		РасписаниеПредставление	= Строка(Форма.Расписание);
		Представление			= ВРег(Лев(РасписаниеПредставление, 1)) + Сред(РасписаниеПредставление, 2);
	Иначе
		Представление = "";
	КонецЕсли;
	Форма.Элементы.РасписаниеПояснение.Заголовок = Представление;
	
КонецПроцедуры

// Подсказки к адресу, библиотеке и пользователю: откуда адрес RepEr, по чему выбрана библиотека,
// ссылка на список пользователей RepEr.
//
// Параметры:
//  Настройки - см. РепозиторийИсправлений_RepEr.НастройкиДляФормы
//
&НаСервере
Процедура ОбновитьПодсказки(Настройки)
	
	Элементы.АдресРасширеннаяПодсказка.Заголовок = Настройки.ОписаниеАдреса;
	
	ПодсказкаБиблиотеки = НСтр("ru = 'Библиотека из версий подсистем: по ее версии выбирается каталог ленты исправлений, код задачи - имя библиотеки и номер.'");
	Если Настройки.БиблиотекаПоКоду Тогда
		ПодсказкаБиблиотеки = ПодсказкаБиблиотеки + " " + НСтр("ru = 'Выбрана по коду базы в RepEr.'");
	КонецЕсли;
	Элементы.БиблиотекаРасширеннаяПодсказка.Заголовок = ПодсказкаБиблиотеки;
	
	Публикация = ПубликацияRepEr(Адрес);
	Элементы.ПользовательРасширеннаяПодсказка.Заголовок = Новый ФорматированнаяСтрока(
		НСтр("ru = 'Пользователь RepEr с ролью «Получение исправлений и пользователей ошибок»'") + " (",
		СсылкаНаСтраницу(НСтр("ru = 'пользователи RepEr'"), Публикация, "/#e1cib/list/Справочник.Пользователи"),
		НСтр("ru = '): от его имени база читает ленту исправлений и число пользователей с ошибками по задачам.
		|Доступ к GitLab базе не нужен: токен проекта - в настройке подключения в RepEr.'"));
	
КонецПроцедуры

// Адрес публикации RepEr, по нему открывается веб-клиент: часть адреса сервиса до /hs/.
//
// Параметры:
//  АдресСервиса - Строка - адрес HTTP-сервиса RepEr.
//
// Возвращаемое значение:
//  Строка - пустая строка, если адреса нет.
//
&НаКлиентеНаСервереБезКонтекста
Функция ПубликацияRepEr(АдресСервиса)
	
	Позиция = СтрНайти(НРег(АдресСервиса), "/hs/");
	Возврат ?(Позиция > 0, Лев(АдресСервиса, Позиция - 1), "");
	
КонецФункции

// Возвращаемое значение:
//  ФорматированнаяСтрока - ссылка на страницу RepEr или текст без ссылки, если адрес RepEr неизвестен.
//
&НаСервереБезКонтекста
Функция СсылкаНаСтраницу(Текст, Публикация, Путь)
	
	Если ПустаяСтрока(Публикация) Тогда
		Возврат Новый ФорматированнаяСтрока(Текст);
	КонецЕсли;
	
	Возврат Новый ФорматированнаяСтрока(Текст,,,, Публикация + Путь);
	
КонецФункции

#КонецОбласти
