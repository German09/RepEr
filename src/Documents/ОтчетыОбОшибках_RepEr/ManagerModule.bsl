#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

// Добавить.
// 
// Параметры:
//  ДанныеОбОтчете - см. РегламентныеОперацииПолныеПрава_RepEr.ПолучитьОтчеты
// 
// Возвращаемое значение:
//  ДокументСсылка.ОтчетыОбОшибках_RepEr - Добавить
Функция Добавить(ДанныеОбОтчете) Экспорт
	
	ДанныеОтчета = ДанныеОбОтчете.Содержимое.Получить();
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(".zip");
	ДанныеОтчета.Записать(ИмяВременногоФайла);
	
	Архиватор = Новый ЧтениеZipФайла(ИмяВременногоФайла);
	
	ВременныйКаталог = Новый Массив;
	ВременныйКаталог.Добавить(КаталогВременныхФайлов());
	ВременныйКаталог.Добавить("ОбработкаПолученныхОтчетовОбОшибках");
	ВременныйКаталог.Добавить(ДанныеОбОтчете.Идентификатор);
	ВременныйКаталог = СтрСоединить(ВременныйКаталог, "\");
	
	Архиватор.ИзвлечьВсе(ВременныйКаталог);
	Архиватор.Закрыть();
	УдалитьФайлы(ИмяВременногоФайла);
	
	ИмяОсновногоФайла = СтрШаблон("%1\%2", ВременныйКаталог, "report.json");
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.Прочитать(ИмяОсновногоФайла, КодировкаТекста.UTF8);
	
	ТекстОсновногоФайла = ТекстовыйДокумент.ПолучитьТекст();
	
	// парсить json и смотреть имена файлов и скринов
	СтруктураОшибки = ОбщегоНазначения_RepEr.СтрокаJSONВЗначение(ТекстОсновногоФайла);
	
	СсылкаНаОтчет = ПолучитьСсылку(ДанныеОбОтчете.Идентификатор);
	ОтчетОбОшибке = СсылкаНаОтчет.ПолучитьОбъект();
	
	Если ОтчетОбОшибке = Неопределено Тогда
		ОтчетОбОшибке = СоздатьДокумент();
		ОтчетОбОшибке.УстановитьСсылкуНового(СсылкаНаОтчет);
	КонецЕсли;
	
	ОтчетОбОшибке.ТекстОтчета 			= ТекстОсновногоФайла;
	ОтчетОбОшибке.Дата 					= ДанныеОбОтчете.Дата;
	ОтчетОбОшибке.ИнформационнаяБаза	= ДанныеОбОтчете.ИнформационнаяБаза;

	Для Каждого элемОшибки Из СтруктураОшибки Цикл
		
		Если элемОшибки.Ключ = "time" Тогда
			ОтчетОбОшибке.ВремяОшибки = СтруктураОшибки.time;
			Продолжить;// в описания добавлять не будем
		КонецЕсли;
		
		#Область Скриншоты
		Если элемОшибки.Ключ = "screenshot" Тогда		
			Если ТипЗнч(элемОшибки.Значение) = Тип("Структура") Тогда			
				ОтчетОбОшибке.Скриншоты.Очистить();			
				Для Каждого КиЗ Из элемОшибки.Значение Цикл				
					НовСтр = ОтчетОбОшибке.Скриншоты.Добавить();				
					ИмяФайлаСкриншота = СтрШаблон("%1\%2", ВременныйКаталог, КиЗ.Значение);				
					НовСтр.Имя 				= КиЗ.Значение;				
					лФайл = Новый Файл(ИмяФайлаСкриншота);
					НовСтр.Расширение 		= лФайл.Расширение;
					НовСтр.Размер 			= лФайл.Размер();
					НовСтр.ДанныеХранилища 	= Новый ХранилищеЗначения(Новый ДвоичныеДанные(ИмяФайлаСкриншота), Новый СжатиеДанных(9));				
				КонецЦикла;			
			КонецЕсли;			
			Продолжить;		
		КонецЕсли;
		#КонецОбласти
		
		#Область Файлы
		Если элемОшибки.Ключ = "additionalFiles" Тогда		
			Если ТипЗнч(элемОшибки.Значение) = Тип("Массив") Тогда			
				ОтчетОбОшибке.Файлы.Очистить();			
				Для Каждого элемФайл Из элемОшибки.Значение Цикл					
					НовСтр = ОтчетОбОшибке.Файлы.Добавить();					
					ИмяФайлаФайла = СтрШаблон("%1\%2", ВременныйКаталог, элемФайл);					
					НовСтр.Имя 			= элемФайл;					
					лФайл = Новый Файл(ИмяФайлаФайла);
					НовСтр.Расширение 		= лФайл.Расширение;
					НовСтр.Размер 			= лФайл.Размер();					
					НовСтр.ДанныеХранилища 	= Новый ХранилищеЗначения(Новый ДвоичныеДанные(ИмяФайлаФайла), Новый СжатиеДанных(9));					
				КонецЦикла;				
			КонецЕсли;			
			Продолжить;			
		КонецЕсли;
		#КонецОбласти
		
		Если элемОшибки.Ключ = "errorInfo" Тогда
			ЗаполнитьИнфоОбОшибке(ОтчетОбОшибке, элемОшибки.Значение);
			Для Каждого СтрОшибки ИЗ ОтчетОбОшибке.Ошибки Цикл
				Если СтрОшибки.Тип = "ScriptUseError"  Тогда
					Если ПустаяСтрока(ОтчетОбОшибке.Наименование) Тогда
						ОтчетОбОшибке.Наименование = СтрОшибки.Ошибка;
						//Более серьезных ошибок не было добавим только эту
						Прервать; //перевемся чтобы болльше ничего к ней не добавлять
					Иначе
						//это причина ошибки, оставлять только его нельзя добавим ее к уже текущему наименованию
						ОтчетОбОшибке.Наименование = СтрШаблон("%1 %2",ОтчетОбОшибке.Наименование,СтрОшибки.Ошибка);
					КонецЕсли;			
				ИначеЕсли СтрОшибки.Тип = ОбщегоНазначенияКлиентСервер_RepEr.ПрограмнаяОшибка() Тогда	
					ОтчетОбОшибке.Наименование = УдалитьВсеЧислаВСкобках(СтрОшибки.Ошибка);
				Иначе
					Если ПустаяСтрока(ОтчетОбОшибке.Наименование) Тогда
						ОтчетОбОшибке.Наименование = СтрОшибки.Ошибка;
						//Более серьезных ошибок не было добавим только эту
						Прервать; //перевемся чтобы болльше ничего к ней не добавлять
					КонецЕсли;	 	
				КонецЕсли;	
			КонецЦикла;	
		ИначеЕсли элемОшибки.Ключ = "sessionInfo" Тогда
			Если ТипЗнч(элемОшибки.Значение) = Тип("Структура") И элемОшибки.Значение.Свойство("userName") Тогда
				ОтчетОбОшибке.Пользователь 	= элемОшибки.Значение.userName;
			КонецЕсли;
		ИначеЕсли элемОшибки.Ключ = "configInfo" Тогда
			Если ТипЗнч(элемОшибки.Значение) = Тип("Структура") Тогда
				элемОшибки.Значение.Свойство("hash",ОтчетОбОшибке.configHash);
			КонецЕсли;	
		КонецЕсли;	 
	КонецЦикла;
	
	ОтчетОбОшибке.Основание = ПолучитьДокументОснование(ОтчетОбОшибке);
	
	УдалитьФайлы(ВременныйКаталог);
	
	ОтчетОбОшибке.Записать();
	
	Возврат ОтчетОбОшибке.Ссылка;
КонецФункции

// Функция удаляет содержимое между скобками, если оно является числом.
// 
// Параметры:
//  ИсходнаяСтрока - Строка - исходная строка, из которой необходимо удалить число в скобках.
//
// Возвращаемое значение:
//  Строка - строка с удаленным числом в скобках, если содержимое между скобками является числом;
//           исходная строка, если содержимое между скобками не является числом или скобки не найдены.
//
Функция УдалитьВсеЧислаВСкобках(ИсходнаяСтрока)Экспорт
	Результат = ИсходнаяСтрока;
	Пока Истина Цикл
        СледСтрока = СтрЗаменитьПоРегулярномуВыражению(ИсходнаяСтрока, "\(\d+\)\}", "}");
        Если СледСтрока = Результат Тогда 
            Прервать;
        КонецЕсли;
        Результат = СледСтрока;
    КонецЦикла;
	Возврат Результат;
КонецФункции

// Уникальные пользователи, сообщившие об ошибках, зарегистрированных под задачами.
// Задача связана с корневым отчетом (без основания), повторные отчеты ссылаются на него через Основание.
// 
// Параметры:
//  Идентификаторы 		- Массив из Строка - Ключи задач, например PROJECT-123, из регистра см. РегистрСведений.КлючиОповещений_RepEx
//  ИнформационнаяБаза 	- СправочникСсылка.ИнформационныеБазы_RepEr - База, в которой возникали ошибки
// 
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - Есть элемент для каждого переданного ключа:
//  * Ключ 		- Строка - Ключ задачи без пробелов в верхнем регистре
//  * Значение 	- Массив из Строка - Имена пользователей по возрастанию, пустой если задача не найдена
Функция ПользователиЗадач(Идентификаторы, ИнформационнаяБаза) Экспорт
	Результат = Новый Соответствие;
	Для Каждого Идентификатор ИЗ Идентификаторы Цикл
		Результат.Вставить(ВРег(СокрЛП(Идентификатор)), Новый Массив);
	КонецЦикла;
	
	КлючиЗадач = Новый Массив;
	Для Каждого КлючИЗначение ИЗ Результат Цикл
		КлючиЗадач.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КлючиОповещений.Идентификатор КАК Идентификатор,
		|	КлючиОповещений.Регистратор КАК Ссылка
		|ПОМЕСТИТЬ ВТЗадачи
		|ИЗ
		|	РегистрСведений.КлючиОповещений_RepEx КАК КлючиОповещений
		|ГДЕ
		|	КлючиОповещений.Идентификатор В(&Идентификаторы)
		|	И КлючиОповещений.Регистратор.Основание = ЗНАЧЕНИЕ(Документ.ОтчетыОбОшибках_RepEr.ПустаяСсылка)
		|	И КлючиОповещений.Регистратор.ИнформационнаяБаза = &ИнформационнаяБаза
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВложенныйЗапрос.Идентификатор КАК Идентификатор,
		|	ВложенныйЗапрос.Пользователь КАК Пользователь
		|ИЗ
		|	(ВЫБРАТЬ
		|		Задачи.Идентификатор КАК Идентификатор,
		|		Отчеты.Пользователь КАК Пользователь
		|	ИЗ
		|		ВТЗадачи КАК Задачи
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтчетыОбОшибках_RepEr КАК Отчеты
		|			ПО (Отчеты.Ссылка = Задачи.Ссылка)
		|	ГДЕ
		|		НЕ Отчеты.ПометкаУдаления
		|		И Отчеты.Пользователь <> """"
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		Задачи.Идентификатор,
		|		Отчеты.Пользователь
		|	ИЗ
		|		ВТЗадачи КАК Задачи
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтчетыОбОшибках_RepEr КАК Отчеты
		|			ПО (Отчеты.Основание = Задачи.Ссылка)
		|	ГДЕ
		|		НЕ Отчеты.ПометкаУдаления
		|		И Отчеты.Пользователь <> """") КАК ВложенныйЗапрос
		|
		|УПОРЯДОЧИТЬ ПО
		|	Идентификатор,
		|	Пользователь";
	
	Запрос.УстановитьПараметр("Идентификаторы", 		КлючиЗадач);
	Запрос.УстановитьПараметр("ИнформационнаяБаза", 	ИнформационнаяБаза);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ИменаПользователей = Результат.Получить(ВРег(Выборка.Идентификатор)); //Массив из Строка, Неопределено
		Если ИменаПользователей <> Неопределено Тогда
			ИменаПользователей.Добавить(Выборка.Пользователь);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

// Внешняя ссылка, которая открывает в базе, приславшей отчет, журнал регистрации
// по пользователю отчета за время ошибки +/- 10 минут.
// Адрес базы - ключ ib дополнительной информации отчета (общие настройки обработки ошибок базы),
// адрес публикации базы на веб-сервере, например {"guid":"...","ib":"https://server/base"}.
// В базе должно стоять расширение RepEr: ссылку разбирает его общая команда ЖурналРегистрацииПоОшибке_RepEr.
// 
// Параметры:
//  Отчет - ДокументСсылка.ОтчетыОбОшибках_RepEr
// 
// Возвращаемое значение:
//  Строка - пустая, если в отчете нет адреса базы, пользователя или времени ошибки
Функция СсылкаНаЖурналРегистрации(Отчет) Экспорт
	
	Результат = "";
	Интервал  = 10 * 60;
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Отчет, "ТекстОтчета,Пользователь,ВремяОшибки");
	АдресБазы = АдресИнформационнойБазы(Реквизиты.ТекстОтчета);
	Если ЗначениеЗаполнено(АдресБазы)
		И ЗначениеЗаполнено(Реквизиты.Пользователь)
		И ЗначениеЗаполнено(Реквизиты.ВремяОшибки) Тогда
		
		Данные = Новый Массив;
		Данные.Добавить(Формат(Реквизиты.ВремяОшибки - Интервал, "ДФ=yyyyMMddHHmmss"));
		Данные.Добавить(Формат(Реквизиты.ВремяОшибки + Интервал, "ДФ=yyyyMMddHHmmss"));
		Данные.Добавить(Реквизиты.Пользователь);
		Результат = СтрШаблон("%1#e1cib/command/ОбщаяКоманда.ЖурналРегистрацииПоОшибке_RepEr?cmdprm=%2",
			АдресБазы, ПараметрКомандыИзСтроки(СтрСоединить(Данные)));
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Адрес информационной базы из дополнительной информации отчета.
// 
// Параметры:
//  ТекстОтчета - Строка - report.json
//              - Неопределено - отчета нет
// 
// Возвращаемое значение:
//  Строка - значение ключа ib, пустая, если его нет
Функция АдресИнформационнойБазы(ТекстОтчета)
	
	Результат = "";
	
	Если ТипЗнч(ТекстОтчета) = Тип("Строка") И СтрНайти(ТекстОтчета, "additionalInfo") > 0 Тогда
		// Дополнительную информацию администратор базы вводит руками: в ней может быть не JSON
		Попытка
			СтруктураОтчета = ОбщегоНазначения_RepEr.СтрокаJSONВЗначение(ТекстОтчета);
			ДополнительнаяИнформация = ОбщегоНазначения_RepEr.СтрокаJSONВЗначение(СтруктураОтчета.additionalInfo);
			Если ТипЗнч(ДополнительнаяИнформация) = Тип("Структура")
				И ДополнительнаяИнформация.Свойство("ib")
				И ТипЗнч(ДополнительнаяИнформация.ib) = Тип("Строка") Тогда
				Результат = СокрЛП(ДополнительнаяИнформация.ib);
			КонецЕсли;
		Исключение
			Результат = "";
		КонецПопытки;
	КонецЕсли;
	
	Пока СтрЗаканчиваетсяНа(Результат, "#") Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Параметр команды в навигационной ссылке, в котором записана строка.
// Платформа передает в команду по ссылке только ссылки, поэтому строка в UTF-8 записывается
// шестнадцатеричными цифрами по 32 в уникальные идентификаторы несуществующих пользователей,
// хвост дополняется нулями. В ссылке цифры идентификатора идут в порядке хранения:
// 4-я и 5-я группы, затем 3-я, 2-я и 1-я.
// 
// Параметры:
//  Данные - Строка
// 
// Возвращаемое значение:
//  Строка - СправочникСсылка.Пользователи:<32 цифры>,...
Функция ПараметрКомандыИзСтроки(Данные)
	
	ДлинаИдентификатора = 32;
	
	Цифры = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(
		ПолучитьДвоичныеДанныеИзСтроки(Данные, КодировкаТекста.UTF8, Ложь)));
	Остаток = СтрДлина(Цифры) % ДлинаИдентификатора;
	Если Остаток > 0 Тогда
		Цифры = Цифры + СтроковыеФункцииКлиентСервер.СформироватьСтрокуСимволов("0", ДлинаИдентификатора - Остаток);
	КонецЕсли;
	
	Ссылки = Новый Массив;
	Для Номер = 0 По СтрДлина(Цифры) / ДлинаИдентификатора - 1 Цикл
		Идентификатор = Сред(Цифры, Номер * ДлинаИдентификатора + 1, ДлинаИдентификатора);
		Ссылки.Добавить("СправочникСсылка.Пользователи:"
			+ Сред(Идентификатор, 17, 16) + Сред(Идентификатор, 13, 4) + Сред(Идентификатор, 9, 4) + Лев(Идентификатор, 8));
	КонецЦикла;
	
	Возврат СтрСоединить(Ссылки, ",");
	
КонецФункции

// Получить документ основание.
// 
// Параметры:
//  ОтчетОбОшибке - ДокументОбъект.ОтчетыОбОшибках_RepEr - Отчет об ошибке
// 
// Возвращаемое значение:
// 	ДокументСсылка.ОтчетыОбОшибках_RepEr		 
Функция ПолучитьДокументОснование(ОтчетОбОшибке) Экспорт 
	ВыборкаДетальныеЗаписи = ОбщегоНазначения_RepEr.ПолучитьВыборкуОтчетов(ОтчетОбОшибке);	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;	
	КонецЕсли;
КонецФункции

// Заполнить стек.
// 
// Параметры:
//  ОтчетОбОшибке 	- ДокументОбъект.ОтчетыОбОшибках_RepEr
//  errorInfo 		- Структура:
//		*userDescription - Строка -
//		*systemErrorInfo - Структура:
//			**clientStackHash - Строка
//			**serverStackHash - Строка
//		*applicationErrorInfo - Структура:
//			**stackHash - Строка
//			**errors - Массив  Из Строка
//			**stack - Массив Из Строка
Процедура ЗаполнитьИнфоОбОшибке(ОтчетОбОшибке, errorInfo) Экспорт
	Перем systemErrorInfo,applicationErrorInfo,errors,stack;
	Если ТипЗнч(errorInfo) = Тип("Структура") Тогда
		errorInfo.Свойство("userDescription",ОтчетОбОшибке.Пояснение); 
		Если errorInfo.Свойство("systemErrorInfo",systemErrorInfo) Тогда
			systemErrorInfo.Свойство("clientStackHash",ОтчетОбОшибке.clientStackHash);	
			systemErrorInfo.Свойство("serverStackHash",ОтчетОбОшибке.serverStackHash);	
		КонецЕсли;
		//заполним stackHash
		Если errorInfo.Свойство("applicationErrorInfo",applicationErrorInfo) Тогда
			applicationErrorInfo.Свойство("stackHash",ОтчетОбОшибке.appStackHash);		
			Если applicationErrorInfo.Свойство("errors",errors) Тогда
				ОтчетОбОшибке.Ошибки.Очистить();
				Для Каждого Ошибка ИЗ errors Цикл
					Если ТипЗнч(Ошибка) = Тип("Массив") Тогда
						Если Ошибка.Количество() Тогда
							Если Не ПустаяСтрока(Ошибка.Получить(0)) Тогда
								СтрокаОшибки  = ОтчетОбОшибке.Ошибки.Добавить();
								//0 это содержание ошибки
								СтрокаОшибки.Ошибка = ОбщегоНазначенияКлиентСервер.УдалитьНедопустимыеСимволыXML(Ошибка.Получить(0));
								Если Ошибка.ВГраница() Тогда
									//1 массив типов	
									Для Каждого ТипОшибки ИЗ Ошибка.Получить(1)	Цикл
										СтрокаОшибки.Тип = ТипОшибки;
										Прервать; 	
									КонецЦикла;	
								КонецЕсли;
							КонецЕсли;			
						КонецЕсли;	
					КонецЕсли;			
				КонецЦикла;
			КонецЕсли;
			Если applicationErrorInfo.Свойство("stack",stack) Тогда
				ОтчетОбОшибке.Стек.Очистить();
				Для Каждого Стек ИЗ stack Цикл
					Если ТипЗнч(Стек) = Тип("Массив") Тогда
						Если Стек.Количество() Тогда
							СтрокаСтека  = ОтчетОбОшибке.Стек.Добавить();
							ИмяМодуля = Стек.Получить(0);
							ПозицияПробела = СтрНайти(ИмяМодуля, " ");
							Если ПозицияПробела > 0 Тогда
								СтрокаСтека.Расширение = Лев(ИмяМодуля, ПозицияПробела - 1);
								СтрокаСтека.Модуль = Сред(ИмяМодуля, ПозицияПробела + 1);
							Иначе
								СтрокаСтека.Модуль = ИмяМодуля;
							КонецЕсли;
							Если Стек.ВГраница() > 0 Тогда
								СтрокаСтека.НомерСтрокиМодуля = Стек.Получить(1);
								Если Стек.ВГраница() > 1 Тогда
									СтрокаСтека.СтрокаМодуля = СокрЛП(Стек.Получить(2));	
								КонецЕсли;	
							КонецЕсли;		
						КонецЕсли;	
					КонецЕсли;			
				КонецЦикла;
			КонецЕсли;			
		КонецЕсли;					
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецЕсли

	
