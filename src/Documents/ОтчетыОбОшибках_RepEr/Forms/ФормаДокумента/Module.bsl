
&НаСервере
Функция ПолучитьАдресХранилища(НомерСтроки, ИмяТаблицы)

	мОбъект = РеквизитФормыВЗначение("Объект");
	
	стрХранилища = мОбъект[ИмяТаблицы].Получить(НомерСтроки - 1);

	Возврат ПоместитьВоВременноеХранилище(стрХранилища.ДанныеХранилища.Получить(), ЭтаФорма.УникальныйИдентификатор);

КонецФункции

&НаКлиенте
Процедура СкриншотыПриАктивизацииСтроки(Элемент)
	
	текДанные = Элементы.Скриншоты.ТекущиеДанные;
	
	Если текДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(текДанные.АдресХранилища) Тогда
		текДанные.АдресХранилища = ПолучитьАдресХранилища(текДанные.НомерСтроки, "Скриншоты");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(Объект.clientStackHash) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Ошибки, "clientStackHash", 	Объект.clientStackHash);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Отчеты, "clientStackHash", 	Объект.clientStackHash);
	КонецЕсли;		
	Если ЗначениеЗаполнено(Объект.serverStackHash) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Ошибки, "serverStackHash", 	Объект.serverStackHash);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Отчеты, "serverStackHash", 	Объект.serverStackHash);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.appStackHash) Тогда		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Ошибки, "appStackHash", 	Объект.appStackHash);	
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Отчеты, "appStackHash", 	Объект.appStackHash);
	КонецЕсли;		
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Отчеты, "Ссылка", 			Объект.Ссылка, ВидСравненияКомпоновкиДанных.НеРавно);	
КонецПроцедуры

&НаКлиенте
Процедура ФайлыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	текДанные = Элементы.Файлы.ТекущиеДанные;
	
	Если текДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(текДанные.АдресХранилища) Тогда
		текДанные.АдресХранилища = ПолучитьАдресХранилища(текДанные.НомерСтроки, "Файлы");
	КонецЕсли;
	
	НачатьПолучениеФайлаССервера(текДанные.АдресХранилища, текДанные.Имя);
	
КонецПроцедуры
