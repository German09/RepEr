#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Оповещать = Истина;	
	Если 	ЗначениеЗаполнено(ИнформационнаяБаза) И 
			Не БлокировкаРаботыСВнешнимиРесурсами.РаботаСВнешнимиРесурсамиЗаблокирована() Тогда
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИнформационнаяБаза,"Исключения,Оповещения");	
		Для Каждого Искл ИЗ Реквизиты.Исключения.Выгрузить() Цикл
			Если СтрНайти(нРег(ТекстОтчета),нРег(Искл.Ошибка)) Тогда
				Оповещать = Ложь; //этот текс об ошибке содержит стоп слова - о них не будем оповещать
				Прервать;
			КонецЕсли;		
		КонецЦикла;
		Если Оповещать Тогда 
			Для Каждого Способ ИЗ Реквизиты.Оповещения.Выгрузить() Цикл
				Если Способ.Использовать Тогда
					Если ЭтоНовый() ИЛИ Неопределено = РегистрыСведений.КлючиОповещений_RepEx.ПолучитьЗапись(Ссылка, Способ.ТипОповещения, Способ.НастройкаПодключения) Тогда
						Обработчик = Оповещения_RepEr.ПолучитьОбработчик(Способ.ТипОповещения);
						Если Не Обработчик	= Неопределено Тогда
							Попытка 
								Результат = Обработчик.Зарегистрировать(Способ.НастройкаПодключения,Ссылка);
							Исключение 
								Результат = Новый Структура("Ошибка",ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
							КонецПопытки;		
							Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
								ОбщегоНазначения.СообщитьПользователю(Результат.Ошибка,Ссылка, , ,Отказ);
								Прервать;
							Иначе
								//тут сфомируем движения
								РегистрыСведений.КлючиОповещений_RepEx.ЗаписатьКлюч(Ссылка,Способ.ТипОповещения,Способ.НастройкаПодключения,Результат.Идентификатор);		
							КонецЕсли;	
						КонецЕсли;
					Иначе
						//запись уже существует просто обновим ее
						НаборЗписей = РегистрыСведений.КлючиОповещений_RepEx.ПолучитьНабор(Ссылка); 	
						Для Каждого Запись ИЗ НаборЗписей Цикл
							Обработчик = Оповещения_RepEr.ПолучитьОбработчик(Запись.ТипОповещения);
							Если Не Обработчик	= Неопределено Тогда
								Попытка 
									Результат = Обработчик.ОбновитьРегистрацию(Запись.НастройкаПодключения,Ссылка,Запись.Идентификатор);
								Исключение 
									Результат = Новый Структура("Ошибка",ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
								КонецПопытки;		
								Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
									ОбщегоНазначения.СообщитьПользователю(Результат.Ошибка,Ссылка, , ,Отказ);
									Прервать;
								КонецЕсли;	
							КонецЕсли;	
						КонецЦикла;
					КонецЕсли;			
				КонецЕсли;		
			КонецЦикла;	
		КонецЕсли;		
	КонецЕсли;	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	Если БлокировкаРаботыСВнешнимиРесурсами.РаботаСВнешнимиРесурсамиЗаблокирована() Тогда
		Отказ = Истина;
	Иначе	
		УдаляемыеЗаписи = Новый Массив;
		НаборЗписей = РегистрыСведений.КлючиОповещений_RepEx.ПолучитьНабор(Ссылка); 	
		Для Каждого Запись ИЗ НаборЗписей Цикл
			Обработчик = Оповещения_RepEr.ПолучитьОбработчик(Запись.ТипОповещения);
			Если Не Обработчик	= Неопределено Тогда
				Попытка 
					Результат = Обработчик.ОтменитьРегистрацию(Запись.НастройкаПодключения,Ссылка,Запись.Идентификатор);
				Исключение 
					Результат = Новый Структура("Ошибка",ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				КонецПопытки;		
				Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
					ОбщегоНазначения.СообщитьПользователю(Результат.Ошибка,Ссылка, , ,Отказ);
				Иначе
					УдаляемыеЗаписи.Добавить(Запись);	
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;
		Для Каждого удЗапись ИЗ  УдаляемыеЗаписи Цикл
			НаборЗписей.Удалить(удЗапись);		
		КонецЦикла;
		НаборЗписей.Записать(Истина);
	КонецЕсли;		
КонецПроцедуры


#КонецОбласти

#КонецЕсли
