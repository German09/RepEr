#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)	
	Если Не ЗначениеЗаполнено(Основание) Тогда
		//только для тех у кого не заполнено основание
		Если 	ЗначениеЗаполнено(ИнформационнаяБаза) И 
				Не БлокировкаРаботыСВнешнимиРесурсами.РаботаСВнешнимиРесурсамиЗаблокирована() Тогда
			Для Каждого Способ ИЗ ИнформационнаяБаза.Оповещения Цикл
				Если Способ.Использовать Тогда
					Если ЭтоНовый() ИЛИ Неопределено = РегистрыСведений.КлючиОповещений_RepEx.ПолучитьЗапись(Ссылка, Способ.ТипОповещения, Способ.НастройкаПодключения) Тогда
						Обработчик = ОповещенияПереопредСервер_RepEr.ПолучитьОбработчик(Способ.ТипОповещения);
						Если Не Обработчик	= Неопределено Тогда
							Попытка 
								Результат = Обработчик.Зарегистрировать(Способ.НастройкаПодключения,Ссылка);
							Исключение 
								Результат = Новый Структура("Ошибка",ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
							КонецПопытки;		
							Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
								ОбщегоНазначения.СообщитьПользователю(Результат.Ошибка,Ссылка, , ,Отказ);
								Прервать;
							Иначе
								//тут сфомируем движения
								РегистрыСведений.КлючиОповещений_RepEx.ЗаписатьКлюч(Ссылка,Способ.ТипОповещения,Способ.НастройкаПодключения,Результат.Идентификатор);		
							КонецЕсли;	
						КонецЕсли;
					Иначе
						//запись уже существует, создавать ее не будем
					КонецЕсли;			
				КонецЕсли;		
			КонецЦикла;		
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	Если БлокировкаРаботыСВнешнимиРесурсами.РаботаСВнешнимиРесурсамиЗаблокирована() Тогда
		Отказ = Истина;
	Иначе	
		мУдаляемыхЗаписей = Новый Массив;
		НаборЗписей = РегистрыСведений.КлючиОповещений_RepEx.ПолучитьНабор(Ссылка); 	
		Для Каждого Запись ИЗ НаборЗписей Цикл
			Обработчик = ОповещенияПереопредСервер_RepEr.ПолучитьОбработчик(Запись.ТипОповещения);
			Если Не Обработчик	= Неопределено Тогда
				Попытка 
					Результат = Обработчик.ОтменитьРегистрацию(Запись.НастройкаПодключения,Запись.Идентификатор);
				Исключение 
					Результат = Новый Структура("Ошибка",ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				КонецПопытки;		
				Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
					ОбщегоНазначения.СообщитьПользователю(Результат.Ошибка,Ссылка, , ,Отказ);
				Иначе
					мУдаляемыхЗаписей.Добавить(Запись);	
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;
		Для Каждого удЗапись ИЗ  мУдаляемыхЗаписей Цикл
			НаборЗписей.Удалить(удЗапись);		
		КонецЦикла;
		НаборЗписей.Записать(Истина);
	КонецЕсли;		
КонецПроцедуры


#КонецОбласти

