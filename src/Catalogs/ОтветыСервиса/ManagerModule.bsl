
Функция ПолучитьОтвет(спрОтвет, КодЯзыка = "", ЯзыкПоУмолчанию = "") Экспорт
	
	мЯзыкПоУмолчанию = ЯзыкПоУмолчанию;
	Если Не ЗначениеЗаполнено(мЯзыкПоУмолчанию) Тогда
		
		мЯзыкПоУмолчанию = Константы.ОсновнойЯзык.Получить();
		
		Если Не ЗначениеЗаполнено(мЯзыкПоУмолчанию) Тогда
			
			мЯзыкПоУмолчанию = ОбщегоНазначенияЛоггерПовтИсп.КодЯзыкаЕслиВсёПусто();
			
		КонецЕсли;
		
	КонецЕсли;
	
	мКодЯзыка = КодЯзыка;
	
	Если Не ЗначениеЗаполнено(мКодЯзыка) Тогда
			
		мКодЯзыка = мЯзыкПоУмолчанию;
			
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"		, спрОтвет);
	Запрос.УстановитьПараметр("КодЯзыка"	, мКодЯзыка);
	Запрос.УстановитьПараметр("КодЯзыкаУм"	, мЯзыкПоУмолчанию);
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Влож.Сообщение КАК Сообщение
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		1 КАК Порядок,
	               |		ОтветыСервисаПолучитьИнформацию.Сообщение КАК Сообщение
	               |	ИЗ
	               |		Справочник.ОтветыСервиса.ПолучитьИнформацию КАК ОтветыСервисаПолучитьИнформацию
	               |	ГДЕ
	               |		ОтветыСервисаПолучитьИнформацию.Ссылка = &Ссылка
	               |		И ОтветыСервисаПолучитьИнформацию.КодЯзыка = &КодЯзыка
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		2,
	               |		ОтветыСервисаПолучитьИнформацию.Сообщение
	               |	ИЗ
	               |		Справочник.ОтветыСервиса.ПолучитьИнформацию КАК ОтветыСервисаПолучитьИнформацию
	               |	ГДЕ
	               |		ОтветыСервисаПолучитьИнформацию.Ссылка = &Ссылка
	               |		И ОтветыСервисаПолучитьИнформацию.КодЯзыка = &КодЯзыкаУм) КАК Влож
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Влож.Порядок";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Выборка.Сообщение;
	
КонецФункции