///////////////////////////////////////////////////////////////////////////////////////////////////////
// Настройка подключения к Jira, GitHub или GitLab, как настройки репозитория в расширении RepEr:
// провайдер, ссылка на проект и токен. Адрес сервиса и проект заполняются по ссылке при записи
// см. Справочник.НастройкиПодключений_RepEx.МодульОбъекта.ПередЗаписью
// Сохраненный секрет в форму не передается: пустое поле оставляет его без изменений.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не ЗначениеЗаполнено(Объект.СсылкаНаПроект) Тогда
		//настройка записана до появления ссылки на проект
		Объект.СсылкаНаПроект = Справочники.НастройкиПодключений_RepEx.СсылкаНаПроектПоРеквизитам(Объект.Провайдер,
			Объект.Адрес, Объект.Проект, Объект.Логин);
	КонецЕсли;
	Если Не ТолькоПросмотр И Не Объект.Ссылка.Пустая() Тогда
		УстановитьПривилегированныйРежим(Истина);
		СекретСохранен = ЗначениеЗаполнено(Справочники.НастройкиПодключений_RepEx.Секрет(Объект.Ссылка));
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	НастроитьЭлементы();
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	Если Не СекретСохранен И ПустаяСтрока(Секрет) Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Поле ""%1"" не заполнено'"), Элементы.Секрет.Заголовок);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,, "Секрет",, Отказ);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	Если Не ПустаяСтрока(Секрет) Тогда
		УстановитьПривилегированныйРежим(Истина);
		Справочники.НастройкиПодключений_RepEx.ЗаписатьСекрет(ТекущийОбъект.Ссылка, СокрЛП(Секрет));
		УстановитьПривилегированныйРежим(Ложь);
		Секрет 			= "";
		СекретСохранен 	= Истина;
	КонецЕсли;
	НастроитьЭлементы();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПровайдерПриИзменении(Элемент)
	НастроитьЭлементыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СсылкаНаПроектПриИзменении(Элемент)
	НастроитьЭлементыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СсылкаНаПроектОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если Не ПустаяСтрока(Объект.СсылкаНаПроект) Тогда
		ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(СокрЛП(Объект.СсылкаНаПроект));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЛогинПриИзменении(Элемент)
	НастроитьЗаголовокСекрета(Элементы, Объект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьПодключение(Команда)
	Результат = ПроверитьПодключениеНаСервере();
	ПоказатьПредупреждение(, Результат.Описание);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура НастроитьЭлементыНаСервере()
	НастроитьЭлементы();
КонецПроцедуры

// Состав полей и подсказки под провайдер: путь к исходникам - только у репозиториев, по нему ищутся
// файлы модулей; пользователь - только у Jira, для авторизации по паролю.
&НаСервере
Процедура НастроитьЭлементы()
	ЭтоJira 		= Объект.Провайдер = Перечисления.Провайдер_RepEx.Jira;
	ЭтоРепозиторий 	= Объект.Провайдер = Перечисления.Провайдер_RepEx.GitHub
		Или Объект.Провайдер = Перечисления.Провайдер_RepEx.GitLab;
	
	Элементы.ПутьКИсходникам.Видимость 		= ЭтоРепозиторий;
	Элементы.Логин.Видимость 				= ЭтоJira;
	Элементы.СсылкаНаПроект.ПодсказкаВвода 	= Справочники.НастройкиПодключений_RepEx.ПримерСсылкиНаПроект(Объект.Провайдер);
	Элементы.Секрет.ПодсказкаВвода 			= ?(СекретСохранен, НСтр("ru = 'Сохранен. Оставьте пустым, чтобы не менять'"), "");
	
	НастроитьЗаголовокСекрета(Элементы, Объект);
	ОбновитьПодсказки();
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьЗаголовокСекрета(Элементы, Объект)
	ПоПаролю 					= Объект.Провайдер = ПредопределенноеЗначение("Перечисление.Провайдер_RepEx.Jira")
		И ЗначениеЗаполнено(Объект.Логин);
	Элементы.Секрет.Заголовок 	= ?(ПоПаролю, НСтр("ru = 'Пароль'"), НСтр("ru = 'Токен'"));
КонецПроцедуры

// Подсказки к ссылке и токену: названия страниц сервиса в них - ссылки на эти страницы.
&НаСервере
Процедура ОбновитьПодсказки()
	Реквизиты = Справочники.НастройкиПодключений_RepEx.РазобратьСсылкуНаПроект(Объект.Провайдер, Объект.СсылкаНаПроект);
	Разобрана = Не ЗначениеЗаполнено(Реквизиты.Ошибка);
	
	Если Объект.Провайдер = Перечисления.Провайдер_RepEx.Jira Тогда
		ПодсказкаСсылки 	= НСтр("ru = 'Страница проекта Jira или любой его задачи: по ней заполняются адрес Jira и ключ проекта.'");
		Страница 			= ?(Разобрана, Реквизиты.Адрес
			+ "/secure/ViewProfile.jspa?selectedTab=com.atlassian.pats.pats-plugin:jira-user-personal-access-tokens", "");
		ПодсказкаСекрета 	= Новый ФорматированнаяСтрока(
			НСтр("ru = 'Персональный токен Jira:'") + " ",
			СсылкаНаСтраницу(НСтр("ru = 'профиль - Personal Access Tokens'"), Страница),
			" " + НСтр("ru = '- Create token. Если указан пользователь - его пароль.'"));
	ИначеЕсли Объект.Провайдер = Перечисления.Провайдер_RepEx.GitHub Тогда
		ПодсказкаСсылки 	= НСтр("ru = 'Страница репозитория GitHub, в котором заводятся задачи.'");
		Сайт 				= ?(Разобрана И Не СтрНайти(Реквизиты.Адрес, "api.github.com") > 0,
			СтрЗаменить(Реквизиты.Адрес, "/api/v3", ""), "https://github.com");
		ПодсказкаСекрета 	= Новый ФорматированнаяСтрока(
			НСтр("ru = 'Токен GitHub с правом на задачи (Issues) репозитория:'") + " ",
			СсылкаНаСтраницу("Settings - Developer settings - Personal access tokens", Сайт + "/settings/tokens"), ".");
	ИначеЕсли Объект.Провайдер = Перечисления.Провайдер_RepEx.GitLab Тогда
		ПодсказкаСсылки 	= НСтр("ru = 'Страница проекта GitLab. Можно указать ссылку на каталог исходников (.../-/tree/master/УТ) - тогда заполнится и путь к исходникам.'");
		АдресПроекта 		= ?(Разобрана, Справочники.НастройкиПодключений_RepEx.СсылкаНаПроектПоРеквизитам(Объект.Провайдер,
			Реквизиты.Адрес, Реквизиты.Проект, ""), "");
		ПодсказкаСекрета 	= Новый ФорматированнаяСтрока(
			НСтр("ru = 'Токен проекта или личный токен GitLab со scope read_api: в проекте Settings -'") + " ",
			СсылкаНаСтраницу("Access tokens", ?(ЗначениеЗаполнено(АдресПроекта), АдресПроекта + "/-/settings/access_tokens", "")),
			". " + НСтр("ru = 'Этим токеном RepEr читает коммиты по модулям и отдает базам ленту исправлений - deploy-токен в базах не нужен.'"));
	Иначе
		ПодсказкаСсылки 	= НСтр("ru = 'Выберите провайдер и укажите ссылку на проект.'");
		ПодсказкаСекрета 	= "";
	КонецЕсли;
	
	Элементы.СсылкаНаПроектРасширеннаяПодсказка.Заголовок 	= ПодсказкаСсылки;
	Элементы.СекретРасширеннаяПодсказка.Заголовок 			= ПодсказкаСекрета;
КонецПроцедуры

// Параметры:
//  Текст 	- Строка - Название страницы
//  Адрес 	- Строка - Адрес страницы; пустая строка - адрес неизвестен
// 
// Возвращаемое значение:
//  ФорматированнаяСтрока - Ссылка на страницу или текст без ссылки
&НаСервереБезКонтекста
Функция СсылкаНаСтраницу(Текст, Адрес)
	Возврат ?(ЗначениеЗаполнено(Адрес), Новый ФорматированнаяСтрока(Текст,,,, Адрес), Новый ФорматированнаяСтрока(Текст));
КонецФункции

&НаСервере
Функция ПроверитьПодключениеНаСервере()
	Настройка = Новый Структура;
	Настройка.Вставить("Ссылка", 			Объект.Ссылка);
	Настройка.Вставить("Провайдер", 		Объект.Провайдер);
	Настройка.Вставить("СсылкаНаПроект", 	Объект.СсылкаНаПроект);
	Настройка.Вставить("Логин", 			Объект.Логин);
	Настройка.Вставить("ПутьКИсходникам", 	Объект.ПутьКИсходникам);
	Настройка.Вставить("Секрет", 			Секрет);
	Возврат Справочники.НастройкиПодключений_RepEx.ПроверитьПодключение(Настройка);
КонецФункции

#КонецОбласти
