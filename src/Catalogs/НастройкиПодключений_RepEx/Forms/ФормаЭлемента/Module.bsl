
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не ТолькоПросмотр Тогда
		Если Не Объект.Ссылка.Пустая() Тогда
			//@skip-check bsl-legacy-check-form-attribute-property-assign
			Пароль  = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Строка(Объект.Ссылка.УникальныйИдентификатор()));
		КонецЕсли;
	КонецЕсли;		
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Строка(Объект.Ссылка.УникальныйИдентификатор()), Пароль);
КонецПроцедуры

#КонецОбласти
#Область ОбработчикиСобытийЭлементовШапкиФормы
&НаКлиенте
Процедура ТипПриИзменении(Элемент)
	Элементы.Типы.ТекущаяСтраница = Элементы.Типы.ПодчиненныеЭлементы.Получить(Тип);
КонецПроцедуры

&НаКлиенте
Процедура АдресОткрытие(Элемент, СтандартнаяОбработка)
	ЗапуститьПриложение(Объект.Адрес);
КонецПроцедуры
#КонецОбласти

