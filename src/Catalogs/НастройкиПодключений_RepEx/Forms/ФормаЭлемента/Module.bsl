#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не ТолькоПросмотр Тогда
		Если Не Объект.Ссылка.Пустая() Тогда
			//@skip-check bsl-legacy-check-form-attribute-property-assign
			Секрет = Справочники.НастройкиПодключений_RepEx.Секрет(Объект.Ссылка);
		КонецЕсли;
	КонецЕсли;		
	УстановитьДоступностьЭлементов(Элементы, Объект);
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	Справочники.НастройкиПодключений_RepEx.ЗаписатьСекрет(Объект.Ссылка, Секрет);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПровайдерПриИзменении(Элемент)
	Если Не ПровайдерПоддерживаетПароль(Объект.Провайдер) Тогда
		Объект.СпособАвторизации = ПредопределенноеЗначение("Перечисление.СпособыАвторизации_RepEx.Токен");
	КонецЕсли;
	УстановитьДоступностьЭлементов(Элементы, Объект);
КонецПроцедуры

&НаКлиенте
Процедура СпособАвторизацииПриИзменении(Элемент)
	УстановитьДоступностьЭлементов(Элементы, Объект);
КонецПроцедуры

&НаКлиенте
Процедура АдресОткрытие(Элемент, СтандартнаяОбработка)
	ЗапуститьПриложение(Объект.Адрес);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Настраивает состав полей под выбранный провайдер и способ авторизации.
// Заголовки полей не меняются: смысл реквизита у каждого провайдера раскрыт
// в подсказке по кнопке, чтобы поле не переименовывалось на глазах у пользователя.
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьЭлементов(Элементы, Объект)
	
	АвторизацияПоТокену = Объект.СпособАвторизации = ПредопределенноеЗначение("Перечисление.СпособыАвторизации_RepEx.Токен");
	
	Элементы.СпособАвторизации.ТолькоПросмотр 	= Не ПровайдерПоддерживаетПароль(Объект.Провайдер);
	Элементы.Секрет.Заголовок 					= ?(АвторизацияПоТокену, НСтр("ru='Токен'"), НСтр("ru='Пароль'"));
	
	//путь к исходникам имеет смысл только у репозитория - по нему ищутся файлы модулей
	Элементы.ПутьКИсходникам.Видимость = ЭтоПровайдерРепозитория(Объект.Провайдер);
	
КонецПроцедуры

// Пароль поддерживает только Jira, остальные провайдеры работают по токену.
&НаКлиентеНаСервереБезКонтекста
Функция ПровайдерПоддерживаетПароль(Провайдер)
	Возврат Провайдер = ПредопределенноеЗначение("Перечисление.Провайдер_RepEx.Jira");
КонецФункции

// Провайдер, настройку которого можно указать в табличной части Репозитории.
&НаКлиентеНаСервереБезКонтекста
Функция ЭтоПровайдерРепозитория(Провайдер)
	Возврат Провайдер = ПредопределенноеЗначение("Перечисление.Провайдер_RepEx.GitHub")
		ИЛИ Провайдер = ПредопределенноеЗначение("Перечисление.Провайдер_RepEx.GitLab");
КонецФункции

#КонецОбласти
