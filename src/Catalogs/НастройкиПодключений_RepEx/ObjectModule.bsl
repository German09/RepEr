#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если ЗначениеЗаполнено(СсылкаНаПроект) Тогда
		Реквизиты = Справочники.НастройкиПодключений_RepEx.РазобратьСсылкуНаПроект(Провайдер, СсылкаНаПроект);
		Если ЗначениеЗаполнено(Реквизиты.Ошибка) Тогда
			ОбщегоНазначения.СообщитьПользователю(Реквизиты.Ошибка, ЭтотОбъект, "СсылкаНаПроект", "Объект", Отказ);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Адрес сервиса и проект заполняются по ссылке на проект, способ авторизации - по логину:
// в форме настройки этих реквизитов нет.
Процедура ПередЗаписью(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СсылкаНаПроект) Тогда
		Реквизиты = Справочники.НастройкиПодключений_RepEx.РазобратьСсылкуНаПроект(Провайдер, СсылкаНаПроект);
		Если Не ЗначениеЗаполнено(Реквизиты.Ошибка) Тогда
			Адрес 	= Реквизиты.Адрес;
			Проект 	= Реквизиты.Проект;
			Если Провайдер = Перечисления.Провайдер_RepEx.GitHub Тогда
				//у GitHub логин - владелец репозитория, см. ОповещенияGitHub_RepEx
				Логин = Реквизиты.Владелец;
			КонецЕсли;
			Если ЗначениеЗаполнено(Реквизиты.ПутьКИсходникам) Тогда
				ПутьКИсходникам = Реквизиты.ПутьКИсходникам;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ПоПаролю 			= Провайдер = Перечисления.Провайдер_RepEx.Jira И ЗначениеЗаполнено(Логин);
	СпособАвторизации 	= ?(ПоПаролю, Перечисления.СпособыАвторизации_RepEx.Пароль, Перечисления.СпособыАвторизации_RepEx.Токен);
КонецПроцедуры

#КонецОбласти

