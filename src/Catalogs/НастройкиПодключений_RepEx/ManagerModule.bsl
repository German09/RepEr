#Область ПрограммныйИнтерфейс

// Провайдер настройки подключения.
// 
// Параметры:
//  Настройка - СправочникСсылка.НастройкиПодключений_RepEx - Настройка
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.Провайдер_RepEx - Сервис, к которому выполняется подключение
Функция Провайдер(Настройка) Экспорт
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Настройка, "Провайдер");
КонецФункции

// Секрет подключения - пароль или токен, в зависимости от способа авторизации.
// Хранится в безопасном хранилище по идентификатору настройки.
// 
// Параметры:
//  Настройка - СправочникСсылка.НастройкиПодключений_RepEx - Настройка
// 
// Возвращаемое значение:
//  Строка - Пароль или токен
Функция Секрет(Настройка) Экспорт
	Возврат ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Строка(Настройка.УникальныйИдентификатор()));
КонецФункции

// Записывает секрет подключения в безопасное хранилище.
// 
// Параметры:
//  Настройка - СправочникСсылка.НастройкиПодключений_RepEx - Настройка
//  Секрет 	  - Строка - Пароль или токен
Процедура ЗаписатьСекрет(Настройка, Секрет) Экспорт
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Строка(Настройка.УникальныйИдентификатор()), Секрет);
КонецПроцедуры

// Параметры авторизации для получения сессии.
// Формирует структуру в том виде, в котором ее ожидает КоннекторHTTP_RepEr.ПолучитьСессию:
// при авторизации по паролю заполняются Логин и Пароль, при авторизации по токену - Токен.
// 
// Параметры:
//  Настройка 	- СправочникСсылка.НастройкиПодключений_RepEx - Настройка
//  ИмяСервиса 	- Строка - Имя сервиса для текстов ошибок
// 
// Возвращаемое значение:
//  Структура:
//  * ИмяСервиса 	 - Строка
//  * ТипАвторизации - Строка - "Basic" или "Bearer"
//  * Логин 		 - Строка - Только при авторизации по паролю
//  * Пароль 		 - Строка - Только при авторизации по паролю
//  * Токен 		 - Строка - Только при авторизации по токену
Функция ПараметрыАвторизации(Настройка, ИмяСервиса) Экспорт
	Результат = Новый Структура("ИмяСервиса,ТипАвторизации", ИмяСервиса, "Basic");
	Если АвторизацияПоТокену(Настройка) Тогда
		Результат.ТипАвторизации = "Bearer";
		Результат.Вставить("Токен", Секрет(Настройка));
	Иначе
		Результат.Вставить("Логин", 	ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Настройка, "Логин"));
		Результат.Вставить("Пароль",	Секрет(Настройка));
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Авторизация по токену.
// 
// Параметры:
//  Настройка - СправочникСсылка.НастройкиПодключений_RepEx - Настройка
// 
// Возвращаемое значение:
//  Булево - Истина, если для подключения используется токен, а не пара логин-пароль
Функция АвторизацияПоТокену(Настройка) Экспорт
	СпособАвторизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Настройка, "СпособАвторизации");
	Возврат СпособАвторизации = Перечисления.СпособыАвторизации_RepEx.Токен;
КонецФункции

// Способы авторизации, поддерживаемые провайдером.
// 
// Параметры:
//  Провайдер - ПеречислениеСсылка.Провайдер_RepEx - Провайдер
// 
// Возвращаемое значение:
//  Массив Из ПеречислениеСсылка.СпособыАвторизации_RepEx
Функция ДоступныеСпособыАвторизации(Провайдер) Экспорт
	Результат = Новый Массив;
	Если Провайдер = Перечисления.Провайдер_RepEx.Jira Тогда
		Результат.Добавить(Перечисления.СпособыАвторизации_RepEx.Пароль);
	КонецЕсли;
	Результат.Добавить(Перечисления.СпособыАвторизации_RepEx.Токен);
	Возврат Результат;
КонецФункции

// Разбирает ссылку на проект в реквизиты подключения. В форме настройки указывается только ссылка,
// адрес сервиса и проект заполняются по ней при записи.
// 
// Параметры:
//  Провайдер 	- ПеречислениеСсылка.Провайдер_RepEx - Сервис проекта
//  Ссылка 		- Строка - Ссылка на проект, как он открывается в браузере:
//				  Jira - https://jira.company.ru/projects/SYSTEM или задача https://jira.company.ru/browse/SYSTEM-123,
//				  GitHub - https://github.com/owner/repo,
//				  GitLab - https://gitlab.company.ru/group/project, https://gitlab.company.ru/projects/123
//				  или каталог исходников https://gitlab.company.ru/group/project/-/tree/master/УТ
// 
// Возвращаемое значение:
//  Структура:
//  * Адрес 			- Строка - Базовый адрес API: https://jira.company.ru, https://api.github.com, https://gitlab.company.ru
//  * Проект 			- Строка - Ключ проекта Jira, имя репозитория GitHub, путь group/project или идентификатор проекта GitLab
//  * Владелец 			- Строка - Владелец репозитория GitHub, у остальных провайдеров пустая строка
//  * ПутьКИсходникам 	- Строка - Каталог из ссылки на каталог репозитория, например /УТ; пустая строка - в ссылке каталога нет
//  * Ошибка 			- Строка - Почему ссылку не удалось разобрать; пустая строка - ссылка разобрана
Функция РазобратьСсылкуНаПроект(Провайдер, Ссылка) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Адрес", 			"");
	Результат.Вставить("Проект", 			"");
	Результат.Вставить("Владелец", 			"");
	Результат.Вставить("ПутьКИсходникам", 	"");
	Результат.Вставить("Ошибка", 			"");
	
	СтруктураURI 	= ОбщегоНазначенияКлиентСервер.СтруктураURI(Ссылка);
	Сегменты 		= СегментыПути(СтруктураURI.ПутьНаСервере);
	Корень 			= СтрШаблон("%1://%2", СтруктураURI.Схема, СтруктураURI.ИмяСервера);
	
	Если Не ЗначениеЗаполнено(СтруктураURI.Схема) Или Не ЗначениеЗаполнено(СтруктураURI.Хост) Тогда
		Результат.Ошибка = СтрШаблон(НСтр("ru = 'Укажите ссылку на проект, например %1'"), ПримерСсылкиНаПроект(Провайдер));
	ИначеЕсли Провайдер = Перечисления.Провайдер_RepEx.Jira Тогда
		РазобратьСсылкуJira(Результат, Корень, Сегменты);
	ИначеЕсли Провайдер = Перечисления.Провайдер_RepEx.GitHub Тогда
		РазобратьСсылкуGitHub(Результат, Корень, СтруктураURI.Хост, Сегменты);
	ИначеЕсли Провайдер = Перечисления.Провайдер_RepEx.GitLab Тогда
		РазобратьСсылкуGitLab(Результат, Корень, Сегменты);
	Иначе
		Результат.Ошибка = НСтр("ru = 'Не указан провайдер'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат.Ошибка) И Не ЗначениеЗаполнено(Результат.Проект) Тогда
		Результат.Ошибка = СтрШаблон(НСтр("ru = 'В ссылке %1 нет проекта, пример ссылки: %2'"), СокрЛП(Ссылка),
			ПримерСсылкиНаПроект(Провайдер));
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Ссылка на проект по реквизитам подключения - для настроек, записанных до появления ссылки на проект.
// Обратна см. РазобратьСсылкуНаПроект
// 
// Параметры:
//  Провайдер 	- ПеречислениеСсылка.Провайдер_RepEx - Сервис проекта
//  Адрес 		- Строка - Базовый адрес API сервиса
//  Проект 		- Строка - Ключ проекта Jira, имя репозитория GitHub, путь или идентификатор проекта GitLab
//  Логин 		- Строка - Владелец репозитория GitHub
// 
// Возвращаемое значение:
//  Строка - Ссылка на проект; пустая строка, если адрес не заполнен
Функция СсылкаНаПроектПоРеквизитам(Провайдер, Знач Адрес, Знач Проект, Знач Логин) Экспорт
	Адрес 	= БезКосойЧертыВКонце(СокрЛП(Адрес));
	Проект 	= СокрЛП(Проект);
	Если Не ЗначениеЗаполнено(Адрес) Тогда
		Результат = "";
	ИначеЕсли Не ЗначениеЗаполнено(Проект) Тогда
		Результат = Адрес;
	ИначеЕсли Провайдер = Перечисления.Провайдер_RepEx.Jira Тогда
		Результат = СтрШаблон("%1/projects/%2", Адрес, Проект);
	ИначеЕсли Провайдер = Перечисления.Провайдер_RepEx.GitHub Тогда
		//адрес API - https://api.github.com или https://<сервер>/api/v3 у GitHub Enterprise
		Сайт 		= ?(СтрНайти(НРег(Адрес), "api.github.com") > 0, "https://github.com", СтрЗаменить(Адрес, "/api/v3", ""));
		Результат 	= СтрШаблон("%1/%2/%3", Сайт, СокрЛП(Логин), Проект);
	ИначеЕсли СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Проект) Тогда
		//GitLab переадресует /projects/<идентификатор> на страницу проекта
		Результат = СтрШаблон("%1/projects/%2", Адрес, Проект);
	Иначе
		Результат = СтрШаблон("%1/%2", Адрес, Проект);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Пример ссылки на проект для подсказок.
// 
// Параметры:
//  Провайдер - ПеречислениеСсылка.Провайдер_RepEx - Сервис проекта
// 
// Возвращаемое значение:
//  Строка
Функция ПримерСсылкиНаПроект(Провайдер) Экспорт
	Если Провайдер = Перечисления.Провайдер_RepEx.Jira Тогда
		Результат = "https://jira.company.ru/projects/SYSTEM";
	ИначеЕсли Провайдер = Перечисления.Провайдер_RepEx.GitHub Тогда
		Результат = "https://github.com/owner/repo";
	Иначе
		Результат = "https://gitlab.company.ru/group/project";
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Проект GitLab в адресе API: путь group/project кодируется (group%2Fproject), идентификатор остается как есть.
// 
// Параметры:
//  Проект - Строка - Путь или идентификатор проекта GitLab
// 
// Возвращаемое значение:
//  Строка
Функция ИдентификаторПроектаGitLab(Проект) Экспорт
	Возврат КодироватьСтроку(СокрЛП(Проект), СпособКодированияСтроки.КодировкаURL);
КонецФункции

// Проверяет подключение с настройками из формы, в том числе еще не записанными:
// Jira - доступ к проекту, GitHub - к репозиторию, GitLab - к проекту, каталогу исходников в ветке
// и ленте исправлений в реестре пакетов.
// 
// Параметры:
//  Параметры - Структура - Настройка подключения:
//  * Ссылка 			- СправочникСсылка.НастройкиПодключений_RepEx - Записанная настройка, ее секрет берется, если Секрет не указан
//  * Провайдер 		- ПеречислениеСсылка.Провайдер_RepEx
//  * СсылкаНаПроект 	- Строка - см. РазобратьСсылкуНаПроект
//  * Логин 			- Строка - Пользователь Jira для авторизации по паролю; пустая строка - авторизация по токену
//  * Секрет 			- Строка - Пароль или токен; пустая строка - сохраненный секрет настройки
//  * ПутьКИсходникам 	- Строка - Каталог с выгрузкой конфигурации в репозитории
// 
// Возвращаемое значение:
//  Структура:
//  * Успех 	- Булево
//  * Описание 	- Строка - Результат проверки для пользователя
Функция ПроверитьПодключение(Параметры) Экспорт
	Результат 	= Новый Структура("Успех, Описание", Ложь, "");
	Реквизиты 	= РазобратьСсылкуНаПроект(Параметры.Провайдер, Параметры.СсылкаНаПроект);
	Секрет 		= СокрЛП(Параметры.Секрет);
	Если Не ЗначениеЗаполнено(Секрет) И ЗначениеЗаполнено(Параметры.Ссылка) Тогда
		УстановитьПривилегированныйРежим(Истина);
		Секрет = Секрет(Параметры.Ссылка);
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Реквизиты.Ошибка) Тогда
		Результат.Описание = Реквизиты.Ошибка;
	ИначеЕсли Не ЗначениеЗаполнено(Секрет) Тогда
		Результат.Описание = НСтр("ru = 'Не указан токен или пароль.'");
	ИначеЕсли БлокировкаРаботыСВнешнимиРесурсами.РаботаСВнешнимиРесурсамиЗаблокирована() Тогда
		Результат.Описание = НСтр("ru = 'Работа с внешними ресурсами заблокирована.'");
	ИначеЕсли Параметры.Провайдер = Перечисления.Провайдер_RepEx.Jira Тогда
		ПроверитьПроектJira(Результат, Реквизиты, СокрЛП(Параметры.Логин), Секрет);
	ИначеЕсли Параметры.Провайдер = Перечисления.Провайдер_RepEx.GitHub Тогда
		ПроверитьРепозиторийGitHub(Результат, Реквизиты, Секрет);
	Иначе
		ПутьКИсходникам = ?(ЗначениеЗаполнено(Реквизиты.ПутьКИсходникам), Реквизиты.ПутьКИсходникам, Параметры.ПутьКИсходникам);
		ПроверитьПроектGitLab(Результат, Реквизиты, Секрет, ПутьКИсходникам);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сегменты пути ссылки без параметров и якоря.
// 
// Параметры:
//  ПутьНаСервере - Строка - Путь с параметрами и якорем, см. ОбщегоНазначенияКлиентСервер.СтруктураURI
// 
// Возвращаемое значение:
//  Массив из Строка - Сегменты пути как в ссылке, без раскодирования
Функция СегментыПути(Знач ПутьНаСервере)
	Для Каждого Разделитель ИЗ СтрРазделить("?,#", ",") Цикл
		Позиция = СтрНайти(ПутьНаСервере, Разделитель);
		Если Позиция > 0 Тогда
			ПутьНаСервере = Лев(ПутьНаСервере, Позиция - 1);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрРазделить(ПутьНаСервере, "/", Ложь);
КонецФункции

// Jira: ключ проекта стоит после projects (страница проекта) или browse (страница проекта или задачи),
// сегменты перед ними - путь публикации Jira на сервере.
Процедура РазобратьСсылкуJira(Результат, Корень, Сегменты)
	Публикация 		= Новый Массив;
	ПослеРаздела 	= Ложь;
	Для Каждого Сегмент ИЗ Сегменты Цикл
		Если ПослеРаздела Тогда
			//у задачи ключ проекта - до дефиса: SYSTEM-123
			Результат.Проект = СтрРазделить(Сегмент, "-").Получить(0);
			Прервать;
		ИначеЕсли НРег(Сегмент) = "projects" Или НРег(Сегмент) = "browse" Тогда
			ПослеРаздела = Истина;
		Иначе
			Публикация.Добавить(Сегмент);
		КонецЕсли;
	КонецЦикла;
	
	//в Jira Cloud перед projects стоит продукт: /jira/software/projects/SYSTEM
	Путь = СтрСоединить(Публикация, "/");
	Для Каждого Продукт ИЗ СтрРазделить("jira/software,jira/core,jira/servicedesk", ",") Цикл
		Если СтрЗаканчиваетсяНа(НРег(Путь), Продукт) Тогда
			Путь = Лев(Путь, СтрДлина(Путь) - СтрДлина(Продукт));
		КонецЕсли;
	КонецЦикла;
	Путь = БезКосойЧертыВКонце(Путь);
	
	Результат.Адрес = Корень + ?(ЗначениеЗаполнено(Путь), "/" + Путь, "");
КонецПроцедуры

// GitHub: владелец и репозиторий - первые сегменты пути; ссылка на API (api.github.com/repos/owner/repo)
// и на каталог (owner/repo/tree/<ветка>/<каталог>) тоже разбираются.
Процедура РазобратьСсылкуGitHub(Результат, Корень, Хост, Сегменты)
	Части 		= Новый Массив;
	Каталог 	= Новый Массив;
	Состояние 	= "Репозиторий";
	Для Каждого Сегмент ИЗ Сегменты Цикл
		Если Состояние = "Репозиторий" И Части.Количество() < 2 Тогда
			Если Части.Количество() > 0 Или СтрРазделить("api,v3,repos", ",").Найти(НРег(Сегмент)) = Неопределено Тогда
				Части.Добавить(Сегмент);
			КонецЕсли;
		ИначеЕсли Состояние = "Репозиторий" И НРег(Сегмент) = "tree" Тогда
			Состояние = "Ветка";
		ИначеЕсли Состояние = "Ветка" Тогда
			Состояние = "Каталог";
		ИначеЕсли Состояние = "Каталог" Тогда
			Каталог.Добавить(Сегмент);
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ЭтоGitHubCom 	= НРег(Хост) = "github.com" Или НРег(Хост) = "api.github.com";
	Результат.Адрес = ?(ЭтоGitHubCom, "https://api.github.com", Корень + "/api/v3");
	Если Части.Количество() = 2 Тогда
		Результат.Владелец 	= Части.Получить(0);
		Результат.Проект 	= БезОкончанияGit(Части.Получить(1));
	КонецЕсли;
	Результат.ПутьКИсходникам = ПутьКИсходникам(Каталог);
КонецПроцедуры

// GitLab: проект - сегменты до /-/ (group/subgroup/project), /projects/<идентификатор>
// или адрес API /api/v4/projects/<проект>; каталог исходников - после /-/tree/<ветка>/.
Процедура РазобратьСсылкуGitLab(Результат, Корень, Сегменты)
	ПутьПроекта = Новый Массив;
	Каталог 	= Новый Массив;
	Состояние 	= "Проект";
	Для Каждого Сегмент ИЗ Сегменты Цикл
		Если Состояние = "Проект" И Сегмент = "-" Тогда
			Состояние = "Раздел";
		ИначеЕсли Состояние = "Проект" Тогда
			ПутьПроекта.Добавить(Сегмент);
		ИначеЕсли Состояние = "Раздел" И НРег(Сегмент) = "tree" Тогда
			Состояние = "Ветка";
		ИначеЕсли Состояние = "Ветка" Тогда
			Состояние = "Каталог";
		ИначеЕсли Состояние = "Каталог" Тогда
			Каталог.Добавить(Сегмент);
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Путь 		= СтрСоединить(ПутьПроекта, "/");
	ПутьНРег 	= НРег(Путь);
	ПрефиксAPI 	= "api/v4/projects/";
	Если СтрНачинаетсяС(ПутьНРег, ПрефиксAPI) Тогда
		Проект = СтрРазделить(Сред(Путь, СтрДлина(ПрефиксAPI) + 1), "/").Получить(0);
	ИначеЕсли СтрНачинаетсяС(ПутьНРег, "projects/") Тогда
		Проект = СтрРазделить(Сред(Путь, СтрДлина("projects/") + 1), "/").Получить(0);
	Иначе
		Проект = БезОкончанияGit(Путь);
	КонецЕсли;
	
	Результат.Адрес 			= Корень;
	Результат.Проект 			= РаскодироватьСтроку(Проект, СпособКодированияСтроки.КодировкаURL);
	Результат.ПутьКИсходникам 	= ПутьКИсходникам(Каталог);
КонецПроцедуры

// Путь к исходникам из сегментов каталога репозитория: /УТ. Папка src в конце отбрасывается -
// путь к исходникам указывает на папку, в которой лежит src.
// 
// Параметры:
//  Каталог - Массив из Строка - Сегменты каталога, как в ссылке
// 
// Возвращаемое значение:
//  Строка - Пустая строка, если каталога нет
Функция ПутьКИсходникам(Каталог)
	Путь = РаскодироватьСтроку(СтрСоединить(Каталог, "/"), СпособКодированияСтроки.КодировкаURL);
	Если НРег(Путь) = "src" Тогда
		Путь = "";
	ИначеЕсли СтрЗаканчиваетсяНа(НРег(Путь), "/src") Тогда
		Путь = Лев(Путь, СтрДлина(Путь) - СтрДлина("/src"));
	КонецЕсли;
	Возврат ?(ЗначениеЗаполнено(Путь), "/" + Путь, "");
КонецФункции

Функция БезОкончанияGit(Знач Имя)
	Если СтрЗаканчиваетсяНа(НРег(Имя), ".git") Тогда
		Имя = Лев(Имя, СтрДлина(Имя) - СтрДлина(".git"));
	КонецЕсли;
	Возврат Имя;
КонецФункции

Функция БезКосойЧертыВКонце(Знач Адрес)
	Пока СтрЗаканчиваетсяНа(Адрес, "/") Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;
	Возврат Адрес;
КонецФункции

Процедура ПроверитьПроектJira(Результат, Реквизиты, Логин, Секрет)
	Заголовки = Новый Соответствие;
	Если ЗначениеЗаполнено(Логин) Тогда
		ДанныеАвторизации = ПолучитьДвоичныеДанныеИзСтроки(Логин + ":" + Секрет);
		Заголовки.Вставить("Authorization", "Basic " + ПолучитьBase64СтрокуИзДвоичныхДанных(ДанныеАвторизации));
	Иначе
		Заголовки.Вставить("Authorization", "Bearer " + Секрет);
	КонецЕсли;
	
	Адрес = СтрШаблон("%1/rest/api/2/project/%2", Реквизиты.Адрес, КодироватьСтроку(Реквизиты.Проект, СпособКодированияСтроки.КодировкаURL));
	Ответ = ВыполнитьЗапрос(Адрес, Заголовки);
	Если Ответ.КодСостояния = 200 И ТипЗнч(Ответ.Данные) = Тип("Соответствие") Тогда
		Результат.Успех 	= Истина;
		Результат.Описание 	= СтрШаблон(НСтр("ru = 'Проект Jira %1 (%2) доступен.'"), Ответ.Данные.Получить("name"), Ответ.Данные.Получить("key"));
	Иначе
		Результат.Описание = ОписаниеОтказа(Ответ, СтрШаблон(НСтр("ru = 'Проект Jira %1'"), Реквизиты.Проект));
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьРепозиторийGitHub(Результат, Реквизиты, Секрет)
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Секрет);
	Заголовки.Вставить("Accept", 		"application/vnd.github+json");
	
	Адрес = СтрШаблон("%1/repos/%2/%3", Реквизиты.Адрес, Реквизиты.Владелец, Реквизиты.Проект);
	Ответ = ВыполнитьЗапрос(Адрес, Заголовки);
	Если Ответ.КодСостояния = 200 И ТипЗнч(Ответ.Данные) = Тип("Соответствие") Тогда
		Результат.Успех 	= Истина;
		Результат.Описание 	= СтрШаблон(НСтр("ru = 'Репозиторий GitHub %1 доступен.'"), Ответ.Данные.Получить("full_name"));
	Иначе
		Результат.Описание = ОписаниеОтказа(Ответ, СтрШаблон(НСтр("ru = 'Репозиторий GitHub %1/%2'"), Реквизиты.Владелец, Реквизиты.Проект));
	КонецЕсли;
КонецПроцедуры

// GitLab: кроме доступа к проекту - каталог исходников в ветке, где ищутся коммиты по модулям
// см. РепозиторииGitLab_RepEr.ПолучитьКоммиты, и лента исправлений, которую RepEr отдает базам
// см. РепозиторииGitLab_RepEr.ФайлЛентыИсправлений
Процедура ПроверитьПроектGitLab(Результат, Реквизиты, Секрет, ПутьКИсходникам)
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("PRIVATE-TOKEN", Секрет);
	
	АдресПроекта 	= СтрШаблон("%1/api/v4/projects/%2", Реквизиты.Адрес, ИдентификаторПроектаGitLab(Реквизиты.Проект));
	Ответ 			= ВыполнитьЗапрос(АдресПроекта, Заголовки);
	Если Ответ.КодСостояния <> 200 Или ТипЗнч(Ответ.Данные) <> Тип("Соответствие") Тогда
		Результат.Описание = ОписаниеОтказа(Ответ, СтрШаблон(НСтр("ru = 'Проект GitLab %1'"), Реквизиты.Проект));
		Возврат;
	КонецЕсли;
	
	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Проект GitLab %1 доступен.'"), Ответ.Данные.Получить("name_with_namespace")));
	
	Ветка 			= РепозиторииGitLab_RepEr.ПолучитьИмяВетки();
	Каталог 		= СтрЗаменить(СтрШаблон("%1/src", ПутьКИсходникам), "//", "/");
	Каталог 		= ?(СтрНачинаетсяС(Каталог, "/"), Сред(Каталог, 2), Каталог);
	ПараметрыЗапроса = Новый Структура("path, ref, per_page", Каталог, Ветка, 1);
	Ответ 			= ВыполнитьЗапрос(АдресПроекта + "/repository/tree", Заголовки, ПараметрыЗапроса);
	Если Ответ.КодСостояния = 200 Тогда
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Исходники: каталог %1 в ветке %2.'"), Каталог, Ветка));
	Иначе
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Каталога %1 в ветке %2 нет (код ответа %3): коммиты по модулям из стека ошибок не найдутся.'"),
			Каталог, Ветка, Ответ.КодСостояния));
	КонецЕсли;
	
	ПараметрыЗапроса = Новый Структура("package_type, package_name, per_page", "generic", РепозиторииGitLab_RepEr.ИмяПакетаЛенты(), 100);
	Ответ 			= ВыполнитьЗапрос(АдресПроекта + "/packages", Заголовки, ПараметрыЗапроса);
	Если Ответ.КодСостояния = 200 И ТипЗнч(Ответ.Данные) = Тип("Массив") Тогда
		Версии = Новый Массив;
		Для Каждого Пакет ИЗ Ответ.Данные Цикл
			//отбор package_name нестрогий
			Если Пакет.Получить("name") = РепозиторииGitLab_RepEr.ИмяПакетаЛенты() Тогда
				Версии.Добавить(Пакет.Получить("version"));
			КонецЕсли;
		КонецЦикла;
		Строки.Добавить(?(Версии.Количество() = 0,
			НСтр("ru = 'Ленты исправлений в реестре пакетов проекта нет.'"),
			СтрШаблон(НСтр("ru = 'Лента исправлений: версии %1.'"), СтрСоединить(Версии, ", "))));
	Иначе
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Ленту исправлений проверить не удалось (код ответа %1): токену нужен scope read_api.'"),
			Ответ.КодСостояния));
	КонецЕсли;
	
	Результат.Успех 	= Истина;
	Результат.Описание 	= СтрСоединить(Строки, Символы.ПС);
КонецПроцедуры

// GET-запрос к API сервиса.
// 
// Параметры:
//  Адрес 				- Строка - Адрес ресурса без параметров
//  Заголовки 			- Соответствие из КлючИЗначение - Заголовки авторизации
//  ПараметрыЗапроса 	- Структура, Неопределено - Параметры запроса, кодируются коннектором
// 
// Возвращаемое значение:
//  Структура:
//  * КодСостояния 	- Число - Код ответа HTTP, 0 - не удалось подключиться
//  * Данные 		- Произвольный, Неопределено - Тело ответа из JSON: Соответствие или Массив; Неопределено - тело не JSON
//  * Описание 		- Строка - Ошибка подключения или начало тела ответа
Функция ВыполнитьЗапрос(Адрес, Заголовки, ПараметрыЗапроса = Неопределено)
	Ответ 			= Новый Структура("КодСостояния, Данные, Описание", 0, Неопределено, "");
	ДопПараметры 	= КоннекторHTTP_RepEr.НовыеПараметры();
	Для Каждого Заголовок ИЗ Заголовки Цикл
		ДопПараметры.Заголовки.Вставить(Заголовок.Ключ, Заголовок.Значение);
	КонецЦикла;
	
	Попытка
		HTTPОтвет 			= КоннекторHTTP_RepEr.Get(Адрес, ПараметрыЗапроса, ДопПараметры);
		Ответ.КодСостояния 	= HTTPОтвет.КодСостояния;
		Ответ.Описание 		= Лев(СокрЛП(КоннекторHTTP_RepEr.КакТекст(HTTPОтвет)), 300);
	Исключение
		HTTPОтвет 		= Неопределено;
		Ответ.Описание 	= ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Если HTTPОтвет <> Неопределено Тогда
		Попытка
			Ответ.Данные = КоннекторHTTP_RepEr.КакJson(HTTPОтвет);
		Исключение
			//тело не JSON: для пользователя остается начало тела в описании
			Ответ.Данные = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Возврат Ответ;
КонецФункции

// Описание неудачной проверки для пользователя.
// 
// Параметры:
//  Ответ 	- см. ВыполнитьЗапрос
//  Объект 	- Строка - Что проверялось: проект, репозиторий
// 
// Возвращаемое значение:
//  Строка
Функция ОписаниеОтказа(Ответ, Объект)
	Если Ответ.КодСостояния = 0 Тогда
		Результат = СтрШаблон(НСтр("ru = 'Не удалось подключиться: %1'"), Ответ.Описание);
	ИначеЕсли Ответ.КодСостояния = 401 Тогда
		Результат = НСтр("ru = 'Токен или пароль не принят (код ответа 401).'");
	ИначеЕсли Ответ.КодСостояния = 403 Тогда
		Результат = СтрШаблон(НСтр("ru = '%1: нет доступа (код ответа 403).'"), Объект);
	ИначеЕсли Ответ.КодСостояния = 404 Тогда
		Результат = СтрШаблон(НСтр("ru = '%1 не найден или недоступен с этим токеном (код ответа 404).'"), Объект);
	Иначе
		Результат = СтрШаблон(НСтр("ru = '%1: код ответа %2. %3'"), Объект, Ответ.КодСостояния, Ответ.Описание);
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти

#КонецЕсли
