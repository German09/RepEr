
Функция ИнформацияОБазе(ИмяБазы) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Наименование", ИмяБазы);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Базы.Ссылка КАК База,
	               |	Базы.ДоступРазрешен КАК ДоступРазрешен,
	               |	Базы.ДопОтветНаПолучениеИнформации КАК ДопОтвет,
	               |	Базы.ЯзыкПоУмолчанию КАК ЯзыкПоУмолчанию
	               |ИЗ
	               |	Справочник.Базы КАК Базы
	               |ГДЕ
	               |	Базы.Наименование = &Наименование";
	
	Результат = Новый Структура("База, ДоступРазрешен, ДопОтвет, ЯзыкПоУмолчанию", Неопределено, Ложь, Неопределено, "");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;

КонецФункции
