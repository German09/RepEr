
#Область ОбработчикиСобытийЭлементовТаблицыФормыИсключения

&НаКлиенте
Процедура ИсключенияПриАктивизацииСтроки(Элемент)
	ТД = Элемент.ТекущиеДанные;
	Если Не ТД = Неопределено Тогда
		УстановитьОтборПоНаименованию(Ошибки, ТД.Ошибка, Объект.Ссылка)		
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ИсключенияПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ТД = Элемент.ТекущиеДанные;
	Если Не ТД = Неопределено Тогда
		УстановитьОтборПоНаименованию(Ошибки, ТД.Ошибка, Объект.Ссылка)		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

// Установить отбор по наименованию.
// 
// Параметры:
//  Список 			- ДинамическийСписок - Список
//  СтрокаПоиска 	- Строка - Строка поиска
//  ИнфБаза 		- СправочникСсылка.ИнформационныеБазы_RepEr - Инф база
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборПоНаименованию(Список, Знач СтрокаПоиска, ИнфБаза)
	
	ЭлементыОтбора = Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы;
	
	ГруппаОтбора = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(
		ЭлементыОтбора, "ГруппаОтбораНаименования", ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
			
	СтрокаПоиска 		= СтрЗаменить(СтрокаПоиска,"""",""); //Уберем кавычки
					
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(
		ГруппаОтбора,
		"ТекстОтчета", 
		ВидСравненияКомпоновкиДанных.Содержит, 
		СтрокаПоиска,
		,
		Истина);
		Если Не ИнфБаза.Пустая()	Тогда
			ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(
				ГруппаОтбора,
				"ИнформационнаяБаза", 
				ВидСравненияКомпоновкиДанных.Равно, 
				ИнфБаза,
				,
				Истина);	
		КонецЕсли;
КонецПроцедуры
#КонецОбласти
