#Область ПрограммныйИнтерфейс

// Зписывает ключ оповещения
// 
// Параметры:
//  Отчет 			- ДокументСсылка.ОтчетыОбОшибках_RepEr
//  Тип 			- ПеречислениеСсылка.ТипыОповещений_RepEx
//  Настройка 		- СправочникСсылка.НастройкиПодключений_RepEx
//  Идентификатор 	- Строка
Процедура ЗаписатьКлюч(Отчет, Тип, Настройка, Идентификатор) Экспорт	
	НаборЗписей = Неопределено; //РегистрСведенийНаборЗаписей.КлючиОповещений_RepEx
	Запись = ПолучитьЗапись(Отчет, Тип, Настройка,НаборЗписей);
	Если Запись = Неопределено Тогда
		Запись = НаборЗписей.Добавить();
		Запись.ТипОповещения 		= Тип;
		Запись.НастройкаПодключения	= Настройка	
	КонецЕсли;
	Запись.Идентификатор  		= Идентификатор;		
	Попытка
		Если НаборЗписей.Модифицированность() Тогда
			НаборЗписей.Записать(Истина);
		КонецЕсли;	
	Исключение
		ТекстОшибки = НСтр("ru='Не удалось записать ключ.'");
		ТекстОшибки = ТекстОшибки + Символы.ПС + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
	КонецПопытки;	
КонецПроцедуры

// Получить запись.
// 
// Параметры:
//  Отчет 		- ДокументСсылка.ОтчетыОбОшибках_RepEr - Отчет
//  Тип 		- ПеречислениеСсылка.ТипыОповещений_RepEx - Тип
//  Настройка 	- СправочникСсылка.НастройкиПодключений_RepEx - Настройка
//  НаборЗписей - Неопределено,РегистрСведенийНаборЗаписей.КлючиОповещений_RepEx -  Возвращаемый параметр
// 
// Возвращаемое значение:
//  РегистрСведенийЗапись.КлючиОповещений_RepEx - Получить запись
Функция ПолучитьЗапись(Отчет, Тип, Настройка, НаборЗписей = Неопределено) Экспорт
	НаборЗписей = ПолучитьНабор(Отчет);
	Для Каждого Запись ИЗ НаборЗписей Цикл
		Если Запись.ТипОповещения = Тип И Запись.НастройкаПодключения	= Настройка Тогда
			Возврат Запись;			
		КонецЕсли;
	КонецЦикла;
КонецФункции

// Получить набор.
// 
// Параметры:
//  Отчет - ДокументСсылка.ОтчетыОбОшибках_RepEr - Отчет
// 
// Возвращаемое значение:
// 	РегистрСведенийНаборЗаписей.КлючиОповещений_RepEx 
Функция ПолучитьНабор(Отчет) Экспорт
	НаборЗписей = СоздатьНаборЗаписей();
	НаборЗписей.Отбор.Регистратор.Установить(Отчет); 	
	НаборЗписей.Прочитать();
	Возврат НаборЗписей;
КонецФункции

