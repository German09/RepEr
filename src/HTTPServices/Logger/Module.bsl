Функция ДанныеЗапроса(Запрос)
	
	текстЗапроса 	= Запрос.ПолучитьТелоКакСтроку();
	Результат 		= СтроковыеФукнцииЛоггер.СтрокаJSONВЗначение(текстЗапроса);
	
	Возврат Результат;
	
КонецФункции

Функция ЯзыкЗапроса(Запрос)
	
	стрЗапрос = ДанныеЗапроса(Запрос);
	
	Если стрЗапрос.Свойство("platformInterfaceLanguageCode") Тогда
		Возврат стрЗапрос.platformInterfaceLanguageCode;
	КонецЕсли;
	
	Возврат ОбщегоНазначенияЛоггерПовтИсп.КодЯзыкаЕслиВсёПусто();
	
КонецФункции

Функция ПолучитьИнформацию_getInfo(Запрос)
	
	мЯзык = ЯзыкЗапроса(Запрос);
	
	ДанныеОтвета = Новый Структура;
	
	//данная ошибка должна быть отправлена в сервис регистрации
	ДанныеОтвета.Вставить("needSendReport", Истина); 
	
	//то с помощью данного свойства можно показать пользователю рекомендацию, мотивирующую на отправку отчета об ошибке.
	ДанныеОтвета.Вставить("userMessage", ОбщегоНазначенияЛоггерПовтИсп.ТекстОтветаНаПолучениеИнформации(мЯзык));
	
	//тип дампа, который нужно приложить к отчету об ошибке (аналогичен значению атрибута type элемента dump файла logcfg.xml)
	ДанныеОтвета.Вставить("dumpType", 1);
	
	
	Если Константы.РазделятьДоступПоБазам.Получить() = Истина Тогда
		
		Ответ = Новый HTTPСервисОтвет(505);
		ДанныеОтвета.Вставить("needSendReport", Ложь); 
		ДанныеОтвета.Вставить("userMessage", ОбщегоНазначенияЛоггерПовтИсп.ТекстОтветаОшибкиДоступаПриРазделенииБаз(мЯзык));
		
	Иначе
		
		Ответ = Новый HTTPСервисОтвет(200);
		
	КонецЕсли;
	
	ДанныеОтветаСтрокой = СтроковыеФукнцииЛоггер.ЗначениеВСтрокуJSON(ДанныеОтвета);
		
	Ответ.УстановитьТелоИзСтроки(ДанныеОтветаСтрокой);
	
	Возврат Ответ;
	
КонецФункции

Функция ОтправитьОтчет_pushReport(Запрос)
	
	ДанныеОтчета = Запрос.ПолучитьТелоКакДвоичныеДанные();
	ДанныеОтчета = Новый ХранилищеЗначения(ДанныеОтчета);
	
	РегистрыСведений.Отчеты_RepEr.ДобавитьЗапись(ДанныеОтчета);
	
	Возврат Новый HTTPСервисОтвет(200);
	
КонецФункции

Функция ПолучитьИнформациюДляБазы_getInfo(Запрос)
	
	мЯзык = ЯзыкЗапроса(Запрос);
	
	ДанныеОтвета = Новый Структура;
	
	//данная ошибка должна быть отправлена в сервис регистрации
	ДанныеОтвета.Вставить("needSendReport", Истина); 
	
	//то с помощью данного свойства можно показать пользователю рекомендацию, мотивирующую на отправку отчета об ошибке.
	ДанныеОтвета.Вставить("userMessage", ОбщегоНазначенияЛоггерПовтИсп.ТекстОтветаНаПолучениеИнформации(мЯзык));
	
	//тип дампа, который нужно приложить к отчету об ошибке (аналогичен значению атрибута type элемента dump файла logcfg.xml)
	ДанныеОтвета.Вставить("dumpType", 1);
	
	Ответ = Новый HTTPСервисОтвет(200);
	
	// Если разделение выключено - то отправим общую информацию
	Если Константы.РазделятьДоступПоБазам.Получить() = Истина Тогда
		
		имяБазы = Запрос.ПараметрыURL.Получить("baseName");
		
		инфоБазы = Справочники.Базы.ИнформацияОБазе(имяБазы);
		
		Если инфоБазы.База = Неопределено или инфоБазы.ДоступРазрешен = Ложь Тогда
			ДанныеОтвета.Вставить("userMessage", ОбщегоНазначенияЛоггерПовтИсп.ТекстОтветаБазаНеНастроена(мЯзык));
		Иначе
			мОтвет = Справочники.ОтветыСервиса.ПолучитьОтвет(инфоБазы.ДопОтвет, мЯзык, инфоБазы.ЯзыкПоУмолчанию);
			Если ЗначениеЗаполнено(мОтвет) Тогда
				ДанныеОтвета.Вставить("userMessage", мОтвет);
			КонецЕсли;
		КонецЕсли;
			
	КонецЕсли;
	
	ДанныеОтветаСтрокой = СтроковыеФукнцииЛоггер.ЗначениеВСтрокуJSON(ДанныеОтвета);
		
	Ответ.УстановитьТелоИзСтроки(ДанныеОтветаСтрокой);
	
	Возврат Ответ;
	
КонецФункции

Функция ОтправитьОтчетДляБазы_pushReport(Запрос)
	
	//мЯзык = ЯзыкЗапроса(Запрос);
	
	База = Неопределено;
	
	ДанныеОтчета = Запрос.ПолучитьТелоКакДвоичныеДанные();
	ДанныеОтчета = Новый ХранилищеЗначения(ДанныеОтчета);
	
	Если Константы.РазделятьДоступПоБазам.Получить() = Истина Тогда
		
		имяБазы = Запрос.ПараметрыURL.Получить("baseName");
		
		инфоБазы = Справочники.Базы.ИнформацияОБазе(имяБазы);
		
		Если инфоБазы.ДоступРазрешен = Ложь Тогда
			
			Ответ = Новый HTTPСервисОтвет(505);
			
			стрОтвет = ОбщегоНазначенияЛоггерПовтИсп.ТекстОтветаБазаНеНастроена(инфоБазы.ЯзыкПоУмолчанию);
			
			Ответ.УстановитьТелоИзСтроки(стрОтвет);
				
			Возврат Ответ;
			
		КонецЕсли;
		
		База = инфоБазы.База;
			
	КонецЕсли;
	
	РегистрыСведений.Отчеты_RepEr.ДобавитьЗапись(ДанныеОтчета,,, База);
	
	Возврат Новый HTTPСервисОтвет(200);
	
КонецФункции










