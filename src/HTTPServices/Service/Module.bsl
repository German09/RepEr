// @strict-types

// Сервис для баз, которые отправляют ошибки в RepEr: пользователи, сообщившие об ошибках по задачам,
// и лента исправлений из GitLab. Базы обращаются к нему из расширения RepEr под пользователем RepEr
// с ролью ПолучениеИсправлений_RepEr: данные сервис читает в привилегированном режиме.

#Область ОбработчикиСобытий

//Уникальные пользователи, сообщившие об ошибке, по ключу задачи
//	GET http://localhost/reper/hs/service/InfoBase/issue/PROJECT-123/users
//Ответ - JSON-массив имен пользователей: ["Пользователь1", "Пользователь2"]
//Пустой массив, если задача не найдена; 404, если не найдена информационная база
//
Функция ПользователиЗадачиПолучить(Запрос)
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ИнформационнаяБаза = ИнформационнаяБаза(Запрос);
		Если ЗначениеЗаполнено(ИнформационнаяБаза) Тогда
			Идентификатор 		= Строка(Запрос.ПараметрыURL.Получить("IssueKey"));
			Идентификаторы 		= Новый Массив; //Массив из Строка
			Идентификаторы.Добавить(Идентификатор);
			ПользователиЗадач	= Документы.ОтчетыОбОшибках_RepEr.ПользователиЗадач(Идентификаторы, ИнформационнаяБаза);
			ИменаПользователей	= ПользователиЗадач.Получить(ВРег(СокрЛП(Идентификатор))); //Массив из Строка
			Ответ 				= ОтветJSON(ИменаПользователей);
		Иначе
			Ответ = ОтветИнформационнаяБазаНеНайдена(Запрос);
		КонецЕсли;
	Исключение
		Ответ = ПодготовитьОтветОбОшибке("ПользователиЗадачиПолучить");
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Ответ;
КонецФункции

//Количество уникальных пользователей, сообщивших об ошибке, по массиву ключей задач
//	POST http://localhost/reper/hs/service/InfoBase/issues/users/count
//	Тело - JSON-массив ключей задач: ["PROJECT-123", "PROJECT-456"]
//Ответ - JSON-массив в порядке запроса: [{"issue": "PROJECT-123", "users": 15}, {"issue": "PROJECT-456", "users": 0}]
//400, если тело не массив строк; 404, если не найдена информационная база
//
Функция КоличествоПользователейЗадачПолучить(Запрос)
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ИнформационнаяБаза 	= ИнформационнаяБаза(Запрос);
		Идентификаторы 		= КлючиЗадачИзТела(Запрос);
		Если Не ЗначениеЗаполнено(ИнформационнаяБаза) Тогда
			Ответ = ОтветИнформационнаяБазаНеНайдена(Запрос);
		ИначеЕсли Идентификаторы = Неопределено Тогда
			Ответ = Новый HTTPСервисОтвет(400);
			Ответ.УстановитьТелоИзСтроки(НСтр("ru = 'Ожидается JSON-массив ключей задач, например [""PROJECT-123""]'"));
		Иначе
			ПользователиЗадач = Документы.ОтчетыОбОшибках_RepEr.ПользователиЗадач(Идентификаторы, ИнформационнаяБаза);
			Данные = Новый Массив; //Массив из Структура
			Для Каждого Идентификатор ИЗ Идентификаторы Цикл
				ИменаПользователей = ПользователиЗадач.Получить(ВРег(Идентификатор)); //Массив из Строка
				Данные.Добавить(Новый Структура("issue, users", Идентификатор, ИменаПользователей.Количество()));
			КонецЦикла;
			Ответ = ОтветJSON(Данные);
		КонецЕсли;
	Исключение
		Ответ = ПодготовитьОтветОбОшибке("КоличествоПользователейЗадачПолучить");
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Ответ;
КонецФункции

//Страница версии ленты исправлений в GitLab - для ссылки в списке исправлений базы
//	GET http://localhost/reper/hs/service/InfoBase/patches/1.3.19.01
//Ответ - JSON: {"page": "https://<сервер GitLab>/<группа>/<проект>/-/packages/123"}
//404, если не найдена информационная база или у нее нет репозитория GitLab
//
Функция ИсправленияВерсииПолучить(Запрос)
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Ответ 		= Неопределено;
		Настройка 	= НастройкаЛенты(Запрос, Ответ);
		Если Ответ = Неопределено Тогда
			Версия 		= Строка(Запрос.ПараметрыURL.Получить("Version"));
			Страница 	= РепозиторииGitLab_RepEr.СтраницаВерсииЛентыИсправлений(Настройка, Версия);
			Ответ 		= ОтветJSON(Новый Структура("page", Страница));
		КонецЕсли;
	Исключение
		Ответ = ПодготовитьОтветОбОшибке("ИсправленияВерсииПолучить");
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Ответ;
КонецФункции

//Файл ленты исправлений: оглавление index.json или архив исправления
//	GET http://localhost/reper/hs/service/InfoBase/patches/1.3.19.01/index.json
//Лента - generic-пакет в реестре пакетов первого используемого репозитория GitLab информационной базы,
//читается токеном его настройки подключения: deploy-токен в базах не нужен.
//Оглавления версии, для которой исправлений еще не публиковали, нет - ответ 200 с пустым оглавлением
//{"patches": [], "not_found": true}, чтобы база отличала его от ошибки подключения.
//404 - не найдена информационная база, у нее нет репозитория GitLab или в ленте нет архива;
//502 - GitLab не ответил или не принял токен настройки подключения
//
Функция ФайлИсправленийПолучить(Запрос)
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Ответ 		= Неопределено;
		Настройка 	= НастройкаЛенты(Запрос, Ответ);
		Если Ответ = Неопределено Тогда
			Ответ = ОтветФайлЛенты(Запрос, Настройка);
		КонецЕсли;
	Исключение
		Ответ = ПодготовитьОтветОбОшибке("ФайлИсправленийПолучить");
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Ответ;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Информационная база по параметру URL InfoBaseCode.
// 
// Параметры:
//  Запрос - HTTPСервисЗапрос - Запрос к сервису
// 
// Возвращаемое значение:
//  СправочникСсылка.ИнформационныеБазы_RepEr - Пустая ссылка, если база с таким кодом не найдена
Функция ИнформационнаяБаза(Запрос)
	Код = Строка(Запрос.ПараметрыURL.Получить("InfoBaseCode"));
	Возврат ОбщегоНазначенияПовтИсп_RepEr.ПолучитьИнфоБазу(ВРег(Код));
КонецФункции

// Ключи задач из тела запроса без пробелов и повторов, в порядке передачи.
// 
// Параметры:
//  Запрос - HTTPСервисЗапрос - Запрос к сервису, тело - JSON-массив строк
// 
// Возвращаемое значение:
//  Массив из Строка, Неопределено - Неопределено, если тело не JSON-массив строк
Функция КлючиЗадачИзТела(Запрос)
	Попытка
		Тело = ОбщегоНазначения_RepEr.СтрокаJSONВЗначение(Запрос.ПолучитьТелоКакСтроку());
	Исключение
		Тело = Неопределено;
	КонецПопытки;
	
	КлючиЗадач 	= Новый Массив; //Массив из Строка
	Корректно 	= ТипЗнч(Тело) = Тип("Массив");
	Если Корректно Тогда
		Добавленные = Новый Соответствие;
		Для Каждого Элемент ИЗ Тело Цикл
			Если ТипЗнч(Элемент) <> Тип("Строка") Тогда
				Корректно = Ложь;
				Прервать;
			КонецЕсли;
			Идентификатор = СокрЛП(Строка(Элемент));
			Если Добавленные.Получить(ВРег(Идентификатор)) = Неопределено Тогда
				Добавленные.Вставить(ВРег(Идентификатор), Истина);
				КлючиЗадач.Добавить(Идентификатор);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Результат = ?(Корректно, КлючиЗадач, Неопределено);
	Возврат Результат;
КонецФункции

// Подключение к проекту GitLab с лентой исправлений информационной базы из параметра URL InfoBaseCode.
// 
// Параметры:
//  Запрос 	- HTTPСервисЗапрос - Запрос к сервису
//  Ответ 	- HTTPСервисОтвет, Неопределено - Возвращаемый параметр: ответ об ошибке, если ленту читать неоткуда
// 
// Возвращаемое значение:
//  СправочникСсылка.НастройкиПодключений_RepEx, Неопределено - Неопределено, если ленту читать неоткуда
Функция НастройкаЛенты(Запрос, Ответ)
	Настройка 			= Неопределено;
	ИнформационнаяБаза 	= ИнформационнаяБаза(Запрос);
	Если Не ЗначениеЗаполнено(ИнформационнаяБаза) Тогда
		Ответ = ОтветИнформационнаяБазаНеНайдена(Запрос);
	ИначеЕсли БлокировкаРаботыСВнешнимиРесурсами.РаботаСВнешнимиРесурсамиЗаблокирована() Тогда
		Ответ = ОтветТекстом(503, НСтр("ru = 'В RepEr заблокирована работа с внешними ресурсами'"));
	Иначе
		Настройка = Репозитории_RepEr.НастройкаЛентыИсправлений(ИнформационнаяБаза);
		Если Не ЗначениеЗаполнено(Настройка) Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'У информационной базы с кодом %1 нет используемого репозитория GitLab с лентой исправлений'"),
				Запрос.ПараметрыURL.Получить("InfoBaseCode"));
			Настройка 	= Неопределено;
			Ответ 		= ОтветТекстом(404, ТекстОшибки);
		КонецЕсли;
	КонецЕсли;
	Возврат Настройка;
КонецФункции

// Файл ленты исправлений из GitLab. Оглавления версии, для которой исправлений еще не публиковали, в GitLab нет:
// тогда ответ - пустое оглавление с признаком not_found. GitLab отвечает 404 и на проект, которого не видно токену,
// поэтому перед пустым оглавлением проверяется доступ к проекту.
// 
// Параметры:
//  Запрос 		- HTTPСервисЗапрос - Запрос к сервису
//  Настройка 	- СправочникСсылка.НастройкиПодключений_RepEx - Подключение к проекту GitLab
// 
// Возвращаемое значение:
//  HTTPСервисОтвет
Функция ОтветФайлЛенты(Запрос, Настройка)
	Версия 			= Строка(Запрос.ПараметрыURL.Получить("Version"));
	ИмяФайла 		= Строка(Запрос.ПараметрыURL.Получить("FileName"));
	ЭтоОглавление 	= НРег(ИмяФайла) = "index.json";
	Файл 			= РепозиторииGitLab_RepEr.ФайлЛентыИсправлений(Настройка, Версия, ИмяФайла);
	
	Если Файл.КодСостояния = 200 Тогда
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", ?(ЭтоОглавление, "application/json; charset=utf-8", "application/octet-stream"));
		Ответ.УстановитьТелоИзДвоичныхДанных(Файл.Тело);
	ИначеЕсли Файл.КодСостояния = 404 И ЭтоОглавление Тогда
		Проект = РепозиторииGitLab_RepEr.ЗапросКПроекту(Настройка, "");
		Если Проект.КодСостояния = 200 Тогда
			Ответ = ОтветJSON(Новый Структура("patches, not_found", Новый Массив, Истина));
		Иначе
			Ответ = ОтветОшибкаGitLab(Настройка, Проект);
		КонецЕсли;
	ИначеЕсли Файл.КодСостояния = 404 Тогда
		Ответ = ОтветТекстом(404, СтрШаблон(НСтр("ru = 'В ленте исправлений версии %1 нет файла %2'"), Версия, ИмяФайла));
	Иначе
		Ответ = ОтветОшибкаGitLab(Настройка, Файл);
	КонецЕсли;
	
	Возврат Ответ;
КонецФункции

// Ответ 502: GitLab не ответил или не принял токен настройки подключения. Код ответа GitLab
// базе не передается: 401 она приняла бы за неверный пароль пользователя RepEr.
// 
// Параметры:
//  Настройка 	- СправочникСсылка.НастройкиПодключений_RepEx - Подключение к проекту GitLab
//  ОтветGitLab - см. РепозиторииGitLab_RepEr.ЗапросКПроекту
// 
// Возвращаемое значение:
//  HTTPСервисОтвет
Функция ОтветОшибкаGitLab(Настройка, ОтветGitLab)
	Если ОтветGitLab.КодСостояния = 0 Тогда
		Причина = ОтветGitLab.Описание;
	Иначе
		Причина = СтрШаблон(НСтр("ru = 'код ответа %1'"), ОтветGitLab.КодСостояния);
	КонецЕсли;
	ТекстОшибки = СтрШаблон(НСтр("ru = 'Проект GitLab недоступен по настройке подключения ""%1"": %2'"), Настройка, Причина);
	Возврат ОтветТекстом(502, ТекстОшибки);
КонецФункции

// Ответ с текстом.
// 
// Параметры:
//  КодСостояния 	- Число
//  Текст 			- Строка
// 
// Возвращаемое значение:
//  HTTPСервисОтвет
Функция ОтветТекстом(КодСостояния, Текст)
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "text/plain; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Текст, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции

// Ответ 200 с телом в JSON.
// 
// Параметры:
//  Данные - Структура, Массив из Произвольный - Сериализуемое значение
// 
// Возвращаемое значение:
//  HTTPСервисОтвет
Функция ОтветJSON(Данные)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ОбщегоНазначения_RepEr.ЗначениеВСтрокуJSON(Данные), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции

// Ответ 404 о ненайденной информационной базе.
// 
// Параметры:
//  Запрос - HTTPСервисЗапрос - Запрос к сервису
// 
// Возвращаемое значение:
//  HTTPСервисОтвет
Функция ОтветИнформационнаяБазаНеНайдена(Запрос)
	Ответ = Новый HTTPСервисОтвет(404);
	Ответ.УстановитьТелоИзСтроки(СтрШаблон(НСтр("ru = 'Информационная база с кодом %1 не найдена'"), Запрос.ПараметрыURL.Получить("InfoBaseCode")));
	Возврат Ответ;
КонецФункции

// Ответ 500 с записью ошибки в журнал регистрации.
// 
// Параметры:
//  ИмяМетода - Строка - Имя метода сервиса
// 
// Возвращаемое значение:
//  HTTPСервисОтвет
Функция ПодготовитьОтветОбОшибке(ИмяМетода)
	Ответ 		= Новый HTTPСервисОтвет(500);
	Комментарий	= ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	Ответ.УстановитьТелоИзСтроки(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Service." + ИмяМетода, УровеньЖурналаРегистрации.Ошибка, , , Комментарий);
	Возврат Ответ;
КонецФункции

#КонецОбласти
