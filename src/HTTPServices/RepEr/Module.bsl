
#Область ОбработчикиСобытий

// http://localhost/repper/hs/reper/InfoBase/
Функция getInfo(Запрос)
	Попытка 
		Ответ 				= Новый HTTPСервисОтвет(200);
		Разделитель			= Запрос.ПараметрыURL.Получить("InfoBaseCode");
		СтруктураЗапрос 	= ОбщегоНазначенияСервер_RepEr.ПолучитьСтруктуруЗапроса(Запрос.ПолучитьТелоКакСтроку(),Разделитель);
		//Подготовим ответ
		СтруктураОтвет 		= ПолучитьОтвет(СтруктураЗапрос);
		РегистрыСведений.Ошибки_RepEr.ДобавитьЗапись(СтруктураЗапрос);
		ДанныеОтвета = ОбщегоНазначенияСервер_RepEr.ЗначениеВСтрокуJSON(СтруктураОтвет);	
		Ответ.УстановитьТелоИзСтроки(ДанныеОтвета);
	Исключение
		Ответ = ПодготовитьОтветОбОшибке("getInfo");			
	КонецПопытки;		
	Возврат Ответ;
КонецФункции

Функция pushReport(Запрос)
	Попытка
		Ответ 			= Новый HTTPСервисОтвет(200);
		Разделитель		= Запрос.ПараметрыURL.Получить("InfoBaseCode");
		ДанныеОтчета 	= Запрос.ПолучитьТелоКакДвоичныеДанные();
		РегистрыСведений.Отчеты_RepEr.ДобавитьЗапись(Разделитель,Новый ХранилищеЗначения(ДанныеОтчета));
	Исключение
		Ответ = ПодготовитьОтветОбОшибке("pushReport");	
	КонецПопытки;		
	Возврат Ответ;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПодготовитьОтветОбОшибке(ИмяМетода)
	Ответ 		= Новый HTTPСервисОтвет(500);
	Ответ.УстановитьТелоИзСтроки(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("RepEr."+ИмяМетода,УровеньЖурналаРегистрации.Ошибка, , ,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	Возврат Ответ;
КонецФункции	

// Получить ответ.
// 
// Параметры:
//  СтруктураЗапроса -  см. ОбщегоНазначенияСервер_RepEr.ПолучитьСтруктуруЗапроса
// 
// Возвращаемое значение:
//  Структура - Получить ответ:
// * needSendReport - Булево - Данная ошибка должна быть отправлена в сервис регистрации
// * userMessage 	- Строка - С помощью данного свойства можно показать пользователю рекомендацию об ошибке.
// * dumpType 		- Число  - Тип дампа, который нужно приложить к отчету об ошибке (аналогичен значению атрибута type элемента dump файла logcfg.xml)
Функция ПолучитьОтвет(СтруктураЗапроса)
	Результат = Новый Структура;
	Результат.Вставить("needSendReport", 	ОтправлятьОтчет(СтруктураЗапроса)); 
	Результат.Вставить("userMessage", 		ОбщегоНазначенияСервер_RepEr.ПодготовитьСообщениеПользователю(СтруктураЗапроса));
	Результат.Вставить("dumpType", 			1);
	//дополним сам запрос чтобы записать это в регистр для возможного анализа ответов
	Для Каждого КлючЗнач ИЗ Результат Цикл
		СтруктураЗапроса.Вставить(КлючЗнач.Ключ,КлючЗнач.Значение);
	КонецЦикла;			
	Возврат Результат  
КонецФункции

// Отправлять отчет. Клиенту всегда даем возможность отправлять отчет. Серверу только если у нам еще не набралось N отчетов
// 
// Параметры:
//  СтруктураЗапроса 	- См. ОбщегоНазначенияСервер_RepEr.ПолучитьСтруктуруЗапроса
//  КолвДляСервера 		- Число - Требуемое кол-во очетов для ошибок сервера, после которых не следует отправлять их больше
// 
// Возвращаемое значение:
//  Булево - Отправлять отчет
Функция ОтправлятьОтчет(СтруктураЗапроса,КолвДляСервера = 6)
	Результат = Истина;
	Если Не ЗначениеЗаполнено(СтруктураЗапроса.clientStackHash) Тогда
		//это сервер
		ОтчетыОбОшибках	= ОбщегоНазначенияСервер_RepEr.ПолучитьОтчеты(СтруктураЗапроса);
		Результат = (ОтчетыОбОшибках.Количество()<КолвДляСервера);
	КонецЕсли;	
	Возврат Результат;
КонецФункции
	
#КонецОбласти	 
