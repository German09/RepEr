
#Область ОбработчикиСобытий

//http://localhost/repper/hs/reper/InfoBase/
Функция getInfo(Запрос)
	Ответ 		= Новый HTTPСервисОтвет(200);
	Разделитель			= Запрос.ПараметрыURL.Получить("InfoBaseCode");
	СтруктураЗапрос 	= СтроковыеФукнцииЛоггер.СтрокаJSONВЗначение(Запрос.ПолучитьТелоКакСтроку());
	//Подготовим ответ
	СтруктураОтвет 		= ПолучитьОтвет(СтруктураЗапрос);
	РегистрыСведений.Ошибки_RepEr.ДобавитьЗапись(Разделитель,СтруктураЗапрос);
	ДанныеОтвета = СтроковыеФукнцииЛоггер.ЗначениеВСтрокуJSON(СтруктураОтвет);	
	Ответ.УстановитьТелоИзСтроки(ДанныеОтвета);
	Возврат Ответ;
КонецФункции

Функция pushReport(Запрос)
	Ответ 			= Новый HTTPСервисОтвет(200);
	Разделитель		= Запрос.ПараметрыURL.Получить("InfoBaseCode");
	ДанныеОтчета 	= Запрос.ПолучитьТелоКакДвоичныеДанные();
	РегистрыСведений.Отчеты_RepEr.ДобавитьЗапись(Разделитель,Новый ХранилищеЗначения(ДанныеОтчета));
	Возврат Ответ;
КонецФункции

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

// Получить ответ.
// 
// Параметры:
//  СтруктураЗапроса - Произвольный - Структура запроса
// 
// Возвращаемое значение:
//  Структура - Получить ответ:
// * needSendReport - Булево - Данная ошибка должна быть отправлена в сервис регистрации
// * userMessage 	- Строка - С помощью данного свойства можно показать пользователю рекомендацию об ошибке.
// * dumpType 		- Число  - Тип дампа, который нужно приложить к отчету об ошибке (аналогичен значению атрибута type элемента dump файла logcfg.xml)
Функция ПолучитьОтвет(СтруктураЗапроса)
	Результат = Новый Структура;
	Результат.Вставить("needSendReport", 	Истина); 
	Результат.Вставить("userMessage", 		"Отправляем");
	Результат.Вставить("dumpType", 			1);
	//дополним сам запрос чтобы записать это в регистр для возможного анализа ответов
	Для Каждого КлючЗнач ИЗ Результат Цикл
		СтруктураЗапроса.Вставить(КлючЗнач.Ключ,КлючЗнач.Значение);
	КонецЦикла;			
	Возврат Результат  
КонецФункции
#КонецОбласти	 
