#Область ПрограммныйИнтерфейс
// Получить обработчик.
// 
// Параметры:
//  ТипОповещения - ПеречислениеСсылка.ТипыОповещений_RepEx
// 
// Возвращаемое значение:
// 	ОбщийМодуль 
Функция ПолучитьОбработчик(ТипОповещения) Экспорт
	Если ТипОповещения = Перечисления.ТипыОповещений_RepEx.Jira Тогда
		Возврат ОповещенияJira_RepEx;	
	КонецЕсли;		
КонецФункции

// Имя событий.
// 
// Возвращаемое значение:
//  Массив Из Строка
Функция ИмяСобытий() Экспорт
	Результат = Новый Массив;
	Результат.Добавить(ОповещенияJira_RepEx.ИмяСервиса());
	Возврат Результат;
КонецФункции	

#КонецОбласти

		