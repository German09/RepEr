#Область ПрограммныйИнтерфейс
// Получить обработчик.
// 
// Параметры:
//  Провайдер - ПеречислениеСсылка.Провайдер_RepEx
// 
// Возвращаемое значение:
// 	ОбщийМодуль 
Функция ПолучитьОбработчик(Провайдер) Экспорт
	Если Провайдер = Перечисления.Провайдер_RepEx.Jira Тогда
		Возврат ОповещенияJira_RepEx;	
	ИначеЕсли Провайдер = Перечисления.Провайдер_RepEx.GitHub Тогда
		Возврат ОповещенияGitHub_RepEx;	
	КонецЕсли;		
КонецФункции

// Получить обработчик по настройке подключения.
// 
// Параметры:
//  Настройка - СправочникСсылка.НастройкиПодключений_RepEx
// 
// Возвращаемое значение:
// 	ОбщийМодуль 
Функция ПолучитьОбработчикПоНастройке(Настройка) Экспорт
	Возврат ПолучитьОбработчик(Справочники.НастройкиПодключений_RepEx.Провайдер(Настройка));	
КонецФункции

// Имя событий.
// 
// Возвращаемое значение:
//  Массив Из Строка
Функция ИмяСобытий() Экспорт
	Результат = Новый Массив;
	Результат.Добавить(ОповещенияJira_RepEx.ИмяСервиса());
	Результат.Добавить(ОповещенияGitHub_RepEx.ИмяСервиса());
	Возврат Результат;
КонецФункции	

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Новый результат ответа.
// 
// Возвращаемое значение:
//  Структура:
//  * Ошибка 		- Строка
//  * Идентификатор - Строка
Функция НовыйРезультатОтвета() Экспорт
	Возврат Новый Структура("Ошибка,Идентификатор", "", "");
КонецФункции

// Имя скриншота.
// 
// Параметры:
//  Отчет - ДокументСсылка.ОтчетыОбОшибках_RepEr - Отчет
// 
// Возвращаемое значение:
//  Строка - Имя файла скриншота отчета
Функция ИмяСкриншота(Отчет) Экспорт
	Возврат СтрШаблон("%1.png",ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет, "Номер"));
КонецФункции

// Получить MIME-тип по расширению файла.
// 
// Параметры:
//  Расширение - Строка - Расширение файла
// 
// Возвращаемое значение:
//  Строка - MIME-тип
Функция ПолучитьMIME(Расширение) Экспорт
	Результат = "text/plain; charset=UTF-8";
	Если СтрЗаканчиваетсяНа(Расширение,"png") Тогда
		Результат = "image/png";
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Получить тему оповещения из наименования отчета.
// Убирает из наименования путь к модулю, чтобы тема выглядела лучше.
// Имеем
//	"Обработка.КонфигураторТоваров.Форма.Основная.Форма}: Поле объекта не обнаружено (Наименование)"
// Оставляем
//	"Поле объекта не обнаружено (Наименование)"
// 
// Параметры:
//  Отчет - ДокументСсылка.ОтчетыОбОшибках_RepEr - Отчет
// 
// Возвращаемое значение:
//  Строка - Тема оповещения
Функция ПолучитьТему(Отчет) Экспорт
	//@skip-check bsl-legacy-check-string-literal
	Результат 	= СтрЗаменить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет,"Наименование"), Символы.ПС, " ");
	Результат	= СтрЗаменитьПоРегулярномуВыражению(Результат, "(\{.*\}: )(.*)", "$2");
	Возврат Результат;
КонецФункции

// Получить имя расширения из стека отчета.
// 
// Параметры:
//  Отчет - ДокументСсылка.ОтчетыОбОшибках_RepEr - Отчет
// 
// Возвращаемое значение:
//  Строка, Неопределено - Имя расширения из первой заполненной строки стека
Функция ПолучитьИмяРасширенияИзСтека(Отчет) Экспорт
	Для Каждого СтрокаСтека ИЗ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет, "Стек").Выгрузить() Цикл
		Если ЗначениеЗаполнено(СтрокаСтека.Расширение) Тогда
			Возврат СокрЛП(СтрокаСтека.Расширение);
		КонецЕсли;
	КонецЦикла;
КонецФункции

// Получить номер родительской задачи из имени расширения.
// Формат имени: EF_9161_... или EF_FIRE_8550_...
// 
// Параметры:
//  ИмяРасширения - Строка - Имя расширения
// 
// Возвращаемое значение:
//  Строка, Неопределено - Номер родительской задачи
Функция ПолучитьНомерРодительскойЗадачиИзРасширения(ИмяРасширения) Экспорт
	Если Не ЗначениеЗаполнено(ИмяРасширения) Или Не СтрНачинаетсяС(ИмяРасширения, "EF") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Часть ИЗ СтрРазделить(ИмяРасширения, "_", Ложь) Цикл
		Если ЗначениеЗаполнено(Часть) И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Часть) Тогда
			Возврат Часть;
		КонецЕсли;
	КонецЦикла;
КонецФункции

#КонецОбласти

		
