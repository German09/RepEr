#Область ПрограммныйИнтерфейс
// Получить обработчик.
// 
// Параметры:
//  Провайдер - ПеречислениеСсылка.Провайдер_RepEx
// 
// Возвращаемое значение:
// 	ОбщийМодуль 
Функция ПолучитьОбработчик(Провайдер) Экспорт
	Если Провайдер = Перечисления.Провайдер_RepEx.Jira Тогда
		Возврат ОповещенияJira_RepEx;	
	ИначеЕсли Провайдер = Перечисления.Провайдер_RepEx.GitHub Тогда
		Возврат ОповещенияGitHub_RepEx;	
	КонецЕсли;		
КонецФункции

// Получить обработчик по настройке подключения.
// 
// Параметры:
//  Настройка - СправочникСсылка.НастройкиПодключений_RepEx
// 
// Возвращаемое значение:
// 	ОбщийМодуль 
Функция ПолучитьОбработчикПоНастройке(Настройка) Экспорт
	Возврат ПолучитьОбработчик(Справочники.НастройкиПодключений_RepEx.Провайдер(Настройка));	
КонецФункции

// Имя событий.
// 
// Возвращаемое значение:
//  Массив Из Строка
Функция ИмяСобытий() Экспорт
	Результат = Новый Массив;
	Результат.Добавить(ОповещенияJira_RepEx.ИмяСервиса());
	Результат.Добавить(ОповещенияGitHub_RepEx.ИмяСервиса());
	Возврат Результат;
КонецФункции	

// Используемые настройки информационной базы, которые относятся к отчету.
// Если в стеке отчета есть расширение из настроек - только настройки этого расширения, иначе настройки без расширения.
// Стек идет от первого вызова к месту ошибки: при нескольких расширениях решает ближайшее к месту ошибки.
// 
// Параметры:
//  Настройки 	- ТаблицаЗначений - Выгрузка табличной части Оповещения или Репозитории информационной базы
//  Отчет 		- ДокументСсылка.ОтчетыОбОшибках_RepEr - Отчет
// 
// Возвращаемое значение:
//  Массив из СтрокаТаблицыЗначений - В порядке строк настроек
Функция НастройкиОтчета(Настройки, Отчет) Экспорт
	БезРасширения 	= Новый Массив;
	ПоРасширениям 	= Новый Соответствие;
	Для Каждого Настройка ИЗ Настройки Цикл
		Если Настройка.Использовать Тогда
			ИмяРасширения = НРег(СокрЛП(Настройка.Расширение));
			Если ПустаяСтрока(ИмяРасширения) Тогда
				БезРасширения.Добавить(Настройка);
			ИначеЕсли ПоРасширениям.Получить(ИмяРасширения) = Неопределено Тогда
				ПоРасширениям.Вставить(ИмяРасширения, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Настройка));
			Иначе
				ПоРасширениям.Получить(ИмяРасширения).Добавить(Настройка);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Результат = БезРасширения;
	Если ПоРасширениям.Количество() Тогда
		Стек = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет, "Стек").Выгрузить();
		Для Индекс = 1 По Стек.Количество() Цикл
			ИмяРасширения 	= НРег(СокрЛП(Стек.Получить(Стек.Количество() - Индекс).Расширение));
			НайденныеСтроки = ПоРасширениям.Получить(ИмяРасширения);
			Если НайденныеСтроки <> Неопределено Тогда
				Результат = НайденныеСтроки;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Заводит задачу корневого отчета в подключении, если ее там еще нет: повтор ошибки регистрируется
// комментарием к этой задаче, а корневой отчет мог быть зарегистрирован в другом подключении
// до настройки расширения в информационной базе.
// 
// Параметры:
//  Обработчик 	- ОбщийМодуль - см. ПолучитьОбработчикПоНастройке
//  Настройка 	- СправочникСсылка.НастройкиПодключений_RepEx
//  Отчет 		- ДокументСсылка.ОтчетыОбОшибках_RepEr - Отчет, для которого регистрируется оповещение
// 
// Возвращаемое значение:
//  Строка - Текст ошибки, пустая, если задача есть или заведена
Функция ЗарегистрироватьОснование(Обработчик, Настройка, Отчет) Экспорт
	Результат = "";
	Основание = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет, "Основание");
	Если ЗначениеЗаполнено(Основание)
		И Неопределено = РегистрыСведений.КлючиОповещений_RepEx.ПолучитьЗапись(Основание, Настройка) Тогда
		Ответ 		= Обработчик.Зарегистрировать(Настройка, Основание);
		Результат 	= Ответ.Ошибка;
		Если ПустаяСтрока(Результат) Тогда
			РегистрыСведений.КлючиОповещений_RepEx.ЗаписатьКлюч(Основание, Настройка, Ответ.Идентификатор);
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Новый результат ответа.
// 
// Возвращаемое значение:
//  Структура:
//  * Ошибка 		- Строка
//  * Идентификатор - Строка
Функция НовыйРезультатОтвета() Экспорт
	Возврат Новый Структура("Ошибка,Идентификатор", "", "");
КонецФункции

// Имя скриншота.
// 
// Параметры:
//  Отчет - ДокументСсылка.ОтчетыОбОшибках_RepEr - Отчет
// 
// Возвращаемое значение:
//  Строка - Имя файла скриншота отчета
Функция ИмяСкриншота(Отчет) Экспорт
	Возврат СтрШаблон("%1.png",ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет, "Номер"));
КонецФункции

// Получить MIME-тип по расширению файла.
// 
// Параметры:
//  Расширение - Строка - Расширение файла
// 
// Возвращаемое значение:
//  Строка - MIME-тип
Функция ПолучитьMIME(Расширение) Экспорт
	Результат = "text/plain; charset=UTF-8";
	Если СтрЗаканчиваетсяНа(Расширение,"png") Тогда
		Результат = "image/png";
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Получить тему оповещения из наименования отчета.
// Убирает из наименования путь к модулю, чтобы тема выглядела лучше.
// Имеем
//	"Обработка.КонфигураторТоваров.Форма.Основная.Форма}: Поле объекта не обнаружено (Наименование)"
// Оставляем
//	"Поле объекта не обнаружено (Наименование)"
// 
// Параметры:
//  Отчет - ДокументСсылка.ОтчетыОбОшибках_RepEr - Отчет
// 
// Возвращаемое значение:
//  Строка - Тема оповещения
Функция ПолучитьТему(Отчет) Экспорт
	//@skip-check bsl-legacy-check-string-literal
	Результат 	= СтрЗаменить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет,"Наименование"), Символы.ПС, " ");
	Результат	= СтрЗаменитьПоРегулярномуВыражению(Результат, "(\{.*\}: )(.*)", "$2");
	Возврат Результат;
КонецФункции

// Получить имя расширения из стека отчета.
// 
// Параметры:
//  Отчет - ДокументСсылка.ОтчетыОбОшибках_RepEr - Отчет
// 
// Возвращаемое значение:
//  Строка, Неопределено - Имя расширения из первой заполненной строки стека
Функция ПолучитьИмяРасширенияИзСтека(Отчет) Экспорт
	Для Каждого СтрокаСтека ИЗ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет, "Стек").Выгрузить() Цикл
		Если ЗначениеЗаполнено(СтрокаСтека.Расширение) Тогда
			Возврат СокрЛП(СтрокаСтека.Расширение);
		КонецЕсли;
	КонецЦикла;
КонецФункции

// Получить номер родительской задачи из имени расширения.
// Формат имени: EF_9161_... или EF_FIRE_8550_...
// 
// Параметры:
//  ИмяРасширения - Строка - Имя расширения
// 
// Возвращаемое значение:
//  Строка, Неопределено - Номер родительской задачи
Функция ПолучитьНомерРодительскойЗадачиИзРасширения(ИмяРасширения) Экспорт
	Если Не ЗначениеЗаполнено(ИмяРасширения) Или Не СтрНачинаетсяС(ИмяРасширения, "EF") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Часть ИЗ СтрРазделить(ИмяРасширения, "_", Ложь) Цикл
		Если ЗначениеЗаполнено(Часть) И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Часть) Тогда
			Возврат Часть;
		КонецЕсли;
	КонецЦикла;
КонецФункции

#КонецОбласти

		
