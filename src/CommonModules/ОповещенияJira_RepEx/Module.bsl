#Область ПрограммныйИнтерфейс

// Зарегистрировать.
// 
// Параметры:
//  Настройка 	- СправочникСсылка.НастройкиПодключений_RepEx -
//  Отчет 		- ДокументСсылка.ОтчетыОбОшибках_RepEr -
// 
// Возвращаемое значение:
// 	см. ОтправитьЗапрос
Функция Зарегистрировать(Настройка, Отчет) Экспорт
	Основание 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет,"Основание");
	Ответ 		= НовыйРезультатОтвета();
	Если ЗначениеЗаполнено(Основание) Тогда
		//регистрация комментария
		НаборЗписей = РегистрыСведений.КлючиОповещений_RepEx.ПолучитьНабор(Основание); 	
		Для Каждого Запись ИЗ НаборЗписей Цикл
			Если Запись.ТипОповещения = ТипОповещения() Тогда
				Дополнения = Новый Структура("Тело",ПолучитьКомментарий(Настройка,Отчет));	
				Дополнения.Вставить("Адрес",	СтрШаблон("/%1/%2",Запись.Идентификатор,ПризнакКомментария()));	
				//ответ будет таким что в структуру его не разложить
				Дополнения.Вставить("Параметры",Новый Структура("ПараметрыПреобразованияJSON", Новый Структура("ПрочитатьВСоответствие", Истина)));	 
				Ответ = ОтправитьЗапрос(Настройка,Отчет, Дополнения);	
				Ключ = Запись.Идентификатор;	
				Если ПустаяСтрока(Ответ.Ошибка) Тогда
					ОтправитьФайлы(Настройка,Отчет,Ключ);			
				КонецЕсли;
			
			КонецЕсли;
		КонецЦикла;
	Иначе
		//Регистрация задачи
		Ответ  = ОтправитьЗапрос(Настройка,Отчет, Новый Структура("Тело",ПолучитьТело(Настройка,Отчет)));
		Ключ   = Ответ.Идентификатор;	
		Если ПустаяСтрока(Ответ.Ошибка) Тогда
			ОтправитьФайлы(Настройка,Отчет,Ключ);			
		КонецЕсли;
	КонецЕсли;			
	Возврат Ответ;	
КонецФункции

// Отменить регистрацию.
// 
// Параметры:
//  Настройка  	- СправочникСсылка.НастройкиПодключений_RepEx
//  Отчет 		- ДокументСсылка.ОтчетыОбОшибках_RepEr -
//  Ключ  		- Строка - Номер задачи из см. Зарегистрировать
// Возвращаемое значение:
// 	см. ОтправитьЗапрос
Функция ОтменитьРегистрацию(Настройка,Отчет,Ключ) Экспорт
	Основание 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет,"Основание");
	Ответ 		= НовыйРезультатОтвета();
	Если ЗначениеЗаполнено(Основание) Тогда
		//удаление комментария
		НаборЗписей = РегистрыСведений.КлючиОповещений_RepEx.ПолучитьНабор(Основание); 	
		Для Каждого Запись ИЗ НаборЗписей Цикл
			Если Запись.ТипОповещения = ТипОповещения() Тогда
				//удаление комментария задачи
				Дополнения = Новый Структура("Метод,Тело",2,Новый Структура);
				Дополнения.Вставить("Адрес",СтрШаблон("/%1/%3/%2",Запись.Идентификатор,Ключ,ПризнакКомментария()));	
				Ответ = ОтправитьЗапрос(Настройка,Отчет,Дополнения);
				Прервать;
			КонецЕсли;		
		КонецЦикла;	
	Иначе
		//удаление задачи
		Дополнения = Новый Структура("Метод,Тело,Адрес",2,Новый Структура,СтрШаблон("/%1",Ключ));	  
		Ответ = ОтправитьЗапрос(Настройка,Отчет,Дополнения);
	КонецЕсли;	
	Возврат Ответ;
КонецФункции

// Отменить регистрацию.
// 
// Параметры:
//  Настройка  	- СправочникСсылка.НастройкиПодключений_RepEx
//  Отчет 		- ДокументСсылка.ОтчетыОбОшибках_RepEr -
//  Ключ  		- Строка - Номер задачи из см. Зарегистрировать
// Возвращаемое значение:
// 	см. ОтправитьЗапрос
Функция ОбновитьРегистрацию(Настройка, Отчет, Ключ) Экспорт
	Основание 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет,"Основание");
	Ответ 		= НовыйРезультатОтвета();
	Если ЗначениеЗаполнено(Основание) Тогда
		//изменить комментарий
		НаборЗписей = РегистрыСведений.КлючиОповещений_RepEx.ПолучитьНабор(Основание); 	
		Для Каждого Запись ИЗ НаборЗписей Цикл
			Если Запись.ТипОповещения = ТипОповещения() Тогда
				Дополнения = Новый Структура("Метод,Тело",3,ПолучитьКомментарий(Настройка,Отчет));
				//ответ будет таким что в структуру его не разложить
				Дополнения.Вставить("Параметры",Новый Структура("ПараметрыПреобразованияJSON", Новый Структура("ПрочитатьВСоответствие", Истина)));	 
				Дополнения.Вставить("Адрес",СтрШаблон("/%1/%2",Запись.Идентификатор,ПризнакКомментария()));					
				Ответ 	= ОтправитьЗапрос(Настройка,Отчет,Дополнения);
				Ключ = Запись.Идентификатор;	
				Если ПустаяСтрока(Ответ.Ошибка) Тогда
					ОтправитьФайлы(Настройка,Отчет,Ключ);
				КонецЕсли;
				Прервать;	
			КонецЕсли;
		КонецЦикла;
	Иначе
		Дополнения = Новый Структура("Метод,Тело",3,ПолучитьТело(Настройка,Отчет));
		Дополнения.Вставить("Адрес",СтрШаблон("/%1",Ключ));				
		Ответ = ОтправитьЗапрос(Настройка,Отчет,Дополнения);
		Если ПустаяСтрока(Ответ.Ошибка) Тогда
			ОтправитьФайлы(Настройка,Отчет,Ключ);
		КонецЕсли;
	КонецЕсли;		
	Возврат Ответ;
КонецФункции

#КонецОбласти

