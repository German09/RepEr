#КонецОбласти	

#Область СлужебныеПроцедурыИФункции

//см. https://developer.atlassian.com/cloud/jira/platform/rest/v2/api-group-issue-attachments/#api-rest-api-2-issue-issueidorkey-attachments-post
//см. https://github.com/vbondarevsky/Connector#%D0%BE%D1%82%D0%BF%D1%80%D0%B0%D0%B2%D0%BA%D0%B0-%D1%84%D0%B0%D0%B9%D0%BB%D0%B0
//см. https://forum.infostart.ru/forum15/topic282586/
//КоннекторHTTP_RepEr.ЗакодироватьФайлы
Процедура ОтправитьФайлы(Настройка,Отчет,Ключ)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("X-Atlassian-Token",	"no-check");
	//@skip-check bsl-legacy-check-string-literal
	ИмяСкриншота = ИмяСкриншота(Отчет);
	Для Каждого Строка ИЗ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет,"Скриншоты").Выгрузить() Цикл
		НовФайл = Новый Структура;
		НовФайл.Вставить("Имя", 		"file");
		НовФайл.Вставить("ИмяФайла", 	ИмяСкриншота);
		НовФайл.Вставить("Данные", 		Строка.ДанныеХранилища.Получить());
		НовФайл.Вставить("Тип", 		ПолучитьMIME(Строка.Расширение));
		Дополнения = Новый Структура("Заголовки,Параметры",Заголовки,Новый Структура("Файлы", НовФайл));
		Дополнения.Вставить("Адрес",СтрШаблон("/%1/attachments",Ключ));		
		РезультатСтроки =  ОтправитьЗапрос(Настройка,Отчет,Дополнения);
		Если ЗначениеЗаполнено(РезультатСтроки.Ошибка) Тогда
			
		Иначе
			//тут получили ИД файла, пока не понятно куда его записать
						
		КонецЕсли;			
	КонецЦикла;			
КонецПроцедуры

Функция ИмяСкриншота(Отчет)
	Возврат СтрШаблон("%1.png",ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет, "Номер"));
КонецФункции


Функция ПолучитьMIME(Расщирение)
	Результат = "text/plain; charset=UTF-8";
	Если СтрЗаканчиваетсяНа(Расщирение,"png") Тогда
		Результат = "image/png";
	КонецЕсли;
	Возврат Результат;
КонецФункции			

// Получить тело.
// 
// Параметры:
//  Настройка 	- СправочникСсылка.НастройкиПодключений_RepEx - Настройка
//  Отчет 		- ДокументСсылка.ОтчетыОбОшибках_RepEr - Отчет
// 
// Возвращаемое значение:
//  Структура - Получить тело:
// * fields - Структура -:
// 	** description - Строка -
// 	** summary - Строка -
// 	** issuetype - Структура -:
// 		*** id - Строка -
// 	** priority - Структура -:
// 		*** name - Строка -
// 	** project - Структура -:
// 		*** key - Строка -
// 	** reporter - Структура -:
// 		*** name - Строка -
Функция ПолучитьТело(Настройка,Отчет)
	Реквизиты 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Настройка,"Разделитель,Логин");
	Поля 		= Новый Структура();
	Поля.Вставить("description",ПолучитьОписание(Отчет));
	Поля.Вставить("summary", 	ПолучитьТему(Отчет));
	Поля.Вставить("issuetype", 	Новый Структура("id",	"10303")); // Стандарт: Ошибка - 10303, Задача - 10301
	Поля.Вставить("priority", 	Новый Структура("name",	"Medium"));
	Поля.Вставить("project", 	Новый Структура("key",	Реквизиты.Разделитель));	
	Поля.Вставить("reporter", 	Новый Структура("name",	Реквизиты.Логин));
	Возврат Новый Структура("fields",Поля);
КонецФункции

// Получить тело.
// 
// Параметры:
//  Настройка 	- СправочникСсылка.НастройкиПодключений_RepEx - Настройка
//  Отчет 		- ДокументСсылка.ОтчетыОбОшибках_RepEr - Отчет
// 
// Возвращаемое значение:
//  Структура - Получить тело:
// * body - Строка -
Функция ПолучитьКомментарий(Настройка,Отчет)
	Поля = Новый Структура();
	Поля.Вставить("body",ПолучитьОписание(Отчет));
	Возврат Поля;
КонецФункции			

Функция ПолучитьОписание(Отчет)
	Строки = Новый Массив;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Отчет,"Пользователь,Пояснение,ВремяОшибки");
	Строки.Добавить(СтрШаблон("Дата: 			" + Формат(Реквизиты.ВремяОшибки,"ДЛФ=DDT;")));
	Строки.Добавить(СтрШаблон("Пользователь: 	" + Реквизиты.Пользователь));
	Строки.Добавить(СтрШаблон("!%1|thumbnail! ", ИмяСкриншота(Отчет)));
	Строки.Добавить(ПолучитьСтекВызова(Отчет));
	Строки.Добавить(ПолучитьРасшифровкуОшибок(Отчет));
	Строки.Добавить(СтрШаблон("[%1|%2]",Строка(Отчет),ОбщегоНазначения_RepEr.ПолучитьИнтернетСсылку(Отчет)));
	Строки.Добавить(СокрЛП(Реквизиты.Пояснение));
	Строки.Добавить(ПолучитьКоммиты(Отчет));
	Возврат СтрСоединить(Строки,Символы.ПС)
КонецФункции

Функция ПолучитьКоммиты(Отчет)
	КоммитыОтчета =  Репозитории_RepEr.ПолучитьКоммиты(Отчет);
	СтрокиМодулей  = ПолучитьСтроки(КоммитыОтчета);
	Если СтрокиМодулей.Количество() Тогда
		СтрокиМодулей.Вставить(0,"|Модуль||Коммиты|");
		Возврат "|"+СтрСоединить(СтрокиМодулей,"|"+Символы.ПС);	
	КонецЕсли;	 
КонецФункции

Функция ПолучитьСтроки(КоммитыОтчета)
	Результат 	= Новый Массив;
	Для Каждого Модуль ИЗ КоммитыОтчета Цикл
		КолонкиСтроки = Новый Массив;
		КолонкиСтроки.Добавить(СтрШаблон("[%1|%2]",Модуль.Ключ.Имя,Модуль.Ключ.Ссылка));
		КоммитыМодуля = ПолучитьКоммитыМодуля(Модуль.Значение);
		Если КоммитыМодуля.Количество() Тогда
			КолонкиСтроки.Добавить(" * " + СтрСоединить(КоммитыМодуля,Символы.ПС+" * "));
		Иначе	
			КолонкиСтроки.Добавить(" ");
		КонецЕсли;
		Результат.Добавить("|"+СтрСоединить(КолонкиСтроки,"|"));					
	КонецЦикла;
	Возврат Результат;		
КонецФункции

Функция ПолучитьКоммитыМодуля(КоммитыМодуля)
	Результат 	= Новый Массив;
	ДатаОт 		= (ТекущаяДатаСеанса() - 60*60*24*14); //смотрим на 2 недели назад
	Для Каждого Коммит ИЗ  КоммитыМодуля Цикл
		Если Коммит.Дата>ДатаОт Тогда
			Результат.Добавить(СтрШаблон("%1 от %2",СтрШаблон("[%1|%2]",Коммит.Заголовок,Коммит.Ссылка),Коммит.Дата));
		КонецЕсли;		
	КонецЦикла;
	Возврат Результат; 	
КонецФункции			

// Получить стек вызова.
// 
// Параметры:
//  Отчет - ДокументСсылка.ОтчетыОбОшибках_RepEr - Отчет
// 
// Возвращаемое значение:
//  Строка - Получить стек в формате возможном к помещению в стек EDT
//  
//Пример:
//	{ОбщийМодуль.ПродуктыВызовСервера.Модуль(98)}:Возврат ПродуктыПовтИсп.ПолучитьСостав(ВариантКомплИлиИдентификатор);
//	 {ОбщийМодуль.ПродуктыВызовСервера.Модуль(24)}:Состав = ПолучитьСостав(Идентификатор);
//	  {Справочник.ХарактеристикиНоменклатуры.Команда.Продукт.МодульКоманды(5)}:Продукт = ПродуктыВызовСервера.Получить(ПараметрКоманды,Ошибка);
//
Функция ПолучитьСтекВызова(Отчет)
	Строки = Новый Массив;
	Отступы = Новый Массив;
	Для Каждого Строка ИЗ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет,"Стек").Выгрузить() Цикл
		Строки.Добавить(СтрШаблон("%1{%3(%2)}:%4",СтрСоединить(Отступы),Формат(Строка.НомерСтрокиМодуля,"ЧЦ=10; ЧГ=;"),Строка.Модуль,Строка.СтрокаМодуля));
		Отступы.Добавить(" ");		
	КонецЦикла;	
	Возврат СтрШаблон("%1%2%3","{code:java}",СтрСоединить(Строки,Символы.ПС),"{code}");
КонецФункции

Функция ПолучитьРасшифровкуОшибок(Отчет)
	Строки = Новый Массив;
	Для Каждого Строка ИЗ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет,"Ошибки").Выгрузить() Цикл
		Если Не Строка.Тип = ОбщегоНазначенияКлиентСервер_RepEr.ПрограмнаяОшибка() Тогда
			//это ошибка не из стека
			Строки.Добавить(Строка.Ошибка);
		КонецЕсли;		
	КонецЦикла;	
	Возврат СтрШаблон("%1%2%1","{quote}",СтрСоединить(Строки,Символы.ПС));	
КонецФункции	

//Убираем из наименование модули, чтобы тема задачи лучше выглядела
//Имем 
//	"Обработка.КонфигураторТоваров.Форма.Основная.Форма}: Поле объекта не обнаружено (Наименование)";
//Оставляем
//	"Поле объекта не обнаружено (Наименование)"
Функция ПолучитьТему(Отчет)
	//@skip-check bsl-legacy-check-string-literal
	Результат 	= СтрЗаменить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет,"Наименование"), Символы.ПС, " ");
	Результат	= СтрЗаменитьПоРегулярномуВыражению(Результат, "(\{.*\}: )(.*)", "$2");
	Возврат Результат;
КонецФункции

// Отправить запрос.
// 
// Параметры:
//  Настройка 			- СправочникСсылка.НастройкиПодключений_RepEx -
//  Отчет				- ДокументСсылка.ОтчетыОбОшибках_RepEr -
//  
//  Дополнения 	- Структура:
//  	*Тело 		- Структура, Неопределено 	-
//  	*Адрес 		- Строка 					- Дополнение адреса
//  	*Параметры	- см. КоннекторHTTP_RepEr.НовыеПараметры
//  	*Заголовки	- Неопределено, Соответствие Из Строка -
//  	*Метод 		- Число - 	1 - Создание
//  							2 - Удаление
//  							3 - Изменение	
// 
// Возвращаемое значение:
//  Структура:  
//  * Ошибка		- Строка
//	* Идентификатор	- Строка
Функция ОтправитьЗапрос(Настройка, Отчет, Дополнения)
	Перем СтрОтвет;
	Перем СтрОшибки; 
	Результат 		= НовыйРезультатОтвета();
	Метод 			= ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Дополнения,"Метод",1);
	Тело 			= ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Дополнения,"Тело");
	
	Реквизиты 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Настройка,"Адрес,Логин");
	СтрАдреса 	= Новый Структура("ИмяСервиса,Логин",ИмяСервиса(),Реквизиты.Логин);
	СтрАдреса.Вставить("Пароль",ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Строка(Настройка.УникальныйИдентификатор())));
	СтрАдреса.Вставить("Адрес",	СтрШаблон("%1/rest/api/latest/issue",СокрЛП(Реквизиты.Адрес)));
		
	Сессия  		= КоннекторHTTP_RepEr.ПолучитьСессию(СтрАдреса,Результат.Ошибка,"Basic");
	Если ПустаяСтрока(Результат.Ошибка) Тогда
		Для Каждого ДопЗагловок ИЗ ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Дополнения,"Заголовки",Новый Соответствие()) Цикл
			Сессия.Заголовки.Вставить(ДопЗагловок.Ключ,ДопЗагловок.Значение);	
		КонецЦикла;	
		ДопПараметры 	= КоннекторHTTPКлиентСервер_RepEr.ДопПараметрыЗапроса(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Дополнения,"Параметры"));
		Адрес 			= СтрАдреса.Адрес + ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Дополнения,"Адрес","");
		Попытка
			Если Метод = 1 Тогда
				Если Не Тело = Неопределено Тогда 
					стрОтвет 	= КоннекторHTTP_RepEr.PostJson(Адрес,Тело,ДопПараметры,Сессия,ИмяСервиса(),Отчет);	
				Иначе
					//Это отправка файла
					//Уберем лишние заголовки, с ними будет 415 ошибка
					Для Каждого ЛишнийЗаголовок ИЗ КоннекторHTTP_RepEr.ЗаголовкиКонтента() Цикл
						Если Не Сессия.Заголовки.Получить(ЛишнийЗаголовок.Ключ) = Неопределено Тогда
							Сессия.Заголовки.Удалить(ЛишнийЗаголовок.Ключ);
						КонецЕсли;		
					КонецЦикла;	
					стрОтвет 	= КоннекторHTTP_RepEr.КакJson(КоннекторHTTP_RepEr.POST(Адрес,Тело,ДопПараметры,Сессия,ИмяСервиса(),Отчет));
				КонецЕсли;	
			ИначеЕсли Метод = 2 Тогда
				стрОтвет 	= КоннекторHTTP_RepEr.Delete(Адрес,Тело,ДопПараметры,Сессия,ИмяСервиса(),Отчет);
			ИначеЕсли Метод = 3 Тогда
				//По сути повторяет создание
				//используется в основном для тестирования функционала размещения новых задач
				Попытка
					стрОтвет 	= КоннекторHTTP_RepEr.PutJSON(Адрес,Тело,ДопПараметры,Сессия,ИмяСервиса(),Отчет);
				Исключение
					//всегда будет ошибка десериализации ответа в JSON
					стрОтвет 	= Неопределено;
				КонецПопытки			
			КонецЕсли;	
		Исключение
			Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Ошибки = Новый Массив;
		Если ТипЗнч(стрОтвет) = Тип("Структура") Тогда
			Если стрОтвет.Свойство("errors",стрОшибки) Тогда
				Для Каждого КлючЗначение ИЗ стрОшибки Цикл
					Ошибки.Добавить(КлючЗначение.Значение);	
				КонецЦикла;
				Результат.Ошибка = СтрШаблон("%1: ", ИмяСервиса(),СтрСоединить(Ошибки,"; "));
				Если стрОтвет.Свойство("errorMessages",Ошибки) И ТипЗнч(Ошибки) = Тип("Массив") И Ошибки.Количество() Тогда
					Если Не ПустаяСтрока(Результат.Ошибка)Тогда
						Ошибки.Добавить(Результат.Ошибка);
					КонецЕсли;	
					Результат.Ошибка =  СтрШаблон("%1: ", ИмяСервиса(),СтрСоединить(Ошибки,"; "));
				КонецЕсли;		
			ИначеЕсли стрОтвет.Свойство("key",Результат.Идентификатор) Тогда
				//тут все ок, номер задачи получили
			ИначеЕсли стрОтвет.Свойство("id",Результат.Идентификатор) Тогда
				//нет key но есть ID - это комментарий		
			КонецЕсли;
		ИначеЕсли ТипЗнч(стрОтвет) = Тип("Соответствие") Тогда
			//это в случае добавления комментария
			Если Не стрОтвет.Получить("errors")= Неопределено Тогда
				стрОшибки = стрОтвет.Получить("errors");
				Для Каждого КлючЗначение ИЗ стрОшибки Цикл
					Ошибки.Добавить(КлючЗначение.Значение);	
				КонецЦикла;
				Результат.Ошибка =  СтрШаблон("%1: ", ИмяСервиса(),СтрСоединить(Ошибки,"; "));
			ИначеЕсли Не стрОтвет.Получить("key") = Неопределено Тогда
				//тут все ок, номер задачи получили
				Результат.Идентификатор = стрОтвет.Получить("key");
			ИначеЕсли Не стрОтвет.Получить("id")= Неопределено Тогда
				//нет key но есть ID - это комментарий
				Результат.Идентификатор = стрОтвет.Получить("id");		
			КонецЕсли;	
		ИначеЕсли ТипЗнч(стрОтвет) = Тип("Массив") Тогда
			//это добавление файла
			Для Каждого сооСвойствФайла ИЗ стрОтвет Цикл
				Результат.Идентификатор = сооСвойствФайла.Получить("id");	
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;		
	Возврат Результат;	
КонецФункции

Функция НовыйРезультатОтвета()
	Возврат Новый Структура("Ошибка,Идентификатор","");
КонецФункции

Функция ПризнакКомментария()
	Возврат "comment";
КонецФункции	

#КонецОбласти	
