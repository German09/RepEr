#Область СлужебныеПроцедурыИФункции

//см. https://developer.atlassian.com/cloud/jira/platform/rest/v2/api-group-issue-attachments/#api-rest-api-2-issue-issueidorkey-attachments-post
//см. https://github.com/vbondarevsky/Connector#%D0%BE%D1%82%D0%BF%D1%80%D0%B0%D0%B2%D0%BA%D0%B0-%D1%84%D0%B0%D0%B9%D0%BB%D0%B0
//см. https://forum.infostart.ru/forum15/topic282586/
//КоннекторHTTP_RepEr.ЗакодироватьФайлы
Процедура ОтправитьФайлы(Настройка,Отчет,Ключ)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("X-Atlassian-Token",	"no-check");
	//@skip-check bsl-legacy-check-string-literal
	ИмяСкриншота = Оповещения_RepEr.ИмяСкриншота(Отчет);
	Для Каждого Строка ИЗ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет,"Скриншоты").Выгрузить() Цикл
		НовФайл = Новый Структура;
		НовФайл.Вставить("Имя", 		"file");
		НовФайл.Вставить("ИмяФайла", 	ИмяСкриншота);
		НовФайл.Вставить("Данные", 		Строка.ДанныеХранилища.Получить());
		НовФайл.Вставить("Тип", 		Оповещения_RepEr.ПолучитьMIME(Строка.Расширение));
		Дополнения = Новый Структура("Заголовки,Параметры",Заголовки,Новый Структура("Файлы", НовФайл));
		Дополнения.Вставить("Адрес",СтрШаблон("/%1/attachments",Ключ));		
		РезультатСтроки =  ОтправитьЗапрос(Настройка,Отчет,Дополнения);
		Если ЗначениеЗаполнено(РезультатСтроки.Ошибка) Тогда
			
		Иначе
			//тут получили ИД файла, пока не понятно куда его записать
						
		КонецЕсли;			
	КонецЦикла;			
КонецПроцедуры

// Получить тело.
// 
// Параметры:
//  Настройка 	- СправочникСсылка.НастройкиПодключений_RepEx - Настройка
//  Отчет 		- ДокументСсылка.ОтчетыОбОшибках_RepEr - Отчет
// 
// Возвращаемое значение:
//  Структура - Получить тело:
// * fields - Структура -:
// 	** description - Строка -
// 	** summary - Строка -
// 	** issuetype - Структура -:
// 		*** id - Строка -
// 	** priority - Структура -:
// 		*** name - Строка -
// 	** project - Структура -:
// 		*** key - Строка -
// 	** reporter - Структура -:
// 		*** name - Строка -
Функция ПолучитьТело(Настройка,Отчет)
	
	Возврат ПодготовитьСозданиеЗадачи(Настройка, Отчет).Тело;
	
КонецФункции

Функция ПодготовитьСозданиеЗадачи(Настройка, Отчет)
	
	Реквизиты 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Настройка,"Проект,Логин");
	Поля 		= Новый Структура();
	Поля.Вставить("description",ПолучитьОписание(Отчет));
	Поля.Вставить("summary", 	Оповещения_RepEr.ПолучитьТему(Отчет));
	Поля.Вставить("issuetype", 	Новый Структура("id", 	ТипыЗадач().Ошибка));
	Поля.Вставить("priority", 	Новый Структура("name",	"Medium"));
	Поля.Вставить("project", 	Новый Структура("key",	Реквизиты.Проект));	
	Если ЗначениеЗаполнено(Реквизиты.Логин) Тогда
		//при авторизации по токену логин не заполняется, автором станет владелец токена
		Поля.Вставить("reporter", 	Новый Структура("name",	Реквизиты.Логин));
	КонецЕсли;
	
	Результат = Новый Структура("Тело,КлючРодителяДляСвязи", Неопределено, Неопределено);
	Результат.КлючРодителяДляСвязи = ДополнитьТелоПодзадачейРасширения(Настройка, Отчет, Реквизиты.Проект, Поля);
	Результат.Тело = Новый Структура("fields", Поля);
	Возврат Результат;
	
КонецФункции

// Получить тело.
// 
// Параметры:
//  Настройка 	- СправочникСсылка.НастройкиПодключений_RepEx - Настройка
//  Отчет 		- ДокументСсылка.ОтчетыОбОшибках_RepEr - Отчет
// 
// Возвращаемое значение:
//  Структура - Получить тело:
// * body - Строка -
Функция ПолучитьКомментарий(Настройка,Отчет)
	Поля = Новый Структура();
	Поля.Вставить("body",ПолучитьОписание(Отчет));
	Возврат Поля;
КонецФункции			

Функция ПолучитьОписание(Отчет)
	Строки = Новый Массив;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Отчет,"Пользователь,Пояснение,ВремяОшибки");
	Строки.Добавить(СтрШаблон("Дата: 			" + Формат(Реквизиты.ВремяОшибки,"ДЛФ=DDT;")));
	Строки.Добавить(СтрШаблон("Пользователь: 	" + Реквизиты.Пользователь));
	Строки.Добавить(СтрШаблон("!%1|thumbnail! ", Оповещения_RepEr.ИмяСкриншота(Отчет)));
	Строки.Добавить(ПолучитьСтекВызова(Отчет));
	Строки.Добавить(ПолучитьРасшифровкуОшибок(Отчет));
	Строки.Добавить(СтрШаблон("[%1|%2]",Строка(Отчет),ОбщегоНазначения_RepEr.ПолучитьИнтернетСсылку(Отчет)));
	Строки.Добавить(СокрЛП(Реквизиты.Пояснение));
	Строки.Добавить(ПолучитьКоммиты(Отчет));
	Возврат СтрСоединить(Строки,Символы.ПС);
КонецФункции

Функция ПолучитьКоммиты(Отчет)
	КоммитыОтчета =  Репозитории_RepEr.ПолучитьКоммиты(Отчет);
	СтрокиМодулей  = ПолучитьСтроки(КоммитыОтчета);
	Если СтрокиМодулей.Количество() Тогда
		СтрокиМодулей.Вставить(0,"|Модуль||Коммиты|");
		Возврат "|"+СтрСоединить(СтрокиМодулей,"|"+Символы.ПС)+"|";	
	КонецЕсли;	 
КонецФункции

Функция ПолучитьСтроки(КоммитыОтчета)
	Результат 	= Новый Массив;
	Для Каждого Модуль ИЗ КоммитыОтчета Цикл
		КолонкиСтроки = Новый Массив;
		КолонкиСтроки.Добавить(СтрШаблон("[%1|%2]",Модуль.Ключ.Имя,Модуль.Ключ.Ссылка));
		КоммитыМодуля = ПолучитьКоммитыМодуля(Модуль.Значение);
		Если КоммитыМодуля.Количество() Тогда
			КолонкиСтроки.Добавить(" * " + СтрСоединить(КоммитыМодуля,Символы.ПС+" * "));
		Иначе	
			КолонкиСтроки.Добавить(" ");
		КонецЕсли;
		Результат.Добавить("|"+СтрСоединить(КолонкиСтроки,"|"));					
	КонецЦикла;
	Возврат Результат;		
КонецФункции

Функция ПолучитьКоммитыМодуля(КоммитыМодуля)
	Результат 	= Новый Массив;
	ДатаОт 		= (ТекущаяДатаСеанса() - 60*60*24*14); //смотрим на 2 недели назад
	Для Каждого Коммит ИЗ  КоммитыМодуля Цикл
		Если Коммит.Дата>ДатаОт Тогда
			Результат.Добавить(СтрШаблон("%2 %1",СтрШаблон("[%1|%2]",Коммит.Заголовок,Коммит.Ссылка),Коммит.Дата));
			Если Результат.Количество() = 3 Тогда
				//не больше
				Прервать;
			КонецЕсли;	
		КонецЕсли;		
	КонецЦикла;
	Возврат Результат; 	
КонецФункции			

// Получить стек вызова.
// 
// Параметры:
//  Отчет - ДокументСсылка.ОтчетыОбОшибках_RepEr - Отчет
// 
// Возвращаемое значение:
//  Строка - Получить стек в формате возможном к помещению в стек EDT
//  
//Пример:
//	{ОбщийМодуль.ПродуктыВызовСервера.Модуль(98)}:Возврат ПродуктыПовтИсп.ПолучитьСостав(ВариантКомплИлиИдентификатор);
//	 {ОбщийМодуль.ПродуктыВызовСервера.Модуль(24)}:Состав = ПолучитьСостав(Идентификатор);
//	  {Справочник.ХарактеристикиНоменклатуры.Команда.Продукт.МодульКоманды(5)}:Продукт = ПродуктыВызовСервера.Получить(ПараметрКоманды,Ошибка);
//
Функция ПолучитьСтекВызова(Отчет)
	Строки = Новый Массив;
	Отступы = Новый Массив;
	Для Каждого Строка ИЗ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет,"Стек").Выгрузить() Цикл
		Строки.Добавить(СтрШаблон("%1{%3(%2)}:%4",СтрСоединить(Отступы),Формат(Строка.НомерСтрокиМодуля,"ЧЦ=10; ЧГ=;"),Строка.Модуль,Строка.СтрокаМодуля));
		Отступы.Добавить(" ");		
	КонецЦикла;	
	Возврат СтрШаблон("%1%2%3","{code:java}",СтрСоединить(Строки,Символы.ПС),"{code}");
КонецФункции

Функция ПолучитьРасшифровкуОшибок(Отчет)
	Строки = Новый Массив;
	Для Каждого Строка ИЗ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет,"Ошибки").Выгрузить() Цикл
		Если Не Строка.Тип = ОбщегоНазначенияКлиентСервер_RepEr.ПрограмнаяОшибка() Тогда
			//это ошибка не из стека
			Строки.Добавить(Строка.Ошибка);
		КонецЕсли;		
	КонецЦикла;	
	Возврат СтрШаблон("%1%2%1","{quote}",СтрСоединить(Строки,Символы.ПС));	
КонецФункции	

Функция ДополнитьТелоПодзадачейРасширения(Настройка, Отчет, КодПроекта, Поля)
	
	ИмяРасширения = Оповещения_RepEr.ПолучитьИмяРасширенияИзСтека(Отчет);
	НомерРодителя = Оповещения_RepEr.ПолучитьНомерРодительскойЗадачиИзРасширения(ИмяРасширения);
	Если Не ЗначениеЗаполнено(НомерРодителя) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КлючРодителя = СтрШаблон("%1-%2", КодПроекта, НомерРодителя);
	ПоляРодителя = ПолучитьПоляРодительскойЗадачи(Настройка, Отчет, КлючРодителя);
	Если ПоляРодителя = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СкопироватьПоляРодительскойЗадачи(ПоляРодителя, Поля);
	
	// Подзадачу в Jira можно создать только под задачей верхнего уровня.
	// Если у базовой задачи уже заполнен parent - она сама подзадача, вложение невозможно.
	Если ЗадачаЯвляетсяПодзадачейJira(ПоляРодителя) Тогда
		Возврат КлючРодителя;
	КонецЕсли;
	
	УстановитьСозданиеПодзадачиJira(Поля, КлючРодителя);
	
КонецФункции

//Типы задач смотрим тут (подставить свой домен) см. https://jira..ru/rest/api/latest/issuetype
//
Функция ТипыЗадач()
	Возврат Новый ФиксированнаяСтруктура("Ошибка,Задача,Подзадача", "10303", "10301", "10302");
КонецФункции

// Получает поля родительской задачи Jira.
//
// Параметры:
//  Настройка - СправочникСсылка.НастройкиПодключений_RepEx -
//  Отчет - ДокументСсылка.ОтчетыОбОшибках_RepEr -
//  КлючРодителя - Строка -
//
// Возвращаемое значение:
//  Соответствие Из Произвольный - поля задачи.
//  Неопределено - если задача не найдена.
Функция ПолучитьПоляРодительскойЗадачи(Настройка, Отчет, КлючРодителя) Экспорт
	
	ПараметрыСессии = ПолучитьПараметрыСессииJira(Настройка);
	Если Не ПустаяСтрока(ПараметрыСессии.Ошибка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыЗапроса = Новый Структура("fields", "assignee,components,fixVersions,parent");
	ДопПараметры = КоннекторHTTPКлиентСервер_RepEr.ДопПараметрыЗапроса();
	ДопПараметры.ПараметрыПреобразованияJSON.ПрочитатьВСоответствие = Истина;
	Адрес = СтрШаблон("%1/%2", ПараметрыСессии.БазовыйАдрес, КлючРодителя);
	
	Попытка
		ОтветHTTP = КоннекторHTTP_RepEr.Get(Адрес, ПараметрыЗапроса, ДопПараметры, ПараметрыСессии.Сессия, ИмяСервиса(), Отчет);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Если ОтветHTTP.КодСостояния <> 200 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрОтвет = КоннекторHTTP_RepEr.КакJson(ОтветHTTP, ДопПараметры.ПараметрыПреобразованияJSON);
	Если ТипЗнч(СтрОтвет) = Тип("Соответствие") Тогда
		Возврат СтрОтвет.Получить("fields");
	КонецЕсли;
	
КонецФункции

Функция ПолучитьПараметрыСессииJira(Настройка)
	
	Результат = Новый Структура("Ошибка,Сессия,БазовыйАдрес", "", Неопределено, "");
	Адрес 	  = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Настройка, "Адрес");
	СтрАдреса = Справочники.НастройкиПодключений_RepEx.ПараметрыАвторизации(Настройка, ИмяСервиса());
	СтрАдреса.Вставить("Адрес", СтрШаблон("%1/rest/api/latest/issue", СокрЛП(Адрес)));
	Результат.Сессия = КоннекторHTTP_RepEr.ПолучитьСессию(СтрАдреса, Результат.Ошибка, СтрАдреса.ТипАвторизации);
	Результат.БазовыйАдрес = СтрАдреса.Адрес;
	Возврат Результат;
	
КонецФункции

Процедура СкопироватьПоляРодительскойЗадачи(ПоляРодителя, Поля)
	
	Если ТипЗнч(ПоляРодителя) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
	
	Assignee = ПоляРодителя.Получить("assignee");
	Если Assignee <> Неопределено И ТипЗнч(Assignee) = Тип("Соответствие") Тогда
		Name = Assignee.Получить("name");
		Если ЗначениеЗаполнено(Name) Тогда
			Поля.Вставить("assignee", Новый Структура("name", Name));
		КонецЕсли;
	КонецЕсли;
	
	Components = ПоляРодителя.Получить("components");
	Если ТипЗнч(Components) = Тип("Массив") И Components.Количество() Тогда
		Поля.Вставить("components", СкопироватьМассивИдентификаторовJira(Components));
	КонецЕсли;
	
	FixVersions = ПоляРодителя.Получить("fixVersions");
	Если ТипЗнч(FixVersions) = Тип("Массив") И FixVersions.Количество() Тогда
		Поля.Вставить("fixVersions", СкопироватьМассивИдентификаторовJira(FixVersions));
	КонецЕсли;
	
КонецПроцедуры

Функция СкопироватьМассивИдентификаторовJira(ИсходныйМассив)
	
	Результат = Новый Массив;
	Для Каждого Элемент ИЗ ИсходныйМассив Цикл
		Если ТипЗнч(Элемент) = Тип("Соответствие") Тогда
			Id = Элемент.Получить("id");
			Если Id <> Неопределено Тогда
				Результат.Добавить(Новый Структура("id", Id));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Процедура УстановитьСозданиеПодзадачиJira(Поля, КлючРодителя)
	
	// Создание подзадачи в Jira: тип с subtask=true и ссылка на родителя.
	Поля.Вставить("issuetype", Новый Структура("id", ТипыЗадач().Подзадача));
	Поля.Вставить("parent", Новый Структура("key", КлючРодителя));
	
КонецПроцедуры

Функция ЗадачаЯвляетсяПодзадачейJira(ПоляЗадачи)
	
	Если ТипЗнч(ПоляЗадачи) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// При чтении из API подзадача определяется заполненным полем parent.
	Parent = ПоляЗадачи.Получить("parent");
	Если Parent = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ЗначениеЗаполнено(КлючЗадачиJira(Parent));
	
КонецФункции

Функция КлючЗадачиJira(ЗадачаJira)
	
	Если ТипЗнч(ЗадачаJira) = Тип("Структура") И ЗадачаJira.Свойство("key") Тогда
		Возврат ЗадачаJira.key;
	ИначеЕсли ТипЗнч(ЗадачаJira) = Тип("Соответствие") Тогда
		Возврат ЗадачаJira.Получить("key");
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ИмяТипаСвязиJira()
	
	Возврат "Relates";
	
КонецФункции

// Создает связь issueLink между задачами Jira.
//
// Параметры:
//  Настройка - СправочникСсылка.НастройкиПодключений_RepEx -
//  Отчет - ДокументСсылка.ОтчетыОбОшибках_RepEr -
//  КлючЗадачи - Строка -
//  КлючРодителя - Строка -
//
// Возвращаемое значение:
//  Строка - текст ошибки.
//  Неопределено - при успехе.
Функция СоздатьСвязьЗадачJira(Настройка, Отчет, КлючЗадачи, КлючРодителя)
	
	ПараметрыСессии = ПолучитьПараметрыСессииJira(Настройка);
	Если Не ПустаяСтрока(ПараметрыСессии.Ошибка) Тогда
		Возврат ПараметрыСессии.Ошибка;
	КонецЕсли;
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Настройка, "Адрес");
	Адрес = СтрШаблон("%1/rest/api/latest/issueLink", СокрЛП(Реквизиты.Адрес));
	
	Тело = Новый Структура;
	Тело.Вставить("type", Новый Структура("name", ИмяТипаСвязиJira()));
	Тело.Вставить("inwardIssue", Новый Структура("key", КлючРодителя));
	Тело.Вставить("outwardIssue", Новый Структура("key", КлючЗадачи));
	
	ДопПараметры = КоннекторHTTPКлиентСервер_RepEr.ДопПараметрыЗапроса();
	ДопПараметры.Вставить("Json", Тело);
	ДопПараметры.ПараметрыПреобразованияJSON.ПрочитатьВСоответствие = Истина;
	
	Попытка
		ОтветHTTP = КоннекторHTTP_RepEr.Post(Адрес, Неопределено, ДопПараметры, ПараметрыСессии.Сессия, ИмяСервиса(), Отчет);
	Исключение
		Возврат СтрШаблон("%1: %2", ИмяСервиса(), ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	// Успешный issueLink часто возвращает пустое тело - JSON парсить не нужно.
	Если ОтветHTTP.КодСостояния >= 200 И ОтветHTTP.КодСостояния < 300 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Ошибки = Новый Массив;
	Если Не ПустаяСтрока(СокрЛП(КоннекторHTTP_RepEr.КакТекст(ОтветHTTP))) Тогда
		СтрОтвет = РазобратьJsonОтветJiraКакСоответствие(ОтветHTTP, ДопПараметры.ПараметрыПреобразованияJSON);
		ДобавитьОшибкиJiraИзСоответствия(СтрОтвет, Ошибки);
	КонецЕсли;
	Если Ошибки.Количество() Тогда
		Возврат СтрШаблон("%1: %2", ИмяСервиса(), СтрСоединить(Ошибки, "; "));
	КонецЕсли;
	
	Возврат СтрШаблон("%1: %2", ИмяСервиса(), КоннекторHTTP_RepEr.КакИсключение(ОтветHTTP));
	
КонецФункции

// Разбирает тело HTTP-ответа Jira в соответствие.
//
// Параметры:
//  ОтветHTTP - Структура - HTTP-ответ коннектора.
//  ПараметрыПреобразованияJSON - Структура -
//
// Возвращаемое значение:
//  Соответствие Из Произвольный - разобранный JSON.
//  Неопределено - если тело ответа не JSON.
Функция РазобратьJsonОтветJiraКакСоответствие(ОтветHTTP, ПараметрыПреобразованияJSON)
	
	Попытка
		Возврат КоннекторHTTP_RepEr.КакJson(ОтветHTTP, ПараметрыПреобразованияJSON);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Добавляет ошибки Jira из соответствия в массив сообщений.
//
// Параметры:
//  ОтветJira - Неопределено, Соответствие Из Произвольный -
//  Ошибки - Массив Из Строка - дополняется найденными ошибками.
Процедура ДобавитьОшибкиJiraИзСоответствия(ОтветJira, Ошибки)
	
	Перем СтрОшибки;
	
	Если ТипЗнч(ОтветJira) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
	
	Если ОтветJira.Получить("errors") <> Неопределено Тогда
		СтрОшибки = ОтветJira.Получить("errors");
		Для Каждого КлючЗначение ИЗ СтрОшибки Цикл
			Ошибки.Добавить(КлючЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	Если ОтветJira.Получить("errorMessages") <> Неопределено Тогда
		Для Каждого Сообщение ИЗ ОтветJira.Получить("errorMessages") Цикл
			Ошибки.Добавить(Сообщение);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Отправить запрос.
// 
// Параметры:
//  Настройка 			- СправочникСсылка.НастройкиПодключений_RepEx -
//  Отчет				- ДокументСсылка.ОтчетыОбОшибках_RepEr -
//  
//  Дополнения 	- Структура:
//  	*Тело 		- Структура, Неопределено 	-
//  	*Адрес 		- Строка 					- Дополнение адреса
//  	*Параметры	- см. КоннекторHTTP_RepEr.НовыеПараметры
//  	*Заголовки	- Неопределено, Соответствие Из Строка -
//  	*Метод 		- Число - 	1 - Создание
//  							2 - Удаление
//  							3 - Изменение	
// 
// Возвращаемое значение:
//  Структура:  
//  * Ошибка		- Строка
//	* Идентификатор	- Строка
Функция ОтправитьЗапрос(Настройка, Отчет, Дополнения)
	Перем СтрОтвет;
	Перем СтрОшибки; 
	Результат 		= Оповещения_RepEr.НовыйРезультатОтвета();
	Метод 			= ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Дополнения,"Метод",1);
	Тело 			= ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Дополнения,"Тело");
	
	ПараметрыСессии = ПолучитьПараметрыСессииJira(Настройка);
	Результат.Ошибка = ПараметрыСессии.Ошибка;
	Сессия  		 = ПараметрыСессии.Сессия;
	Если ПустаяСтрока(Результат.Ошибка) Тогда
		Для Каждого ДопЗагловок ИЗ ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Дополнения,"Заголовки",Новый Соответствие()) Цикл
			Сессия.Заголовки.Вставить(ДопЗагловок.Ключ,ДопЗагловок.Значение);	
		КонецЦикла;	
		ДопПараметры 	= КоннекторHTTPКлиентСервер_RepEr.ДопПараметрыЗапроса(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Дополнения,"Параметры"));
		Адрес 			= ПараметрыСессии.БазовыйАдрес + ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Дополнения,"Адрес","");
		Попытка
			Если Метод = 1 Тогда
				Если Не Тело = Неопределено Тогда 
					стрОтвет 	= КоннекторHTTP_RepEr.PostJson(Адрес,Тело,ДопПараметры,Сессия,ИмяСервиса(),Отчет);	
				Иначе
					//Это отправка файла
					//Уберем лишние заголовки, с ними будет 415 ошибка
					Для Каждого ЛишнийЗаголовок ИЗ КоннекторHTTP_RepEr.ЗаголовкиКонтента() Цикл
						Если Не Сессия.Заголовки.Получить(ЛишнийЗаголовок.Ключ) = Неопределено Тогда
							Сессия.Заголовки.Удалить(ЛишнийЗаголовок.Ключ);
						КонецЕсли;		
					КонецЦикла;	
					стрОтвет 	= КоннекторHTTP_RepEr.КакJson(КоннекторHTTP_RepEr.POST(Адрес,Тело,ДопПараметры,Сессия,ИмяСервиса(),Отчет));
				КонецЕсли;	
			ИначеЕсли Метод = 2 Тогда
				стрОтвет 	= КоннекторHTTP_RepEr.Delete(Адрес,Тело,ДопПараметры,Сессия,ИмяСервиса(),Отчет);
			ИначеЕсли Метод = 3 Тогда
				//По сути повторяет создание
				//используется в основном для тестирования функционала размещения новых задач
				Попытка
					стрОтвет 	= КоннекторHTTP_RepEr.PutJSON(Адрес,Тело,ДопПараметры,Сессия,ИмяСервиса(),Отчет);
				Исключение
					//всегда будет ошибка десериализации ответа в JSON
					стрОтвет 	= Неопределено;
				КонецПопытки			
			КонецЕсли;	
		Исключение
			Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Ошибки = Новый Массив;
		Если ТипЗнч(стрОтвет) = Тип("Структура") Тогда
			Если стрОтвет.Свойство("errors",стрОшибки) Тогда
				Для Каждого КлючЗначение ИЗ стрОшибки Цикл
					Ошибки.Добавить(КлючЗначение.Значение);	
				КонецЦикла;
				Результат.Ошибка = СтрШаблон("%1: %2", ИмяСервиса(),СтрСоединить(Ошибки,"; "));
				Если стрОтвет.Свойство("errorMessages",Ошибки) И ТипЗнч(Ошибки) = Тип("Массив") И Ошибки.Количество() Тогда
					Если Не ПустаяСтрока(Результат.Ошибка)Тогда
						Ошибки.Добавить(Результат.Ошибка);
					КонецЕсли;	
					Результат.Ошибка =  СтрШаблон("%1: %2", ИмяСервиса(),СтрСоединить(Ошибки,"; "));
				КонецЕсли;		
			ИначеЕсли стрОтвет.Свойство("key",Результат.Идентификатор) Тогда
				//тут все ок, номер задачи получили
			ИначеЕсли стрОтвет.Свойство("id",Результат.Идентификатор) Тогда
				//нет key но есть ID - это комментарий		
			КонецЕсли;
		ИначеЕсли ТипЗнч(стрОтвет) = Тип("Соответствие") Тогда
			//это в случае добавления комментария
			Если Не стрОтвет.Получить("errors")= Неопределено Тогда
				стрОшибки = стрОтвет.Получить("errors");
				Для Каждого КлючЗначение ИЗ стрОшибки Цикл
					Ошибки.Добавить(КлючЗначение.Значение);	
				КонецЦикла;
				Результат.Ошибка =  СтрШаблон("%1: %2", ИмяСервиса(),СтрСоединить(Ошибки,"; "));
			ИначеЕсли Не стрОтвет.Получить("key") = Неопределено Тогда
				//тут все ок, номер задачи получили
				Результат.Идентификатор = стрОтвет.Получить("key");
			ИначеЕсли Не стрОтвет.Получить("id")= Неопределено Тогда
				//нет key но есть ID - это комментарий
				Результат.Идентификатор = стрОтвет.Получить("id");		
			КонецЕсли;	
		ИначеЕсли ТипЗнч(стрОтвет) = Тип("Массив") Тогда
			//это добавление файла
			Для Каждого сооСвойствФайла ИЗ стрОтвет Цикл
				Результат.Идентификатор = сооСвойствФайла.Получить("id");	
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;		
	Возврат Результат;	
КонецФункции

Функция ПризнакКомментария()
	Возврат "comment";
КонецФункции	

#КонецОбласти	
