 
#Область ПрограммныйИнтерфейс
 
 // Создать документ
 // 
 // Параметры:
 //  Выборка - См. РегламентныеОперацииСервер_RepEr.ПолучитьОтчеты
 // 
 // Возвращаемое значение:
 //  ДокументСсылка.ОтчетыОбОшибках_RepEr
 Функция СоздатьДокумент(Выборка) Экспорт
	Перем Результат; //ДокументСсылка.ОтчетыОбОшибках_RepEr
	НачатьТранзакцию();
	Попытка 								
			Результат = Документы.ОтчетыОбОшибках_RepEr.Добавить(Выборка);
			РегистрыСведений.Отчеты_RepEr.УдалитьЗапись(Выборка.Идентификатор);
		ЗафиксироватьТранзакцию();		
	Исключение
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("RepEr.Распаковка отчета",УровеньЖурналаРегистрации.Ошибка,Метаданные.РегистрыСведений.Отчеты_RepEr, Выборка.Идентификатор, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Если Не Результат = Неопределено Тогда
		//проведем документ, для регистрации ошибки
		Результат.ПолучитьОбъект().Записать(РежимЗаписиДокумента.Проведение,РежимПроведенияДокумента.Оперативный); 	
	КонецЕсли;	
	Возврат Результат;
КонецФункции

Функция ПолучитьИнтернетСсылку(Ссылка) Экспорт
	Возврат ОбщегоНазначенияСерверПовтИсп_RepEr.АдресПубликацииИнформационнойБазыВИнтернете()+ПолучитьНавигационнуюСсылку(Ссылка);
КонецФункции

// Подготовить сообщение пользователю.
// 
// Параметры:
//  СтруктураЗапроса - см. ПолучитьСтруктуруЗапроса
// 
// Возвращаемое значение:
// 	Строка 
Функция ПодготовитьСообщениеПользователю(СтруктураЗапроса) Экспорт
	Результат = "";
	Если ЗначениеЗаполнено(СтруктураЗапроса.clientStackHash) Тогда
		//это клиент ему нужно дать информацию о текущем состатоянии, для сервера это лишнее
		ОтчетыОбОшибках	= ПолучитьОтчеты(СтруктураЗапроса);
		Идентификаторы 	= ПолучититьИдентифкаторы(ОтчетыОбОшибках);
		ЧислоОшибок 	= ПолучитьОшибки(СтруктураЗапроса);
		 
		Если Идентификаторы.Количество() Тогда
			Результат = Результат+СтрШаблон("Мы зарегистрировали данную ошибку под номером %1.
	 		|Мы уже работаем над ее устранением.
	 		|При обращении в службу поддержки указывате данный номер.
	 		|Это ошибка возникала %2 раз.
	 		|Мы получили %3 отчета с дополнительной информацией.",СтрСоединить(Идентификаторы,", "), ЧислоОшибок, ОтчетыОбОшибках.Количество());
		ИначеЕсли ОтчетыОбОшибках.Количество() Тогда
			//сообщаем что отчеты получили, но еще не зарегистрировали
	 		Результат = Результат+СтрШаблон("Нас уведомили о %1 аналогичных ошибках и мы получили %2 отчета с дополнительной информацией.
	 		|В ближайшее время мы зарегистриуем ошибку и сообщим вам номер (при возникновении аналогичной ошибки).",ЧислоОшибок, ОтчетыОбОшибках.Количество());	 
		Иначе
			//просим пользоваттеля отправить отчет
			Если ЧислоОшибок Тогда
				Результат = Результат+СтрШаблон("Нас уведомили о %1 аналогичных ошибках, но к сожалению никто не отправил отчет с дополнительной информацией. Пожалуйста направьте отчет, мы зарегистриуем ошибку и устраним ее.",ЧислоОшибок);
			Иначе
				Результат = Результат+"Пожалуйста направьте отчет об ошибке с дополнительной информацией для устранения этой ошибки.";				 
			КонецЕсли;					 
		КонецЕсли;
		Результат = Результат + Символы.ПС+Символы.ПС+"С уважением, команда проекта "+СтруктураЗапроса.ИнформационнаяБаза.Наименование; //для акцентирования внимания			 
	КонецЕсли;
	Возврат Результат;		
КонецФункции


// Получить структуру запроса.
// https://its.1c.ru/db/v8323doc#bookmark:dev:TI000002264
// https://its.1c.ru/db/v8323doc#bookmark:dev:TI000002558
// 
// Параметры:
//  Запрос 	- Строка - Тектс запроса JSON 
//  База	- Строка - Код информационной базы
// 
// Возвращаемое значение:
//  Структура:
// 	*appName								- Строка -
// 	*appStackHash							- Строка -
// 	*appVersion								- Строка -
// 	*clientID								- Строка -
// 	*clientStackHash						- Строка -
// 	*configHash								- Строка -
// 	*configName								- Строка -
// 	*configurationInterfaceLanguageCode		- Строка -
// 	*configVersion							- Строка -
// 	*errorCategories 						- Массив из Строка - который содержит уникальные категории ошибок из списка ошибок
// 	*platformInterfaceLanguageCode			- Строка -
// 	*platformType							- Строка -
// 	*reportID								- Строка -
// 	*serverStackHash						- Строка -
// 	*systemCrash							- Строка -
//	*ИнформационнаяБаза						- СправочникСсылка.ИнформационныеБазы_RepEr -
//
Функция ПолучитьСтруктуруЗапроса(Запрос,База) Экспорт
	СтруктураЗапрос 	= СтрокаJSONВЗначение(Запрос);
	Если Не СтруктураЗапрос.Свойство("clientStackHash") Тогда
		СтруктураЗапрос.Вставить("clientStackHash","");
	КонецЕсли;
	Если Не СтруктураЗапрос.Свойство("appStackHash") Тогда
		СтруктураЗапрос.Вставить("appStackHash","");
	КонецЕсли;
	СтруктураЗапрос.Вставить("ИнформационнаяБаза", ОбщегоНазначенияСерверПовтИсп_RepEr.ПолучитьИнфоБазу(ВРег(База)));	
	Возврат СтруктураЗапрос;
КонецФункции	

#Область JSON

// Возвращает значение в виде JSON-строки.
// Преобразованы в JSON-строку (сериализованы) могут быть только те объекты,
// для которых в описании указано, что они сериализуются.
//
// Параметры:
//   Значение - Произвольный - Значение, которое необходимо сериализовать в JSON-строку.
//
// Возвращаемое значение:
//   Строка - JSON-строка представления значения в сериализованном виде.
//
Функция ЗначениеВСтрокуJSON(Значение) Экспорт
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(, Символы.Таб);
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	
	ЗаписатьJSON(ЗаписьJSON, Значение);
	
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

// Возвращает JSON-строку из параметра
//
// Параметры:
//   СтрокаJSON - Строка - JSON, который надо десериализовать в значение.
//
// Возвращаемое значение:
//   Произвольный - Значение полученное из JSON-строки
//
Функция СтрокаJSONВЗначение(СтрокаJSON) Экспорт
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Результат = ПрочитатьJSON(ЧтениеJSON, Ложь, "time");
	
	Возврат Результат;
	
КонецФункции

