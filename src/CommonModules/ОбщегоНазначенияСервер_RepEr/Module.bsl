// Получить отчеты.
// 
// Параметры:
//  СтруктураЗапроса - см. ПолучитьСтруктуруЗапроса
// 
// Возвращаемое значение:
//  Массив ИЗ ДокументСсылка.ОтчетыОбОшибках_RepEr
Функция ПолучитьОтчеты(СтруктураЗапроса) Экспорт  
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ОтчетыОбОшибках_RepEr.Ссылка
		|ИЗ
		|	Документ.ОтчетыОбОшибках_RepEr КАК ОтчетыОбОшибках_RepEr
		|ГДЕ
		|	ОтчетыОбОшибках_RepEr.appStackHash = &appStackHash
		|	И ОтчетыОбОшибках_RepEr.ПометкаУдаления = ЛОЖЬ
		|	И ОтчетыОбОшибках_RepEr.ИнформационнаяБаза = &ИнформационнаяБаза";
	
	Запрос.УстановитьПараметр("appStackHash", 		СтруктураЗапроса.appStackHash);
	Запрос.УстановитьПараметр("ИнформационнаяБаза", СтруктураЗапроса.ИнформационнаяБаза);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

// Получить отчеты.
// 
// Параметры:
//  СтруктураЗапроса - см. ПолучитьСтруктуруЗапроса
// 
// Возвращаемое значение:
//  Число
Функция ПолучитьОшибки(СтруктураЗапроса)  
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Ошибки.Идентификатор
		|ИЗ
		|	РегистрСведений.Ошибки_RepEr КАК Ошибки
		|ГДЕ
		|	Ошибки.appStackHash = &appStackHash
		|	И Ошибки.ИнформационнаяБаза = &ИнформационнаяБаза";
	
	Запрос.УстановитьПараметр("appStackHash", 		СтруктураЗапроса.appStackHash);
	Запрос.УстановитьПараметр("ИнформационнаяБаза", СтруктураЗапроса.ИнформационнаяБаза);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Возврат ТЗ.Количество();
КонецФункции

// Получитить идентифкаторы.
// 
// Параметры:
//  Отчеты  - Массив ИЗ ДокументСсылка.ОтчетыОбОшибках_RepEr
// 
// Возвращаемое значение:
//  Массив из Строка
Функция ПолучититьИдентифкаторы(Отчеты)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КлючиОповещений_RepEx.Идентификатор КАК Идентификатор
		|ИЗ
		|	РегистрСведений.КлючиОповещений_RepEx КАК КлючиОповещений_RepEx
		|ГДЕ
		|	КлючиОповещений_RepEx.Регистратор В (&Регистраторы)";
	
	Запрос.УстановитьПараметр("Регистраторы", Отчеты);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Идентификатор");
КонецФункции
	
