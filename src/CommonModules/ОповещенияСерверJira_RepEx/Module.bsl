#Область ПрограммныйИнтерфейс

// Зарегистрировать.
// 
// Параметры:
//  Настройка 	- СправочникСсылка.НастройкиПодключений_RepEx -
//  Отчет 		- ДокументСсылка.ОтчетыОбОшибках_RepEr -
// 
// Возвращаемое значение:
// 	Структура
//	* Ошибка 		- Строка - Описание ошибки
//	* Идентификатор	- Строка - Номер задачи
Функция Зарегистрировать(Настройка, Отчет) Экспорт
	Ответ = ОтправитьЗапрос(Настройка,ПолучитьТело(Настройка,Отчет));
	Если ПустаяСтрока(Ответ.Ошибка) Тогда
		ОтправитьФайлы(Настройка,Отчет,Ответ.Идентификатор);			
	КонецЕсли;	
	Возврат Ответ;	
КонецФункции

// Отменить регистрацию.
// 
// Параметры:
//  Настройка  	- СправочникСсылка.НастройкиПодключений_RepEx
//  Ключ  		- Строка - Номер задачи из см. Зарегистрировать
// Возвращаемое значение:
// 	Структура
//	* Ошибка 		- Строка - Описание ошибки
Функция ОтменитьРегистрацию(Настройка, Ключ) Экспорт
	Ответ = ОтправитьЗапрос(Настройка,Новый Структура,2,"/"+Ключ);
	Возврат Ответ;
КонецФункции

// Отменить регистрацию.
// 
// Параметры:
//  Настройка  	- СправочникСсылка.НастройкиПодключений_RepEx
//  Отчет 		- ДокументСсылка.ОтчетыОбОшибках_RepEr -
//  Ключ  		- Строка - Номер задачи из см. Зарегистрировать
// Возвращаемое значение:
// 	Структура
//	* Ошибка 		- Строка - Описание ошибки
Функция ОбновитьРегистрацию(Настройка, Отчет, Ключ) Экспорт
	Ответ = ОтправитьЗапрос(Настройка,ПолучитьТело(Настройка,Отчет),3,"/"+Ключ);
	Если ПустаяСтрока(Ответ.Ошибка) Тогда
		ОтправитьФайлы(Настройка,Отчет,Ключ);
	КонецЕсли;	
	Возврат Ответ;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//https://developer.atlassian.com/cloud/jira/platform/rest/v2/api-group-issue-attachments/#api-rest-api-2-issue-issueidorkey-attachments-post
//https://github.com/vbondarevsky/Connector#%D0%BE%D1%82%D0%BF%D1%80%D0%B0%D0%B2%D0%BA%D0%B0-%D1%84%D0%B0%D0%B9%D0%BB%D0%B0
//https://forum.infostart.ru/forum15/topic282586/
// см. КоннекторHTTP_RepEr.ЗакодироватьФайлы
Процедура ОтправитьФайлы(Настройка,Отчет,Ключ)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("X-Atlassian-Token",	"no-check");
	Для Каждого Строка ИЗ Отчет.Скриншоты Цикл
		НовФайл = Новый Структура;
		НовФайл.Вставить("Имя", 		"file");
		НовФайл.Вставить("ИмяФайла", 	Строка.Имя);
		НовФайл.Вставить("Данные", 		Строка.ДанныеХранилища.Получить());
		НовФайл.Вставить("Тип", 		ПолучитьMIME(Строка.Расширение));	
		РезультатСтроки =  ОтправитьЗапрос(Настройка,Неопределено,1,СтрШаблон("/%1/attachments",Ключ),Новый Структура("Файлы", НовФайл),Заголовки);
		Если ЗначениеЗаполнено(РезультатСтроки.Ошибка) Тогда
			
		Иначе
			//тут получили ИД файла, пока не понятно куда его записать
						
		КонецЕсли;			
	КонецЦикла;			
КонецПроцедуры

Функция ПолучитьMIME(Расщирение)
	Результат = "text/plain; charset=UTF-8";
	Если СтрЗаканчиваетсяНа(Расщирение,"png") Тогда
		Результат = "image/png";
	КонецЕсли;
	Возврат Результат;
КонецФункции			

// Получить тело.
// 
// Параметры:
//  Настройка 	- СправочникСсылка.НастройкиПодключений_RepEx - Настройка
//  Отчет 		- ДокументСсылка.ОтчетыОбОшибках_RepEr - Отчет
// 
// Возвращаемое значение:
//  Структура - Получить тело:
// * fields - Структура -:
// 	** description - Строка -
// 	** summary - Строка -
// 	** issuetype - Структура -:
// 		*** id - Строка -
// 	** priority - Структура -:
// 		*** name - Строка -
// 	** project - Структура -:
// 		*** key - Строка -
// 	** reporter - Структура -:
// 		*** name - Строка -
Функция ПолучитьТело(Настройка,Отчет)
	Поля = Новый Структура();
	Поля.Вставить("description",ПолучитьОписание(Отчет));
	Поля.Вставить("summary", 	ПолучитьТему(Отчет));
	Поля.Вставить("issuetype", 	Новый Структура("id",	"10303")); // Стандарт: Ошибка - 10303, Задача - 10301
	Поля.Вставить("priority", 	Новый Структура("name",	"Medium"));
	Поля.Вставить("project", 	Новый Структура("key",	Настройка.Разделитель));	
	Поля.Вставить("reporter", 	Новый Структура("name",	Настройка.Логин));
	Возврат Новый Структура("fields",Поля);
КонецФункции		

Функция ПолучитьОписание(Отчет)
	Строки = Новый Массив;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Отчет,"Пользователь,Пояснение,ВремяОшибки");
	Строки.Добавить(СтрШаблон("Дата: 			" + Формат(Реквизиты.ВремяОшибки,"ДЛФ=DDT;")));
	Строки.Добавить(СтрШаблон("Пользователь: 	" + Реквизиты.Пользователь));
	Строки.Добавить(ПолучитьСтекВызова(Отчет));
	Строки.Добавить(СтрШаблон("[%1|%2]",Строка(Отчет),ОбщегоНазначенияСервер_RepEr.ПолучитьИнтернетСсылку(Отчет)));
	Строки.Добавить(СокрЛП(Реквизиты.Пояснение));
	Возврат СтрСоединить(Строки,Символы.ПС)
КонецФункции

Функция ПолучитьСтекВызова(Отчет)
	Строки = Новый Массив;
	Ном = 0;
	Для Каждого Строка ИЗ Отчет.Стек Цикл
		Ном = Ном + 1;
		ОтступТаб = ""; // для описания проще по номерам отсутпы путают  //СтрЗаменить(СтрЗаменить(Формат(1,СтрШаблон("ЧЦ=%1; ЧВН=; ЧГ=;",Ном)),"0",Символы.Таб),"1",""); 
		Строки.Добавить(СтрШаблон("%1%2 %3 - %4",ОтступТаб,Формат(Строка.НомерСтрокиМодуля,"ЧЦ=3; ЧВН=; ЧГ=;"),Строка.Модуль,Строка.СтрокаМодуля));		
	КонецЦикла;	
	Возврат СтрШаблон("%1%2%3","{code:java}",СтрСоединить(Строки,Символы.ПС),"{code}");
КонецФункции

Функция ПолучитьТему(Отчет)
	Возврат СтрЗаменить(Отчет.Наименование, Символы.ПС, " ");
КонецФункции

// Отправить запрос.
// 
// Параметры:
//  Настройка 			- СправочникСсылка.НастройкиПодключений_RepEx -
//  Тело 				- Структура, Неопределено -
//  Метод 				- Число - 
//  						1 - Создание
//  						2 - Удаление
//  						3 - Изменение	
//  ДополнениеАдреса 	- Строка - Дополнение адреса
//  ДопПараметры		- Структура
//  ЗаголовкиОснова		- Соответствие Из Строка
// 
// Возвращаемое значение:
//  Структура:  
//  * Ошибка		- Строка
//	* Идентификатор	- Строка
Функция ОтправитьЗапрос(Настройка,Тело,Метод=1,ДополнениеАдреса="",ДопПараметры = Неопределено,ЗаголовкиОснова = Неопределено)
	Перем стрОтвет;
	Перем стрОшибки; 
	Результат 		= Новый Структура("Ошибка,Идентификатор");
	ТипАвторизации 	= "Basic";
	Пользователь	= СокрЛП(Настройка.Логин);
	УстановитьПривилегированныйРежим(Истина);
	Пароль 			= ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Строка(Настройка.УникальныйИдентификатор()));
	Token 			= ПолучитьBase64СтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзСтроки(""+Пользователь+ ":" + Пароль));	
	Если ТипЗнч(ЗаголовкиОснова) = Тип("Соответствие") Тогда
		Заголовки = ОбщегоНазначения.СкопироватьРекурсивно(ЗаголовкиОснова);
	Иначе
		Заголовки = Новый Соответствие;
	КонецЕсли;
	Если Не Тело = Неопределено Тогда
		//это может помещать отправке файла
		Заголовки.Вставить("Content-Type",   	"application/json");
		Заголовки.Вставить("Accept-Charset", 	"utf-8");
	КонецЕсли;	
	Заголовки.Вставить("Authorization", 	ТипАвторизации + " " + Token);
	
	Сессия = КоннекторHTTP_RepEr.СоздатьСессию();
	Сессия.Вставить("Заголовки", Заголовки);
	Хост 	= СокрЛП(Настройка.Адрес);
	Адрес 	= СтрШаблон("%1%3rest/api/latest/issue%2",Хост,ДополнениеАдреса,?(Прав(Хост,1)="/","","/"));
	Попытка
		Если Метод = 1 Тогда
			стрОтвет 	= КоннекторHTTP_RepEr.КакJson(КоннекторHTTP_RepEr.POST(Адрес,Тело,ДопПараметрыЗапроса(ДопПараметры),Сессия));
		ИначеЕсли Метод = 2 Тогда
			стрОтвет 	= КоннекторHTTP_RepEr.Delete(Адрес,Тело,ДопПараметрыЗапроса(ДопПараметры),Сессия);
		ИначеЕсли Метод = 3 Тогда
			//По сути повторяет создание
			//используется в основном для тестирования функционала размещения новых задач
			Попытка
				стрОтвет 	= КоннекторHTTP_RepEr.PutJSON(Адрес,Тело,ДопПараметрыЗапроса(ДопПараметры),Сессия);
			Исключение
				//всегда будет ошибка десериализации ответа в JSON
				стрОтвет 	= Неопределено;
			КонецПопытки			
		КонецЕсли;	
	Исключение
		Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Если ТипЗнч(стрОтвет) = Тип("Структура") Тогда
		Если стрОтвет.Свойство("errors",стрОшибки) Тогда
			мОшибки = Новый Массив;
			Для Каждого КлючЗначение ИЗ стрОшибки Цикл
				мОшибки.Добавить(КлючЗначение.Значение);	
			КонецЦикла;
			Результат.Ошибка =  СтрСоединить(мОшибки,"; ");
		ИначеЕсли стрОтвет.Свойство("key",Результат.Идентификатор) Тогда
			//тут все ок, номер задачи получили
		КонецЕсли;
	ИначеЕсли ТипЗнч(стрОтвет) = Тип("Массив") Тогда
		//это добавление файла
		Для Каждого сооСвойствФайла ИЗ стрОтвет Цикл
			Результат.Идентификатор = сооСвойствФайла.Получить("id");	
		КонецЦикла;	
	КонецЕсли;	
	Возврат Результат;	
КонецФункции

// Доп параметры запросов. Относительно стандартных
// 
// Параметры:
//  Основа - Неопределено,Структура - Основа
// 
// Возвращаемое значение:
//  Структура -- Доп параметры запросов::
// * Таймаут - Число -
// * ПараметрыПреобразованияJSON - Структура -::
// ** ПрочитатьВСоответствие - Булево -
Функция ДопПараметрыЗапроса(Основа = Неопределено)
	Если ТипЗнч(Основа) = Тип("Структура") Тогда
		Параметры = ОбщегоНазначения.СкопироватьРекурсивно(Основа);
	Иначе			 
		Параметры = Новый Структура;
	КонецЕсли;	
	Параметры.Вставить("Таймаут", 20);
	Параметры.Вставить("ПараметрыПреобразованияJSON", Новый Структура("ПрочитатьВСоответствие", Ложь)); //так проще получать информацию
	Возврат Параметры;
КонецФункции
#КонецОбласти	
