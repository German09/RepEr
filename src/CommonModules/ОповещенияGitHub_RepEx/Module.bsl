#Область ПрограммныйИнтерфейс

// Зарегистрировать.
// 
// Параметры:
//  Настройка 	- СправочникСсылка.НастройкиПодключений_RepEx -
//  Отчет 		- ДокументСсылка.ОтчетыОбОшибках_RepEr -
// 
// Возвращаемое значение:
// 	см. ОтправитьЗапрос
Функция Зарегистрировать(Настройка, Отчет) Экспорт
	Основание 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет,"Основание");
	Ответ 		= Оповещения_RepEr.НовыйРезультатОтвета();
	Если ЗначениеЗаполнено(Основание) Тогда
		// регистрация комментария к задаче родителя
		НаборЗписей = РегистрыСведений.КлючиОповещений_RepEx.ПолучитьНабор(Основание);
		Для Каждого Запись ИЗ НаборЗписей Цикл
			Если Справочники.НастройкиПодключений_RepEx.Провайдер(Запись.НастройкаПодключения) = Провайдер() Тогда
				Дополнения = Новый Структура("Тело", ПолучитьТелоКомментария(Отчет));
				Дополнения.Вставить("Адрес", СтрШаблон("/%1/comments", Запись.Идентификатор));
				Ответ = ОтправитьЗапрос(Настройка, Отчет, Дополнения);
			КонецЕсли;
		КонецЦикла;
	Иначе
		// создание задачи (issue)
		Дополнения = Новый Структура("Тело", ПолучитьТелоЗадачи(Отчет));
		Ответ = ОтправитьЗапрос(Настройка, Отчет, Дополнения);
	КонецЕсли;
	Возврат Ответ;
КонецФункции

// Отменить регистрацию.
// 
// Параметры:
//  Настройка 	- СправочникСсылка.НастройкиПодключений_RepEx -
//  Отчет 		- ДокументСсылка.ОтчетыОбОшибках_RepEr -
//  Ключ 		- Строка - Номер задачи или идентификатор комментария из см. Зарегистрировать
// 
// Возвращаемое значение:
// 	см. ОтправитьЗапрос
Функция ОтменитьРегистрацию(Настройка, Отчет, Ключ) Экспорт
	Основание 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет,"Основание");
	Ответ 		= Оповещения_RepEr.НовыйРезультатОтвета();
	Если ЗначениеЗаполнено(Основание) Тогда
		// удаление комментария
		Дополнения = Новый Структура("Метод", 2);
		Дополнения.Вставить("Адрес", СтрШаблон("/comments/%1", Ключ));
		Ответ = ОтправитьЗапрос(Настройка, Отчет, Дополнения);
	Иначе
		// закрытие задачи
		Дополнения = Новый Структура("Метод,Тело", 3, Новый Структура("state", "closed"));
		Дополнения.Вставить("Адрес", СтрШаблон("/%1", Ключ));
		Ответ = ОтправитьЗапрос(Настройка, Отчет, Дополнения);
	КонецЕсли;
	Возврат Ответ;
КонецФункции

// Обновить регистрацию.
// 
// Параметры:
//  Настройка 	- СправочникСсылка.НастройкиПодключений_RepEx -
//  Отчет 		- ДокументСсылка.ОтчетыОбОшибках_RepEr -
//  Ключ 		- Строка - Номер задачи или идентификатор комментария из см. Зарегистрировать
// 
// Возвращаемое значение:
// 	см. ОтправитьЗапрос
Функция ОбновитьРегистрацию(Настройка, Отчет, Ключ) Экспорт
	Основание 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет,"Основание");
	Ответ 		= Оповещения_RepEr.НовыйРезультатОтвета();
	Если ЗначениеЗаполнено(Основание) Тогда
		Дополнения = Новый Структура("Метод,Тело", 3, ПолучитьТелоКомментария(Отчет));
		Дополнения.Вставить("Адрес", СтрШаблон("/comments/%1", Ключ));
		Ответ = ОтправитьЗапрос(Настройка, Отчет, Дополнения);
	Иначе
		Дополнения = Новый Структура("Метод,Тело", 3, ПолучитьТелоЗадачи(Отчет));
		Дополнения.Вставить("Адрес", СтрШаблон("/%1", Ключ));
		Ответ = ОтправитьЗапрос(Настройка, Отчет, Дополнения);
	КонецЕсли;
	Возврат Ответ;
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Провайдер.
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.Провайдер_RepEx - Провайдер, который обслуживает этот модуль
Функция Провайдер() Экспорт
	Возврат Перечисления.Провайдер_RepEx.GitHub;
КонецФункции

// Имя сервиса.
// 
// Возвращаемое значение:
//  Строка - Имя сервиса
Функция ИмяСервиса() Экспорт
	Возврат "GitHub";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// см. https://docs.github.com/en/rest/issues/issues#create-an-issue
Функция ПолучитьТелоЗадачи(Отчет)
	Тело = Новый Структура;
	Тело.Вставить("title", Оповещения_RepEr.ПолучитьТему(Отчет));
	Тело.Вставить("body", ПолучитьОписание(Отчет));
	Возврат Тело;
КонецФункции

// см. https://docs.github.com/en/rest/issues/comments#create-an-issue-comment
Функция ПолучитьТелоКомментария(Отчет)
	Возврат Новый Структура("body", ПолучитьОписание(Отчет));
КонецФункции

Функция ПолучитьОписание(Отчет)
	Строки 		= Новый Массив;
	Реквизиты 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Отчет,"Пользователь,Пояснение,ВремяОшибки");
	Строки.Добавить(СтрШаблон("**Дата:** %1", Формат(Реквизиты.ВремяОшибки,"ДЛФ=DDT;")));
	Строки.Добавить(СтрШаблон("**Пользователь:** %1", Реквизиты.Пользователь));
	АдресЖурнала = Документы.ОтчетыОбОшибках_RepEr.СсылкаНаЖурналРегистрации(Отчет);
	Если ЗначениеЗаполнено(АдресЖурнала) Тогда
		Строки.Добавить(СтрШаблон("[%1](%2)", НСтр("ru = 'Журнал регистрации пользователя +/- 10 минут'"), АдресЖурнала));
	КонецЕсли;
	Строки.Добавить(СтрШаблон("_Скриншот: %1_", Оповещения_RepEr.ИмяСкриншота(Отчет)));
	Строки.Добавить(ПолучитьСтекВызова(Отчет));
	Строки.Добавить(ПолучитьРасшифровкуОшибок(Отчет));
	Строки.Добавить(СтрШаблон("[%1](%2)", Строка(Отчет), ОбщегоНазначения_RepEr.ПолучитьИнтернетСсылку(Отчет)));
	Строки.Добавить(СокрЛП(Реквизиты.Пояснение));
	СсылкаНаРодителя = ПолучитьСсылкуНаРодительскуюЗадачу(Отчет);
	Если ЗначениеЗаполнено(СсылкаНаРодителя) Тогда
		Строки.Добавить(СсылкаНаРодителя);
	КонецЕсли;
	Коммиты = ПолучитьКоммиты(Отчет);
	Если ЗначениеЗаполнено(Коммиты) Тогда
		Строки.Добавить(Коммиты);
	КонецЕсли;
	Возврат СтрСоединить(Строки, Символы.ПС + Символы.ПС);
КонецФункции

// Формирует ссылку на родительскую задачу GitHub по имени расширения из стека.
// 
// Параметры:
//  Отчет - ДокументСсылка.ОтчетыОбОшибках_RepEr - Отчет
// 
// Возвращаемое значение:
//  Строка - Markdown-ссылка на задачу или пустая строка
Функция ПолучитьСсылкуНаРодительскуюЗадачу(Отчет)
	ИмяРасширения = Оповещения_RepEr.ПолучитьИмяРасширенияИзСтека(Отчет);
	НомерРодителя = Оповещения_RepEr.ПолучитьНомерРодительскойЗадачиИзРасширения(ИмяРасширения);
	Если ЗначениеЗаполнено(НомерРодителя) Тогда
		Возврат СтрШаблон("Связано с #%1", НомерРодителя);
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ПолучитьСтекВызова(Отчет)
	Строки 	= Новый Массив;
	Отступы = Новый Массив;
	Для Каждого Строка ИЗ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет,"Стек").Выгрузить() Цикл
		Строки.Добавить(СтрШаблон("%1{%3(%2)}:%4", СтрСоединить(Отступы), Формат(Строка.НомерСтрокиМодуля,"ЧЦ=10; ЧГ=;"), Строка.Модуль, Строка.СтрокаМодуля));
		Отступы.Добавить(" ");
	КонецЦикла;
	Блок = Новый Массив;
	Блок.Добавить("```");
	Блок.Добавить(СтрСоединить(Строки, Символы.ПС));
	Блок.Добавить("```");
	Возврат СтрСоединить(Блок, Символы.ПС);
КонецФункции

Функция ПолучитьРасшифровкуОшибок(Отчет)
	Строки = Новый Массив;
	Для Каждого Строка ИЗ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет,"Ошибки").Выгрузить() Цикл
		Если Не Строка.Тип = ОбщегоНазначенияКлиентСервер_RepEr.ПрограмнаяОшибка() Тогда
			Строки.Добавить(СтрШаблон("> %1", Строка.Ошибка));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

Функция ПолучитьКоммиты(Отчет)
	КоммитыОтчета = Репозитории_RepEr.ПолучитьКоммиты(Отчет);
	Если КоммитыОтчета = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	СтрокиМодулей = ПолучитьСтрокиКоммитов(КоммитыОтчета);
	Если Не СтрокиМодулей.Количество() Тогда
		Возврат "";
	КонецЕсли;
	Таблица = Новый Массив;
	Таблица.Добавить("| Модуль | Коммиты |");
	Таблица.Добавить("| --- | --- |");
	Для Каждого СтрокаМодуля ИЗ СтрокиМодулей Цикл
		Таблица.Добавить(СтрокаМодуля);
	КонецЦикла;
	Возврат СтрСоединить(Таблица, Символы.ПС);
КонецФункции

Функция ПолучитьСтрокиКоммитов(КоммитыОтчета)
	Результат = Новый Массив;
	Для Каждого Модуль ИЗ КоммитыОтчета Цикл
		КоммитыМодуля = ПолучитьКоммитыМодуля(Модуль.Значение);
		ТекстКоммитов = ?(КоммитыМодуля.Количество(), СтрСоединить(КоммитыМодуля, "<br>"), " ");
		Результат.Добавить(СтрШаблон("| [%1](%2) | %3 |", Модуль.Ключ.Имя, Модуль.Ключ.Ссылка, ТекстКоммитов));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПолучитьКоммитыМодуля(КоммитыМодуля)
	Результат 	= Новый Массив;
	ДатаОт 		= (ТекущаяДатаСеанса() - 60*60*24*14); // смотрим на 2 недели назад
	Для Каждого Коммит ИЗ КоммитыМодуля Цикл
		Если Коммит.Дата > ДатаОт Тогда
			Результат.Добавить(СтрШаблон("%1 [%2](%3)", Коммит.Дата, Коммит.Заголовок, Коммит.Ссылка));
			Если Результат.Количество() = 3 Тогда
				// не больше
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Отправить запрос.
// 
// Параметры:
//  Настройка 	- СправочникСсылка.НастройкиПодключений_RepEx -
//  Отчет 		- ДокументСсылка.ОтчетыОбОшибках_RepEr -
//  Дополнения 	- Структура:
//  	* Тело 		- Структура, Неопределено 	-
//  	* Адрес 	- Строка 					- Дополнение адреса
//  	* Метод 	- Число - 	1 - Создание (POST)
//  							2 - Удаление (DELETE)
//  							3 - Изменение (PATCH)
// 
// Возвращаемое значение:
//  Структура:
//  * Ошибка 		- Строка
//  * Идентификатор 	- Строка
Функция ОтправитьЗапрос(Настройка, Отчет, Дополнения)
	Результат 	= Оповещения_RepEr.НовыйРезультатОтвета();
	Метод 		= ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Дополнения,"Метод",1);
	Тело 		= ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Дополнения,"Тело");

	ПараметрыСессии = ПолучитьПараметрыСессии(Настройка);
	Результат.Ошибка = ПараметрыСессии.Ошибка;
	Если Не ПустаяСтрока(Результат.Ошибка) Тогда
		Возврат Результат;
	КонецЕсли;

	ДопПараметры = КоннекторHTTPКлиентСервер_RepEr.ДопПараметрыЗапроса();
	ДопПараметры.ПараметрыПреобразованияJSON.ПрочитатьВСоответствие = Истина;
	Адрес = ПараметрыСессии.БазовыйАдрес + ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Дополнения,"Адрес","");

	Попытка
		Если Метод = 2 Тогда
			ОтветHTTP = КоннекторHTTP_RepEr.Delete(Адрес, Неопределено, ДопПараметры, ПараметрыСессии.Сессия, ИмяСервиса(), Отчет);
		Иначе
			ДопПараметры.Вставить("Json", Тело);
			Если Метод = 3 Тогда
				ОтветHTTP = КоннекторHTTP_RepEr.Patch(Адрес, Неопределено, ДопПараметры, ПараметрыСессии.Сессия);
			Иначе
				ОтветHTTP = КоннекторHTTP_RepEr.Post(Адрес, Неопределено, ДопПараметры, ПараметрыСессии.Сессия, ИмяСервиса(), Отчет);
			КонецЕсли;
		КонецЕсли;
	Исключение
		Результат.Ошибка = СтрШаблон("%1: %2", ИмяСервиса(), ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Результат;
	КонецПопытки;

	Если ОтветHTTP.КодСостояния >= 200 И ОтветHTTP.КодСостояния < 300 Тогда
		Если Не Метод = 2 Тогда
			ЗаполнитьИдентификатор(Результат, ОтветHTTP, ДопПараметры.ПараметрыПреобразованияJSON);
		КонецЕсли;
	Иначе
		Результат.Ошибка = ПолучитьТекстОшибки(ОтветHTTP, ДопПараметры.ПараметрыПреобразованияJSON);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Процедура ЗаполнитьИдентификатор(Результат, ОтветHTTP, ПараметрыПреобразованияJSON)
	Попытка
		СтрОтвет = КоннекторHTTP_RepEr.КакJson(ОтветHTTP, ПараметрыПреобразованияJSON);
	Исключение
		Возврат;
	КонецПопытки;
	Если ТипЗнч(СтрОтвет) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
	Значение = СтрОтвет.Получить("number");
	Если Значение = Неопределено Тогда
		Значение = СтрОтвет.Получить("id");
	КонецЕсли;
	Если Значение <> Неопределено Тогда
		Результат.Идентификатор = Формат(Значение, "ЧГ=; ЧН=0");
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьТекстОшибки(ОтветHTTP, ПараметрыПреобразованияJSON)
	Ошибки = Новый Массив;
	Попытка
		СтрОтвет = КоннекторHTTP_RepEr.КакJson(ОтветHTTP, ПараметрыПреобразованияJSON);
	Исключение
		СтрОтвет = Неопределено;
	КонецПопытки;
	Если ТипЗнч(СтрОтвет) = Тип("Соответствие") Тогда
		Сообщение = СтрОтвет.Получить("message");
		Если ЗначениеЗаполнено(Сообщение) Тогда
			Ошибки.Добавить(Сообщение);
		КонецЕсли;
		Детализация = СтрОтвет.Получить("errors");
		Если ТипЗнч(Детализация) = Тип("Массив") Тогда
			Для Каждого ЭлементОшибки ИЗ Детализация Цикл
				Если ТипЗнч(ЭлементОшибки) = Тип("Соответствие") Тогда
					Ошибки.Добавить(ПредставлениеОшибки(ЭлементОшибки));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если Не Ошибки.Количество() Тогда
		Ошибки.Добавить(КоннекторHTTP_RepEr.КакИсключение(ОтветHTTP));
	КонецЕсли;
	Возврат СтрШаблон("%1: %2", ИмяСервиса(), СтрСоединить(Ошибки, "; "));
КонецФункции

Функция ПредставлениеОшибки(ЭлементОшибки)
	Сообщение = ЭлементОшибки.Получить("message");
	Если ЗначениеЗаполнено(Сообщение) Тогда
		Возврат Сообщение;
	КонецЕсли;
	Возврат СтрШаблон("%1 (%2)", ЭлементОшибки.Получить("field"), ЭлементОшибки.Получить("code"));
КонецФункции

Функция ПолучитьПараметрыСессии(Настройка)
	Результат 	= Новый Структура("Ошибка,Сессия,БазовыйАдрес", "", Неопределено, "");
	//GitHub адресует репозиторий парой владелец/имя, владельцем выступает логин пользователя или организации
	Реквизиты 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Настройка, "Адрес,Логин,Проект");
	СтрАдреса 	= Справочники.НастройкиПодключений_RepEx.ПараметрыАвторизации(Настройка, ИмяСервиса());
	Результат.БазовыйАдрес = СтрШаблон("%1/repos/%2/%3/issues", СокрЛП(Реквизиты.Адрес), СокрЛП(Реквизиты.Логин), СокрЛП(Реквизиты.Проект));
	СтрАдреса.Вставить("Адрес", Результат.БазовыйАдрес);
	Результат.Сессия = КоннекторHTTP_RepEr.ПолучитьСессию(СтрАдреса, Результат.Ошибка, СтрАдреса.ТипАвторизации);
	Если ПустаяСтрока(Результат.Ошибка) Тогда
		Результат.Сессия.Заголовки.Вставить("Accept", "application/vnd.github+json");
		Результат.Сессия.Заголовки.Вставить("X-GitHub-Api-Version", "2022-11-28");
	КонецЕсли;
	Возврат Результат;
КонецФункции

