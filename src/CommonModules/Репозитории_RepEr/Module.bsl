// Возвращаемое значение:
//  Строка - путь к файлу GIT
//
Функция ПолучитьПутьКФайлу(Знач Модуль) Экспорт
	Для Каждого Имя ИЗ РепозиторииПовтИсп_RepEr.ИменаМетаданных() Цикл
		Если СтрНачинаетсяС(Модуль,Имя.Ключ) Тогда
			Для Каждого Элемент ИЗ Имя.Значение Цикл
				Попытка
				 	Результат = СтрЗаменитьПоРегулярномуВыражению(Модуль,Элемент.Выражение,Элемент.Замена);
				 	Если Не Результат = Модуль Тогда
				 		Возврат Результат;
				 	КонецЕсли;
				Исключение
					//Видимо какая то ошибка в выражении, нарочно прерываем чтобы заметить ее
					//Инф = ИнформацияОбОшибке();
					Прервать;
				КонецПопытки;			
			КонецЦикла; 
			Прервать; //ту почему то не смогли подобрать выражение	
		КонецЕсли;		
	КонецЦикла;		
КонецФункции

