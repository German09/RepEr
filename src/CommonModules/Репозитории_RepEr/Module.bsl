#Область ПрограммныйИнтерфейс
// Получить обработчик.
// 
// Параметры:
//  ТипОповещения - ПеречислениеСсылка.ТипыРепозиториев_RepEr
// 
// Возвращаемое значение:
// 	ОбщийМодуль 
Функция ПолучитьОбработчик(ТипОповещения) Экспорт
	Если ТипОповещения = Перечисления.ТипыРепозиториев_RepEr.GitLab Тогда
		Возврат РепозиторииGitLab_RepEr;	
	КонецЕсли;		
КонецФункции

// Имя событий.
// 
// Возвращаемое значение:
//  Массив Из Строка
Функция ИмяСобытий() Экспорт
	Результат = Новый Массив;
	Результат.Добавить(РепозиторииGitLab_RepEr.ИмяСервиса());
	Возврат Результат;
КонецФункции	

// Получить коммиты.
// 
// Параметры:
//  Отчет 	- ДокументСсылка.ОтчетыОбОшибках_RepEr
//  ДатаОт	- Дата - До от которой выводим коммиты
// 
// Возвращаемое значение:
// 	Соответствие Из КлючИЗначение:
//		*Ключ - Структура:
//  		**Имя			- Строка
//			**Путь 			- см. ПолучитьПутьКФайлу
//			**Подключение 	- СправочникСсылка.НастройкиПодключений_RepEx
//		*Значение - Массив ИЗ Структура:
//			**Заголовок - Строка
//	 		**Ссылка 	- Строка
//			**Дата		- Дата
Функция ПолучитьКоммиты(Отчет) Экспорт
	ИнфоБаза	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет,"ИнформационнаяБаза");				 		
	Если 	ЗначениеЗаполнено(ИнфоБаза) И 
			Не БлокировкаРаботыСВнешнимиРесурсами.РаботаСВнешнимиРесурсамиЗаблокирована() Тогда	
		Для Каждого Репозиторий ИЗ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИнфоБаза,"Репозитории").Выгрузить() Цикл
			Если Репозиторий.Использовать Тогда
				Обработчик = ПолучитьОбработчик(Репозиторий.ТипРепозитория);
				Если Не Обработчик	= Неопределено Тогда
					Возврат Обработчик.ПолучитьКоммиты(Репозиторий.НастройкаПодключения,Отчет);		
				КонецЕсли;
			КонецЕсли;							
		КонецЦикла;		
	КонецЕсли;				
КонецФункции	

// Получить модули.
// 
// Параметры:
//  Отчет - ДокументСсылка.ОтчетыОбОшибках_RepEr
// 
// Возвращаемое значение:
//  Массив из Структура:
//  	*Имя	- Строка
//		*Путь 	- см. ПолучитьПутьКФайлу
Функция ПолучитьМодули(Отчет) Экспорт
	Результат = Новый Массив;
	Стек = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет,"Стек").Выгрузить();
	Стек.Свернуть("Модуль");
	Для Каждого Модуль ИЗ Стек.ВыгрузитьКолонку("Модуль") Цикл
		ПутьКМодулю = ПолучитьПутьКФайлу(Модуль);
		Если ЗначениеЗаполнено(ПутьКМодулю) Тогда
			Результат.Добавить(Новый Структура("Имя,Путь",Модуль,ПутьКМодулю));		
		КонецЕсли;		
	КонецЦикла;	
	Возврат Результат;
КонецФункции
	

#КонецОбласти

