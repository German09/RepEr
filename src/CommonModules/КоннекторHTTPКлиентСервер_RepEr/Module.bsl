#Область ПрограммныйИнтерфейс
// Доп параметры запросов. Относительно стандартных
// 
// Параметры:
//  Основа - Неопределено,Структура - Основа
// 
// Возвращаемое значение:
//  Структура - Доп параметры запросов:
// 	* Таймаут - Число -
// 	* ПараметрыПреобразованияJSON - Структура -:
// 		** ПрочитатьВСоответствие - Булево -
Функция ДопПараметрыЗапроса(Основа = Неопределено) Экспорт
	Если ТипЗнч(Основа) = Тип("Структура") Тогда
		Параметры = ОбщегоНазначенияКлиентСервер.СкопироватьРекурсивно(Основа);
	Иначе			 
		Параметры = Новый Структура;
	КонецЕсли;	
	Параметры.Вставить("Таймаут", 40);
	Если Не Параметры.Свойство("ПараметрыПреобразованияJSON") Тогда
		Параметры.Вставить("ПараметрыПреобразованияJSON", Новый Структура("ПрочитатьВСоответствие", Ложь)); //так проще получать информацию, но жто не всегда возможно
	КонецЕсли;		
	Возврат Параметры;
КонецФункции

// Обработать ответ
// 
// Параметры:
//  Результат - Структура - Результат:
// * Ошибка - Строка - 
// * Информация - Структура - 
//  Ответ - ИнформацияОбОшибке, Структура  - Ответ:
// * code - Строка - 
// * reason - Строка - 
// * message - Строка - 
//  Метод 		- Строка
//  ИмяСервиса 	- Строка
Процедура ОбработатьОтвет(Результат, Знач Ответ, Метод, ИмяСервиса) Экспорт
	Перем Код,Сообщение,Причина; 
	Если ТипЗнч(Ответ) = Тип("Структура") Тогда
		Если Ответ.Свойство("code",Код) Тогда
			Ответ.Свойство("message",Сообщение);
			Ответ.Свойство("reason",Причина);
        	Шаблон = "Ошибка выполнения запроса %1 к сервису '%2'
        	|%3
        	|Код:		%4
        	|Причина:	%5";
        	Результат.Ошибка = СтрШаблон(Шаблон,Метод,ИмяСервиса,Сообщение,Код,Причина);
		ИначеЕсли Ответ.Свойство("error",Сообщение) Тогда
			Шаблон = "Ошибка выполнения запроса %1 к сервису '%2'
        	|%3";
        	Результат.Ошибка = СтрШаблон(Шаблон,Метод,ИмяСервиса,Сообщение);		
		КонецЕсли;
		Если ПустаяСтрока(Результат.Ошибка) Тогда
			Результат.Информация = Ответ;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Ответ) = Тип("ИнформацияОбОшибке") Тогда
		ИнформацияОбОшибке = Ответ;
		Ответ 	= Новый Структура("code","01");	
		Ответ.Вставить("reason", ИнформацияОбОшибке.Описание);
		Ответ.Вставить("message", "Ошибка отправки запроса");
		ОбработатьОтвет(Результат,Ответ,Метод, ИмяСервиса);	
	ИначеЕсли ТипЗнч(Ответ) = Тип("Число") Тогда
		Ответ 	= Новый Структура("code",Ответ);	
		Ответ.Вставить("reason", "Сервис не отвечает");
		Ответ.Вставить("message", "Ошибка получения результатов запроса");
		ОбработатьОтвет(Результат,Ответ,Метод, ИмяСервиса);			
	КонецЕсли;		
КонецПроцедуры

// Сообщение логирования, для дальнейшего получения детелаьной информации
// 
// 
// Параметры:
//  ПодготовленныйЗапрос 	- Структура
//  ВключатьТело 			- Булево - Включать тело
//  Ответ 					- см. НовыйОтвет
//  Примечание 				- Строка,Неопределено - Примечание
// 
// Возвращаемое значение:
//  Строка - Сообщение логирования
Функция СообщениеЛогирования(ПодготовленныйЗапрос,ВключатьТело = Истина, Ответ= Неопределено, Примечание = Неопределено) Экспорт
	ОписаниеПримечания = "";
	//именно так хитро чтобы в 1 строке ЖР было видно url
	Если ЗначениеЗаполнено(Примечание) Тогда
		ОписаниеПримечания = СтрШаблон(",%1""description"":""%2""%1",Символы.ПС,СокрЛП(ОбщегоНазначенияКлиентСервер.УдалитьНедопустимыеСимволыXML(Примечание)));
	КонецЕсли;	
	Возврат СтрШаблон("{""url"":""%1"",%2""context"":%2%3%4%2}",ПодготовленныйЗапрос.URL, Символы.ПС, ПолучитьЗапросДляЛогирования(ПодготовленныйЗапрос,ВключатьТело,Ответ),ОписаниеПримечания);
КонецФункции

// Получить запрос для логирования.
// 
// Параметры:
//  ПодготовленныйЗапрос  	- Структура
//  ВключатьТело 			- Булево - Включать тело
//  Ответ 					- см. НовыйОтвет
// 
// Возвращаемое значение:
//  Строка - Получить запрос для логирования
Функция ПолучитьЗапросДляЛогирования(ПодготовленныйЗапрос,ВключатьТело = Истина,Ответ = Неопределено) Экспорт	
	Подробности = Новый Структура();
	Подробности.Вставить("Metod",	ПодготовленныйЗапрос.Метод);
	Подробности.Вставить("Headers",	ПолучитьЗаголовки(ПодготовленныйЗапрос.Заголовки, СтрРазделить("Content_Type,Accept_Charset",",")));
	Если ТипЗнч(Подробности.Headers) = Тип("Структура") И Подробности.Headers.Свойство("Authorization") Тогда
		Подробности.Headers.Удалить("Authorization"); //удалим строку авторизации	
	КонецЕсли;
	Если ВключатьТело Тогда
		Тело = ПодготовленныйЗапрос.HTTPЗапрос.ПолучитьТелоКакСтроку();
		Если Не Тело = Неопределено Тогда
			Попытка
				Подробности.Вставить("Body",ПрочитатьЗначениеJSON(Тело));
			Исключение
				Подробности.Вставить("Body",ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыXML(Тело, ""));
			КонецПопытки;		
		КонецЕсли;	
	КонецЕсли;	
	Если Не Ответ = Неопределено Тогда
		СтрОтвета = "";	
		Попытка
			#Если Клиент Тогда
				ОтветСтрокой = Ответ.ПолучитьТелоКакСтроку();
				Если Не ОтветСтрокой = Неопределено Тогда
					СтрОтвета = ПрочитатьЗначениеJSON(ОтветСтрокой);
				КонецЕсли;	
			#Иначе
				//без функций преобразования, а то если они будут, то ЗаписатьЗначениеJSON (ниже вызывается)уже не сработает, так как будут ссылочные типы
				СтрОтвета = КоннекторHTTP_RepEr.КакJSON(Ответ,ДопПараметрыЗапроса().ПараметрыПреобразованияJSON);//,ПодготовленныйЗапрос.ПараметрыПреобразованияJSON);
			#КонецЕсли
		Исключение
			Попытка
				#Если Клиент Тогда
					СтрОтвета = Ответ.ПолучитьТелоКакСтроку();	
				#Иначе
					СтрОтвета = КоннекторHTTP_RepEr.КакТекст(Ответ);
				#КонецЕсли	
			Исключение
				СтрОтвета = "";					
			КонецПопытки 			
		КонецПопытки;
		Подробности.Вставить("Response", Новый Структура("Code,Body",Ответ.КодСостояния,СтрОтвета));	
	КонецЕсли;
	Попытка
		Возврат ЗаписатьЗначениеJSON(Подробности); 				
	Исключение
		Возврат ОбщегоНазначенияКлиентСервер_RepEr.ЗначениеВСтрокуXML(Подробности)
	КонецПопытки;
КонецФункции


#КонецОбласти

// Получить заголовки. Из соотвесвтия в структуру, поскольку типовой ЗаписатьЗначениеJSON работает только со структурами
// 
// Параметры:
//  Соответствие - Соответствие Из Строка
//  Исключения - Массив Из Строка
// 
// Возвращаемое значение:
//  Неопределено,Структура из Строка
Функция ПолучитьЗаголовки(Соответствие,Исключения)
	Результат = Новый Структура;
	Для Каждого Элемент из Соответствие Цикл
		Имя = СтрЗаменить(Элемент.Ключ,"-","_");
		Если Исключения.Найти(Имя)= Неопределено Тогда
			Результат.Вставить(Имя,Элемент.Значение);
		КонецЕсли;					
	КонецЦикла;
	Если Результат.Количество() = 0 Тогда
		Результат = Неопределено;
	КонецЕсли;	
	Возврат Результат;			
КонецФункции