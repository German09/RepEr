
#Область ПрограммныйИнтерфейс


// Получить коммиты.
// см. https://docs.gitlab.com/api/commits/#list-repository-commits
// 
// Параметры:
//  Настройка 	- СправочникСсылка.НастройкиПодключений_RepEx
//  Отчет 		- ДокументСсылка.ОтчетыОбОшибках_RepEr
// 
// Возвращаемое значение:
// 	см. Репозитории_RepEr.ПолучитьКоммиты 
Функция ПолучитьКоммиты(Настройка, Отчет) Экспорт
	Результат	= Новый Соответствие();
	Ошибка 		= "";
	Реквизиты 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Настройка,Новый Структура("Адрес,КодПроекта,Путь","Адрес","Логин","Разделитель"));
	СтрАдреса 	= Новый Структура("ИмяСервиса",ИмяСервиса());
	Токен 		= ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Строка(Настройка.УникальныйИдентификатор()));
	СтрАдреса.Вставить("Адрес",СтрШаблон("%1/api/v4/projects/%2/repository/commits",СокрЛП(Реквизиты.Адрес),СокрЛП(Реквизиты.КодПроекта)));
	Сессия    	= КоннекторHTTP_RepEr.ПолучитьСессию(СтрАдреса,Ошибка,"");
	//Результат = СтрАдреса;
	Если ПустаяСтрока(Ошибка) Тогда
		ПутьПроекта			= СокрЛП(Реквизиты.Адрес);
	    ПараметрыЗапроса    = Новый Структура("page",1);
	    ПараметрыЗапроса.Вставить("per_page",10);			//по 10 элментов на страницу
	    ПараметрыЗапроса.Вставить("ref_name",ПолучитьИмяВетки()); 		    
		ДопПараметры        = КоннекторHTTPКлиентСервер_RepEr.ДопПараметрыЗапроса();
		ДопПараметры.ПараметрыПреобразованияJSON.Вставить("ИменаСвойствСоЗначениямиДата", СтрРазделить("created_at,authored_date,committed_date",","));
		Сессия.Заголовки.Вставить("PRIVATE-TOKEN", Токен); 
		
		Для Каждого Модуль ИЗ Репозитории_RepEr.ПолучитьМодули(Отчет) Цикл
			Модуль.Путь 		= СтрЗаменить(СтрШаблон("%1/src/%2",Реквизиты.Путь,Модуль.Путь),"//","/");
			Модуль.Путь 		= ?(СтрНачинаетсяС(Модуль.Путь,"/"),Сред(Модуль.Путь,2),Модуль.Путь);
			ПараметрыЗапроса.Вставить("path",Модуль.Путь);
			Ответ  	= КоннекторHTTP_RepEr.GetJson(СтрАдреса.Адрес,ПараметрыЗапроса,ДопПараметры,Сессия,СтрАдреса.ИмяСервиса,Отчет);
			Коммиты = Новый Массив;
			Если ТипЗнч(Ответ) = Тип("Структура") И  Ответ.Свойство("error",Ошибка) Тогда 
				//тут есть ошибка
			ИначеЕсли ТипЗнч(Ответ) = Тип("Массив") Тогда				
				Для Каждого Коммит ИЗ Ответ Цикл
					Коммиты.Добавить(Новый Структура("Заголовок,Ссылка,Дата",Коммит.title,Коммит.web_url,Коммит.committed_date));
					ПутьПроекта = СтрЗаменитьПоРегулярномуВыражению(Коммит.web_url,"(.+)(/-/.+)","$1"); //уточним путь проекта			
				КонецЦикла;			
			КонецЕсли;
			Модуль.Вставить("Подключение",	Настройка);
			Модуль.Вставить("Ссылка",		СтрШаблон("%1/-/blob/%2/%3?ref_type=heads",ПутьПроекта,ПолучитьИмяВетки(),КодироватьСтроку(Модуль.Путь,СпособКодированияСтроки.КодировкаURL)));
			Результат.Вставить(Модуль,Коммиты);				
		КонецЦикла;
		Возврат Результат;				
	КонецЕсли;				
КонецФункции

Функция ПолучитьИмяВетки()
	Возврат "master";
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ИмяСервиса() Экспорт
	Возврат "GitLab";
КонецФункции

#КонецОбласти		