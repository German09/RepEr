// Получить коммиты.
// см. https://docs.gitlab.com/api/commits/#list-repository-commits
// 
// Параметры:
//  Настройка 	- СправочникСсылка.НастройкиПодключений_RepEx
//  Отчет 		- ДокументСсылка.ОтчетыОбОшибках_RepEr
// 
// Возвращаемое значение:
// 	см. Репозитории_RepEr.ПолучитьКоммиты 
Функция ПолучитьКоммиты(Настройка, Отчет) Экспорт
	Результат	= Новый Соответствие();
	Ошибка 		= "";
	Реквизиты 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Настройка,"Адрес,Проект,ПутьКИсходникам");
	СтрАдреса 	= Новый Структура("ИмяСервиса",ИмяСервиса());
	Токен 		= Справочники.НастройкиПодключений_RepEx.Секрет(Настройка);
	СтрАдреса.Вставить("Адрес",СтрШаблон("%1/api/v4/projects/%2/repository/commits",СокрЛП(Реквизиты.Адрес),
		Справочники.НастройкиПодключений_RepEx.ИдентификаторПроектаGitLab(Реквизиты.Проект)));
	Сессия    	= КоннекторHTTP_RepEr.ПолучитьСессию(СтрАдреса,Ошибка,"");
	//Результат = СтрАдреса;
	Если ПустаяСтрока(Ошибка) Тогда
		ПутьПроекта			= СокрЛП(Реквизиты.Адрес);
	    ПараметрыЗапроса    = Новый Структура("page",1);
	    ПараметрыЗапроса.Вставить("per_page",10);			//по 10 элментов на страницу
	    ПараметрыЗапроса.Вставить("ref_name",ПолучитьИмяВетки()); 		    
		ДопПараметры        = КоннекторHTTPКлиентСервер_RepEr.ДопПараметрыЗапроса();
		ДопПараметры.ПараметрыПреобразованияJSON.Вставить("ИменаСвойствСоЗначениямиДата", СтрРазделить("created_at,authored_date,committed_date",","));
		Сессия.Заголовки.Вставить("PRIVATE-TOKEN", Токен); 
		
		Для Каждого Модуль ИЗ Репозитории_RepEr.ПолучитьМодули(Отчет) Цикл
			Модуль.Путь 		= СтрЗаменить(СтрШаблон("%1/src/%2",Реквизиты.ПутьКИсходникам,Модуль.Путь),"//","/");
			Модуль.Путь 		= ?(СтрНачинаетсяС(Модуль.Путь,"/"),Сред(Модуль.Путь,2),Модуль.Путь);
			ПараметрыЗапроса.Вставить("path",Модуль.Путь);
			Ответ  	= КоннекторHTTP_RepEr.GetJson(СтрАдреса.Адрес,ПараметрыЗапроса,ДопПараметры,Сессия,СтрАдреса.ИмяСервиса,Отчет);
			Коммиты = Новый Массив;
			Если ТипЗнч(Ответ) = Тип("Структура") И  Ответ.Свойство("error",Ошибка) Тогда 
				//тут есть ошибка
			ИначеЕсли ТипЗнч(Ответ) = Тип("Массив") Тогда				
				Для Каждого Коммит ИЗ Ответ Цикл
					Коммиты.Добавить(Новый Структура("Заголовок,Ссылка,Дата",Коммит.title,Коммит.web_url,Коммит.committed_date));
					ПутьПроекта = СтрЗаменитьПоРегулярномуВыражению(Коммит.web_url,"(.+)(/-/.+)","$1"); //уточним путь проекта			
				КонецЦикла;			
			КонецЕсли;
			Модуль.Вставить("Подключение",	Настройка);
			Модуль.Вставить("Ссылка",		СтрШаблон("%1/-/blob/%2/%3?ref_type=heads",ПутьПроекта,ПолучитьИмяВетки(),КодироватьСтроку(Модуль.Путь,СпособКодированияСтроки.КодировкаURL)));
			Результат.Вставить(Модуль,Коммиты);				
		КонецЦикла;
		Возврат Результат;				
	КонецЕсли;				
КонецФункции

// Ветка, в которой ищутся коммиты по модулям.
// 
// Возвращаемое значение:
//  Строка
Функция ПолучитьИмяВетки() Экспорт
	Возврат "master";
КонецФункции

// Файл ленты исправлений из реестра пакетов проекта GitLab: generic-пакет, версия пакета - версия библиотеки
// (например 1.3.19.01), в ней оглавление index.json и архивы исправлений, см. ИмяПакетаЛенты
// Базы читают ленту через HTTP-сервис Service: токен проекта есть только в настройке подключения.
// 
// Параметры:
//  Настройка 	- СправочникСсылка.НастройкиПодключений_RepEx - Подключение к проекту GitLab
//  Версия 		- Строка - Версия библиотеки
//  ИмяФайла 	- Строка - index.json или имя архива из оглавления
// 
// Возвращаемое значение:
//  см. ЗапросКПроекту
Функция ФайлЛентыИсправлений(Настройка, Версия, ИмяФайла) Экспорт
	Путь = СтрШаблон("packages/generic/%1/%2/%3", ИмяПакетаЛенты(),
		КодироватьСтроку(Версия, СпособКодированияСтроки.КодировкаURL),
		КодироватьСтроку(ИмяФайла, СпособКодированияСтроки.КодировкаURL));
	Возврат ЗапросКПроекту(Настройка, Путь);
КонецФункции

// Адрес страницы версии ленты исправлений в GitLab, например https://<сервер>/<группа>/<проект>/-/packages/123.
// 
// Параметры:
//  Настройка 	- СправочникСсылка.НастройкиПодключений_RepEx - Подключение к проекту GitLab
//  Версия 		- Строка - Версия библиотеки
// 
// Возвращаемое значение:
//  Строка - Адрес страницы версии; если ее не нашли - страница пакетов проекта
Функция СтраницаВерсииЛентыИсправлений(Настройка, Версия) Экспорт
	Реквизиты 		= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Настройка, "Провайдер, Адрес, Проект");
	АдресПроекта 	= Справочники.НастройкиПодключений_RepEx.СсылкаНаПроектПоРеквизитам(Реквизиты.Провайдер,
		Реквизиты.Адрес, Реквизиты.Проект, "");
	Результат 		= АдресПроекта + "/-/packages";
	
	ПараметрыЗапроса = Новый Структура("package_type, package_name, package_version", "generic", ИмяПакетаЛенты(), Версия);
	Ответ = ЗапросКПроекту(Настройка, "packages", ПараметрыЗапроса);
	Если Ответ.КодСостояния = 200 Тогда
		Пакеты = Новый Массив; //Массив из Соответствие
		Попытка
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(ПолучитьСтрокуИзДвоичныхДанных(Ответ.Тело, КодировкаТекста.UTF8));
			Прочитано = ПрочитатьJSON(Чтение, Истина);
			Чтение.Закрыть();
			Если ТипЗнч(Прочитано) = Тип("Массив") Тогда
				Пакеты = Прочитано;
			КонецЕсли;
		Исключение
			//страницу версии не узнать, остается страница пакетов проекта
			Пакеты = Новый Массив;
		КонецПопытки;
		СтруктураURI = ОбщегоНазначенияКлиентСервер.СтруктураURI(Реквизиты.Адрес);
		Для Каждого Пакет ИЗ Пакеты Цикл
			//отбор package_name в API нестрогий, имя и версия сверяются точно
			Ссылки 			= Пакет.Получить("_links"); //Соответствие из КлючИЗначение
			ПутьНаСайте 	= ?(ТипЗнч(Ссылки) = Тип("Соответствие"), Ссылки.Получить("web_path"), Неопределено);
			Если ЗначениеЗаполнено(ПутьНаСайте) И Пакет.Получить("name") = ИмяПакетаЛенты()
				И Пакет.Получить("version") = Версия Тогда
				Результат = СтрШаблон("%1://%2%3", СтруктураURI.Схема, СтруктураURI.ИмяСервера, ПутьНаСайте);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Запрос к проекту GitLab в API, авторизация - токеном настройки подключения.
// Секрет читается из безопасного хранилища: вызывать в привилегированном режиме.
// 
// Параметры:
//  Настройка 			- СправочникСсылка.НастройкиПодключений_RepEx - Подключение к проекту GitLab
//  Путь 				- Строка - Путь от проекта: packages/generic/...; пустая строка - сам проект
//  ПараметрыЗапроса 	- Структура, Неопределено - Параметры запроса
// 
// Возвращаемое значение:
//  Структура:
//  * КодСостояния 	- Число - Код ответа GitLab, 0 - не удалось подключиться
//  * Тело 			- ДвоичныеДанные
//  * Описание 		- Строка - Описание ошибки подключения
Функция ЗапросКПроекту(Настройка, Путь, ПараметрыЗапроса = Неопределено) Экспорт
	Результат 	= Новый Структура("КодСостояния, Тело, Описание", 0, ПолучитьДвоичныеДанныеИзСтроки(""), "");
	Реквизиты 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Настройка, "Адрес, Проект");
	Адрес 		= СтрШаблон("%1/api/v4/projects/%2", СокрЛП(Реквизиты.Адрес),
		Справочники.НастройкиПодключений_RepEx.ИдентификаторПроектаGitLab(Реквизиты.Проект));
	Если ЗначениеЗаполнено(Путь) Тогда
		Адрес = Адрес + "/" + Путь;
	КонецЕсли;
	
	ДопПараметры = КоннекторHTTP_RepEr.НовыеПараметры();
	ДопПараметры.Заголовки.Вставить("PRIVATE-TOKEN", Справочники.НастройкиПодключений_RepEx.Секрет(Настройка));
	ДопПараметры.Таймаут = 60;
	Попытка
		Ответ 					= КоннекторHTTP_RepEr.Get(Адрес, ПараметрыЗапроса, ДопПараметры);
		Результат.КодСостояния 	= Ответ.КодСостояния;
		Результат.Тело 			= КоннекторHTTP_RepEr.КакДвоичныеДанные(Ответ);
	Исключение
		Результат.Описание = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

// Имя generic-пакета ленты исправлений в реестре пакетов проекта: то же, что в переменной EF_FEED_URL
// заданий пайплайна и в расширении RepEr.
// 
// Возвращаемое значение:
//  Строка
Функция ИмяПакетаЛенты() Экспорт
	Возврат "ef";
КонецФункции

