
#Область ПрограммныйИнтерфейс


// Получить коммиты.
// 
// Параметры:
//  Настройка 	- СправочникСсылка.НастройкиПодключений_RepEx
//  Отчет 		- ДокументСсылка.ОтчетыОбОшибках_RepEr
// 
// Возвращаемое значение:
//  
Функция ПолучитьКоммиты(Настройка, Отчет) Экспорт
	Ошибка 		= "";
	Реквизиты 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Настройка,Новый Структура("Адрес,КодПроекта,Путь","Адрес","Логин","Разделитель"));
	СтрАдреса 	= Новый Структура("ИмяСервиса",ИмяСервиса());
	Токен 		= ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Строка(Настройка.УникальныйИдентификатор()));
	СтрАдреса.Вставить("Адрес",СтрШаблон("%1/api/v4/projects/%2/repository",СокрЛП(Реквизиты.Адрес),СокрЛП(Реквизиты.КодПроекта)));
	Сессия    	= КоннекторHTTP_RepEr.ПолучитьСессию(СтрАдреса,Ошибка,"");
	//Результат = СтрАдреса;
	Если ПустаяСтрока(Ошибка) Тогда
	    ПараметрыЗапроса    = Новый Структура("ref","master"); //только ветка мастер
		ДопПараметры        = КоннекторHTTPКлиентСервер_RepEr.ДопПараметрыЗапроса();
		Сессия.Заголовки.Вставить("PRIVATE-TOKEN", Токен); 
		Для Каждого Модуль ИЗ Репозитории_RepEr.ПолучитьМодули(Отчет) Цикл
			Путь 		= СтрЗаменить(СтрШаблон("%1/src/%2",Реквизиты.Путь,Модуль),"//","/");
			Путь 		= ?(СтрНачинаетсяС(Путь,"/"),Сред(Путь,2),Путь);
			ПутьURL 	= КодироватьСтроку(Путь,СпособКодированияСтроки.КодировкаURL);
			Адрес      	= СтрШаблон("%1/%2",СтрАдреса.Адрес,Стршаблон("files/%1/blame",ПутьURL));
			Результат  	= КоннекторHTTP_RepEr.GetJson(Адрес,ПараметрыЗапроса,ДопПараметры,Сессия,СтрАдреса.ИмяСервиса,Отчет);
			Если Результат.Свойство("error",Ошибка) Тогда 
				//тут есть ошибка
			Иначе
				Ошибка 		= "";	
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;				
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ИмяСервиса() Экспорт
	Возврат "GitLab";
КонецФункции

#КонецОбласти		