#Область ПрограммныйИнтерфейс

// Получить коммиты по модулям стека из ветки по умолчанию репозитория.
// см. https://docs.github.com/en/rest/commits/commits#list-commits
// 
// Параметры:
//  Настройка 	- СправочникСсылка.НастройкиПодключений_RepEx
//  Отчет 		- ДокументСсылка.ОтчетыОбОшибках_RepEr
// 
// Возвращаемое значение:
// 	см. Репозитории_RepEr.ПолучитьКоммиты
Функция ПолучитьКоммиты(Настройка, Отчет) Экспорт
	Результат	= Новый Соответствие();
	Ошибка 		= "";
	//GitHub адресует репозиторий парой владелец/имя, владельцем выступает логин пользователя или организации
	Реквизиты 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Настройка, "Провайдер,Адрес,Логин,Проект,ПутьКИсходникам");
	СтрАдреса 	= Справочники.НастройкиПодключений_RepEx.ПараметрыАвторизации(Настройка, ИмяСервиса());
	СтрАдреса.Вставить("Адрес", СтрШаблон("%1/repos/%2/%3/commits", СокрЛП(Реквизиты.Адрес), СокрЛП(Реквизиты.Логин), СокрЛП(Реквизиты.Проект)));
	Сессия 		= КоннекторHTTP_RepEr.ПолучитьСессию(СтрАдреса, Ошибка, СтрАдреса.ТипАвторизации);
	Если ПустаяСтрока(Ошибка) Тогда
		Сессия.Заголовки.Вставить("Accept", "application/vnd.github+json");
		Сессия.Заголовки.Вставить("X-GitHub-Api-Version", "2022-11-28");
		ПутьПроекта 		= Справочники.НастройкиПодключений_RepEx.СсылкаНаПроектПоРеквизитам(Реквизиты.Провайдер,
			Реквизиты.Адрес, Реквизиты.Проект, Реквизиты.Логин);
		ПараметрыЗапроса 	= Новый Структура("page", 1);
		ПараметрыЗапроса.Вставить("per_page", 10); //по 10 элементов на страницу
		ДопПараметры 		= КоннекторHTTPКлиентСервер_RepEr.ДопПараметрыЗапроса();
		ДопПараметры.ПараметрыПреобразованияJSON.ПрочитатьВСоответствие = Истина;
		ДопПараметры.ПараметрыПреобразованияJSON.Вставить("ИменаСвойствСоЗначениямиДата", СтрРазделить("date", ","));
		
		Для Каждого Модуль ИЗ Репозитории_RepEr.ПолучитьМодули(Отчет) Цикл
			Модуль.Путь = СтрЗаменить(СтрШаблон("%1/src/%2", Реквизиты.ПутьКИсходникам, Модуль.Путь), "//", "/");
			Модуль.Путь = ?(СтрНачинаетсяС(Модуль.Путь, "/"), Сред(Модуль.Путь, 2), Модуль.Путь);
			ПараметрыЗапроса.Вставить("path", Модуль.Путь);
			Ответ 	= КоннекторHTTP_RepEr.GetJson(СтрАдреса.Адрес, ПараметрыЗапроса, ДопПараметры, Сессия, ИмяСервиса(), Отчет);
			Коммиты = Новый Массив;
			Если ТипЗнч(Ответ) = Тип("Массив") Тогда
				Для Каждого Коммит ИЗ Ответ Цикл
					Коммиты.Добавить(ОписаниеКоммита(Коммит));
				КонецЦикла;
			КонецЕсли;
			Модуль.Вставить("Подключение", 	Настройка);
			//HEAD - ветка по умолчанию, в ней же ищутся коммиты
			Модуль.Вставить("Ссылка", 		СтрШаблон("%1/blob/HEAD/%2", ПутьПроекта,
				КодироватьСтроку(Модуль.Путь, СпособКодированияСтроки.URLВКодировкеURL)));
			Результат.Вставить(Модуль, Коммиты);
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Имя сервиса.
// 
// Возвращаемое значение:
//  Строка - Имя сервиса, то же, что у оповещений GitHub
Функция ИмяСервиса() Экспорт
	Возврат "GitHub";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание коммита из ответа GitHub.
// 
// Параметры:
//  Коммит - Соответствие из КлючИЗначение - Элемент ответа list-commits
// 
// Возвращаемое значение:
//  Структура:
//  * Заголовок - Строка - Первая строка сообщения коммита
//  * Ссылка 	- Строка
//  * Дата 		- Дата - Дата коммита, местное время
Функция ОписаниеКоммита(Коммит)
	Результат 	= Новый Структура("Заголовок,Ссылка,Дата", "", Строка(Коммит.Получить("html_url")), Дата(1, 1, 1));
	Данные 		= Коммит.Получить("commit");
	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Результат.Заголовок = СокрЛП(СтрПолучитьСтроку(Строка(Данные.Получить("message")), 1));
		Коммиттер 			= Данные.Получить("committer");
		Если ТипЗнч(Коммиттер) = Тип("Соответствие") И ТипЗнч(Коммиттер.Получить("date")) = Тип("Дата") Тогда
			Результат.Дата = Коммиттер.Получить("date");
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти
