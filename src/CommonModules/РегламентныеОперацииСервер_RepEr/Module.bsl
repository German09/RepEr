// Получить отчеты.
// 
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - Получить отчеты:
//	*Идентификатор 		- УникальныйИдентификатор
//	*ИнформационнаяБаза	- СправочникСсылка.ИнформационныеБазы_RepEr
//	*МоментВремени		- Число
//	*Содержимое			- ДвоичныеДанные
//	*Дата				- Дата
Функция ПолучитьОтчеты() Экспорт
	Перем РезультатЗапроса;
	Перем Запрос;
	Перем Выборка;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Идентификатор,
	|	ИнформационнаяБаза,
	|	МоментВремени КАК МоментВремени,
	|	Содержимое,
	|	Дата КАК Дата
	|ИЗ
	|	РегистрСведений.Отчеты_RepEr
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	МоментВремени";
	РезультатЗапроса = Запрос.Выполнить();
	Выборка	= РезультатЗапроса.Выбрать();
	Возврат Выборка
КонецФункции
