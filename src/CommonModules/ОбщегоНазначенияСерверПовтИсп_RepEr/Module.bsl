Функция АдресПубликацииИнформационнойБазыВИнтернете() Экспорт
	Результат = ОбщегоНазначения.АдресПубликацииИнформационнойБазыВИнтернете();
	Если ЗначениеЗаполнено(Результат)Тогда
		Результат = Результат+"#";
	Иначе
		Результат = "";
	КонецЕсли;
	Возврат Результат;	
КонецФункции