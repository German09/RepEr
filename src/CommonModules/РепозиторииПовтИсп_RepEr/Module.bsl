#Область СлужебныеПроцедурыИФункции

//@skip-check bsl-legacy-check-method-for-statements-after-return
Функция ПолучитьВыражения(Имя, Объект = Истина, Формы = Истина, Команды = Истина)
	Результат = Новый Массив;
	Если СтрНачинаетсяС(Имя,"Common") Тогда
		// тут общие объекты, у них нет менеджеров
		Если СтрЗаканчиваетсяНа(Имя,"Commands") Тогда
			ДобавитьМодуль(Результат, Имя, ,"Command");
		Иначе	 
			ДобавитьМодуль(Результат, Имя);
		КонецЕсли;	
	Иначе
		//у всех остальных есть менеджер
		ДобавитьМодуль(Результат, Имя, "МодульМенеджера","Manager");
	КонецЕсли;
	Если Объект	Тогда
		Если СтрЗаканчиваетсяНа(Имя,"Registers") Тогда
			ДобавитьМодуль(Результат, Имя, "МодульНабораЗаписей","RecordSet");
		Иначе	
			ДобавитьМодуль(Результат, Имя, "МодульОбъекта","Object");
		КонецЕсли;	
	КонецЕсли;	
	Если Формы Тогда
		Результат.Добавить(Новый Структура("Выражение,Замена","(.+)\.(.+)\.Форма\.(.+)\.(.*)",СтрШаблон("%1/$2/Forms/$3/Module.bsl",Имя)));
	КонецЕсли;
	Если Команды Тогда
		Результат.Добавить(Новый Структура("Выражение,Замена","(.+)\.(.+)\.Команда\.(.+)\.(.*)",СтрШаблон("%1/$2/Commands/$3/CommandModule.bsl",Имя)));
	КонецЕсли;	
	Возврат Результат;
КонецФункции

Процедура ДобавитьМодуль(Результат,Имя,Признак = "",Префикс = "")
	Результат.Добавить(Новый Структура("Выражение,Замена","(.+)\.(.+)\.(.*)"+Признак,СтрШаблон("%1/$2/%2Module.bsl",Имя,Префикс)));
КонецПроцедуры

#КонецОбласти