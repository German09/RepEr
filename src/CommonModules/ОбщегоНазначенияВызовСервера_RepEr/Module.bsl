
#Область ПрограммныйИнтерфейс
// Заполнить.
// 
// Параметры:
//  Ссылка - ДокументСсылка.ОтчетыОбОшибках_RepEr
Процедура Заполнить(Ссылка) Экспорт
	Перем ErrorInfo;
	Объект = Ссылка.ПолучитьОбъект();
	СтруктураОшибки = ОбщегоНазначения_RepEr.СтрокаJSONВЗначение(Объект.ТекстОтчета);
	Если СтруктураОшибки.Свойство("ErrorInfo",ErrorInfo) Тогда
		Документы.ОтчетыОбОшибках_RepEr.ЗаполнитьИнфоОбОшибке(Объект,ErrorInfo);
		Объект.Записать();
	КонецЕсли;	
КонецПроцедуры

// Исправить.
// 
// Параметры:
//  Ссылка - ДокументСсылка.ОтчетыОбОшибках_RepEr
Процедура Исправить(Ссылка) Экспорт
	Объект = Ссылка.ПолучитьОбъект();
	Объект.Наименование = ОбщегоНазначенияКлиентСервер.УдалитьНедопустимыеСимволыXML(Объект.Наименование);
	Для Каждого СтрОшибки ИЗ Объект.Ошибки Цикл
		СтрОшибки.Ошибка  = ОбщегоНазначенияКлиентСервер.УдалитьНедопустимыеСимволыXML(СтрОшибки.Ошибка);			
	КонецЦикла;	
	Объект.Записать();
КонецПроцедуры

// Получаем свойтсва первой версии объекта
// 
// Параметры:
//  Ссылка - ЛюбаяСсылка
// 
// Возвращаемое значение:
//  Неопределено, Структура - :
// * ИмяПользователя 	- Строка - 
// * Дата 				- Дата - 
Функция ПолучитьСвойстваПервойВерсии(Ссылка) Экспорт
	Свойства	= "Дата,ИмяПользователя";
	Результат 	= Новый Структура("Дата,ИмяПользователя",'00010101',"");
	Для Каждого Версия ИЗ ИсторияДанных.ВыбратьВерсии(Новый Структура("Данные", Ссылка),Свойства,"НомерВерсии Возр") Цикл
		ЗаполнитьЗначенияСвойств(Результат,Версия);
		Возврат Результат; 	
	КонецЦикла;	
КонецФункции

// События API.
// 
// Возвращаемое значение:
//  Массив Из Строка
Функция СобытияAPI() Экспорт
	МассивСобытий = Новый Массив;			
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСобытий, Оповещения_RepEr.ИмяСобытий());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСобытий, Репозитории_RepEr.ИмяСобытий());
	Возврат МассивСобытий;
КонецФункции
#КонецОбласти

	
