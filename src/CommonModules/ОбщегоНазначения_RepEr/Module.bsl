// Получить отчеты.
// 
// Параметры:
//  СтруктураЗапроса - см. ПолучитьСтруктуруЗапроса
// 
// Возвращаемое значение:
//  Массив ИЗ ДокументСсылка.ОтчетыОбОшибках_RepEr
Функция ПолучитьОтчеты(СтруктураЗапроса) Экспорт  
	ВыборкаДетальныеЗаписи = ПолучитьВыборкуОтчетов(СтруктураЗапроса);
	Возврат ВыборкаДетальныеЗаписи.Владелец().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

// Получить отчеты.
// 
// Параметры:
//  СтруктураЗапроса - см. ПолучитьСтруктуруЗапроса
// 
// Возвращаемое значение:
//  Число
Функция ПолучитьОшибки(СтруктураЗапроса)  
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Таблица.Идентификатор
		|ИЗ
		|	РегистрСведений.Ошибки_RepEr КАК Таблица
		|ГДЕ
		|	Таблица.ИнформационнаяБаза = &ИнформационнаяБаза
		|	И ВЫБОР
		|		КОГДА &appStackHash = """"
		|			ТОГДА Таблица.clientStackHash = &clientStackHash
		|			И Таблица.serverStackHash = &serverStackHash
		|		ИНАЧЕ Таблица.appStackHash = &appStackHash
		|	КОНЕЦ";
			
	Запрос.УстановитьПараметр("appStackHash", 			СокрЛП(СтруктураЗапроса.appStackHash));
	Запрос.УстановитьПараметр("clientStackHash", 		СтруктураЗапроса.clientStackHash);
	Запрос.УстановитьПараметр("serverStackHash", 		СтруктураЗапроса.serverStackHash);
	Запрос.УстановитьПараметр("ИнформационнаяБаза", 	СтруктураЗапроса.ИнформационнаяБаза);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Возврат ТЗ.Количество();
КонецФункции

// Получитить идентифкаторы.
// 
// Параметры:
//  Отчеты  - Массив ИЗ ДокументСсылка.ОтчетыОбОшибках_RepEr
// 
// Возвращаемое значение:
//  Массив из Строка
Функция ПолучититьИдентифкаторы(Отчеты)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КлючиОповещений_RepEx.Идентификатор КАК Идентификатор
		|ИЗ
		|	РегистрСведений.КлючиОповещений_RepEx КАК КлючиОповещений_RepEx
		|ГДЕ
		|	КлючиОповещений_RepEx.Регистратор В
		|			(ВЫБРАТЬ
		|				ВЫБОР
		|					КОГДА Документ.Основание = ЗНАЧЕНИЕ(Документ.ОтчетыОбОшибках_RepEr.ПустаяСсылка)
		|						ТОГДА Документ.Ссылка
		|					ИНАЧЕ Документ.Основание
		|				КОНЕЦ КАК Ссылка
		|			ИЗ
		|				Документ.ОтчетыОбОшибках_RepEr КАК Документ
		|			ГДЕ
		|				Документ.Ссылка В (&Регистраторы))";
	
	Запрос.УстановитьПараметр("Регистраторы", Отчеты);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Идентификатор");
КонецФункции
	
