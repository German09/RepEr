#Область ПрограммныйИнтерфейс
// Журнал API.
// 
// Параметры:
//  ИмяСобытия 	- Строка - Имя события, если не указаны то все
//  Данные 		- ОпределяемыйТип.СсылкиApi_RegExp, Неопределено -
//	Владелец	- Форма
//	Дополнения	- Строка
//
//@skip-check method-too-many-params
Процедура ЖурналAPI(ИмяСобытия = Неопределено, Данные = Неопределено, Владелец = Неопределено, Дополнения = "Запрос,Ответ") Экспорт
	МассивСобытий = Новый Массив;
	Для Каждого Дополнение ИЗ СтрРазделить(Дополнения,",") Цикл
		Если ИмяСобытия = Неопределено Тогда
			Для Каждого Событие ИЗ ОбщегоНазначенияВызовСервера_RepEr.СобытияAPI() Цикл
				МассивСобытий.Добавить(СтрШаблон("%1.%2",Событие,Дополнение));
			КонецЦикла;
		Иначе
			МассивСобытий.Добавить(СтрШаблон("%1.%2",ИмяСобытия,Дополнение));	
		КонецЕсли;		
	КонецЦикла;	
	
	Если Не Данные = Неопределено Тогда
		//получим дату начала 
		ПараметрыОтбора = Новый Структура;
		СвойстваВерсии = ОбщегоНазначенияВызовСервера_RepEr.ПолучитьСвойстваПервойВерсии(Данные);
		Если Не СвойстваВерсии = Неопределено Тогда
			ПараметрыОтбора.Вставить("ДатаНачала", НачалоДня(СвойстваВерсии.Дата));
		КонецЕсли;		
		ПараметрыОтбора.Вставить("Данные",Данные);
	Иначе
		ПараметрыОтбора = Новый Структура();	
	КонецЕсли;
	ПараметрыОтбора.Вставить("СобытиеЖурналаРегистрации", МассивСобытий);
	
	ОткрытьЖурналРегистрации(ПараметрыОтбора,Владелец, Истина);
КонецПроцедуры
#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс
// Открывает форму журнала регистрации с установленным отбором.
//
// Параметры:
//  Отбор - Структура:
//     * Пользователь              - Строка
//                                 - СписокЗначений - имя или список пользователей
//                                                    информационной базы.
//     * СобытиеЖурналаРегистрации - Строка
//                                 - Массив Из Строка - идентификатор события.
//     * ДатаНачала                - Дата           - начало интервала отображаемых событий.
//     * ДатаОкончания             - Дата           - конец интервала отображаемых событий.
//     * Данные                    - Произвольный   - данные любого типа.
//     * Сеанс                     - СписокЗначений Из Строка - список выбираемых сеансов.
//     * Уровень                   - Строка
//                                 - Массив - представление уровня важности
//                                            события журнала регистрации.
//     * ИмяПриложения             - Массив         - массив идентификаторов приложения.
//  Владелец - ФормаКлиентскогоПриложения - форма, из которой открывается журнал регистрации.
//  ВНовомОкне 	- Булево - если Ложь, не нужно
//  			- Произвольный - если любой тип, кроме Булево - это и будет ключ.
//
Процедура ОткрытьЖурналРегистрации(Знач Отбор = Неопределено, Владелец = Неопределено, ВНовомОкне = Ложь)
	
	ОткрытьФорму("Обработка.ЖурналРегистрации.Форма", Отбор, Владелец, ?(ВНовомОкне = Истина, Новый УникальныйИдентификатор, ?(ВНовомОкне <> Ложь, ВНовомОкне, Неопределено)));
	
КонецПроцедуры
#КонецОбласти