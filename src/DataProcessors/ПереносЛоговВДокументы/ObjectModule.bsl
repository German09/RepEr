Процедура ОбработатьДанныеПолученногоОтчетаОбОшибке(ДанныеОбОтчете, ИспользоватьРассылку = Ложь)
	
	ДанныеОтчета = ДанныеОбОтчете.Содержимое.Получить();
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(".zip");
	ДанныеОтчета.Записать(ИмяВременногоФайла);
	
	Архиватор = Новый ЧтениеZipФайла(ИмяВременногоФайла);
	
	ВременныйКаталог = Новый Массив;
	ВременныйКаталог.Добавить(КаталогВременныхФайлов());
	ВременныйКаталог.Добавить("ОбработкаПолученныхОтчетовОбОшибках");
	ВременныйКаталог.Добавить(ДанныеОбОтчете.Идентификатор);
	ВременныйКаталог = СтрСоединить(ВременныйКаталог, "\");
	
	Архиватор.ИзвлечьВсе(ВременныйКаталог);
	Архиватор.Закрыть();
	УдалитьФайлы(ИмяВременногоФайла);
	
	ИмяОсновногоФайла = СтрШаблон("%1\%2", ВременныйКаталог, "report.json");
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.Прочитать(ИмяОсновногоФайла, КодировкаТекста.UTF8);
	
	ТекстОсновногоФайла = ТекстовыйДокумент.ПолучитьТекст();
	
	// парсить json и смотреть имена файлов и скринов
	СтруктураОшибки = СтроковыеФукнцииЛоггер.СтрокаJSONВЗначение(ТекстОсновногоФайла);
	#Если _ Тогда
		СтруктураОшибки = Новый Структура;
	#КонецЕсли
	
	СсылкаНаОтчет = Документы.ОтчетыОбОшибках.ПолучитьСсылку(ДанныеОбОтчете.Идентификатор);
	ОтчетОбОшибке = СсылкаНаОтчет.ПолучитьОбъект();
	
	Если ОтчетОбОшибке = Неопределено Тогда
		ОтчетОбОшибке = Документы.ОтчетыОбОшибках.СоздатьДокумент();
		ОтчетОбОшибке.УстановитьСсылкуНового(СсылкаНаОтчет);
	КонецЕсли;
	
	ОтчетОбОшибке.ТекстОтчета 	= ТекстОсновногоФайла;
	ОтчетОбОшибке.Дата 			= ДанныеОбОтчете.Дата;
	ОтчетОбОшибке.База			= ДанныеОбОтчете.База;
	
	ОтчетОбОшибке.Описания.Очистить();
	
	стрПояснение = Неопределено;
	Если СтруктураОшибки.Свойство("errorInfo", стрПояснение) Тогда
		Если ТипЗнч(стрПояснение) = Тип("Структура") И стрПояснение.Свойство("userDescription") Тогда
			ОтчетОбОшибке.Пояснение 	= стрПояснение.userDescription;
		КонецЕсли;
	КонецЕсли;
	
	
	Для Каждого элемОшибки Из СтруктураОшибки Цикл
		
		Если элемОшибки.Ключ = "time" Тогда
			ОтчетОбОшибке.ВремяОшибки = СтруктураОшибки.time;
			Продолжить;// в описания добавлять не будем
		КонецЕсли;
		
		
		#Область Сохраним_Скриншоты
		Если элемОшибки.Ключ = "screenshot" Тогда
			
			Если ТипЗнч(элемОшибки.Значение) = Тип("Структура") Тогда
				
				ОтчетОбОшибке.Скриншоты.Очистить();
				
				Для Каждого КиЗ Из элемОшибки.Значение Цикл
					
					НовСтр = ОтчетОбОшибке.Скриншоты.Добавить();
					
					ИмяФайлаСкриншота = СтрШаблон("%1\%2", ВременныйКаталог, КиЗ.Значение);
					
					НовСтр.Имя 				= КиЗ.Значение;
					
					лФайл = Новый Файл(ИмяФайлаСкриншота);
					НовСтр.Расширение 		= лФайл.Расширение;
					НовСтр.Размер 			= лФайл.Размер();
					НовСтр.ДанныеХранилища 	= Новый ХранилищеЗначения(Новый ДвоичныеДанные(ИмяФайлаСкриншота), Новый СжатиеДанных(9));
					
				КонецЦикла;
				
			КонецЕсли;
			
			Продолжить;// в описания добавлять не будем
			
		КонецЕсли;
		#КонецОбласти
		
		#Область Сохраним_Файлы
		Если элемОшибки.Ключ = "additionalFiles" Тогда
			
			Если ТипЗнч(элемОшибки.Значение) = Тип("Массив") Тогда
				
				ОтчетОбОшибке.Файлы.Очистить();
				
				Для Каждого элемФайл Из элемОшибки.Значение Цикл
					
					НовСтр = ОтчетОбОшибке.Файлы.Добавить();
					
					ИмяФайлаФайла = СтрШаблон("%1\%2", ВременныйКаталог, элемФайл);
					
					НовСтр.Имя 			= элемФайл;
					
					лФайл = Новый Файл(ИмяФайлаФайла);
					НовСтр.Расширение 		= лФайл.Расширение;
					НовСтр.Размер 			= лФайл.Размер();
					
					НовСтр.ДанныеХранилища 	= Новый ХранилищеЗначения(Новый ДвоичныеДанные(ИмяФайлаФайла), Новый СжатиеДанных(9));
					
				КонецЦикла;
				
			КонецЕсли;
			
			Продолжить;// в описания добавлять не будем
			
		КонецЕсли;
		#КонецОбласти
		
		Если элемОшибки.Ключ = "errorInfo" Тогда
			Если ТипЗнч(элемОшибки.Значение) = Тип("Структура") Тогда
				Если элемОшибки.Значение.Свойство("userDescription") Тогда
					ОтчетОбОшибке.Пояснение 	= элемОшибки.Значение.userDescription;
				КонецЕсли;
				элемОшибки.Значение.Удалить("userDescription");
				элемОшибки.Значение.Удалить("systemErrorInfo");
			КонецЕсли;
		КонецЕсли;
		
		Если элемОшибки.Ключ = "sessionInfo" Тогда
			Если ТипЗнч(элемОшибки.Значение) = Тип("Структура") И элемОшибки.Значение.Свойство("userName") Тогда
				ОтчетОбОшибке.Пользователь 	= элемОшибки.Значение.userName;
			КонецЕсли;
		КонецЕсли;
		
		Если элемОшибки.Ключ = "errorInfo" Тогда
			НовСтр = ОтчетОбОшибке.Описания.Вставить(0);
		Иначе
			НовСтр = ОтчетОбОшибке.Описания.Добавить();
		КонецЕсли;
		НовСтр.Секция	= элемОшибки.Ключ;
		НовСтр.Описание	= СтроковыеФукнцииЛоггер.ЗначениеВСтрокуJSON(элемОшибки.Значение);
		
	КонецЦикла;
	
	УдалитьФайлы(ВременныйКаталог);
	
	ОтчетОбОшибке.Записать();
	
	Если ЧиститьЛоги Тогда
		РегистрыСведений.ПолученныеОтчетыОбОшибках.УдалитьЗапись(ДанныеОбОтчете.Идентификатор);
	КонецЕсли;
	
	Если ИспользоватьРассылку Тогда
		РегистрыСведений.ДокументыДляРассылки.ДобавитьЗапись(ОтчетОбОшибке.Ссылка);
	КонецЕсли;
		
КонецПроцедуры

Процедура ДобавитьСообщение(ТекстСообщения)
	
	Сообщить(ТекстСообщения);
	
	ЗаписьЖурналаРегистрации("ОбработкаПолученныхОтчетовОбОшибках",
	УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщения);
		
КонецПроцедуры

#КонецОбласти

#Область НашКод

Процедура ВыполнитьОсновноеДействие() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрСведений.ПолученныеОтчетыОбОшибках";
	РезультатЗапроса = Запрос.Выполнить();
	
	ИспользоватьРассылку =  Константы.ИспользоватьРассылку.Получить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка	= РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Попытка
				ОбработатьДанныеПолученногоОтчетаОбОшибке(Выборка, ИспользоватьРассылку);
			Исключение
				ТекстОшибки = "Не удалось обработать отчет об ошибке с идентификатором %1 по причине %2";
				ТекстОшибки = СтрШаблон(ТекстОшибки, Выборка.Идентификатор, ОписаниеОшибки());
			    ДобавитьСообщение(ТекстОшибки);
			КонецПопытки;
			
		КонецЦикла;
	КонецЕсли;
	
	ВыполнитьРассылку();
	
КонецПроцедуры

Процедура ВыполнитьРассылку()
	
	Если Константы.ИспользоватьРассылку.Получить() = Ложь Тогда	
		Возврат;
	КонецЕсли;
	
	мУчетка = Константы.УчетнаяЗаписьДляРассылки.Получить();
	мТема	= Константы.ТемаРассылки.Получить();
	мКому	= Константы.ОбщийСписокРассылки.Получить();
	
	Если Не ЗначениеЗаполнено(мУчетка) или Не ЗначениеЗаполнено(мТема) или Не ЗначениеЗаполнено(мКому) Тогда
		Возврат;
	КонецЕсли;
	
	мПолучатели = СтрРазделить(мКому, ",", Ложь);
	
	//получить данные для рассылки по списку документов
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДокументыДляРассылки.Отчет КАК Отчет,
	               |	ДокументыДляРассылки.Отчет.База КАК База,
	               |	1 КАК Количество
	               |ИЗ
	               |	РегистрСведений.ДокументыДляРассылки КАК ДокументыДляРассылки";
	
	тзДанные = Запрос.Выполнить().Выгрузить();
	
	Если тзДанные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	тзИтого = тзДанные.Скопировать();
	тзИтого.Свернуть("База", "Количество");
	
	//далее можно сделать рассылку как по каждой базе (доработать потом), так и одну общую
	текстПисьма = СтрШаблон("Появились новые сообщения (%1) об ошибках: 
						|", тзИтого.Итог("Количество")
	);
	Для Каждого стрТЗ Из тзИтого Цикл
		текстПисьма = текстПисьма + СтрШаблон("
						|Для базы %1 в количестве %2"
						, стрТЗ.База
						, стрТЗ.Количество
		);
	КонецЦикла;
	
	текстПисьма = СтрЗаменить(текстПисьма, Символы.ПС, "<br>");
	
	ОтправкаУспешна = Ложь;
	
	Кому	= "";
	Копии	= Новый Массив;
	Для каждого Получатель Из мПолучатели Цикл
		Если ПустаяСтрока(Кому) Тогда
			Кому = Получатель;
		Иначе
			Копии.Добавить(Новый Структура("Адрес, Представление", Получатель, ""));
		КонецЕсли;
	КонецЦикла;
		
	ПараметрыОтправки = Новый Структура;
	ПараметрыОтправки.Вставить("Тема"		, мТема);
	ПараметрыОтправки.Вставить("Кому"		, Кому);
	ПараметрыОтправки.Вставить("Копии"		, Копии);
	ПараметрыОтправки.Вставить("Тело"		, текстПисьма);
	ПараметрыОтправки.Вставить("ТипТекста"	, Перечисления.ТипыТекстовЭлектронныхПисем.HTML);
	//ПараметрыОтправки.Вставить("Вложения"	, ПоместитьВложенияВоВременноеХранилище());
	//ПараметрыОтправки.Вставить("УдалятьФайлыПослеОтправки", Ложь);
	
	Если ПараметрыОтправки.Кому = "" И
		ПараметрыОтправки.Копии.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указаны адреса у получателей");
		Возврат
	КонецЕсли;
	
	Попытка
		РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(мУчетка, ПараметрыОтправки);
		ОтправкаУспешна = Истина;
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки;
	
	Если ОтправкаУспешна Тогда
		Для Каждого стрТЗ из тзДанные Цикл
			РегистрыСведений.ДокументыДляРассылки.УдалитьЗапись(стрТЗ.Отчет);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли



